<misterromdescription>
	<name>Tetris: The Grand Master (Japan 980710)</name>
	<setname>tgmj</setname>
	<year>1998</year>
	<manufacturer>Arika / Capcom</manufacturer>
	<category>Puzzle</category>
	<players>2</players>
	<joystick>4-way</joystick>
	<rotation>horizontal</rotation>
	<rbf>ZN2Capcom</rbf>

	<!-- idx0 BIOS coh3002c -->
	<rom index="0" zip="coh3002c.zip" md5="none"><part name="m534002c-59.ic353" crc="e860ea8b"/></rom>
	<!-- idx1 platform byte 15 (Capcom+2MB-VRAM) -->
	<rom index="1"><part>15</part></rom>
	<!-- idx2 countryrom -->
	<rom index="2" zip="tgmj.zip" md5="none"><part name="atej_04.2h" crc="bb4bbb96"/></rom>
	<!-- idx3 bankedroms -->
	<rom index="3" zip="tgmj.zip" md5="none">
		<part name="ate-05m.3h" crc="50977f5a"/>
		<part name="ate-06m.4h" crc="05973f16"/>
	</rom>
	<!-- idx4 mobo CAT702 key cp10 -->
	<rom index="4" zip="coh3002c.zip" md5="none"><part name="cp10.ic652" crc="7808fcef"/></rom>
	<!-- idx5 game CAT702 key -->
	<rom index="5" zip="tgmj.zip" md5="none"><part name="cp11" crc="22d77c59"/></rom>
	<!-- idx6 Z80 -->
	<rom index="6" zip="tgmj.zip" md5="none">
		<part name="ate_02.2e" crc="f4f6e82f"/>
	</rom>
	<!-- idx7 QSound samples -->
	<rom index="7" zip="tgmj.zip" md5="none">
		<part name="ate-01m.3a" crc="a21c6521"/>
	</rom>
	<!-- idx8 DSP microcode -->
	<rom index="8" zip="qsound_hle.zip" md5="none"><part name="dl-1425.bin" crc="d6cf5ef5"/></rom>

	<nvram index="9" size="2048"/>
	<switches base="96" default="00"><dip name="Service Mode" bits="1" ids="Off,On"/></switches>
	<buttons names="Rotate Left,Rotate Right,Rotate Left,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,L3" count="3"/>
</misterromdescription>
