<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Puzzle Yutnori (Korea)</name>
    <setname>yutnori</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Nunal</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="A,B,C,-,-,-,Start,Coin,Pause" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>08 80 00 00 F0 24 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="yutnori.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="sys_d8-d15" crc="bf108119" map="01"/>
            <part name="sys_d0-d7" crc="d5c853da" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="graphics_rom_1" crc="d4881b49"/>
        <part name="graphics_rom_2" crc="8cd9ce60"/>
        <part name="graphics_rom_3" crc="04f7c2ac"/>
        <part repeat="0xF0000">00</part>  <!-- oki2 at 0x310000 -->
        <!-- oki2 -->
        <part name="voice_rom" crc="25e85201"/>
        <part repeat="0x10000">00</part>  <!-- oki1 at 0x360000 -->
        <!-- oki1 -->
        <part name="sound rom" crc="d24c2e43"/>
    </rom>

    <switches default="FF,FF,00">
        <dip name="Coin / Credit" bits="0,2" ids="3 / 40,3 / 50,1 / 30,1 / 40,1 / 50,2 / 30,2 / 40,2 / 50"/>
        <dip name="Difficulty" bits="3,5" ids="8,7,6,5,3,2,1,4"/>
        <dip name="Mal Count" bits="6,7" ids="4,2,5,3"/>
        <dip name="Base Bet" bits="8,9" ids="20,30,40,50"/>
        <dip name="Max Bet" bits="10,11" ids="400,150,200,300"/>
        <dip name="Score" bits="12,13" ids="1200 1800 2400,800 1200 1600,1000 2000 3000,1000 1500 2000"/>
        <dip name="Bet -&gt; Score" bits="14,14" ids="Off,On"/>
        <dip name="Service Mode" bits="15,15" ids="On,Off"/>
    </switches>
</misterromdescription>
