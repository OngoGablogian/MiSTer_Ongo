<misterromdescription>
    <!-- Generated by scripts/build_mra_lm.py from MAME limenko.cpp; the layout is
         rtl/lm_sdram_map.svh. Do not edit by hand. -->
    <name>To Heart House</name>
    <setname>hrthouse</setname>
    <rbf>ppriest_Limenko</rbf>
    <mameversion>0289</mameversion>
    <year>200?</year>
    <manufacturer>Limenko</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Hold 1,Hold 2,Hold 3,Hold 4,Start,Coin,Pause,Service Coin,Service Mode,Take / Odd,Bet / Double Up" default="A,B,X,Y,Start,Select,L,R" count="6"/>

    <!-- mod byte (rtl/lm_main.sv): [2:0] game (0 dynabomb, 1 sb2003, 2 legendoh, 3 hrthouse,
         4 spotty), [4] a 1 MB program at 0xfff00000 -->
    <rom index="1"><part>03</part></rom>

    <!-- byte 0 bit 0: IN2 bit 29 (limenko.cpp INPUT_PORTS); bits 3:1 the QS1000's output shift -->
    <switches default="08" base="0">
        <dip bits="0" name="Sound Enable" ids="On,Off"/>
        <dip bits="1,3" name="Volume Boost" ids="Off,+6 dB,+12 dB,+18 dB,+24 dB,+30 dB"/>
    </switches>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM -->
    <rom index="0" zip="hrthouse.zip" md5="none" address="0x30000000">
        <!-- maincpu: ROM_LOAD16_WORD_SWAP -->
        <part repeat="0x100000">FF</part>  <!-- maincpu, erased -->
        <part repeat="0x80000">FF</part>  <!-- maincpu 0x180000 -->
        <interleave output="16">
            <part name="01.sys_rom2" crc="29884065" map="12"/>
        </interleave>
        <!-- qs1000:cpu -->
        <part name="07.sou_prg" crc="42872e1f"/>
        <part repeat="0x40000">FF</part>  <!-- snd, erased or filled -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x17FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="06.sou_rom1" crc="95afe511"/>
        <part repeat="0x180000">00</part>  <!-- samples 0x200000 -->
        <part name="qs1003.u4" crc="19e4b469"/>
        <part repeat="0x600000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_BYTE quads -->
        <interleave output="32">
            <part name="05.cg_rom1" crc="a114b9da" map="0001"/>
            <part name="04.cg_rom2" crc="e3b2a85f" map="0010"/>
            <part name="03.cg_rom3" crc="ca648641" map="0100"/>
            <part name="02.cg_rom4" crc="4c5ea0d3" map="1000"/>
        </interleave>
    </rom>

    <nvram index="2" size="4224"/>
</misterromdescription>
