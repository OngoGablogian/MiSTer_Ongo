<?xml version='1.0' encoding='utf-8'?>
<misterromdescription>
  <!-- PATREON MRA, 20260923. Required RBF: Arcade-XNSYSTEMFL_20260923.rbf. MiSTer requires the RBF stem without .rbf. -->
  <name>Speed Racer</name>
  <setname>speedrcr</setname>
  <year>1995</year>
  <manufacturer>Namco</manufacturer>
  <rbf>XNSYSTEMFL</rbf>
  <about>Namco System FL PATREON release 2026-09-23 (XelaNotPu).</about>
  <buttons names="Accelerator,Start / Jump,Weapon 1,Weapon 2,Weapon 3,Coin,Service,Test,Pause" default="A,B,X,Y,L,R,Select,Start"/>
  <!-- Steering uses standard Left/Right or normalized analog input. No brake or gear on Speed Racer. In test mode: Weapon 1 modifies, Weapon 2 moves up, Weapon 3 moves down; Service enters pages. -->
  <switches default="00">
    <dip bits="0" name="Freeze Screen" ids="Off,On"/>
  </switches>
  <!--
     FAST LOADING (per /home/nas/claude/example.mra).
     Every byte destined for SDRAM is concatenated into ONE index-0
     stream, so the host assembles and transfers it in a single
     download of 0x1680000 bytes. The core splits it by the fixed
     offsets below (rtl/fl_rom_layout.svh, generated from the same
     table) instead of by ioctl_index, so there are no per-region
     transfers and no extra download handshakes.

       stream     size       region
       0x0000000  0x0100000  maincpu
       0x0100000  0x0200000  data
       0x0300000  0x0080000  c75data
       0x0380000  0x0200000  c169roz
       0x0580000  0x0400000  c123tmap
       0x0980000  0x0800000  c355spr
       0x1180000  0x0080000  c169roz:mask
       0x1200000  0x0080000  c123tmap:mask
       0x1280000  0x0400000  c352

     Padding: none required - every region above is exactly filled by
     its parts, so this is a straight concatenation. A region that is
     not full is padded here with <part repeat="0x..">XX</part> so the
     later regions stay on their fixed offsets (tools/roms.py emits
     that automatically, using MAME's erase value for the region).
     The slot table is shared by every System FL set and is sized for
     the largest of them, so fl_download.sv can insist on exactly
     0x1680000 received bytes before it asserts `loaded`.

     Not applicable: the DDR fast-load form <rom index="0"
     address="0x30000000"> (Main_MiSTer rom_finish() -> shmem_put).
     This core has no DDR3 ROM window - fl_download.sv streams index 0
     into SDRAM over ioctl - so address= would write the ROM where
     nothing reads it. The single-stream layout above is the whole of
     the available fast-load optimisation.

     The C75 MCU BIOS is not SDRAM content (it lands in on-chip BRAM
     via fl_bios_loader.sv), so it stays its own index-8 stream, and
     index 9 is the 8 KiB NVRAM save.
  -->
  <rom index="0" zip="speedrcr.zip" md5="none">
    <!-- maincpu: stream 0x0000000, 1048576 bytes -->
    <interleave output="32">
      <part name="se2_mp_ea4.19a" crc="95ab3fd7" map="0021"/>
      <part name="se2_mp_oa4.18a" crc="5b5ef1eb" map="2100"/>
    </interleave>
    <!-- data: stream 0x0100000, 2097152 bytes -->
    <interleave output="32">
      <part name="se1_dat0.13a" crc="cc5d6ff5" map="0001"/>
      <part name="se1_dat1.14a" crc="ddc8b306" map="0010"/>
      <part name="se1_dat2.15a" crc="2a29abbb" map="0100"/>
      <part name="se1_dat3.16a" crc="49849aff" map="1000"/>
    </interleave>
    <!-- c75data: stream 0x0300000, 524288 bytes -->
    <part name="se1_spr.21l" crc="850a27ac"/>
    <!-- c169roz: stream 0x0380000, 2097152 bytes -->
    <part name="se1_rch0.19j" crc="a0827288"/>
    <part name="se1_rch1.18j" crc="af7609ad"/>
    <!-- c123tmap: stream 0x0580000, 4194304 bytes -->
    <part name="se1_sch0.21p" crc="7b5cfad0"/>
    <part name="se1_sch1.20p" crc="5086e0d3"/>
    <part name="se1_sch2.19p" crc="e59a731e"/>
    <part name="se1_sch3.18p" crc="f817027a"/>
    <!-- c355spr: stream 0x0980000, 8388608 bytes -->
    <interleave output="32">
      <part name="se1obj0l.ic1" crc="17585218" map="0021"/>
      <part name="se1obj0u.ic2" crc="d14b1236" map="2100"/>
    </interleave>
    <interleave output="32">
      <part name="se1obj1l.ic3" crc="c4809fd5" map="0021"/>
      <part name="se1obj1u.ic4" crc="0beefa56" map="2100"/>
    </interleave>
    <!-- c169roz:mask: stream 0x1180000, 524288 bytes -->
    <part name="se1_rsh.14k" crc="f6408a1f"/>
    <!-- c123tmap:mask: stream 0x1200000, 524288 bytes -->
    <part name="se1_ssh.18u" crc="cb534142"/>
    <!-- c352: stream 0x1280000, 4194304 bytes -->
    <part name="se1_voi.23s" crc="0cfa2d8a"/>
  </rom>
  <rom index="8" zip="namcoc75.zip" md5="none">
    <part name="c75.bin" crc="42f539a5"/>
  </rom>
  <!-- Cabinet/config byte for rtl/fl_inputs.sv (SYSTEMFL.sv ioctl index 10): bit 0 = Final Lap R controls (brake pedal AN6, shifter IN1.4, IN2 idle). -->
  <rom index="10">
    <part>00</part>
  </rom>
  <!-- 8192-byte NVRAM: saved per .mra name by MiSTer (index 9). -->
  <!-- Factory NVRAM (MAME "nvram" region: default settings incl. pedal/steering calibration) seeds the 8 KiB NVRAM on a fresh install; a saved .nvm still overrides it (loaded after the roms). -->
  <rom index="9" zip="speedrcr.zip" md5="none">
    <part name="speedrcr.nv" crc="58b41c70"/>
  </rom>
  <nvram index="9" size="8192"/>
</misterromdescription>