<misterromdescription>
	<name>Alpine Racer 2 (World, ARS2 Ver.B)</name>
	<setname>alpinr2b</setname>
	<rbf>XNSUPER22</rbf>
	<mameversion>0287</mameversion>
	<year>1996</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System Super 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout = the FIXED slots of rtl/s22_top.sv s22_romload
	  (re-laid by tools/ss22_relayout.py; verify: tools/mra_slotcheck.py + sim/slotmap).

	    0x0000000   4.00M  maincpu     68EC020 program, 32-bit BE interleave (region 0x000000-0x3FFFFF)
	    0x0400000   0.50M  mcu         M37710 data ROM (SS22 BIOS + SEQ data)
	    0x0480000   0.01M  c71         C71 DSP internal ROM (namcoc71), then pad
	    0x0500000   2.00M  sprite      32x32x8bpp sprite tiles (slot 12M)
	    0x1100000  12.00M  textile     16x16x8bpp texture tiles (slot 16M)
	    0x2100000   2.00M  ccrl        texture tilemap LO (slot 2M)
	    0x2300000   0.50M  ccrh        texture tilemap ATTR (slot 0.5M)
	    0x2380000   2.00M  point L     plane L (0x200000 per plane)
	    0x2580000   2.00M  point M     plane M (0x200000 per plane)
	    0x2780000   1.50M  point U     plane U (0x200000 per plane)
	    0x2900000  12.00M  c352        samples (true region offsets, gaps padded, tail truncated)
	    0x3500000   0.50M  point U+    U-plane bytes 0x180000+ (POINTX window -> SDRAM word 0x6C0000)
	    0x3580000         end

	  maincpu is an 8 MB region (4 x 2 MB LOAD32_BYTE) but namcos22s_am maps only ROM
	  0x000000-0x3FFFFF (namcos22.cpp:1860; alpine() config, no bank window), i.e. the
	  FIRST 1 MB of each file. The second halves are constant 0xFF ("2nd half empty") and
	  are not loaded.
	  KEYCUS: none (namcos22_keycus_r has no ALPINE_RACER_2 case -> random); MAME with the
	  C370 window forced to 0xFFFF gives a pixel-identical 40 s attract -> index-1 disabled.
	  EEPROM: MAME's default image alpiner2_defaults.nv is LOAD-BEARING (blank EEPROM ->
	  "MOTOR ERROR2 / OPERATION STOP!!" at ~24 s) -> index 8 (s22_cpu B_EEDL).
	-->

	<rom index="0" zip="alpinr2b.zip|namcoc71.zip" md5="none">
		<interleave output="32">
			<!-- region byte o -> stream lane o^1 (halfword-exchange, hw-proven on ridgerac 2026-08-25) -->
			<part name="ars2verb.2" crc="ed977f83" length="0x100000" map="0100"/>
			<part name="ars2verb.4" crc="610e49c2" length="0x100000" map="1000"/>
			<part name="ars2verb.3" crc="8e7a9983" length="0x100000" map="0001"/>
			<part name="ars2verb.5" crc="7f3517b0" length="0x100000" map="0010"/>
		</interleave>
		<part name="ars2data.8k" crc="29b36dcb"/>
		<part name="c71.bin" crc="47c623ab"/><!-- namcoc71.zip: C71 (TMS320C25) internal ROM -->
		<part repeat="0x7E000">00</part>
		<part name="ars1scg0.12f" crc="bc49ed86"/>
		<part repeat="0xA00000">00</part>
		<part name="ars1cg0.8d" crc="74f4515c"/>
		<part name="ars1cg1.10d" crc="329a95c1"/>
		<part name="ars1cg2.12d" crc="5648345a"/>
		<part name="ars1cg3.13d" crc="a752f205"/>
		<part name="ars1cg4.14d" crc="54bf35b6"/>
		<part name="ars1cg5.16d" crc="e24a19a2"/>
		<part repeat="0x400000">00</part>
		<part name="ars1ccrl.3d" crc="fc8c9161"/>
		<part name="ars1ccrh.1d" crc="a17660bb"/>
		<part name="ars1ptrl0.18k" crc="f04e0e61"/>
		<part name="ars1ptrl1.16k" crc="8bdb4970"/>
		<part name="ars1ptrl2.15k" crc="ec993a4f"/>
		<part name="ars1ptrl3.14k" crc="4d453f3c"/>
		<part name="ars1ptrm0.18j" crc="d1bdc524"/>
		<part name="ars1ptrm1.16j" crc="86b81c81"/>
		<part name="ars1ptrm2.15j" crc="24116b83"/>
		<part name="ars1ptrm3.14j" crc="772bede3"/>
		<part name="ars1ptru0.18f" crc="a4cf197a"/>
		<part name="ars1ptru1.16f" crc="1deb1fc0"/>
		<part name="ars1ptru2.15f" crc="bcfad0ba"/>
		<part name="ars1wavea.2l" crc="f8d107e9"/>
		<part repeat="0x400000">00</part>
		<part name="ars2waveb.1l" crc="deab4ad1"/>
		<part name="ars1ptru3.14f" crc="73ce6958"/>
	</rom>

	<!-- DSW at 0x440000 (namcos22s_am), SW4 = bits 16..23 -> status[31:24] (base 24); only the switches
	     MAME names are exposed. Cabinet = status[32] -> INPUTS. Controls: tools/mra_controls_ss22.py. -->

	<buttons names="Decision,L Select,R Select,-,-,Coin,Service,Test,-,Pause" default="Start,L,R,,,Select"/>
	<rom index="1"><part>80 00 00 00 07 00</part></rom>

	<!-- B_EEDL: MAME "eeprom" region default (8 KB, cell i = CPU 0x460000+2i), see header. -->
	<rom index="8" zip="alpinr2b.zip" md5="none">
		<part name="alpiner2_defaults.nv" crc="1f21154e"/>
	</rom>
	<nvram index="8" size="8192"/>

	<!-- index 9: PATREON pause screen (640x640 RGB565 scrolling supporter credits), written by
