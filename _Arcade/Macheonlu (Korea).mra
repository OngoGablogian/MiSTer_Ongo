<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Macheonlu (Korea)</name>
    <setname>mcheonru</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>SemiCom / AceVer</manufacturer>
    <category>Mini-Games</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="A,B,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 12 00 0A 00 40 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="mcheonru.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="u74" crc="3edb17ce" map="01"/>
            <part name="u52" crc="63fd8a9b" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="u75" crc="0142c085"/>
        <part name="u76" crc="27fda507"/>
        <part name="u77" crc="4dfe0550"/>
        <part name="u78" crc="f1b74978"/>
        <!-- soundcpu -->
        <part name="u35" crc="79e965b4"/>
        <!-- oki1 -->
        <part name="u14" crc="28a62d23"/>
        <part repeat="0x2000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="d61f4f07"/>
    </rom>

    <switches default="FE,FF,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Coinage" bits="1,3" ids="-,-,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="4,6" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <dip name="Unknown" bits="8,8" ids="On,Off"/>
        <dip name="Tile Type" bits="9,9" ids="Traditional,Picture"/>
        <dip name="Mini Game" bits="10,10" ids="Every Round,Every 3 Rounds"/>
        <dip name="Unknown" bits="11,11" ids="On,Off"/>
        <dip name="Unknown" bits="12,12" ids="On,Off"/>
        <dip name="Unknown" bits="13,13" ids="On,Off"/>
        <dip name="Unknown" bits="14,14" ids="On,Off"/>
        <dip name="Free Play" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
