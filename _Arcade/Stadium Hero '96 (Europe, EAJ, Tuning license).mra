<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME deco_mlc.cpp; the layout is
         scripts/mlc_layout.py (rtl/video/mlc_video_pkg.sv). Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME deco_mlc.cpp"/>
    <name>Stadium Hero '96 (Europe, EAJ, Tuning license)</name>
    <setname>stadhr96</setname>
    <rbf>ppriest_DecoMLC156</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Sports</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Dash,Pitch/Swing,Bunt/Substitute,-,-,-,Start,Coin,Pause,Test" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod byte (DecoMLC.sv): [0] the DE156 configurations (0 = SH-2), [2:1] orientation,
         [3] the DECO 146, [5:4] the gfx layout (4bpp, 5bpp, 6bpp, acchi), [6] gfx1 thirds of 8 MB -->
    <rom index="1"><part>69</part></rom>

    <!-- the factory EEPROM image (ROM_REGION16_BE eeprom): the core loads it into its 93C45 -->
    <rom index="2" zip="stadhr96.zip" md5="none">
        <part name="eeprom-stadhr96.bin" crc="77861793"/>
    </rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="stadhr96.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="sh-eaj.2a" crc="10d1496a" map="0021"/>
            <part name="sh-eaj.2b" crc="608a9144" map="2100"/>
        </interleave>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="mcm-01.8m" crc="2255d47d" map="01"/>
            <part name="mcm-00.2e" crc="c1919c3c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcm-03.10m" crc="4bd84ca7" map="01"/>
            <part name="mcm-02.4e" crc="38c39822" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcm-05.11m" crc="476f03d7" map="01"/>
            <part name="mcm-04.6e" crc="7c0bd84c" map="10"/>
        </interleave>
        <!-- gfx2 -->
        <part name="sh-eaf.6h" crc="f074a5c8"/>
        <!-- ymz -->
        <part name="mcm-06.6a" crc="fbc178f3"/>
        <part repeat="0x200000">00</part>  <!-- image end -->
    </rom>

    <switches default="00,00,00">
        <!-- the board has no DIP switches (a 93C45 EEPROM): read by the core, not the game -->
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>
</misterromdescription>
