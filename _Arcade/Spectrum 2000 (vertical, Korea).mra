<!--
  Spectrum 2000 (vertical, Korea) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 41).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... spec2k ...)
  line 10846, ROM_START(spec2k), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Spectrum 2000 (vertical, Korea)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>spec2k</setname>
  <year>2000</year>
  <manufacturer>Yona Tech</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,29">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Free Play" ids="On,Off"/>
    <dip bits="3" name="Number of Bombs" ids="3,2"/>
    <dip bits="4" name="Copyright Notice" ids="Off,On"/>
    <dip bits="5" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,5,2,3"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW2:7)" ids="On,Off"/>
    <dip bits="10" name="Unknown (SW2:6)" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="spec2k.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 (init_spec2k scramble) -->
    <interleave output="16">
      <part crc="be53e243" name="u120" map="01"/>
      <part crc="dbd6f65d" name="u124" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="f4e4fb10" name="u103"/>
    <!-- fgtile, 0x020000 -->
    <part crc="921503b8" name="u3"/>
    <!-- bgtile, 0x400000 (8bpp: two 4bpp halves) -->
    <part crc="1d087122" name="uc3"/>
    <part crc="998dc05c" name="uc2"/>
    <!-- sprites, 0x200000 (plain) -->
    <part crc="3139a213" name="uc1"/>
    <!-- oki1, 0x040000 -->
    <part crc="d16aaaad" name="u101"/>
    <!-- oki2, 0x080000 (two banks, Z80 0xFFF2) -->
    <part crc="65d61f3a" name="u106"/>
  </rom>
</misterromdescription>
