<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Yori Jori Kuk Kuk</name>
    <setname>yorijori</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>2002</year>
    <manufacturer>Golden Bell Entertainment</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>59 02</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="yorijori.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part name="prg1" crc="0e04eb40" offset="0x100000" length="0x100000"/>  <!-- its second MB: 0xfff00000 -->
        <!-- qs1000:cpu, once -->
        <part name="snd5" crc="79067367"/>
        <part repeat="0x60000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="snd2" crc="8d9a8795"/>
        <part name="qs1001a.snd3" crc="d13c6407"/>
        <part repeat="0x280000">00</part>  <!-- maincpu's first MB -->
        <part name="prg1" crc="0e04eb40" offset="0" length="0x100000"/>  <!-- maincpu's first MB: 0xffe00000 -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="roml00" crc="9299ce36" map="0021"/>
            <part name="romh00" crc="16584ff2" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="roml01" crc="b5d1892f" map="0021"/>
            <part name="romh01" crc="fe0485ef" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
