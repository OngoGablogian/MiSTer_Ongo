<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME dreamwld.cpp; the layout is
         rtl/memory/dreamworld_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME dreamwld.cpp"/>
    <name>Rolling Crush (version 1.07.E - 1999/02/11, Trust license)</name>
    <setname>rolcrush</setname>
    <rbf>DreamWorld</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>SemiCom / Exit (Trust license)</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Launch,-,-,-,-,-,Start,Coin,Pause" default="A,Start,Select,R" count="1"/>

    <!-- mod byte (DreamWorld.sv): [0] the second OKI (dreamwld_map), [2:1] orientation -->
    <rom index="1"><part>00</part></rom>

    <!-- hiscore (rtl/hiscore.v), from MAME's plugins/hiscore/hiscore.dat -->
    <rom index="3">
        <part>
        19 9A 57 EF 3F FF 00 02 00 02 00 01 00 0F 10 00
        00 FE DE 76 76 41 01 00
        </part>
    </rom>
    <nvram index="4" size="118"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="rolcrush.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="mx27c2000_4.bin" crc="c47f0540" map="0001"/>
            <part name="mx27c2000_3.bin" crc="7af59294" map="0010"/>
            <part name="mx27c2000_2.bin" crc="5eb24adb" map="0100"/>
            <part name="mx27c2000_1.bin" crc="a37e15b2" map="1000"/>
        </interleave>
        <part repeat="0x100000">00</part>  <!-- gfx1 at 0x200000 -->
        <!-- gfx1 -->
        <part name="m27c160.8.bin" crc="a509bc36"/>
        <part repeat="0x600000">00</part>  <!-- gfx2 at 0xA00000 -->
        <!-- gfx2 -->
        <part name="m27c160.10.bin" crc="739b0cb0"/>
        <!-- spritelut -->
        <interleave output="16">
            <part name="tms27c010_7.bin" crc="4cb84384" map="01"/>
            <part name="tms27c010_6.bin" crc="0c9d197a" map="10"/>
        </interleave>
        <!-- oki1 -->
        <part name="mx27c4000_5.bin" crc="7afa6adb"/>
        <part repeat="0x80000">00</part>  <!-- mcu at 0xD40000 -->
        <!-- mcu -->
        <part name="mcu.bin" crc="9185e237"/>
    </rom>

    <switches default="FF,FE,00">
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <dip name="Coinage" bits="9,10,11" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="12,13,14" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (DreamWorld.sv flip_screen) -->
        <dip name="Flip Screen" bits="16" ids="Off,On"/>
    </switches>
</misterromdescription>
