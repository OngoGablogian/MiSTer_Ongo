<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Wivern Wings</name>
    <setname>wivernwg</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Shooter</category>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Shot,Defense,Bomb,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>0D 01</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="wivernwg.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part name="rom1" crc="83eb9a36"/>
        <part name="rom2" crc="5d657055"/>
        <!-- qs1000:cpu, once -->
        <part name="u7" crc="00a3f705"/>
        <part repeat="0x60000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="romsnd.u15a" crc="fc89eedc"/>
        <part name="qs1001a" crc="d13c6407"/>
        <part repeat="0x380000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="roml00" crc="fb3541b6" map="0021"/>
            <part name="romh00" crc="516aca48" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="roml01" crc="1c764f95" map="0021"/>
            <part name="romh01" crc="fee42c63" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="roml02" crc="fc846707" map="0021"/>
            <part name="romh02" crc="86141c7d" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="l03" crc="85aa8db8" map="0021"/>
            <part name="h03" crc="ade8af9f" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
