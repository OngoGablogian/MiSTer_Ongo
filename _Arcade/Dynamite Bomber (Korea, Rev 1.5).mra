<misterromdescription>
    <!-- Generated by scripts/build_mra_lm.py from MAME limenko.cpp; the layout is
         rtl/lm_sdram_map.svh. Do not edit by hand. -->
    <name>Dynamite Bomber (Korea, Rev 1.5)</name>
    <setname>dynabomb</setname>
    <rbf>ppriest_Limenko</rbf>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Limenko</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Bomb,Throw,Jump,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod byte (rtl/lm_main.sv): [2:0] game (0 dynabomb, 1 sb2003, 2 legendoh, 3 hrthouse,
         4 spotty), [4] a 1 MB program at 0xfff00000 -->
    <rom index="1"><part>00</part></rom>

    <!-- byte 0 bit 0: IN2 bit 29 (limenko.cpp INPUT_PORTS); bits 3:1 the QS1000's output shift -->
    <switches default="06" base="0">
        <dip bits="0" name="Sound Enable" ids="On,Off"/>
        <dip bits="1,3" name="Volume Boost" ids="Off,+6 dB,+12 dB,+18 dB,+24 dB,+30 dB"/>
    </switches>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM -->
    <rom index="0" zip="dynabomb.zip" md5="none" address="0x30000000">
        <!-- maincpu: ROM_LOAD16_WORD_SWAP -->
        <interleave output="16">
            <part name="rom.u6" crc="457e015d" map="12" offset="0x0" length="0x100000"/>
        </interleave>
        <interleave output="16">
            <part name="rom.u6" crc="457e015d" map="12" offset="0x100000" length="0x100000"/>
        </interleave>
        <!-- qs1000:cpu -->
        <part name="rom.u16" crc="f66d7e4d"/>
        <part repeat="0x60000">FF</part>  <!-- snd, erased or filled -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x17FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="rom.u18" crc="50d76732"/>
        <part name="rom.u17" crc="20f2417c"/>
        <part repeat="0x100000">00</part>  <!-- samples 0x200000 -->
        <part name="qs1003.u4" crc="19e4b469"/>
        <!-- maindata: ROM_LOAD16_WORD_SWAP -->
        <interleave output="16">
            <part name="rom.u5" crc="7e837adf" map="12"/>
        </interleave>
        <part repeat="0x200000">FF</part>  <!-- maindata, erased -->
        <part repeat="0x200000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_BYTE quads -->
        <interleave output="32">
            <part name="rom.u1" crc="bf33eff6" map="0001"/>
            <part name="rom.u2" crc="790bbcd5" map="0010"/>
            <part name="rom.u3" crc="ec094b12" map="0100"/>
            <part name="rom.u4" crc="88b24e3c" map="1000"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
