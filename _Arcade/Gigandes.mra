<?xml version="1.0" encoding="utf-8"?>

<misterromdescription>
	<name>Gigandes</name>
	<setname>gigandes</setname>
	<mameversion>0289</mameversion>
	<year>1989</year>
	<manufacturer>East Technology</manufacturer>
	<rbf>Gigandes</rbf>
	<rotation>horizontal</rotation>
	<resolution>384x240</resolution>
	<buttons names="Fire,Jump,Start 1P,Start 2P,Coin,Service,Pause" default="A,B,Start,Select,R,L,X" count="2"/>
	
	<switches default="DF,98" page_id="1" page_name="Switches">
		
		
		
		<dip bits="0,1"   ids="2C/3C,2C/1C,1C/2C,1C/1C" name="Coin A" ids_default="3"/>
		<dip bits="2,3"   ids="2C/3C,2C/1C,1C/2C,1C/1C" name="Coin B" ids_default="3"/>
		<dip bits="4"     ids="Off,On"                  name="Unused"  ids_default="1"/>
		<dip bits="5,6"   ids="Hardest,Hard,Medium,Easy" name="Difficulty" ids_default="2"/>
		<dip bits="7"     ids="On,Off"                  name="Debug Mode" ids_default="1"/>
		
		
		
		<dip bits="8"     ids="On,Off"            name="Demo Sounds"    ids_default="0"/>
		<dip bits="9"     ids="Off,On"            name="Flip Screen"    ids_default="0"/>
		<dip bits="10"    ids="Yes,No"            name="Allow Continue" ids_default="0"/>
		<dip bits="11,12" ids="6,5,4,3"           name="Lives"          ids_default="3"/>
		<dip bits="13"    ids="Dual,Single"       name="Controls"       ids_default="0"/>
		<dip bits="14"    ids="English,Japanese"  name="Language"       ids_default="0"/>
		<dip bits="15"    ids="On,Off"            name="Service Mode"   ids_default="1"/>
	</switches>
	
	
	<rom index="0" zip="gigandes.zip" md5="none" type="merged">
		
		<interleave output="16">
			<part name="east_1.10a" crc="ae74e4e5" map="01"/>
			<part name="east_3.5a"  crc="8bcf2116" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="east_2.8a"  crc="dd94b4d0" map="01"/>
			<part name="east_4.3a"  crc="a647310a" map="10"/>
		</interleave>
		
		<part name="east_5.17d" crc="b24ab5f4"/>
		
		<!-- MAME uses ROM_LOAD32_WORD_SWAP for gfx1. -->
		<interleave output="32">
			<part name="east_8.3f" crc="75eece28" map="0012"/>
			<part name="east_9.3j" crc="5c5e6898" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="east_7.3h" crc="b179a76a" map="0012"/>
			<part name="east_6.3k" crc="52db30e9" map="1200"/>
		</interleave>
		<part name="east-10.16e" crc="ca0ac419"/>
	</rom>
	

</misterromdescription>
