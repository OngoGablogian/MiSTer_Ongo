<misterromdescription>
	<name>Street Fighter EX Plus (USA 970311)</name>
	<setname>sfexpu1</setname>
	<year>1997</year>
	<manufacturer>Capcom / Arika</manufacturer>
	<category>Fighting</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>USA</region>
	<rbf>ZN1Capcom</rbf>

	<!-- BIOS: Capcom ZN-1 BIOS (coh1000c), 512KB, ioctl_index 0. Japanese mask ROM. -->
	<rom index="0" zip="coh1000c.zip" md5="none">
		<part name="m534002c-13.ic353" crc="50033af6"/>
	</rom>

	<!-- Platform: Capcom ZN-1 (0x05) + bit4 (coh1002c 2MB VRAM) = 0x15, ioctl_index 1. -->
	<rom index="1">
		<part>15</part>
	</rom>

	<!-- Country/program ROM: 512KB, ioctl_index 2 (MAME region "countryrom") -->
	<rom index="2" zip="sfexpu1.zip|sfexp.zip" md5="none">
		<part name="sfpu_04.2h" crc="305e4ec0"/>
	</rom>

	<!-- Banked ROM: 6x4MB = 24MB, ioctl_index 3 (MAME region "bankedroms"). -->
	<rom index="3" zip="sfexp.zip" md5="none">
		<part name="sfp-05m.3h" crc="ac7dcc5e"/>
		<part name="sfp-06m.4h" crc="1d504758"/>
		<part name="sfp-07m.5h" crc="0f585f30"/>
		<part name="sfp-08m.2k" crc="65eabc61"/>
		<part name="sfp-09m.3k" crc="15f8b71e"/>
		<part name="sfp-10m.4k" crc="c1ecf652"/>
	</rom>

	<!-- CAT702 key A: motherboard key (cp01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000c.zip" md5="none">
		<part name="cp01.ic652" crc="bb7ba033"/>
	</rom>

	<!-- CAT702 key B: game key (cp04), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="sfexp.zip" md5="none">
		<part name="cp04" crc="e0dc24ae"/>
	</rom>

	<!-- QSound: Z80 sound program (audiocpu), 256KB (2x128KB), ioctl_index 6 -->
	<rom index="6" zip="sfexp.zip" md5="none">
		<part name="sfe_02.2e" crc="1908475c"/>
		<part name="sfe_03.3e" crc="95c1e2e0"/>
	</rom>

	<!-- QSound: DL-1425 sample ROM, 4MB, ioctl_index 7 -->
	<rom index="7" zip="sfexp.zip" md5="none">
		<part name="sfe-01m.3b" crc="f5afff0d"/>
	</rom>

	<!-- QSound: DL-1425 DSP microcode, ioctl_index 8 -->
	<rom index="8" zip="qsound_hle.zip" md5="none">
		<part name="dl-1425.bin" crc="d6cf5ef5"/>
	</rom>

	<nvram index="9" size="2048"/>
	<switches base="96" default="00">
		<dip name="Service Mode" bits="1" ids="Off,On"/>
	</switches>
	<buttons names="LP,MP,HP,LK,MK,HK,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,L3" count="6"/>
</misterromdescription>
