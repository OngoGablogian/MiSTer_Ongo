			<part name="wr1-pt0l.8d" crc="58c14b73" map="10"/>
		</interleave>
		<!-- mirror: MAME masks by region length (words-1 = 0x1FFFF); the core uses 0x3FFFF for every set -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="wr1-pt0u.8j" crc="7ec4cf6b" map="01"/>
			<part name="wr1-pt0l.8d" crc="58c14b73" map="10"/>
