	<rom index="0" zip="winrun.zip|namcoc65.zip" md5="none">

		<!-- 0x0000000  maincpu   0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="wr2-mpub.3k" crc="3bb0ea17" map="01"/>
			<part name="wr2-mplb.1k" crc="95465062" map="10"/>
		</interleave>
		<part repeat="0xC0000">FF</part>

		<!-- 0x0100000  slave     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="wr1-spu.6b" crc="d4915d44" map="01"/>
			<part name="wr1-spl.4b" crc="0c336505" map="10"/>
		</interleave>
		<part repeat="0xC0000">FF</part>

