	<!-- C65 DSW port ($2000, namcos21.cpp:718-741), active low; OSD bit = logical switch
	     (1 = On), the core drives port bit n with ~status[24+n]. -->
	<switches default="00" base="24">
		<dip name="Test Mode (SW:1)" bits="0" ids="Off,On"/>
		<dip name="DSW2 (SW:2)" bits="1" ids="Off,On"/>
		<dip name="DSW3 (SW:3)" bits="2" ids="Off,On"/>
		<dip name="DSW4 (SW:4)" bits="3" ids="Off,On"/>
		<dip name="DSW5 (SW:5)" bits="4" ids="Off,On"/>
		<dip name="PCM ROM (SW:6)" bits="5" ids="2M,4M"/>
		<dip name="DSW7 (SW:7)" bits="6" ids="Off,On"/>
		<dip name="Screen Stop (SW:8)" bits="7" ids="Off,On"/>
	</switches>

	<buttons names="Gas,Brake,Shift Up,Shift Down,Start,Coin,Service,Test,Start 2,Pause" default="A,B,R,L,Start,Select,,,,"/>
</misterromdescription>
