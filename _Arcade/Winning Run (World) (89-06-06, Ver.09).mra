			<part name="wr1-gp0u.1k" crc="c66a43be" map="01"/>
			<part name="wr1-gp0l.3k" crc="91a70e6f" map="10"/>
		</interleave>
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
