	<rom index="0" zip="aircomb.zip|namcoc67.zip" md5="none">

		<!-- 0x0000000  maincpu   0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="ac2-mpr-u.3j" crc="a7133f85" map="01"/>
			<part name="ac2-mpr-l.1j" crc="520a52e6" map="10"/>
		</interleave>

		<!-- 0x0100000  slave     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="ac2-spr-u.6c" crc="42aca956" map="01"/>
			<part name="ac2-spr-l.4c" crc="3e15fa19" map="10"/>
		</interleave>
		<part repeat="0xC0000">FF</part>

		<!-- 0x0200000  data      0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="ac1-data-u.3a" crc="82320c71" map="01"/>
			<part name="ac1-data-l.1a" crc="fd7947d3" map="10"/>
		</interleave>

		<!-- 0x0300000  edata     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="ac1-edata1-u.3c" crc="a9547509" map="01"/>
			<part name="ac1-edata1-l.1c" crc="a87087dd" map="10"/>
		</interleave>

		<!-- 0x0400000  gap_obj   0x200000 -->
		<part repeat="0x200000">FF</part>

		<!-- 0x0600000  point24   0x400000 -->
		<interleave output="32"><!-- {H,H,U,L}: MAME lane 0 is the never-loaded 0x00 of the 32-bit BE word; MRA cannot emit a constant lane, so *-h is repeated there.  The core must ignore stream byte 4n. -->
			<part name="ac1-poi-h.2f" crc="573bbc3b" map="0001"/>
			<part name="ac1-poi-h.2f" crc="573bbc3b" map="0010"/>
			<part name="ac1-poi-lu.2k" crc="d99084b9" map="0100"/>
			<part name="ac1-poi-ll.2n" crc="abb32307" map="1000"/>
		</interleave>
		<part repeat="0x200000">00</part>

		<!-- 0x0A00000  c67       0x002000 -->
		<part name="c67.bin" crc="6bd8988e"/><!-- namcoc67.zip: shared master+slave DSP internal ROM -->

		<!-- 0x0A02000  gap_a     0x002000 -->
		<part repeat="0x2000">FF</part>

		<!-- 0x0A04000  nvram     0x002000 -->
		<part name="aircomb.nv" crc="a97ea3e0"/><!-- default settings incl. analog calibration -->

		<!-- 0x0A06000  gap_b     0x1FA000 -->
		<part repeat="0x1FA000">FF</part>

		<!-- 0x0C00000  c140      0x200000 -->
		<part name="ac1-voi0.12b" crc="f427b119"/>
		<part name="ac1-voi1.12c" crc="c9490667"/>
		<part name="ac1-voi2.12d" crc="1fcb51ba"/>
		<part name="ac1-voi3.12e" crc="cd202e06"/>

		<!-- 0x0E00000  audiocpu  0x020000 -->
		<part name="ac1-snd0.8j" crc="5c1fb84b"/>

		<!-- 0x0E20000  gap_wram  0x1E0000 -->
		<part repeat="0x1E0000">00</part>

		<!-- 0x1000000  c355spr   0x400000 -->
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="ac2-obj0.5s" crc="8327ff22" map="0001"/>
			<part name="ac2-obj1.5x" crc="43af566d" map="0010"/>
			<part name="ac2-obj2.3s" crc="dafbf489" map="0100"/>
			<part name="ac2-obj3.3x" crc="bd555a1d" map="1000"/>
		</interleave>
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="ac2-obj4.4s" crc="e433e344" map="0001"/>
			<part name="ac2-obj5.4x" crc="ecb19199" map="0010"/>
			<part name="ac2-obj6.2s" crc="24cc3f36" map="0100"/>
			<part name="ac2-obj7.2x" crc="d561fbe3" map="1000"/>
		</interleave>
	</rom>

	<!-- C68 DSW port ($2000, namcos21_c67.cpp:658-680).  MAME reads it ACTIVE LOW;
	     the OSD bit here is the LOGICAL switch (1 = On) and the core inverts:
	     dsw_port[n] = ~status[24+n].  Unnamed switches keep MAME's "DSWn" label. -->
	<switches default="20" base="24">
		<dip name="DSW1 (SW:1)" bits="0" ids="Off,On"/>
		<dip name="DSW2 (SW:2)" bits="1" ids="Off,On"/>
		<dip name="DSW3 (SW:3)" bits="2" ids="Off,On"/>
		<dip name="DSW4 (SW:4)" bits="3" ids="Off,On"/>
		<dip name="DSW5 (SW:5)" bits="4" ids="Off,On"/>
		<dip name="PCM ROM (SW:6)" bits="5" ids="2M,4M"/>
		<dip name="DSW7 (SW:7)" bits="6" ids="Off,On"/>
		<dip name="Screen Stop (SW:8)" bits="7" ids="Off,On"/>
	</switches>

	<buttons names="Shoot 1,Start,Shoot 2,-,-,Coin,Service,Test,Start 2,Pause,Throttle Up,Throttle Down" default="A,Start,B,,,Select,L,R,,,X,Y"/>
</misterromdescription>
