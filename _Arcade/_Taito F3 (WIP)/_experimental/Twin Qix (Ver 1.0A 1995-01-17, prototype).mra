<misterromdescription>
  <name>Twin Qix (Ver 1.0A 1995/01/17, prototype)</name>
  <setname>twinqix</setname>
  <year>1995</year>
  <manufacturer>Taito America</manufacturer>
  <rbf>TaitoF3</rbf>
  <players>2</players>
  <joystick>8-way</joystick>
  <rotation>horizontal</rotation>
  <region>World</region>

  <!-- ============================================================
       NEVER LOADED ON A BOARD. Written 2026-09-08.

       Taito F3, the same board Ray Force runs on. Horizontal (MAME ROT0). Note its tilemap is a ROM_LOAD32_BYTE x4 and its tilemap_hi a ROM_LOAD16_BYTE pair, where most F3 sets use a LOAD32_WORD pair and a single ROM. Its ensoniq region is 4 MB, so MAME's otisbank mask is 1.

       Region pads are computed from the real ROM sizes, and the
       assembled stream is 0x01280000 bytes (18.5 MB) exactly, which
       is what proves the regions land on the RTL's base addresses.
       ============================================================ -->
  <rom index="0" zip="twinqix.zip" md5="None">

    <!-- maincpu -->
    <interleave output="32">
      <part name="mpr0-3.b60" crc="1a63d0de" map="0001"/>
      <part name="mpr0-2.b61" crc="45a70987" map="0010"/>
      <part name="mpr0-1.b62" crc="531f9447" map="0100"/>
      <part name="mpr0-0.b63" crc="a4c44c11" map="1000"/>
    </interleave>
    <!-- pad maincpu to 2048 KB -->
    <part repeat="1048576">00</part>

    <!-- audiocpu -->
    <interleave output="16">
      <part name="spr0-1.b66" crc="4b20e99d" map="01"/>
      <part name="spr0-0.b65" crc="2569eb30" map="10"/>
    </interleave>

    <!-- sprites -->
    <interleave output="16">
      <part name="obj0-0.a08" crc="c6ea845c" map="01"/>
      <part name="obj0-1.a20" crc="8c12b7fb" map="10"/>
    </interleave>
    <!-- pad sprites to 4096 KB -->
    <part repeat="3145728">00</part>

    <!-- sprites_hi: no ROM in this set -->
    <!-- pad sprites_hi to 2048 KB -->
    <part repeat="2097152">00</part>

    <!-- tilemap -->
    <interleave output="32">
      <part name="scr0-0.b07" crc="9a1b9b34" map="0001"/>
      <part name="scr0-1.b06" crc="e9bef879" map="0010"/>
      <part name="scr0-2.b05" crc="cac6854b" map="0100"/>
      <part name="scr0-3.b04" crc="ce063034" map="1000"/>
    </interleave>
    <!-- pad tilemap to 4096 KB -->
    <part repeat="2097152">00</part>

    <!-- tilemap_hi -->
    <interleave output="16">
      <part name="scr0-4.b03" crc="d32280fe" map="01"/>
      <part name="scr0-5.b02" crc="fdd1a85b" map="10"/>
    </interleave>
    <!-- pad tilemap_hi to 2048 KB -->
    <part repeat="1048576">00</part>

    <!-- ensoniq -->
    <part name="snd-0.b43" crc="ad5405a9"/>
    <part name="snd-1.b44" crc="274864af"/>
    <part name="snd-14.b10" crc="26312451"/>
    <part name="snd-15.b11" crc="2edaa9dc"/>
    <!-- pad ensoniq to 4096 KB -->
    <part repeat="2097152">00</part>
  </rom>

  <!-- Game config (Rayforce.sv "GAME CONFIG"):
         index 1 = 0xA0, index 2 = 0x01
           visarea 0, extend 1, zone injector off
           (so it starts on level 1), game id 14.
         No expectations are measured for this set yet, so it lands on
         the case default in Rayforce.sv and the ROM CHECKSUM / SDRAM
         BIST / WRITE HASH rows REPORT what they find rather than
         failing against another game's numbers. The self-test TITLE
         row clamps (rf_selftest.sv:329) until a build gives this game
         its own row. That is the page, not the game. -->
  <rom index="1">
    <part>A0</part>
  </rom>
  <rom index="2">
    <part>01</part>
  </rom>

  <!-- the 93C46 settings EEPROM: 64 words, saved to config/nvram/<mra>.nvm -->
  <nvram index="254" size="256"/>

  <buttons names="Button 1,Button 2,-,-,-,-,Start,Coin,Service,Pause" default="A,B,R,L,Select,Start" count="2"/>
</misterromdescription>
