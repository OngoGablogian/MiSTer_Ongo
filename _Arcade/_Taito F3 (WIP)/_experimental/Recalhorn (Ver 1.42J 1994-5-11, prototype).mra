<misterromdescription>
  <name>Recalhorn (Ver 1.42J 1994/5/11, prototype)</name>
  <setname>recalh</setname>
  <year>1994</year>
  <manufacturer>Taito</manufacturer>
  <rbf>TaitoF3</rbf>
  <players>2</players>
  <joystick>8-way</joystick>
  <rotation>horizontal</rotation>
  <region>World</region>

  <!-- ============================================================
       NEVER LOADED ON A BOARD. Written 2026-09-08.

       Taito F3, the same board Ray Force runs on. An UNRELEASED prototype. Horizontal (MAME ROT0). Its sound ROM is half size; streamed TWICE so the third bank window reads bank 0, which is what taito_en's set_entry(i % max) does with a 0x140000 region. Its ensoniq banks are sparse: rh_snd0 fills banks 0 and 1, bank 2 is empty, rh_snd1 sits in bank 3 (MAME offset 0x600000), so the hole is padded to put bank 3 on its boundary.

       Region pads are computed from the real ROM sizes, and the
       assembled stream is 0x01280000 bytes (18.5 MB) exactly, which
       is what proves the regions land on the RTL's base addresses.
       ============================================================ -->
  <rom index="0" zip="recalh.zip" md5="None">

    <!-- maincpu -->
    <interleave output="32">
      <part name="rh_mpr3.bin" crc="65202dd4" map="0001"/>
      <part name="rh_mpr2.bin" crc="3eda66db" map="0010"/>
      <part name="rh_mpr1.bin" crc="536e74ca" map="0100"/>
      <part name="rh_mpr0.bin" crc="38025817" map="1000"/>
    </interleave>

    <!-- audiocpu -->
    <interleave output="16">
      <part name="rh_spr1.bin" crc="504cbc1d" map="01"/>
      <part name="rh_spr0.bin" crc="78fba467" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="rh_spr1.bin" crc="504cbc1d" map="01"/>
      <part name="rh_spr0.bin" crc="78fba467" map="10"/>
    </interleave>

    <!-- sprites -->
    <interleave output="16">
      <part name="rh_objl.bin" crc="c1772b55" map="01"/>
      <part name="rh_objm.bin" crc="ef87c0fd" map="10"/>
    </interleave>
    <!-- pad sprites to 4096 KB -->
    <part repeat="2097152">00</part>

    <!-- sprites_hi: no ROM in this set -->
    <!-- pad sprites_hi to 2048 KB -->
    <part repeat="2097152">00</part>

    <!-- tilemap -->
    <interleave output="32">
      <part name="rh_scrl.bin" crc="1e3f6b79" map="0021"/>
      <part name="rh_scrm.bin" crc="37200968" map="2100"/>
    </interleave>
    <!-- pad tilemap to 4096 KB -->
    <part repeat="2097152">00</part>

    <!-- tilemap_hi: no ROM in this set -->
    <!-- pad tilemap_hi to 2048 KB -->
    <part repeat="2097152">00</part>

    <!-- ensoniq -->
    <part name="rh_snd0.bin" crc="386f5e1b"/>
    <!-- ensoniq bank 2 is empty in MAME -->
    <part repeat="1048576">00</part>
    <part name="rh_snd1.bin" crc="ed894fe1"/>
  </rom>

  <!-- Game config (Rayforce.sv "GAME CONFIG"):
         index 1 = 0xE3, index 2 = 0x01
           visarea 3, extend 1, zone injector off
           (so it starts on level 1), game id 15.
         No expectations are measured for this set yet, so it lands on
         the case default in Rayforce.sv and the ROM CHECKSUM / SDRAM
         BIST / WRITE HASH rows REPORT what they find rather than
         failing against another game's numbers. The self-test TITLE
         row clamps (rf_selftest.sv:329) until a build gives this game
         its own row. That is the page, not the game. -->
  <rom index="1">
    <part>E3</part>
  </rom>
  <rom index="2">
    <part>01</part>
  </rom>

  <!-- the 93C46 settings EEPROM: 64 words, saved to config/nvram/<mra>.nvm -->
  <nvram index="254" size="256"/>

  <buttons names="Jump,Attack,-,-,-,-,Start,Coin,Service,Pause" default="A,B,R,L,Select,Start" count="2"/>
</misterromdescription>
