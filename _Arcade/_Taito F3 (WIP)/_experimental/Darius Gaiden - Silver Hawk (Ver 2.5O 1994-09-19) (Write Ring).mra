<misterromdescription>
  <name>Darius Gaiden - Silver Hawk (Ver 2.5O 1994-09-19) (Write Ring)</name>
  <setname>dariusg</setname>
  <mameversion>0288</mameversion>
  <rbf>TaitoF3</rbf>
  <year>1994</year>
  <manufacturer>Taito</manufacturer>
  <category>Shoot</category>
  <rotation>horizontal</rotation>
  <resolution>15kHz</resolution>
  <players>2</players>
  <joystick>8-way</joystick>
  <num_buttons>2</num_buttons>

  <buttons names="Shot,Bomb,-,-,-,-,Start,Coin,Service,Pause"
           default="A,B,R,L,Select,Start" count="2"/>

  <!-- No DIP switches: F3 boards are configured from the service menu. -->

  <!-- ============================================================
       UNTESTED on hardware as of writing.

       This is the game extend=0 was implemented for. It is an
       extend=0 set (eight 32x32 playfields), so it needs a
       bitstream with extend live: build 01092529 or later. On
       an older core the playfields come out truncated, the way
       Puzzle Bobble 2 did before that build.

       WHY THE PARENT SET IS SAFE HERE, unlike Puzzle Bobble 2's:
       MAME's init_dariusg does nothing but set m_game and call
       tile_decode(). There is no program-ROM patch, so the World
       parent (Ver 2.5O) is the honest target and needs no
       question answered first.

       This set FITS THE UNIVERSAL MAP EXACTLY: every region
       fills its slot with no padding at all, the only game on the
       shelf that does. That is not a coincidence: the map was
       sized for it.

         0x0000000  maincpu    2 MB   4-way byte interleave  EXACT
         0x0200000  audiocpu 512 KB   16-bit interleave      EXACT
         0x0280000  sprites    4 MB   16-bit interleave      EXACT
         0x0680000  sprites_hi 2 MB                          EXACT
         0x0880000  tilemap    4 MB   LOAD32_WORD pair       EXACT
         0x0C80000  tilemap_hi 2 MB                          EXACT
         0x0E80000  ensoniq    4 MB   2x 2 MB, plain         EXACT
         0x1280000             = 18.5 MB total

       All fourteen parts verified by CRC against MAME 0.288's
       ROM_START(dariusg), and the assembled stream measured by
       tools/rf_stream_sum.py at exactly 0x1280000 bytes. Three of
       the five self-test expectations therefore already exist for
       this set, and are recorded here so the cfg_game widening can
       pick them up without re-deriving them:

         exp_bytes  0x01280000
         exp_sum    0xC1917DD8
         exp_bist   0x7A0AC136

       exp_hash (the CPU write-stream fold) and exp_smp (the sample
       ROM fold) still need oracle_f3writes.lua and the rotl1+add
       fold of the first 64 KB of d87-01.

       The zip is the MERGED dariusg set. The parent's fourth
       program ROM is d87-16; dariusgj uses d87-09 and dariusgu
       uses d87-15 in that slot, both present in the merged zip if
       a regional MRA is ever wanted.
       ============================================================ -->
  <rom index="0" zip="dariusg.zip" md5="None">

    <!-- maincpu: ROM_LOAD32_BYTE x4 - 4 x 512 KB = 2 MB, no pad -->
    <interleave output="32">
      <part name="d87-12.bin" crc="de78f328" map="0001"/>
      <part name="d87-11.bin" crc="f7bed18e" map="0010"/>
      <part name="d87-10.bin" crc="4149f66f" map="0100"/>
      <part name="d87-16.bin" crc="8f7e5901" map="1000"/>
    </interleave>

    <!-- audiocpu 68000: ROM_LOAD16_BYTE pair - 512 KB, no pad -->
    <interleave output="16">
      <part name="d87-13.bin" crc="15b1fff4" map="01"/>
      <part name="d87-14.bin" crc="eecda29a" map="10"/>
    </interleave>

    <!-- sprites: ROM_LOAD16_BYTE pair - 2 x 2 MB = 4 MB, no pad -->
    <interleave output="16">
      <part name="d87-03.bin" crc="4be1666e" map="01"/>
      <part name="d87-04.bin" crc="2616002c" map="10"/>
    </interleave>

    <!-- sprites_hi - 2 MB, no pad -->
    <part name="d87-05.bin" crc="4e5891a9"/>

    <!-- tilemap: ROM_LOAD32_WORD pair - 2 x 2 MB = 4 MB, no pad -->
    <interleave output="32">
      <part name="d87-06.bin" crc="3b97a07c" map="0021"/>
      <part name="d87-17.bin" crc="e601d63e" map="2100"/>
    </interleave>

    <!-- tilemap_hi - 2 MB, no pad -->
    <part name="d87-08.bin" crc="76d23602"/>

    <!-- ensoniq sample ROMs, plain (MAME 0x000000 and 0x400000) -->
    <part name="d87-01.bin" crc="3848a110"/>
    <part name="d87-02.bin" crc="9250abae"/>
  </rom>

  <!-- Game config (Rayforce.sv "GAME CONFIG"):
         bit [1:0] = 3  visarea f3 (232 lines from line 24). MAME runs this
                        game on the base `f3` machine, the same one Elevator
                        Action Returns and Puzzle Bobble 2 use, not Ray
                        Force's f3_224a.
         bit [2]   = 1  asks for NON-extend (eight 32x32 playfields), which
                        is what this game is. The sense is inverted against
                        MAME's "extend" naming on purpose: every MRA written
                        before the bit went live carries 0 there and all of
                        those games are extend=1, so 0 has to keep meaning
                        extend=1.
         bit [5]   = 1  game id, high bit. The id is {bit 5, bits 7:6}, so
                        this set is id 4 - its own id, with its own title
                        row on the self-test page and its own expectations
                        arm in Rayforce.sv. It briefly shared id 3 with
                        Bubble Memories, before the field was widened.
         0x27 = game id 4, visarea f3, non-extend. -->
  <rom index="1">
    <part>27</part>
  </rom>

  <!-- Index 2, bits [7:6] = 2: force UART Debug to WRITE RING, without the
       OSD. The board's pad input is dead and MiSTer does not replay the
       saved status word into the core, so a menu option cannot be reached
       at all; the MRA config bytes can. Load this MRA instead of the normal
       one to capture the CPU write stream, then go back. -->
  <rom index="2">
    <part>80</part>
  </rom>

  <!-- the 93C46 settings EEPROM: 64 words, saved to config/nvram/<mra>.nvm -->
  <nvram index="254" size="256"/>
</misterromdescription>
