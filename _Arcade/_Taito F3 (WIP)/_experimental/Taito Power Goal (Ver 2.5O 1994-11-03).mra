<misterromdescription>
  <name>Taito Power Goal (Ver 2.5O 1994/11/03)</name>
  <setname>pwrgoal</setname>
  <year>1994</year>
  <manufacturer>Taito</manufacturer>
  <rbf>TaitoF3</rbf>
  <players>2</players>
  <joystick>8-way</joystick>
  <rotation>horizontal</rotation>
  <region>World</region>

  <!-- ============================================================
       NEVER LOADED ON A BOARD. Written 2026-09-08.

       Taito F3, the same board Ray Force runs on. USES SDRAM MAP PROFILE 1 (index 2 bit [4]), the 42 MB layout, because its sprites do not fit profile 0's 4 MB. Profile 1 gives sprites 13 MB, sprites_hi 7 MB, tilemap 6 MB and tilemap_hi 3 MB. Hattrick Hero '95 in Japan, and the largest sprite set of the football games at 12 MB across THREE interleaved pairs.

       Region pads are computed from the real ROM sizes, and the
       assembled stream is 0x01280000 bytes (18.5 MB) exactly, which
       is what proves the regions land on the RTL's base addresses.
       ============================================================ -->
  <rom index="0" zip="pwrgoal.zip" md5="None">

    <!-- maincpu -->
    <interleave output="32">
      <part name="d94-18.20" crc="b92681c3" map="0001"/>
      <part name="d94-17.19" crc="6009333e" map="0010"/>
      <part name="d94-16.18" crc="c6dbc9c8" map="0100"/>
      <part name="d94-22.17" crc="f672e487" map="1000"/>
    </interleave>
    <!-- pad maincpu to 2048 KB -->
    <part repeat="1048576">00</part>

    <!-- audiocpu -->
    <interleave output="16">
      <part name="d94-19.bin" crc="c93dbcf4" map="01"/>
      <part name="d94-20.bin" crc="f232bf64" map="10"/>
    </interleave>
    <!-- pad audiocpu to 3072 KB -->
    <part repeat="2621440">00</part>

    <!-- sprites -->
    <interleave output="16">
      <part name="d94-09.bin" crc="425e6bec" map="01"/>
      <part name="d94-06.bin" crc="0ed1df55" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="d94-08.bin" crc="bd909caf" map="01"/>
      <part name="d94-05.bin" crc="121c8542" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="d94-07.bin" crc="c8c95e49" map="01"/>
      <part name="d94-04.bin" crc="24958b50" map="10"/>
    </interleave>
    <!-- pad sprites to 13312 KB -->
    <part repeat="1048576">00</part>

    <!-- sprites_hi -->
    <part name="d94-03.bin" crc="95e32072"/>
    <part name="d94-02.bin" crc="f460b9ac"/>
    <part name="d94-01.bin" crc="410ffccd"/>
    <!-- pad sprites_hi to 7168 KB -->
    <part repeat="1048576">00</part>

    <!-- tilemap -->
    <interleave output="32">
      <part name="d94-14.bin" crc="b8ba5761" map="0021"/>
      <part name="d94-13.bin" crc="cafc68ce" map="2100"/>
    </interleave>
    <!-- pad tilemap to 6144 KB -->
    <part repeat="4194304">00</part>

    <!-- tilemap_hi -->
    <part name="d94-12.bin" crc="47064189"/>
    <!-- pad tilemap_hi to 3072 KB -->
    <part repeat="2097152">00</part>

    <!-- ensoniq -->
    <part name="d94-10.bin" crc="a22563ae"/>
    <part name="d94-11.bin" crc="61ed83fa"/>
    <!-- pad ensoniq to 8192 KB -->
    <part repeat="4194304">00</part>
  </rom>

  <!-- Game config (Rayforce.sv "GAME CONFIG"):
         index 1 = 0xC3, index 2 = 0x13
           visarea 3, extend 1, zone injector off
           (so it starts on level 1), game id 27.
         No expectations are measured for this set yet, so it lands on
         the case default in Rayforce.sv and the ROM CHECKSUM / SDRAM
         BIST / WRITE HASH rows REPORT what they find rather than
         failing against another game's numbers. The self-test TITLE
         row clamps (rf_selftest.sv:329) until a build gives this game
         its own row. That is the page, not the game. -->
  <rom index="1">
    <part>C3</part>
  </rom>
  <rom index="2">
    <part>13</part>
  </rom>

  <!-- the 93C46 settings EEPROM: 64 words, saved to config/nvram/<mra>.nvm -->
  <nvram index="254" size="256"/>

  <buttons names="Shoot,Pass,-,-,-,-,Start,Coin,Service,Pause" default="A,B,R,L,Select,Start" count="2"/>
</misterromdescription>
