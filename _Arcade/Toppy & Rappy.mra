<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Toppy &amp; Rappy</name>
    <setname>toppyrap</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Platform</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Fire,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 10 00 00 00 40 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="toppyrap.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ui12.bin" crc="caf5a7e1" map="01"/>
            <part name="uh12.bin" crc="6f5ad699" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="ua4.bin" crc="a9577bcf"/>
        <part name="ua5.bin" crc="7179d32d"/>
        <part name="ua6.bin" crc="4834e5b1"/>
        <part name="ua7.bin" crc="663dd099"/>
        <!-- soundcpu -->
        <part name="u1.bin" crc="07f50947"/>
        <!-- oki1 -->
        <part name="uj15.bin" crc="a3bacfd7"/>
        <part repeat="0x22000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="0704e6c7"/>
    </rom>

    <switches default="FC,EF,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Coinage" bits="2,4" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="5,6" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <dip name="Lives" bits="8,9" ids="2,5,4,3"/>
        <dip name="Time" bits="10,11" ids="70 Seconds,40 Seconds,50 Seconds,60 Seconds"/>
        <dip name="God Mode" bits="13,13" ids="On,Off"/>
        <dip name="Internal Test" bits="14,14" ids="On,Off"/>
        <dip name="Free Play" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
