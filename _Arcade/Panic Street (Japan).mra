<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>panicstr</setname>
	<name>Panic Street (Japan)</name>
	<rotation>horizontal</rotation>
	<year>1999</year>
	<manufacturer>Kaneko</manufacturer>
	<buttons names="Button 1,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="panicstr.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="294b2f14" name="ps-10000.u24" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="e292f393" name="ps110100.u20" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<interleave output="64">
			<part crc="d772ac15" name="ps120000.u16" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="2262e263" name="ps-30000.u4" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<interleave output="64">
			<part crc="7e2b836c" name="sknsj1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="59645f89" name="ps1000j0.u10" map="13570" />
			<part crc="c4722be9" name="ps1001j0.u8" map="1357" />
		</interleave>
	</rom>
	<rom index="2" md5="" >
		<part>00 4A 00 00 00 00</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>