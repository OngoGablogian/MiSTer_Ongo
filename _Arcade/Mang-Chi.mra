<!--
  Mang-Chi — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 38).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... mangchi ...)
  line 10843, ROM_START(mangchi), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Mang-Chi</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>mangchi</setname>
  <year>2000</year>
  <manufacturer>Afega</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,26">
    <dip bits="0" name="DSWS" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Unknown (SW:3)" ids="On,Off"/>
    <dip bits="3,4" name="Vs Rounds" ids="5,4,3,2"/>
    <dip bits="5" name="Unknown (SW:6)" ids="On,Off"/>
    <dip bits="6" name="Free Play" ids="On,Off"/>
    <dip bits="7" name="Unknown (SW:8)" ids="On,Off"/>
    <dip bits="8" name="Unknown (SW:9)" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW:10)" ids="On,Off"/>
    <dip bits="10" name="Unknown (SW:11)" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,3C_1C,2C_1C,3C_2C,2C_3C,1C_3C,1C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="mangchi.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 (init_bubl2000 scramble) -->
    <interleave output="16">
      <part crc="b1d0f33d" name="afega10.u107" map="01"/>
      <part crc="0b1517a5" name="afega9.u112" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="bec4f9aa" name="sound.u92"/>
    <!-- bgtile, 0x100000 (8bpp: two 4bpp halves); no 8x8 ROM -->
    <part crc="c73261e0" name="afega5.uc6"/>
    <part crc="73940917" name="afega4.uc1"/>
    <!-- sprites, 0x080000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="c5cbcc38" name="afega7.uc14" map="01"/>
      <part crc="979efc30" name="afega6.uc11" map="10"/>
    </interleave>
    <!-- oki1, 0x040000 -->
    <part crc="78c8c1f9" name="afega2.u95"/>
  </rom>
</misterromdescription>
