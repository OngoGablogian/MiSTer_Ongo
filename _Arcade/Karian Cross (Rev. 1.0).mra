<!--
  Karian Cross (Rev. 1.0) - Deniam 1997 - MRA for the Deniam MiSTer core.
  MAME set karianx (MAME 0.289 sega/deniam.cpp, deniam-16b). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/MRA_FORMAT.md.

  ioctl index 1: board config byte 02 (bit 0 = deniam-16c, bit 1 = Karian Cross scroll offsets).
  ioctl index 0 stream (hps_io WIDE=1; 16-bit regions arrive as big-endian words):
    000000-0FFFFF  maincpu   MAME region 'maincpu' (word, zero padded)
    100000-27FFFF  chars     MAME region 'chars' (byte, zero padded)
    280000-67FFFF  spritegfx MAME region 'spritegfx' (word, zero padded)
    680000-77FFFF  oki       MAME region 'oki' (byte, zero padded)
    780000-78FFFF  audiocpu  MAME region 'audiocpu' (byte, zero padded)

  DIP switches (index 254): byte 0 = DSW, MAME port value (active low).
-->
<misterromdescription>
    <name>Karian Cross (Rev. 1.0)</name>
    <setname>karianx</setname>
    <rbf>Deniam</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Deniam</manufacturer>
    <category>Puzzle</category>
    <players>2</players>
    <joystick>4-way</joystick>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Pause" default="A,B,X,Start,Select,L"/>

    <switches default="FF" base="16">
        <dip bits="0,1,2" name="Coinage" ids="Free Play,2C1C,3C1C,1C2C,3C2C,1C3C,2C3C,1C1C"/>
        <dip bits="3,4" name="Difficulty" ids="Hard,Very Easy,Easy,Normal"/>
        <dip bits="5" name="Demo Music" ids="Off,On"/>
        <dip bits="7" name="Service Mode" ids="On,Off"/>
    </switches>

    <rom index="1">
        <part>02</part>
    </rom>
    <rom index="0" zip="karianx.zip" md5="None">
        <!-- 000000 maincpu -->
        <interleave output="16">
            <part name="even" crc="fd0ce238" map="10"/>
            <part name="odd" crc="be173cdc" map="01"/>
        </interleave>
        <!-- 100000 chars -->
        <part name="bkg1" crc="5cb8558a"/>
        <part name="bkg2" crc="95ff297c"/>
        <part name="bkg3" crc="6c81f1b2"/>
        <!-- 280000 spritegfx -->
        <interleave output="16">
            <part name="obj4" crc="5f8d75a9" map="10"/>
            <part name="obj1" crc="967ee97d" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="obj5" crc="e9fc22f9" map="10"/>
            <part name="obj2" crc="d39eb04e" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="obj6" crc="c1ec35a5" map="10"/>
            <part name="obj3" crc="6ac1ac87" map="01"/>
        </interleave>
        <part repeat="0x100000">00</part>
        <!-- 680000 oki -->
        <part name="voi" crc="c6506a80"/>
        <part repeat="0x80000">00</part>
        <!-- 780000 audiocpu -->
        <part name="snd" crc="fedd3375"/>
    </rom>
</misterromdescription>
