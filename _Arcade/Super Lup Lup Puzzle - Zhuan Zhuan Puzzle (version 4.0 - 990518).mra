<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Super Lup Lup Puzzle / Zhuan Zhuan Puzzle (version 4.0 / 990518)</name>
    <setname>suplup</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Omega System</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>38 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="suplup.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part name="suplup-rom1.bin" crc="61fb2dbe"/>
        <part name="suplup-rom2.bin" crc="0c176c57"/>
        <part repeat="0x80000">00</part>  <!-- eeprom -->
        <!-- eeprom: the 93C46's default image -->
        <part name="eeprom-suplup.bin" crc="e60c9883"/>
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- oki1 samples -->
        <part name="vrom1.bin" crc="34a56987"/>
        <part repeat="0x5C0000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="suplup-roml00.bin" crc="7848e183" map="0021"/>
            <part name="suplup-romu00.bin" crc="13e3ab7f" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="suplup-roml01.bin" crc="15769f55" map="0021"/>
            <part name="suplup-romu01.bin" crc="6687bc6f" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
