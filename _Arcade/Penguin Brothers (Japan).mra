<misterromdescription>
  <name>Penguin Brothers (Japan)</name>
  <setname>penbros</setname>
  <rbf>Meathax_Penguin</rbf>
  <mameversion>0289</mameversion>
  <year>2000</year>
  <manufacturer>Subsino</manufacturer>
  <category>Platform</category>
  <rotation>horizontal</rotation>
  <buttons names="Bomb,Jump,Pause,Start,Coin,Service,Test" default="A,B,X,Start,Select,R,L"/>
  <switches default="ff,ff">
    <dip name="Service Mode" bits="0" ids="On,Off" values="0,1"/>
    <dip name="Flip Screen" bits="1" ids="On,Off" values="0,1"/>
    <dip name="Unused SW1:3" bits="2" ids="On,Off" values="0,1"/>
    <dip name="Demo Sounds" bits="3" ids="Off,On" values="0,1"/>
    <dip name="Coin A" bits="4,5" ids="1C 2C,2C 1C,3C 1C,1C 1C" values="0,1,2,3"/>
    <dip name="Coin B" bits="6,7" ids="1C 2C,2C 1C,3C 1C,1C 1C" values="0,1,2,3"/>
    <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal" values="0,1,2,3"/>
    <dip name="Lives" bits="10,11" ids="2,4,5,3" values="0,1,2,3"/>
    <dip name="Bonus Life" bits="12,13" ids="Every 250k,150k and 500k,None,200k and 700k" values="0,1,2,3"/>
    <dip name="Winning Rounds (VS)" bits="14,15" ids="5,3,4,2" values="0,1,2,3"/>
  </switches>
  <rom index="0" zip="penbros.zip" md5="None">
    <interleave output="16">
      <part name="a-blast_jpn_u06.u06" crc="7bbdffac" map="01"/>
      <part name="a-blast_jpn_u07.u07" crc="d50cda5f" map="10"/>
    </interleave>
    <interleave output="64">
      <part name="a-blast_jpn_u38.u38" crc="4247b39e" map="00000021"/>
      <part name="a-blast_jpn_u39.u39" crc="f9f07faf" map="00002100"/>
      <part name="a-blast_jpn_u40.u40" crc="dc9e0a96" map="00210000"/>
      <part map="21000000" repeat="0x200000">00 00</part>
    </interleave>
    <part name="a-blast_jpn_u18.u18" crc="de4e65e2"/>
  </rom>
  <rom index="3">
    <part>05 f5 e1 00 ff ff 00 02 00 02 00 01 00 ff 08 00 00 00 00 50 63 00 4a 00</part>
  </rom>
  <nvram index="4" size="99"/>
