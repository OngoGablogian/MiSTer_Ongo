<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Land Breaker (World) / Miss Tang Ja Ru Gi (Korea) (pcb ver 3.02)</name>
    <setname>landbrk</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="landbrk.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00.bin" crc="a803aace" map="0012"/>
            <part name="01.bin" crc="439c95cc" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02.bin" crc="a0c2828c" map="0012"/>
            <part name="03.bin" crc="5106b61a" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04.bin" crc="fbe4a215" map="0012"/>
            <part name="05.bin" crc="61d422b2" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06.bin" crc="bc4f7f30" map="0012"/>
            <part name="07.bin" crc="d4d108ce" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08.bin" crc="36237654" map="0012"/>
            <part name="09.bin" crc="9171828b" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10.bin" crc="fe51744d" map="0012"/>
            <part name="11.bin" crc="fe6fd5e0" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12.bin" crc="9f0f17f3" map="0012"/>
            <part name="13.bin" crc="c7d51bbe" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14.bin" crc="f30f7bc5" map="0012"/>
            <part name="15.bin" crc="bc1664e3" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="rom3.u43" crc="8429189a"/>
        <!-- qs1000:cpu -->
        <part name="lb.107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="rom1.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="lb_3.u97" crc="5b34dff0"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="rom2.u108" crc="f3b327ef"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Show Counters" bits="1" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
