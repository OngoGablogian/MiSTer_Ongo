<misterromdescription>
   <name>Print Club (Japan Vol.2)</name>
   <setname>pclubjv2</setname>
   <rbf>SystemC2</rbf>
   <mameversion>0276</mameversion>
   <year>1995</year>
   <manufacturer>Atlus</manufacturer>
   <category>Arcade</category>

   <rom index="0" zip="pclubjv2.zip" md5="none">
      <!-- board config header -->
      <part>00 00</part>
      <!-- region 0: 68000 program, 2097152 bytes -->
      <part>00 20 00 00</part>
      <interleave output="16">
        <part name="p2jwn.u32" map="10"/>
        <part name="p2jwn.u31" map="01"/>
      </interleave>
      <interleave output="16">
        <part name="p2jwn.u34" map="10"/>
        <part name="p2jwn.u33" map="01"/>
      </interleave>
      <!-- region 1: uPD7759 samples, 524288 bytes -->
      <part>01 08 00 00</part>
      <part name="epr18169.4"/>
      <!-- region 2: 317-xxxx protection table -->
      <part>02 00 01 00</part>
      <part>05 05 04 04 0F 0F 0E 0E 04 04 05 05 0E 0E 0F 0F</part>
      <part>05 0D 04 0C 0F 07 0E 06 05 0D 04 0C 0F 07 0E 06</part>
      <part>05 07 00 02 0F 0D 0A 08 04 06 05 07 0E 0C 0F 0D</part>
      <part>05 0F 00 0A 0F 05 0A 00 05 0F 04 0E 0F 05 0E 04</part>
      <part>01 01 05 05 09 09 0D 0D 00 00 04 04 08 08 0C 0C</part>
      <part>01 09 05 0D 09 01 0D 05 01 09 05 0D 09 01 0D 05</part>
      <part>01 03 01 03 09 0B 09 0B 00 02 04 06 08 0A 0C 0E</part>
      <part>01 0B 01 0B 09 03 09 03 01 0B 05 0F 09 03 0D 07</part>
      <part>0C 0C 0C 0C 0E 0E 0E 0E 0D 0D 0D 0D 0F 0F 0F 0F</part>
      <part>0C 04 0C 04 0E 06 0E 06 0C 04 0C 04 0E 06 0E 06</part>
      <part>0C 0E 08 0A 0E 0C 0A 08 0D 0F 0D 0F 0F 0D 0F 0D</part>
      <part>0C 06 08 02 0E 04 0A 00 0C 06 0C 06 0E 04 0E 04</part>
      <part>09 09 0D 0D 09 09 0D 0D 08 08 0C 0C 08 08 0C 0C</part>
      <part>09 01 0D 05 09 01 0D 05 09 01 0D 05 09 01 0D 05</part>
      <part>09 0B 09 0B 09 0B 09 0B 08 0A 0C 0E 08 0A 0C 0E</part>
      <part>09 03 09 03 09 03 09 03 09 03 0D 07 09 03 0D 07</part>
   </rom>

   <buttons names="Button 1,Button 2,Button 3,Start,Coin,Service,Test" default="A,B,X,Start,Select,R,L" count="7"/>

   <switches default="FF,FF" base="0">
      <dip name="Coins per Credit (Normal / Alternate)" bits="0,1,2" ids="25 / 30,6 / 7,10 / 12,1 / 2,15 / 20,4 / 5,8 / 9,3 / Free Play"/>   <!-- 0,1,2,3,4,5,6,7 -->
      <dip name="Alternate Coinage" bits="3" ids="On,Off"/>   <!-- 0,8 -->
      <dip name="Coin B" bits="4,5,6,7" ids="Free Play (if Coin A too) or 1/1,1 Coin/1 Credit  2/3,1 Coin/1 Credit  4/5,1 Coin/1 Credit  5/6,2 Coins/1 Credit  4/3,2 Coins/1 Credit  5/3  6/4,2 Coins/3 Credits,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>   <!-- 0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240 -->
      <dip name="Demo Sounds" bits="13" ids="Off,On"/>   <!-- 0,32 -->
   </switches>
</misterromdescription>
