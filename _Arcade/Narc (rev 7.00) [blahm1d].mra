<!-- DOWNLOAD STREAM (single rom index=0). Regions concatenate in this order;
     the on-chip demux (rtl/zunit) binds each region to its physical home (D1).
     All packing (program 16-bit interleave is pre-done here; gfx init_gfxrom(8)
     4-way quadrant byte de-interleave and sound bank select are done on-chip).

       [0x000000, 0x080000)  PROGRAM 512KB  (maindata, 34010 code, rev 7.00)
                              ROM_LOAD16_BYTE even/odd -> pre-interleaved 16-bit:
                              [0x000000] {u24,u42}  (region-word 0x40000, byte 0x80000)
                              [0x040000] {u23,u41}  (region-word 0x60000, byte 0xC0000)
       [0x080000, 0x880000)  GFX 8MB region  (ROM_REGION 0x800000, raw quadrants)
                              quadrant bases @+0x000000/+0x200000/+0x400000/+0x600000,
                              each = 15x64KB descending (u94..u80, u76..u62,
                              u58..u44, u40..u26); gaps 0-filled to 0x800000.
       [0x880000, 0x910000)  SOUND MASTER 0x90000  (narcsnd:cpu0, incl reloads)
       [0x910000, 0x9A0000)  SOUND SLAVE  0x90000  (narcsnd:cpu1, incl reloads)
       [0x9A0000, 0x9A0500)  PLDS 0x500  (5x PLS153, 0xEB each, ERASE00-padded)
     Total download = 0x9A0500 bytes. -->

<misterromdescription>
    <about author="rejectedcoins"/>
    <rotation>horizontal</rotation>
    <name>Narc (rev 7.00) [blahm1d]</name>
    <setname>narc_blahm1d</setname>
    <mameversion>0280</mameversion>
    <year>1988</year>
    <manufacturer>Williams</manufacturer>
    <players>2</players>
    <rbf>NARC_blahm1d</rbf>
    <joystick>8</joystick>
    <region>World</region>

    <rom index="0" zip="narc.zip" md5="None">
        <!-- ===== PROGRAM 512KB @0x000000 : rev7 game ROMs, LOAD16_BYTE interleave ===== -->
        <!-- pair0: byte 0x80000/0x80001 -> u42 even(low) / u24 odd(high) -->
        <interleave output="16">
            <part name="rev7_narc_game_rom_u42.u42" crc="d1111b76" map="01"/>
            <part name="rev7_narc_game_rom_u24.u24" crc="aa0d3082" map="10"/>
        </interleave>
        <!-- pair1: byte 0xC0000/0xC0001 -> u41 even(low) / u23 odd(high) -->
        <interleave output="16">
            <part name="rev7_narc_game_rom_u41.u41" crc="3903191f" map="01"/>
            <part name="rev7_narc_game_rom_u23.u23" crc="7a316582" map="10"/>
        </interleave>

        <!-- ===== GFX 8MB @0x080000 : ROM_REGION 0x800000 raw quadrants ===== -->
        <!-- quadrant @+0x000000 : u94..u80 (15x64KB) -->
        <part name="rev2_narc_image_rom_u94.u94" crc="ca3194e4"/>
        <part name="rev2_narc_image_rom_u93.u93" crc="0ed7f7f5"/>
        <part name="rev2_narc_image_rom_u92.u92" crc="40d2fc66"/>
