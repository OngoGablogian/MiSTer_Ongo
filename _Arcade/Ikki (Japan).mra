	<resolution>240x224</resolution>
	<rotation>horizontal</rotation>
	<flip></flip>

	<!--
	  Linear ioctl image, assembled straight from the MAME set.  Parts are
	  concatenated in order; `offset` selects a slice *within* the source file.
	  Layout must match verif/build_rom.py (total 0x24900, crc32 991998ca):
	    0x00000 main ROM   (tvg17_1 low, 2, 3, 4, tvg17_1 high = ROM_CONTINUE)
	    0x0A000 sub ROM
	    0x0C000 sprites    (8, 7, 6)
	    0x18000 tiles      (11, 10, 9)
	    0x24000 colour PROMs
	    0x24700 attribute PROMs
	-->
	<rom index="0" zip="ikki.zip" md5="none" type="merged|nonmerged">
		<part name="tvg17_1"  crc="cb28167c" offset="0x0000" length="0x2000"/>
		<part name="tvg17_2"  crc="756c7450" length="0x2000"/>
		<part name="tvg17_3"  crc="91f0a8b6" length="0x2000"/>
		<part name="tvg17_4"  crc="696fcf7d" length="0x2000"/>
