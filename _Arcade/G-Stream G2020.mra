<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME promat/gstream.cpp; the layout is
         rtl/gs_sdram_map.svh. Do not edit by hand. -->
    <name>G-Stream G2020</name>
    <setname>gstream</setname>
    <rbf>GStream</rbf>
    <mameversion>0289</mameversion>
    <year>2002</year>
    <manufacturer>Oriental Soft Japan</manufacturer>
    <category>Shooter</category>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Shot,Bomb,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod byte (GStream.sv): [0] X2222's map -->
    <rom index="1"><part>00</part></rom>

    <!-- address: the HPS puts the image in DDR3; the core copies its first 5 MB to SDRAM and reads the graphics
         from DDR3 (rtl/memory/vh_rom_loader.sv, rtl/video/gs_video.sv) -->
    <rom index="0" zip="gstream.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part repeat="0x80000">00</part>  <!-- maincpu 0x0 -->
        <part name="gs_prg_01.u56" crc="0d0c6a38"/>
        <!-- maindata -->
        <interleave output="16">
            <part name="gs_prg_02.u197" crc="2f8a6bea" map="12"/>
        </interleave>
        <!-- oki1 -->
        <part name="gs_snd_01.u192" crc="79b64d3f"/>
        <part name="gs_snd_02.u194" crc="e49ed92c"/>
        <!-- oki2 -->
        <part name="gs_snd_03.u191" crc="2bfff4ac"/>
        <part name="gs_snd_04.u193" crc="b259de3b"/>
        <!-- gfx1 -->
        <interleave output="32">
            <part name="gs_gr_07.u107" crc="84e66fe1" map="0021"/>
            <part name="gs_gr_11.u108" crc="946d71d1" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="gs_gr_08.u109" crc="abd0d6aa" map="0021"/>
            <part name="gs_gr_12.u110" crc="94b56e4e" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="gs_gr_09.u180" crc="f2c4fd77" map="0021"/>
            <part name="gs_gr_13.u181" crc="7daaeff0" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="gs_gr_10.u182" crc="d696d15d" map="0021"/>
            <part name="gs_gr_14.u183" crc="6bd2a1e1" map="2100"/>
        </interleave>
        <!-- gfx2 -->
        <part name="gs_gr_01.u120" crc="b82cfab8"/>
        <part name="gs_gr_02.u121" crc="37e19cbd"/>
        <!-- gfx3 -->
        <part name="gs_gr_03.u125" crc="1a3b2b11"/>
        <part name="gs_gr_04.u126" crc="a4e8906c"/>
        <!-- gfx4 -->
        <part name="gs_gr_05.u174" crc="ef283a73"/>
        <part name="gs_gr_06.u175" crc="d4e3a2b2"/>
    </rom>

    <!-- the backup RAM's default (MAME's gstream.nv, each dword turned to the CPU's byte order); a saved .nvm,
         sent at <nvram>, replaces it -->
    <rom index="2" zip="gstream.zip" md5="none">
        <interleave output="32">
            <part name="gstream.nv" crc="895d724b" map="1234"/>
        </interleave>
    </rom>
    <nvram index="4" size="8192"/>
</misterromdescription>
