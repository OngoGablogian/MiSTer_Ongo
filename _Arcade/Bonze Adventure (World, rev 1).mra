<misterromdescription>
    <rbf>BonzeAdventure_bazset</rbf>
    <name>Bonze Adventure (World, rev 1)</name>
    <setname>bonzeadv</setname>
    <year>1988</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>8way</joystick>
    <rotation>horizontal</rotation>
    <region>World</region>

    <rom index="0" zip="bonzeadv.zip|cchip.zip" type="merged" md5="none">
        <!-- 68000 0x000000-0x03ffff -->
        <interleave output="16">
            <part name="b41-09-1.17" crc="af821fbc" map="01"/>
            <part name="b41-11-1.26" crc="823fff00" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b41-10.16" crc="4ca94d77" map="01"/>
            <part name="b41-15.25" crc="aed7a0d0" map="10"/>
        </interleave>
        <!-- Real board has no ROM at 0x040000-0x07ffff. -->
        <part repeat="0x40000">00</part>
        <!-- 68000 mask ROM at CPU 0x080000; core performs word byte-swap. -->
        <part name="b41-01.15" crc="5d072fa4"/>
        <!-- Z80 program, tiles, sprites and YM2610 ADPCM-B. -->
        <part name="b41-13.20" crc="9e464254"/>
        <part name="b41-03.1" crc="736d35d0"/>
        <part name="b41-02.7" crc="29f205d9"/>
        <part name="b41-04.48" crc="c668638f"/>
        <!-- TC0030CMD: shared uPD78C11 mask ROM + Bonze EPROM. -->
        <part name="cchip_upd78c11.bin" crc="43021521"/>
        <part name="cchip_b41-05.43" crc="75c52553"/>
    </rom>

    <switches default="ff,ff" base="16">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="None,80k 150k,50k 150k,40k 100k"/>
        <dip name="Lives" bits="12,13" ids="2,1,4,3"/>
    </switches>
    <buttons names="Fire,Jump,Start 1P,Start 2P,Coin,Service,Pause"
             default="A,B,Start,Select,R,L,X" count="7"/>
</misterromdescription>
