<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Stocker (3/19/85)</name>
	<setname>stocker</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1984</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>1</players>
	<!-- Analog: P1 dial. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="stocker.zip|sente6vb.zip" md5="none">
		<part name="stocker_ab_01_3-19-85.u8a" crc="6a914d99"/>
		<part name="stocker_ab_23_3-19-85.u7a" crc="48e432c2"/>
		<part repeat="0x14000">00</part>
		<part name="stocker_ef_3-19-85.u1a" crc="83e6e5c9"/>
		<part repeat="0x20000">00</part>
		<part name="stocker_gr_01_3-19-85.u6b" crc="2e66ac35"/>
		<part name="stocker_gr_23_3-19-85.u5b" crc="6fa43631"/>
		<part repeat="0x8000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 00 00 00 00 18 00 00 00 02 00 00 00 00 00 00 FF FF FF FF FF FF 09 80 08 04 FF FF FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Gas,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="01,7F,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="End Of Game" bits="14" ids="3 Tickets,Normal"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit"/>
		<dip name="Bonus Coins" bits="2,4" ids="None,2 Coins=1 Bonus,3 Coins=1 Bonus,4 Coins=1 Bonus,4 Coins=2 Bonus,5 Coins=1 Bonus,5 Coins=2 Bonus,5 Coins=3 Bonus"/>
		<dip name="Left Coin Mech" bits="5" ids="x1,x2"/>
		<dip name="Right Coin Mech" bits="6,7" ids="x1,x4,x5,x6"/>
		<dip name="Flip Screen" bits="24" ids="Off,On"/>
	</switches>
</misterromdescription>
