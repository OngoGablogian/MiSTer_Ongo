<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Candy Candy</name>
    <setname>candy</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="candy.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00.u5" crc="04bc53e4" map="0012"/>
            <part name="01.u1" crc="288229f1" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02.u6" crc="5d3b130c" map="0012"/>
            <part name="03.u2" crc="e36cc85c" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04.u7" crc="5090624c" map="0012"/>
            <part name="05.u3" crc="c9e7c5d3" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06.u8" crc="e3b65d10" map="0012"/>
            <part name="07.u4" crc="5bf4cb29" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08.u15" crc="296f3ec3" map="0012"/>
            <part name="09.u10" crc="2ab8f847" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10.u16" crc="f382e9e8" map="0012"/>
            <part name="11.u11" crc="545ef2bf" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12.u17" crc="8d125f1a" map="0012"/>
            <part name="13.u12" crc="a10ea2e8" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14.u18" crc="7cdd8639" map="0012"/>
            <part name="15.u13" crc="8b0cf884" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="cc.u43" crc="837c9967"/>
        <!-- qs1000:cpu -->
        <part name="hc_u107.bin" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="cc.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="cc.u97" crc="1400c878"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="cc.u108" crc="6eedb497"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Free Play" bits="0" ids="On,Off"/>
        <dip name="Unknown" bits="1" ids="On,Off"/>
        <dip name="Unknown" bits="2" ids="On,Off"/>
        <dip name="Unknown" bits="3" ids="On,Off"/>
        <dip name="Unknown" bits="4" ids="On,Off"/>
        <dip name="Unknown" bits="5" ids="On,Off"/>
        <dip name="Unknown" bits="6" ids="On,Off"/>
        <dip name="Unknown" bits="7" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
