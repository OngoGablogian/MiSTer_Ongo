<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Gimme A Break (7/7/85)</name>
	<setname>gimeabrk</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1985</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>2</players>
	<!-- Analog: P1 trackball_y, P1 trackball_x reversed, P2 trackball_y, P2 trackball_x reversed. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="gimeabrk.zip|sente6vb.zip" md5="none">
		<part name="gimmeabreak_ab01_7-7-85.u8a" crc="18cc53db"/>
		<part name="gimmeabreak_ab23_7-7-85.u7a" crc="6bd4190a"/>
		<part name="gimmeabreak_ab45_7-7-85.u6a" crc="5dca4f33"/>
		<part repeat="0x10000">00</part>
		<part name="gimmeabreak_cd_6_ef_7-7-85.u1a" crc="5e2b3510"/>
		<part repeat="0x20000">00</part>
		<part name="gimmeabreak_gr01_7-7-85.u6b" crc="e3cdc476"/>
		<part name="gimmeabreak_gr23_7-7-85.u5b" crc="0555d9c0"/>
		<part repeat="0x8000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 00 10 88 11 89 01 00 00 00 00 00 00 00 00 00 FF FF FF 24 FF FF 09 80 08 28 FF 04 FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Position Cue Ball,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="01,69,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Bonus Shot" bits="8,9" ids="Every 6 Balls,Every 8 Balls,Every 10 Balls,Every 12 Balls"/>
		<dip name="Initial Shots" bits="10,11" ids="8,10,12,14"/>
		<dip name="Players Per Credit" bits="12" ids="1,1 Or 2"/>
		<dip name="Cabinet" bits="13" ids="Cocktail,Upright"/>
		<dip name="High Scores" bits="14" ids="Keep All,Keep Top 5"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit"/>
		<dip name="Bonus Coins" bits="2,4" ids="None,2 Coins=1 Bonus,3 Coins=1 Bonus,4 Coins=1 Bonus,4 Coins=2 Bonus,5 Coins=1 Bonus,5 Coins=2 Bonus,5 Coins=3 Bonus"/>
		<dip name="Left Coin Mech" bits="5" ids="x1,x2"/>
		<dip name="Right Coin Mech" bits="6,7" ids="x1,x4,x5,x6"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
