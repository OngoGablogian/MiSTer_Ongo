<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Penfan Girls - Step1. Mild Mind (set 1)</name>
    <setname>penfan</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="penfan.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00.u5" crc="77ce2855" map="0012"/>
            <part name="01.u1" crc="a7d7299d" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02.u6" crc="79b05a66" map="0012"/>
            <part name="03.u2" crc="bddd9ad8" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04.u7" crc="9fba61bd" map="0012"/>
            <part name="05.u3" crc="ed34befb" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06.u8" crc="cc3dff54" map="0012"/>
            <part name="07.u4" crc="9e33a480" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08.u15" crc="89449f18" map="0012"/>
            <part name="09.u10" crc="2b07cba0" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10.u16" crc="738abbaa" map="0012"/>
            <part name="11.u11" crc="ddcd2bae" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12.u17" crc="2eed0f64" map="0012"/>
            <part name="13.u12" crc="cc3068a8" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14.u18" crc="20a9a08e" map="0012"/>
            <part name="15.u13" crc="872fa9c4" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="pfg.u43" crc="84977191"/>
        <!-- qs1000:cpu -->
        <part name="pfg.u107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="pfg.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="pfg.u97" crc="0c713eef"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="pfg.u108" crc="ac97c23b"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="3" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
