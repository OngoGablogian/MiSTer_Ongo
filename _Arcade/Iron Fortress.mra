<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Iron Fortress</name>
    <setname>ironfort</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Eolith</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="ironfort.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="if00-00.u39" crc="63b74601" map="0012"/>
            <part name="if00-01.u34" crc="890470b3" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="if00-02.u40" crc="63b5cca5" map="0012"/>
            <part name="if00-03.u35" crc="54a76cb5" map="1200"/>
        </interleave>
        <part repeat="0x1000000">00</part>  <!-- maindata end -->
        <!-- maincpu -->
        <part name="u43" crc="29f55825"/>
        <!-- qs1000:cpu -->
        <part name="u107" crc="89450a2f"/>
        <!-- soundcpu -->
        <part name="u111" crc="5d1d1387"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="u97" crc="47b9d43a"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="u108" crc="89233144"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Show DIP Info" bits="0" ids="On,Off"/>
        <dip name="Demo Sounds" bits="1" ids="Off,On"/>
        <dip name="Lives" bits="2,3" ids="4,2,1,3"/>
        <dip name="Coinage" bits="4,5" ids="Free Play,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="6,7" ids="Very Hard,Hard,Easy,Normal"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
