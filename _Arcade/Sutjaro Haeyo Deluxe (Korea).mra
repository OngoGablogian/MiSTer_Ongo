<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Sutjaro Haeyo Deluxe (Korea)</name>
    <setname>sutjarod</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="A,B,C,-,-,-,Start,Coin,Pause" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 10 00 00 00 20 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="sutjarod.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ul12_am27c512.bin" crc="50e2563c" map="01"/>
            <part name="uh12_am27c512.bin" crc="dc7e036c" map="10"/>
        </interleave>
        <part repeat="0xE0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="ua4_am27c040.bin" crc="1e87d377"/>
        <part name="ua5_am27c040.bin" crc="b286427d"/>
        <part repeat="0x100000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="u1_am27c512.bin" crc="c6e31c4a"/>
        <!-- oki1 -->
        <part name="uj15_tms27c010a.bin" crc="da9dea73"/>
        <part repeat="0x22000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="c819b9a8"/>
        <patch offset="0xB994">43 4B</patch>  <!-- init_sutjarod -->
        <patch offset="0xB996">33 45</patch>  <!-- init_sutjarod -->
        <patch offset="0x54">25 08</patch>  <!-- init_sutjarod -->
    </rom>

    <switches default="FF,FF,00">
        <dip name="Unknown" bits="0,0" ids="On,Off"/>
        <dip name="Unknown" bits="1,1" ids="On,Off"/>
        <dip name="Unknown" bits="2,2" ids="On,Off"/>
        <dip name="Unknown" bits="3,3" ids="On,Off"/>
        <dip name="Unknown" bits="4,4" ids="On,Off"/>
        <dip name="Unknown" bits="5,5" ids="On,Off"/>
        <dip name="Unknown" bits="6,6" ids="On,Off"/>
        <dip name="Unknown" bits="7,7" ids="On,Off"/>
        <dip name="Unknown" bits="8,8" ids="On,Off"/>
        <dip name="Unknown" bits="9,9" ids="On,Off"/>
        <dip name="Unknown" bits="10,10" ids="On,Off"/>
        <dip name="Unknown" bits="11,11" ids="On,Off"/>
        <dip name="Unknown" bits="12,12" ids="On,Off"/>
        <dip name="Unknown" bits="13,13" ids="On,Off"/>
        <dip name="Unknown" bits="14,14" ids="On,Off"/>
        <dip name="Unknown" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
