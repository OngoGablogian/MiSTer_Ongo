<misterromdescription>
    <name>Soccer Superstars (ver EAC)</name>
    <setname>soccerss</setname>
    <rbf>KonamiGXT34</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>16</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 22); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="soccerss.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="427eac02.28m" crc="1817b218" map="0012"/>
            <part name="427eac03.30m" crc="8a17f509" map="1200"/>
        </interleave>
        <part repeat="1048576">00</part>
        <interleave output="32">
            <part name="427a04.28r" crc="c7d3e1a2" map="0012"/>
            <part name="427a05.30r" crc="5372f0a5" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 6-byte row, then the last 2 bytes of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="427a15.11r" crc="33ce2b8e"/>  <!-- four-byte part -->
        <part repeat="2446676">00</part>
        <part name="427a14.143" crc="7575a0ed"/>  <!-- second part -->
        <part repeat="1223338">00</part>
        <!-- k055673: GX6, bytes 0-3 of each half-row, then bytes 4-5 -->
        <part repeat="2097154">00</part>
        <interleave output="32">
            <part name="427a13.18r" crc="815a9b87" map="0021"/>
            <part name="427a11.23r" crc="c1ca74c1" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="427a12.21r" crc="97d6fd38" map="0021"/>
            <part name="427a10.25r" crc="6b3ccb41" map="2100"/>
        </interleave>
        <part name="427a09.137" crc="56bdd480"/>  <!-- two-byte part -->
        <part name="427a08.140" crc="221250af"/>  <!-- two-byte part -->
        <!-- soundcpu: MAME's region as it is -->
        <part repeat="4194304">00</part>
        <interleave output="16">
            <part name="427a07.6m" crc="8dbaf4c7" map="01"/>
            <part name="427a06.9m" crc="979df65d" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="427a16.9r" crc="39547265"/>
        <part repeat="2097152">00</part>
        <part repeat="786432">00</part>
        <!-- gfx3: MAME's region as it is -->
        <part name="427a18.145" crc="bb6e6ec6"/>
        <!-- gfx4: MAME's region as it is -->
        <part name="427a17.24c" crc="fb6eb01f"/>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="soccerss.zip" md5="none">
        <part name="soccerss.nv" crc="f222dae4"/>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it -->
    <nvram index="4" size="128"/>

    <switches default="FE,FF">
        <dip name="Sound output" bits="0" ids="Stereo,Mono"/>
        <dip name="Left Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Right Flip Screen" bits="2" ids="On,Off"/>
        <dip name="Number of Screens" bits="3" ids="2,1"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>
</misterromdescription>
