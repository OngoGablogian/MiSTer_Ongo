<misterromdescription>
    <!-- BAZSET ROM3: editable CRC-checked pause, palette, and OSD metadata. -->
    <bazset_runtime version="1"><pause><title>Plump Pop (Japan)</title><build>K240 EGRET SPINNER + PP406 GOOD COLOURS V3 - HARDWARE UNVERIFIED</build><core_by>bazset</core_by><patreon>patreon.com/c/bazset</patreon><x>x.com/bazset_</x><beta_testers>Big Al</beta_testers><patreon_supporters>Alexander Facchini | Groquik | BabaYaga326 | Curt Dittmer | Alessandro Gulli | RGM | JamieCRT | AlfEightyOne | Scott Dexter</patreon_supporters><special_thanks>MAME hardware researchers</special_thanks><bug_prompt>FOUND A BUG? REPORT IT ON MY PATREON</bug_prompt></pause><osd><visibility>Video Settings,Game Settings,DIP Switches,Credits,Reset</visibility><defaults>Aspect=Original;Rotation=No;CRT Adjust=On;CRT H-Size=0;CRT H-Position=0;CRT V-Shift=0;Scandoubler Fx=None</defaults></osd><pause_style><colors background="#120C16" card="#201125" border="#CEBCCF" text="#F7F1F7" dim="#C8B5C8" accent="#F4D8F0"/><layout preset="compact"/><marquee frames="12"/></pause_style></bazset_runtime>

    <about author="bazset" webpage="https://patreon.com/c/bazset" twitter="@bazset_"/>
    <rotation>horizontal</rotation>
    <name>Plump Pop (Japan)</name>
    <setname>plumppop</setname>
    <mameversion>0289</mameversion>
    <year>1987</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <rbf>bazset_PlumpPop</rbf>
    <joystick/>
    <region>Japan</region>
    <category>Arcade</category>
    <rom index="0" zip="plumppop.zip" md5="None">
        <!-- bit 0 = MCU
             bit 1 = color PROM
             bit 2 = Kabuki Z (specific sound features)
             bit 3 = Kageki   (specific sound features)
             bit 4 = banked RAM
             bit 5 = coin XOR
             bit 6 = dip_flip XOR
             bit 7 = HB delay
             Byte 1:
             bit 0 = service XOR
             bit 1 = button aid
             bit 2 = 3 MHz for FM module
             bit 3 = Kabuki Z with different memory map
             bit 4 = 13 bits tilemap code
             bit 5 = PSG channels summed, not shorted -->
        <part>
            13 04 01 00 </part>
        <!-- maincpu - starts at 0x0 - length 0x20000 (17 bits) -->
        <part name="a98__09.11c" crc="107f9e06"/>
        <part name="a98__10.9c" crc="df6e6af2"/>
        <!-- JTFRAME_BA1_START -->
        <!-- sub - starts at 0x20000 - length 0x10000 (16 bits) -->
        <part name="a98__11.4e" crc="bc56775c"/>
        <!-- JTFRAME_BA2_START -->
        <!-- audiocpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- PCM_START -->
        <!-- samples - starts at 0x40000 - length 0x10000 (16 bits) -->
        <part repeat="0x10000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- gfx1 - starts at 0x50000 - length 0x200000 (21 bits) -->
        <interleave output="32">
            <part name="a98__05.mbm27c512.7a" crc="45c36963" map="0001"/>
            <part name="a98__01.mbm27c512.13a" crc="f3033dca" map="0010"/>
            <part name="a98__07.mbm27c512.4a" crc="8e16cd81" map="0100"/>
            <part name="a98__03.mbm27c512.10a" crc="1a519b0a" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="a98__05.mbm27c512.7a" crc="45c36963" map="0001"/>
            <part name="a98__01.mbm27c512.13a" crc="f3033dca" map="0010"/>
            <part name="a98__07.mbm27c512.4a" crc="8e16cd81" map="0100"/>
            <part repeat="0x10000" map="1000">00</part>
        </interleave>
        <interleave output="32">
            <part name="a98__06.mbm27c512.5a" crc="e075341b" map="0001"/>
            <part name="a98__02.mbm27c512.12a" crc="f2d17b0c" map="0010"/>
            <part name="a98__08.mbm27c512.2a" crc="bfa7609a" map="0100"/>
            <part name="a98__04.mbm27c512.8a" crc="b64501a1" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="a98__06.mbm27c512.5a" crc="e075341b" map="0001"/>
            <part name="a98__02.mbm27c512.12a" crc="f2d17b0c" map="0010"/>
            <part name="a98__08.mbm27c512.2a" crc="bfa7609a" map="0100"/>
            <part name="a98__04.mbm27c512.8a" crc="b64501a1" map="1000"/>
        </interleave>
        <part repeat="0x100000"> FF</part>
        <!-- JTFRAME_PROM_START -->
        <!-- proms - starts at 0x250000 - length 0x1000 (12 bits) -->
        <part name="a98-13.15f" crc="7cde2da5"/>
        <part name="a98-12.17f" crc="90dc9da7"/>
        <part repeat="0xC00"> FF</part>
        <!-- MCU_START -->
        <!-- mcu - starts at 0x251000 - length 0x800 (11 bits) -->
        <part name="b06__14.1g" crc="28907072"/>
        <!-- Total 0x251800 bytes - 2374 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <rom index="3"><part></part></rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <DSWA/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2/3,2/1,1/2,1/1"/>
        <dip name="Coin B" bits="6,7" ids="2/3,2/1,1/2,1/1"/>
        <DSWB/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="100k 400k 300k+,100k 300k 200k+,50k 200k 150k+,50k 250k 200k+"/>
        <dip name="Lives" bits="12,13" ids="5,4,2,3"/>
        <dip name="P1/P2 Collision" bits="14" ids="Yes,No"/>
        <dip name="Allow Continue" bits="15" ids="No,Yes"/>
    </switches>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
