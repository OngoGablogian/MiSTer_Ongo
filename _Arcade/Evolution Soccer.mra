<!--
  Evolution Soccer (Evoga / BrezzaSoft, 2001) - BrezzaSoft Crystal System - MRA for the Crystal MiSTer core.

  ROM set: MAME evosocc.zip (parent BIOS crysbios.zip). Sizes/CRCs verified against MAME
  (c233473382353a00fb2d8b00d98c197cee910854 and 0.289). No ROM data is embedded in this file.
  docs/ROM_LAYOUT.md describes the stream.

  Index 1: board record (16 bytes): "CRYS", version 1, game id 2 (evosocc: enables the isolated
           MAME-compatible init_evosocc() protection overlay, docs/PROTECTION.md), populated flash banks 3.
  Index 2: NVRAM image (zeros, then the saved .nvm), before index 0 so the board starts with it.
  Index 0: platform ROM stream. 0x0000000-0x2FFFFFF cartridge flash banks 0-2 (u01, u02, u03),
           0x3000000-0x301FFFF BIOS (mx27l1000.u14, AMG0110B).
-->
<misterromdescription>
    <name>Evolution Soccer</name>
    <setname>evosocc</setname>
    <rbf>Crystal</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Evoga / BrezzaSoft</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <platform>BrezzaSoft Crystal System</platform>
    <category>Sports / Soccer</category>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Service" default="A,B,X,Y,Start,Select,R"/>

    <switches default="FF" base="16">
        <dip bits="0" name="Pause" ids="On,Off"/>
        <dip bits="1" name="Free Play" ids="On,Off"/>
        <dip bits="2" name="Unknown (DSW:3)" ids="On,Off"/>
        <dip bits="3" name="Unknown (DSW:4)" ids="On,Off"/>
        <dip bits="4" name="Unknown (DSW:5)" ids="On,Off"/>
        <dip bits="5" name="Unknown (DSW:6)" ids="On,Off"/>
        <dip bits="6" name="Unknown (DSW:7)" ids="On,Off"/>
        <dip bits="7" name="Test (DSW:8)" ids="On,Off"/>
    </switches>

    <rom index="1">
        <part>
            43 52 59 53 01 02 03 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- NVRAM (64 KiB battery RAM at 0x01400000, MAME nvram format) -->
    <rom index="2">
        <part repeat="0x10000">00</part>
    </rom>
    <nvram index="2" size="65536"/>

    <rom index="0" zip="evosocc.zip|crysbios.zip" md5="none" address="0x32000000">
        <!-- FLASH bank 0-2: MAME region "flash" (ROM_REGION32_LE 0x3000000) -->
        <part name="bcsv0001u01" crc="2581a0ea"/>
        <part name="bcsv0001u02" crc="47ef1794"/>
        <part name="bcsv0001u03" crc="f396a2ec"/>
        <!-- BIOS: MAME region "maincpu", system BIOS 0 "amg0110b" -->
        <part name="mx27l1000.u14" crc="beff39a9"/>
    </rom>
</misterromdescription>
