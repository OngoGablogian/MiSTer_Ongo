<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Twinkle (set 1)</name>
    <setname>twinkle</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>SemiCom / Tirano</manufacturer>
    <category>Maze</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Jump,Fire,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 10 00 00 00 10 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="twinkle.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ui12.bin" crc="5af73684" map="01"/>
            <part name="uh12.bin" crc="a99626fe" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="ua4.bin" crc="6b64bb09"/>
        <part repeat="0x180000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="u1.bin" crc="e40481da"/>
        <!-- oki1 -->
        <part name="uj15.bin" crc="0a534b37"/>
        <part repeat="0x2000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="00d3e4b4"/>
    </rom>

    <switches default="FE,92,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Coinage" bits="1,3" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="4,6" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <dip name="Lives" bits="8,9" ids="1,4,3,2"/>
        <dip name="Pellet Animations" bits="12,12" ids="Off,On"/>
        <dip name="Free Play" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
