<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME silkroad.cpp; the layout is
         rtl/memory/silkroad_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME silkroad.cpp"/>
    <name>The Legend of Silkroad</name>
    <setname>silkroad</setname>
    <rbf>Silkroad</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Unico</manufacturer>
    <category>Fighter</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Attack,Jump,Select Magic,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,R,L" count="3"/>

    <!-- mod byte (Silkroad.sv): [2:1] orientation -->
    <rom index="1"><part>00</part></rom>

    <!-- hiscore (rtl/hiscore.v), from MAME's plugins/hiscore/hiscore.dat -->
    <rom index="3">
        <part>
        19 9A 57 EF 3F FF 00 02 00 02 00 01 00 0F 10 00
        00 FE 30 5E 8C 4D 01 00
        </part>
    </rom>
    <nvram index="4" size="140"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="silkroad.zip" md5="none" address="0x30000000">
        <!-- gfx region A: thirds 0 and 1, 4 bytes each a tile row -->
        <interleave output="64">
            <part name="rom12.rom12" crc="96393d04" map="00004321"/>
            <part name="rom08.rom08" crc="23f1d462" map="43210000"/>
        </interleave>
        <interleave output="64">
            <part name="rom13.rom13" crc="4ca1698e" map="00004321"/>
            <part name="rom09.rom09" crc="ef0b5bf4" map="43210000"/>
        </interleave>
        <interleave output="64">
            <part name="rom14.rom14" crc="d00b19c4" map="00004321"/>
            <part name="rom10.rom10" crc="7d324280" map="43210000"/>
        </interleave>
        <interleave output="64">
            <part name="rom07.rom07" crc="9fc6ff9d" map="00004321"/>
            <part name="rom11.rom11" crc="11abaf1c" map="43210000"/>
        </interleave>
        <!-- gfx region B: third 2 -->
        <part name="rom04.rom04" crc="d9f0bbd7"/>
        <part name="rom05.rom05" crc="512d6e25"/>
        <part name="rom06.rom06" crc="3ac26060"/>
        <part name="rom15.rom15" crc="26a3b168"/>
        <!-- maincpu -->
        <interleave output="32">
            <part name="rom02.bin" crc="4e5200fc" map="0012"/>
            <part name="rom03.bin" crc="73ccc78c" map="1200"/>
        </interleave>
        <!-- oki1 -->
        <part name="rom00.bin" crc="b10ba7ab"/>
        <!-- oki2 -->
        <part name="rom01.bin" crc="db8cb455"/>
    </rom>

    <switches default="1C,F7,00">
        <dip name="Lives" bits="0" ids="2,1"/>
        <dip name="Special Effect" bits="1" ids="On,Off"/>
        <dip name="Difficulty" bits="5,7" ids="Normal,Easy,Easier,Easiest,Hardest,Harder,Hard,Medium"/>
        <dip name="Free Play" bits="9" ids="On,Off"/>
        <dip name="Demo Sounds" bits="11" ids="On,Off"/>
        <dip name="Chute Type" bits="12" ids="Multi,Single"/>
        <dip name="Coin A" bits="13,15" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <!-- not on the board: read by the core, not the game (Silkroad.sv flip_screen) -->
        <dip name="Flip Screen" bits="16" ids="Off,On"/>
    </switches>
</misterromdescription>
