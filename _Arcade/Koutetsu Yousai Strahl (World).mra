    <dip bits="7" name="Demo Sounds" ids="On,Off"/>
    <dip bits="8,9" name="Lives" ids="5,4,2,3"/>
    <dip bits="10,11" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="12" name="Unused (SW2:5)" ids="On,Off"/>
    <dip bits="13,14" name="Bonus Life" ids="None,300k and every 300k,100k and every 200k,200k and every 200k"/>
    <dip bits="15" name="Service Mode" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

