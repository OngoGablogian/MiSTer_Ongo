<misterromdescription>
    <!--
    MK4 (Mortal Kombat 4, version 3.0) on the zk4 core. Layout from MAME 0.289 midzeus.cpp ROM_START( mk4 ) :1506-1525:
      maindata ROM_REGION32_LE 24 MiB; four ROM_LOAD32_WORD pairs, 2 MiB each: the even-offset ROM (u10/u12/u14/u16)
      is the LOW 16 bits of each 32-bit word, the +2 ROM (u11/u13/u15/u17) the HIGH 16 bits; pairs at 0/4/8/12 MiB.
      This MRA sends the 16 MiB interleaved image as rom index 1 (zk4_loader EXPECTED_WORDS 0x400000); the loader
      zero-fills the rest of the 24 MiB region (MAME reads 0 there) and copies words 0-0x3FFFF into main RAM with
      word 0 shifted left (midzeus.cpp:236-237).
      map: one character per OUTPUT byte, highest first; the digit is the part's 1-based input byte ('0' = none).
      The DCS2 sound ROMs (u2-u5) are sent separately as ROM index 3.
    -->
    <name>Mortal Kombat 4 (version 3.0)</name>
    <setname>mk4</setname>
    <rbf>blahm1d_mk4</rbf>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>Midway</manufacturer>
    <region>World</region>
    <players>2</players>
    <joystick>8-way</joystick>
    <rom index="1" zip="mk4.zip" md5="None">
        <interleave output="32">
            <part name="mk4_l3.u10" crc="84efe5a9" map="0021"/>
            <part name="mk4_l3.u11" crc="0c026ccb" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mk4_l2.u12" crc="7816c07f" map="0021"/>
            <part name="mk4_l2.u13" crc="b3c237cd" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mk4_l2.u14" crc="fd33eb1a" map="0021"/>
            <part name="mk4_l2.u15" crc="b907518f" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mk4_l2.u16" crc="24371d57" map="0021"/>
            <part name="mk4_l2.u17" crc="3a1a082c" map="2100"/>
        </interleave>
    </rom>
    <!-- DCS2 sound ROM (midzeus.cpp:1507-1511): u2 + u3 + u4 + u5 concatenated, 7 MiB. zk4_dcs2 stores it in DDR3
         and rebuilds MAME's ERASEFF 16-bit region by address (low byte = ROM byte, high byte 0xFF, holes 0xFFFF).
         The v9 fabric DCS2 engine consumes index 3. -->
    <rom index="3" zip="mk4.zip" md5="None">
        <part name="mk4_l2.u2" crc="f9d410b4"/>
        <part name="mk4_l2.u3" crc="8fbcf0ac"/>
        <part name="mk4_l1.u4" crc="dee91696"/>
        <part name="mk4_l1.u5" crc="44d072be"/>
    </rom>
    <nvram index="2" size="32768"/>
</misterromdescription>
