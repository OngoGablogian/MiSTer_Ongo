<misterromdescription>
    <name>Daisu-Kiss (ver JAA)</name>
    <setname>daiskiss</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>00</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 0); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="daiskiss.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="535jaa03.27b" crc="9dc10140" map="0012"/>
            <part name="535jaa02.31b" crc="e5b3e0e5" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 5-byte row, then the last 1 byte of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="535a19.17h" crc="fa1c59d1"/>  <!-- four-byte part -->
        <part repeat="2097152">00</part>
        <part name="535a18.13g" crc="d02e5103"/>  <!-- second part -->
        <part repeat="524288">00</part>
        <!-- k055673: MAME's region, a four-byte part then the fifth bytes -->
        <part repeat="3145728">00</part>
        <interleave output="32">
            <part name="535a17.25g" crc="b12070e2" map="0021"/>
            <part name="535a13.28g" crc="10cf9d05" map="2100"/>
        </interleave>
        <part repeat="2097152">00</part>
        <part name="535a11.30g" crc="2b176b0f"/>
        <part repeat="524288">00</part>
        <!-- soundcpu: MAME's region as it is -->
        <part repeat="3145728">00</part>
        <interleave output="16">
            <part name="535a08.9c" crc="449416a7" map="01"/>
            <part name="535a09.7c" crc="8ec57ab4" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="535a22.9g" crc="7ee59acb"/>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it -->
    <nvram index="4" size="128"/>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="1,2,3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- from Pugsy's MAME cheats (mamecheat.co.uk), scripts/mame_cheats.py: replaced
         as the CPU reads them (rtl/cheat/cheatengine.sv) -->
    <cheats size="16" max="16">
        <cheat name="Infinite Time (Question)"         >00000010 00C0136F 00000000 00000009</cheat>
        <cheat name="P1 Infinite Lives (Question)"     >00000010 00C01173 00000000 00000000</cheat>
        <cheat name="P2 Infinite Lives (Question)"     >00000010 00C01273 00000000 00000000</cheat>
        <cheat name="Infinite Time (Geography)"        >00000010 00C0146F 00000000 00000009</cheat>
        <cheat name="P1 Infinite Lives (Geography)"    >00000010 00C0107F 00000000 00000003</cheat>
        <cheat name="P2 Infinite Lives (Geography)"    >00000010 00C0127F 00000000 00000003</cheat>
        <cheat name="Infinite Time (Kiss)"             >00000010 00C0156F 00000000 0000001D</cheat>
        <cheat name="P1 finish (Hit)"                  >00000010 00C01483 00000000 00000063</cheat>
        <cheat name="P2 finish (Hit)"                  >00000010 00C01683 00000000 00000063</cheat>
        <cheat name="P1 Infinite Lives (Bake)"         >00000010 00C0118D 00000000 00000003</cheat>
        <cheat name="P2 Infinite Lives (Bake)"         >00000010 00C0128D 00000000 00000003</cheat>
        <cheat name="Infinite Time (English,Arith)"    >00000010 00C02770 00000000 00000002</cheat>
        <cheat name="P1 Infinite Lives (English,Arith)">00000010 00C087F3 00000000 00000003</cheat>
        <cheat name="P2 Infinite Lives (English,Arith)">00000010 00C0892F 00000000 00000003</cheat>
        <cheat name="P1 Infinite Time (Ice Cream)"     >00000010 00C0306F 00000000 00000009</cheat>
        <cheat name="P2 Infinite Time (Ice Cream)"     >00000010 00C04A6F 00000000 00000009</cheat>
        <cheat name="P1 Infinite Lives (Dance)"        >00000010 00C0287F 00000000 00000002</cheat>
        <cheat name="P2 Infinite Lives (Dance)"        >00000010 00C0297F 00000000 00000002</cheat>
        <cheat name="P1 Infinite Lives (Block)"        >00000010 00C08C3D 00000000 00000002</cheat>
        <cheat name="P2 Infinite Lives (Block)"        >00000010 00C08C3F 00000000 00000002</cheat>
        <cheat name="P1 Infinite Time (Discern)"       >00000010 00C0586F 00000000 00000009</cheat>
        <cheat name="P1 Infinite Lives (Discern)"      >00000010 00C07D85 00000000 00000000</cheat>
        <cheat name="P2 Infinite Lives (Discern)"      >00000010 00C07E85 00000000 00000000</cheat>
    </cheats>
</misterromdescription>
