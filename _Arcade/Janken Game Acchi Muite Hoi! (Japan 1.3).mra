<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME deco_mlc.cpp; the layout is
         scripts/mlc_layout.py (rtl/video/mlc_video_pkg.sv). Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME deco_mlc.cpp"/>
    <name>Janken Game Acchi Muite Hoi! (Japan 1.3)</name>
    <setname>acchi</setname>
    <rbf>ppriest_DecoMLC156</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <!-- the grip lever's two buttons: Upper and Lower held = Rock, Lower alone = Scissors,
         neither = Paper (Upper alone is no hand). Start is the red button that advances. -->
    <buttons names="Upper Button,Lower Button,-,-,-,-,Start,Coin,Pause,Test" default="A,B,Start,Select,R" count="2"/>

    <!-- mod byte (DecoMLC.sv): [0] the DE156 configurations (0 = SH-2), [2:1] orientation,
         [3] the DECO 146, [5:4] the gfx layout (4bpp, 5bpp, 6bpp, acchi), [6] gfx1 thirds of 8 MB -->
    <rom index="1"><part>31</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="acchi.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="eaa-00-3.l10" crc="faff1710" map="0021"/>
            <part name="eaa-01-3.l11" crc="00510371" map="2100"/>
        </interleave>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="faa-09-0.c2" crc="b616058f" map="01"/>
            <part name="faa-08-0.c1" crc="70ba2149" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="faa-07-0.h2" crc="60028a62" map="01"/>
            <part name="faa-05-0.h1" crc="1e7a7a0a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="faa-06-0.f2" crc="5538ff81" map="01"/>
            <part name="faa-04-0.f1" crc="35280765" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="faa-03-0.e2" crc="af457714" map="01"/>
            <part name="faa-01-0.e1" crc="a245270b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="faa-02-0.b2" crc="bdf75bd6" map="01"/>
            <part name="faa-00-0.b1" crc="2cf34cd6" map="10"/>
        </interleave>
        <part repeat="0x400000">00</part>  <!-- gfx2 at 0x1900000 -->
        <!-- gfx2 -->
        <part name="eaa-02-0.l12" crc="09baf624"/>
        <!-- ymz -->
        <part name="faa-10-0.a5" crc="9f280e5f"/>
        <part name="faa-11-0.a7" crc="3775ae66"/>
        <part repeat="0x200000">00</part>  <!-- image end -->
    </rom>

    <switches default="00,00,00">
        <!-- the board has no DIP switches (a 93C45 EEPROM): read by the core, not the game -->
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>
</misterromdescription>
