<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>jjparads</setname>
	<name>Jan Jan Paradise</name>
	<rotation>horizontal</rotation>
	<year>1996</year>
	<manufacturer>Electro Design</manufacturer>
	<buttons names="Button 1,Button 2,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="jjparads.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="f31b2e95" name="jp100-00.u24" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="70cc8c24" name="jp101-00.u20" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="35401c1e" name="jp102-00.u17" map="12345678" />
		</interleave>
		<part repeat="0x400000">00</part>

		<interleave output="64">
			<part crc="493d63db" name="jp200-00.u16" map="12345678" />
		</interleave>
		<part repeat="0xE00000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="7023fe46" name="jp300-00.u4" map="12345678" />
		</interleave>
		<part repeat="0xE00000">00</part>

		<interleave output="64">
			<part crc="7e2b836c" name="sknsj1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="de2fb669" name="jp1j1.u10" map="13570" />
			<part crc="7276efb1" name="jp1j1.u8" map="1357" />
		</interleave>
		<part repeat="0x100000">00</part>
	</rom>
	<rom index="2" md5="" >
		<part>10 4A 00 00 05 00</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>