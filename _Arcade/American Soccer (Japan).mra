<misterromdescription>
	<name>American Soccer (Japan)</name>
	<region>Japan</region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<platform>Universal Do! Castle Hardware</platform>
	<series>Mr. Do</series>
	<year>1987</year>
	<manufacturer>Universal</manufacturer>
	<category>Sports</category>
	<setname>asoccer</setname>
	<parent>idsoccer</parent>
	<mameversion>0288</mameversion>
	<rbf>DoCastle</rbf>
	<about author="aCORES" source="MAME universal/docastle.cpp, Universal manuals and PCB evidence" />
	<resolution>15kHz</resolution>
	<rotation>horizontal</rotation>
	<flip>yes</flip>
	<players>2</players>
	<joystick>8-way dual</joystick>
	<num_buttons>2</num_buttons>
	<buttons names="Kick,Change Player,Start 1P,Start 2P,Coin 1,Coin 2,Service Mode,Pause,Right Stick Left,Right Stick Right,Right Stick Up,Right Stick Down,Service Credit" default="A,B,Start,Select,R,L,X,Y,-,-,-,-,-" />

	<switches default="FF,FF">
		<dip bits="0,1" name="Difficulty" ids="Hardest,Hard,Medium,Easy"/>
		<dip bits="2" name="Joysticks" ids="Single,Dual"/>
		<dip bits="3" name="Flip Screen" ids="On,Off"/>
		<dip bits="4" name="Unknown SWA:4" ids="On,Off"/>
		<dip bits="5" name="Demo Sounds" ids="Off,On"/>
		<dip bits="6,7" name="Real Game Time" ids="1:00,2:00,2:30,3:00"/>
		<dip bits="8,9,10,11" name="Coin B" ids="Free,1/1,1/1,1/1,1/1,4/1,3/2,3/1,2/3,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
		<dip bits="12,13,14,15" name="Coin A" ids="Free,1/1,1/1,1/1,1/1,4/1,3/2,3/1,2/3,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
	</switches>

