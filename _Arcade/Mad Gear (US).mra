<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Mad Gear (US)</name>
    <setname>madgear</setname>
    <mameversion>0282</mameversion>
    <year>1989</year>
    <manufacturer>Capcom</manufacturer>
    <players>2</players>
    <rbf>madgear</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="madgear.zip" md5="None" asm_md5="42be9f71d14b70dc7b96fbc073fc19b7">
        <!-- maincpu - starts at 0x0 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="mg_03.7b" crc="b2672465" map="01"/>
            <part name="mg_04.8b" crc="b112257d" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mg_01.5b" crc="1cea2af0" map="01"/>
            <part name="mg_02.6b" crc="9f5ebe16" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x80000 - length 0x10000 (16 bits) -->
        <part name="mg_05.14j" crc="2fbfc945"/>
        <!-- PCM_START -->
        <!-- oki - starts at 0x90000 - length 0x40000 (18 bits) -->
        <part name="ls-06.10e" crc="88d39a5b"/>
        <part name="ls-05.12e" crc="b06e03b5"/>
        <!-- JTFRAME_BA2_START -->
        <!-- gfx2 - starts at 0xD0000 - length 0x8000 (15 bits) -->
        <part name="mg_06.10k" crc="382ee59b"/>
        <!-- OBJ_START -->
        <!-- sprites - starts at 0xD8000 - length 0x80000 (19 bits) -->
        <interleave output="32">
            <part name="mg_m12.rom1" crc="887ef120" map="0001"/>
            <part name="mg_m14.rom1" crc="21e5424c" map="0010"/>
            <part name="mg_m11.rom0" crc="ee319a64" map="0100"/>
            <part name="mg_m13.rom0" crc="eae07db4" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="mg_m08.rom3" crc="59709aa3" map="0001"/>
            <part name="mg_m10.rom3" crc="b64afb54" map="0010"/>
            <part name="mg_m07.rom2" crc="e5c0b211" map="0100"/>
            <part name="mg_m09.rom2" crc="40ee83eb" map="1000"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- gfx3 - starts at 0x158000 - length 0x40000 (18 bits) -->
        <part name="ls-12.7l" crc="6c1b2c6c"/>
        <!-- FG_START -->
        <!-- gfx4 - starts at 0x198000 - length 0x80000 (19 bits) -->
        <interleave output="16">
            <part name="ls-11.2l" crc="6bf81c64" map="12"/>
        </interleave>
        <!-- JTFRAME_PROM_START -->
        <!-- proms - starts at 0x218000 - length 0x100 (8 bits) -->
        <part name="29.14k" crc="7f862e1e"/>
        <!-- Total 0x218100 bytes - 2144 kBytes -->
    </rom>
    <nvram index="2" size="61440"/>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff,ff,ff">
        <DSW1/>
        <dip name="Allow Continue" bits="0" ids="No,Yes"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Difficulty" bits="2,3" ids="Very Difficult,Difficult,Easy,Normal"/>
        <dip name="Cabinet" bits="4,5" ids="Upright Two Players,Cocktail,Upright One Player,Upright One Player"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On"/>
        <dip name="Demo Music" bits="7" ids="Off,On"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <DSW2/>
        <dip name="Coin B" bits="24,27" ids="1 / 1,8/3,6/1,5/3,5/1,4/1,3/2,3/1,2/3,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Coin A" bits="28,31" ids="Free Play,8/3,6/1,5/3,5/1,4/1,3/2,3/1,2/3,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
    </switches>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
