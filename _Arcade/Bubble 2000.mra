  Bubble 2000 — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 39).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... bubl2000 ...)
  line 10836, ROM_START(bubl2000), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Bubble 2000</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>bubl2000</setname>
  <year>1998</year>
  <manufacturer>Afega (Tuning license)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,27">
    <dip bits="0" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="1" name="Unused (SW2:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW2:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW2:3)" ids="On,Off"/>
    <dip bits="6,7" name="Free Credit" ids="1500k,1000k,500k,800k"/>
    <dip bits="8" name="Unused (SW1:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Disabled,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Disabled,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="bubl2000.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 (init_bubl2000 scramble) -->
    <interleave output="16">
      <part crc="b386041a" name="rom11.107" map="01"/>
      <part crc="87f960d7" name="rom10.112" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="rom01.92"/>
    <!-- fgtile, 0x010000 -->
    <part crc="f4c15588" name="rom03.4"/>
    <!-- bgtile, 0x300000 (8bpp: two 4bpp halves, six files) -->
    <part crc="ac1aabf5" name="rom06.6"/>
    <part crc="69aff769" name="rom07.9"/>
    <part crc="3a5b7226" name="rom13.7"/>
    <part crc="46acd054" name="rom04.1"/>
    <part crc="37deb6a1" name="rom05.3"/>
    <part crc="1fdc59dd" name="rom12.2"/>
    <!-- sprites, 0x080000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="04fcb5c6" name="rom09.14" map="01"/>
      <part crc="519dfd82" name="rom08.11" map="10"/>
    </interleave>
    <!-- oki1, 0x040000 -->
    <part crc="859a86e5" name="rom02.95"/>
  </rom>
</misterromdescription>
