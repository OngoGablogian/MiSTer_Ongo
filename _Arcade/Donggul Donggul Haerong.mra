<!--
  Donggul Donggul Haerong (Danbi, 2001) - BrezzaSoft Crystal System - MRA for the Crystal MiSTer core.

  ROM set: MAME donghaer.zip (parent BIOS crysbios.zip). Sizes/CRCs verified against MAME 0.289. No ROM data is
  embedded in this file. docs/ROM_LAYOUT.md describes the stream.

  Index 1: board record (16 bytes): "CRYS", version 1, game id 5 (donghaer: enables the isolated protection
           overlay - MAME's init_donghaer() words plus the challenge fix that stops the game's self-corruption,
           docs/PROTECTION.md), populated flash banks 2.
  Index 2: NVRAM image (zeros, then the saved .nvm), before index 0 so the board starts with it.
  Index 0: platform ROM stream. 0x0000000-0x1FFFFFF cartridge flash banks 0-1 (u1, u2),
           0x2000000-0x201FFFF BIOS (mx27l1000.u14, AMG0110B).
-->
<misterromdescription>
    <name>Donggul Donggul Haerong</name>
    <setname>donghaer</setname>
    <rbf>Crystal</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Danbi</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <platform>BrezzaSoft Crystal System</platform>
    <category>Platform</category>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Service" default="A,B,X,Y,Start,Select,R"/>

    <switches default="FF" base="16">
        <dip bits="0" name="Pause" ids="On,Off"/>
        <dip bits="1" name="Free Play" ids="On,Off"/>
        <dip bits="2" name="Unknown (DSW:3)" ids="On,Off"/>
        <dip bits="3" name="Unknown (DSW:4)" ids="On,Off"/>
        <dip bits="4" name="Unknown (DSW:5)" ids="On,Off"/>
        <dip bits="5" name="Unknown (DSW:6)" ids="On,Off"/>
        <dip bits="6" name="Unknown (DSW:7)" ids="On,Off"/>
        <dip bits="7" name="Test (DSW:8)" ids="On,Off"/>
    </switches>

    <rom index="1">
        <part>
            43 52 59 53 01 05 02 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- NVRAM (64 KiB battery RAM at 0x01400000, MAME nvram format) -->
    <rom index="2">
        <part repeat="0x10000">00</part>
    </rom>
    <nvram index="2" size="65536"/>

    <rom index="0" zip="donghaer.zip|crysbios.zip" md5="none" address="0x32000000">
        <!-- FLASH bank 0-1: MAME region "flash" (ROM_REGION32_LE 0x2000000) -->
        <part name="u1" crc="61217ad7"/>
        <part name="u2" crc="6d82f1a5"/>
        <!-- BIOS: MAME region "maincpu", system BIOS 0 "amg0110b" -->
        <part name="mx27l1000.u14" crc="beff39a9"/>
    </rom>
</misterromdescription>
