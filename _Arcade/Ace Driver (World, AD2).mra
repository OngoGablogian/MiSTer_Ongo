		<dip bits="14" name="Test Mode? (SW3:7)" ids="Off,On"/>
		<dip bits="15" name="Test Mode? (SW3:8, needs SW3:7)" ids="Off,On"/>
	</switches>
	<nvram index="8" size="8192"/>

