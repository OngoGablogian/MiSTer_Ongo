<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME deco_mlc.cpp; the layout is
         scripts/mlc_layout.py (rtl/video/mlc_video_pkg.sv). Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME deco_mlc.cpp"/>
    <name>Avengers In Galactic Storm (US/Europe 1.0)</name>
    <setname>avengrgs</setname>
    <rbf>ppriest_DecoMLC</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Fighter</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Light Punch,Heavy Punch,Light Kick,Heavy Kick,-,-,Start,Coin,Pause,Test" default="A,B,X,Y,Start,Select,R" count="4"/>

    <!-- mod byte (DecoMLC.sv): [0] the DE156 configurations (0 = SH-2), [2:1] orientation,
         [3] the DECO 146, [5:4] the gfx layout (4bpp, 5bpp, 6bpp, acchi), [6] gfx1 thirds of 8 MB -->
    <rom index="1"><part>00</part></rom>

    <!-- the factory EEPROM image (ROM_REGION16_BE eeprom): the core loads it into its 93C45 -->
    <rom index="2" zip="avengrgs.zip" md5="none">
        <part name="avengrgs.nv" crc="c0e84b4e"/>
    </rom>

    <!-- hiscore (rtl/hiscore.v), from MAME's plugins/hiscore/hiscore.dat -->
    <rom index="3">
        <part>
        19 9A 57 EF 3F FF 00 02 00 02 00 01 00 0F 10 00
        00 10 89 09 4E 01 52 00
        </part>
    </rom>
    <nvram index="4" size="78"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="avengrgs.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="sf_01-0.7l" crc="f37c0a01" map="0012"/>
            <part name="sf_00-0.7k" crc="7d20e2df" map="1200"/>
        </interleave>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="mcg-02.1f" crc="29af9866" map="01"/>
            <part name="mcg-00.1j" crc="99129d9a" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcg-03.7m" crc="4a0c965f" map="01"/>
            <part name="mcg-01.1d" crc="3638861b" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcg-09.7n" crc="8fb9870b" map="01"/>
            <part name="mcg-08.7p" crc="c253943e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcg-06.3f" crc="01571cf6" map="01"/>
            <part name="mcg-04.3j" crc="a4954c0e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcg-07.8m" crc="d09a3635" map="01"/>
            <part name="mcg-05.3d" crc="182c2b49" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mcg-11.8n" crc="8f7fc281" map="01"/>
            <part name="mcg-10.8p" crc="1383f524" map="10"/>
        </interleave>
        <!-- gfx2 -->
        <part name="sf_02-0.6j" crc="c98585dd"/>
        <!-- ymz -->
        <part name="mcg-12.5a" crc="bef9b28f"/>
        <part name="mcg-13.9k" crc="92301551"/>
        <part name="mcg-14.6a" crc="c0d8b5f0"/>
    </rom>

    <switches default="00,00,00">
        <!-- the board has no DIP switches (a 93C45 EEPROM): read by the core, not the game -->
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>
</misterromdescription>
