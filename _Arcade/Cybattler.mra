<!--
  Cybattler — Jaleco 1993, MAME jaleco/megasys1.cpp (cybattlr).
  Mega System 1 type C. Generated by tools/gen_ms1bcd_mra.py from
  tools/ms1_romdata.py, which is extracted from the driver; do not hand-edit.

  SDRAM image: fixed per-mode bases, each region padded to the mode's largest
  instance so the core needs one base table per mode rather than one per set.
  Total 0x344000 bytes.

  <switches> byte 2 is not a DIP: it is the game-mode byte, read at RUN TIME
  only (never during the ROM stream — index 254 arrives last). Bits 1:0 mode
  B/C/D, bit 4 sample clock 2 MHz, bits 6:5 protection (0 MCU, 1 simulated,
  2 none, 3 System D's own).
-->
<misterromdescription>
  <name>Cybattler</name>
  <mratimestamp>202609200000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>cybattlr</setname>
  <year>1993</year>
  <manufacturer>Jaleco</manufacturer>
  <category>Arcade</category>
  <rbf>kuze_JalecoMS1BCD</rbf>
  <rotation>vertical (cw)</rotation>

  <switches default="FF,BF,01">
    <dip bits="0,2" name="Coin A" ids="4C_1C,3C_1C,2C_3C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="3,5" name="Coin B" ids="4C_1C,3C_1C,2C_3C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="6" name="Free Play" ids="On,Off"/>
    <dip bits="7" name="Service Mode" ids="On,Off"/>
    <dip bits="8,9" name="Difficulty" ids="Very Hard,Hard,Easy,Normal"/>
    <dip bits="10" name="Disable Instruction Screen" ids="On,Off"/>
    <dip bits="11,12" name="Allow Continue" ids="Off,Not on Final Mission,Up to Mission 4,On"/>
    <dip bits="13" name="Intro Music" ids="Off,On"/>
    <dip bits="14" name="Demo Sounds" ids="On,Off"/>
    <dip bits="15" name="Flip Screen" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="cybattlr.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000 -->
    <interleave output="16">
      <part crc="bee20587" name="cb_03.rom" map="01"/>
      <part crc="2ed14c50" name="cb_02.rom" map="10"/>
    </interleave>
    <!-- audiocpu 0x020000 @ 0x080000 -->
    <interleave output="16">
      <part crc="bf7b3558" name="cb_08.rom" map="01"/>
      <part crc="85d219d7" name="cb_07.rom" map="10"/>
    </interleave>
    <!-- iomcu 0x004000 @ 0x0A0000 -->
    <part crc="a72e04a7" name="mo-91028.mcu"/>
    <!-- scroll1 0x080000 @ 0x0A4000 -->
    <part crc="1109337f" name="cb_m01.rom"/>
    <!-- scroll2 0x080000 @ 0x124000 -->
    <part crc="0c91798e" name="cb_m04.rom"/>
    <!-- scroll3 0x020000 @ 0x1A4000 -->
    <part crc="37b1f195" name="cb_09.rom"/>
    <!-- sprites 0x100000 @ 0x1C4000 -->
    <part crc="4cd49f58" name="cb_m03.rom"/>
    <part crc="882825db" name="cb_m02.rom"/>
    <!-- oki1 0x040000 @ 0x2C4000 -->
    <part crc="59d62d1f" name="cb_11.rom"/>
    <!-- oki2 0x040000 @ 0x304000 -->
    <part crc="8af95eed" name="cb_10.rom"/>
  </rom>

  <!-- Priority PROM (512 B). Its own index so it reaches a write
       port on ms1_prio.sv rather than SDRAM, and so that "is any PROM
       data in the bitstream?" stays an easy question. -->
  <rom index="1" zip="cybattlr.zip" md5="none">
    <part crc="cfe90082" name="pr-91028.12"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for cybattlr, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 1F 01 01 00 ED 02 20
    </part>
  </rom>
  <nvram index="4" size="237"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 1F D1 01 00 00 09 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
