<!--
  GunNail (28th May. 1992) — NMK16 "Gunnail" rbf (gunnail/gunnailp share the gunnail_prot()
  machine config, nmk16.cpp). Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp:
    - ROM_START(gunnail), GAME(... gunnail ...) line 10732
    - INPUT_PORTS_START(gunnail): 2 buttons per player, DSW1/DSW2 below

  ROM part order = rtl/gunnail/gunnail_core.sv's fixed SDRAM layout
  (docs/hw-bringup.md): maincpu @0x000000, NMK004 program @0x080000,
  NMK004 boot ROM nmk004.bin @0x090000 (from nmk004.zip — MAME's shared
  NMK004 device ROM), NMK-215 protection ROM @0x092000 (the core copies
  it into the MCU's on-chip ROM during the download), fgtile @0x094000,
  bgtile @0x0B4000, sprites @0x1B4000, oki1 @0x3B4000, oki2 @0x434000
  (contiguous — the loader streams the parts back to back).
  maincpu is a ROM_LOAD16_BYTE pair, interleaved below.
  The nmk_irq timing PROMs are fixed at synthesis and not downloaded.
  Generated by tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>GunNail (28th May. 1992)</name>
  <mratimestamp>202609090000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>gunnail</setname>
  <year>1993</year>
  <manufacturer>NMK / Tecmo</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1 default 0xFD (Flip off, Language English = bit1 clear,
       Normal, four "Unused" off = set), DSW2 default 0xFF. Byte order
       matches gunnail_core.sv's decode (sel_dsw1 at 0x080008, sel_dsw2 at
       0x08000A). ids are listed in bit-value order (value 0 first). -->
  <switches default="FD,FF">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Language" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6" name="Unused (SW1:2)" ids="On,Off"/>
    <dip bits="7" name="Unused (SW1:1)" ids="On,Off"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Start,Coin" default="Y,B,Start,R"/>

  <rom index="0" zip="gunnail.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 @ 0x000000 -->
    <!-- ROM_LOAD16_BYTE pair: the low-byte chip (3o.u133, odd MAME
         offsets) on even stream addresses (map="01"), the high-byte chip
         (3e.u131) on odd — the core rebuilds 68000 words by byte parity. -->
    <interleave output="16">
      <part crc="f114e89c" name="3o.u133" map="01"/>
      <part crc="61d985b2" name="3e.u131" map="10"/>
    </interleave>
    <!-- NMK004 external program, 0x010000 @ 0x080000 -->
    <part crc="cd4e55f8" name="92077_2.u101"/>
    <!-- NMK004 internal boot ROM, 0x002000 @ 0x090000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- NMK-215 protection MCU ROM, 0x002000 @ 0x092000 -->
    <part crc="d355a06f" name="nmk-215.bin"/>
    <!-- fgtile, 0x020000 @ 0x094000 -->
    <part crc="3d00a9f4" name="1.u21"/>
    <!-- bgtile, 0x100000 @ 0x0B4000 (NMK214-scrambled, decoded per fetch) -->
    <part crc="a9ea2804" name="92077-4.u19"/>
    <!-- sprites, 0x200000 @ 0x1B4000 (ROM_LOAD16_WORD_SWAP, NMK214-scrambled) -->
    <part crc="d49169b3" name="92077-7.u134"/>
    <!-- oki1, 0x080000 @ 0x3B4000 -->
    <part crc="feb83c73" name="92077-5.u56"/>
    <!-- oki2, 0x080000 @ 0x434000 -->
    <part crc="6d133f0d" name="92077-6.u57"/>
  </rom>
</misterromdescription>
