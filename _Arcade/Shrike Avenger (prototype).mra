<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Shrike Avenger (prototype)</name>
	<setname>shrike</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1986</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>1</players>
	<!-- Analog: P1 ad_stick_y, P1 ad_stick_x. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="shrike.zip|sente6vb.zip" md5="none">
		<part name="savgu35.bin" crc="dd2230a0"/>
		<part name="savgu20.bin" crc="3d140edc"/>
		<part name="savgu34.bin" crc="779eca9d"/>
		<part name="savgu19.bin" crc="9ec89a80"/>
