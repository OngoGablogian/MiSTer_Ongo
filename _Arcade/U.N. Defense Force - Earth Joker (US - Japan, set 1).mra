<misterromdescription>
    <rbf>EarthJoker_bazset</rbf>
    <name>U.N. Defense Force: Earth Joker (US / Japan, set 1)</name>
    <setname>earthjkr</setname>
    <year>1993</year>
    <manufacturer>Visco</manufacturer>
    <players>2</players>
    <joystick>8way</joystick>
    <rotation>vertical (ccw)</rotation>
    <region>US / Japan</region>

    <rom index="0" zip="earthjkr.zip" type="merged" md5="none">
        <!-- 68000 program ROMs. Core applies MAME's set-1 bad-dump repair at 0x007aaa. -->
        <interleave output="16">
            <part name="ej_3b.ic23" crc="bdd86fc2" map="01"/>
            <part name="ej_3a.ic8" crc="9c8050c6" map="10"/>
        </interleave>
        <part repeat="0x40000">00</part>
        <part name="ej_30e.ic30" crc="49d1f77f"/>
        <part name="ej_2.ic27" crc="42ba2566"/>
        <part name="ej_chr-0.ic3" crc="ac675297"/>
        <part name="ej_obj-0.ic6" crc="5f21ac47"/>
        <interleave output="16">
            <part name="ej_0.ic4" crc="b612086f" map="01"/>
            <part name="ej_1.ic5" crc="cb4891db" map="10"/>
        </interleave>
    </rom>

    <!-- MAME hiscore.dat: @:maincpu,program,103204,2f,00,42 -->
    <nvram index="2" size="47"/>

    <switches default="ff,f3" base="16">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="100k and 300k,200k only,100k only,None"/>
        <dip name="Lives" bits="12,13" ids="1,4,3,2"/>
        <dip name="Copyright" bits="14" ids="Visco/Romstar,Visco"/>
    </switches>
    <buttons names="Fire,Bomb,Start 1P,Start 2P,Coin,Service,Pause,Autofire"
             default="A,B,Start,Select,R,L,X,Y" count="8"/>
</misterromdescription>
