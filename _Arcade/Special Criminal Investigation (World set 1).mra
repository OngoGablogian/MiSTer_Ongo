<?xml version="1.0" encoding="utf-8"?>

<misterromdescription>
    <name>Special Criminal Investigation (World set 1)</name>
    <setname>sci</setname>
    <mameversion>0289</mameversion>
    <year>1989</year>
    <manufacturer>Taito</manufacturer>
    <rbf>bazset_SCI</rbf>
    <rotation>horizontal</rotation>
    <resolution>320x240</resolution>
    <buttons names="Gas,Brake,Gun,Turbo,Gear,Start 1P,Coin,Service,Pause" default="A,B,X,Y,R,Start,Select,L,R3" count="5"/>
    <switches default="FE,FF" page_id="1" page_name="Switches">
        <dip bits="0" ids="Upright,Cockpit" name="Cabinet"/>
        <dip bits="2" ids="On,Off" name="Service Mode"/>
        <dip bits="3" ids="Off,On" name="Demo Sounds"/>
        <dip bits="4,5" ids="4C/1C,3C/1C,2C/1C,1C/1C" name="Coin A"/>
        <dip bits="6,7" ids="1C/6C,1C/4C,1C/3C,1C/2C" name="Coin B"/>
        <dip bits="8,9" ids="Hardest,Hard,Easy,Medium" name="Difficulty"/>
        <dip bits="10,11" ids="55 Seconds,65 Seconds,70 Seconds,60 Seconds" name="Timer Setting"/>
        <dip bits="12" ids="5,3" name="Turbos Stocked"/>
        <dip bits="13" ids="270 Degree,360 Degree" name="Steering Radius"/>
        <dip bits="14" ids="Off,On" name="Clear Damage on Continue"/>
        <dip bits="15" ids="Low,Normal" name="Siren Volume"/>
    </switches>

