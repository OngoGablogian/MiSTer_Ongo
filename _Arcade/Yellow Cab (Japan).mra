<misterromdescription>
	<name>Yellow Cab (Japan)</name>
	<mameversion>0270</mameversion>
	<setname>yellowcbj</setname>
	<parent>kamikcab</parent>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<year>1984</year>
	<manufacturer>Data East Corporation</manufacturer>
	<category>Driving</category>
	<rbf>Meathax_DataEastLiberation</rbf>
	<about author="aCORES Yellow Cab scaffold" source="MAME liberate.cpp / kamikcab"/>
	<resolution>15kHz</resolution>
	<rotation>vertical</rotation>
	<flip>yes</flip>
	<players>2</players>
	<joystick>8-way</joystick>
	<num_buttons>2</num_buttons>
	<buttons names="Brake,-,Start1P,Start2P,CoinA,CoinB,Service,Tilt" default="A,B,Start,Select,R,L,X,Y"/>

	<switches default="3F,FF">
		<!-- DSW1 -->
		<dip bits="0,1" name="Coin A" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
		<dip bits="2,3" name="Coin B" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
		<dip bits="4" name="Unknown SW1-5" ids="On,Off"/>
		<dip bits="5" name="Unknown SW1-6" ids="On,Off"/>
		<dip bits="6" name="Cabinet" ids="Upright,Cocktail"/>
		<dip bits="7" name="Manufacturer" ids="Data East USA,Data East"/>
		<!-- DSW2 -->
		<dip bits="8,9" name="Lives" ids="Infinite,5,2,3"/>
		<dip bits="10,11" name="Bonus" ids="20K only,40K / every 50K,30K / every 40K,20K / every 30K"/>
		<dip bits="12,13" name="Difficulty" ids="Hardest,Hard,Normal,Easy"/>
		<dip bits="14" name="Unknown SW2-7" ids="On,Off"/>
		<dip bits="15" name="Invincibility (Cheat)" ids="On,Off"/>
	</switches>

	<!--
	  Ioctl linear map (see rtl/mem/rom_map.sv):
	    0x00000  maincpu 64K (nibble-swapped in FPGA)
	    0x10000  audiocpu 16K window ($C000-$FFFF)
	    0x14000  gfx1 3 x 24K normalized plane slots
	    0x26000  gfx2 32K
	    0x2E000  user1 16K
	    0x32000  prom 32
	-->
	<rom index="0" zip="yellowcbj.zip|kamikcab.zip" md5="none">
		<!-- DELU v1: Liberation engine, Yellow Cab variant, nibble-swap + bank bit2 -->
		<part>44 45 4C 55 01 00 00 05 00 00 00 00 00 00 00 00</part>
		<!-- maincpu $0000-$7FFF pad -->
		<part repeat="0x8000">00</part>
		<!-- $8000 / reload $C000 -->
		<part name="bp10.bin" crc="1024f2f1"/>
		<!-- $A000 -->
		<part name="bp11.bin" crc="63cdee83"/>
		<!-- $C000 reload bp10 -->
		<part name="bp10.bin" crc="1024f2f1"/>
		<!-- $E000 reload bp11 -->
		<part name="bp11.bin" crc="63cdee83"/>

		<!-- audiocpu $C000-$DFFF empty, bp09 @$E000 -->
		<part repeat="0x2000">00</part>
		<part name="bp09" crc="16b13676"/>

		<!-- gfx1 plane 0 (16K data in a normalized 24K slot) -->
		<part name="bp03.bin" crc="6761d767"/>
		<part name="bp04.bin" crc="55517196"/>
		<part repeat="0x2000">00</part>
		<!-- plane 1 -->
		<part name="bp05.rom" crc="33658fd9"/>
		<part name="bp06.rom" crc="fbc20f07"/>
		<part repeat="0x2000">00</part>
		<!-- plane 2 -->
		<part name="bp07.rom" crc="061f9e54"/>
		<part name="bp08.rom" crc="2ace626d"/>
		<part repeat="0x2000">00</part>

		<!-- gfx2 (32K region; only 24K ROM) -->
		<part name="bp01.bin" crc="8e92a253"/>
		<part name="bp02.bin" crc="47ada1bb"/>
		<part name="bp00.bin" crc="9ead0da1"/>
		<part repeat="0x2000">00</part>

		<!-- user1 -->
		<part name="bp12" crc="8c8f5d35"/>

		<!-- prom -->
		<part name="bp15" crc="30d3acce"/>
	</rom>

	<rom index="1"></rom>
	<rom index="2"></rom>
	<rom index="3">
		<part>
			03 00 00 00 FF FF 00 08 00 08 00 01 11 11 40 00
			00 00 63 6B 7C 00 20 00
		</part>
	</rom>
	<nvram index="4" size="124"/>

	<remark>Main ROM nibble-swapped on load (init_yellowcb). Bank enable = DECO16 IO write bit2.</remark>
</misterromdescription>
