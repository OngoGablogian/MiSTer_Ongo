	<rom index="0" zip="solvalou.zip|namcoc67.zip" md5="none">

		<!-- 0x0000000  maincpu   0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="sv1-mp-u.bin" crc="b6f92762" map="01"/>
			<part name="sv1-mp-l.bin" crc="28c54c42" map="10"/>
		</interleave>
		<part repeat="0xC0000">FF</part>

		<!-- 0x0100000  slave     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="sv1-sp-u.bin" crc="ebd4bf82" map="01"/>
			<part name="sv1-sp-l.bin" crc="7acab679" map="10"/>
		</interleave>
		<part repeat="0xC0000">FF</part>

		<!-- 0x0200000  data      0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="sv1-data-u.bin" crc="2e561996" map="01"/>
			<part name="sv1-data-l.bin" crc="495fb8dd" map="10"/>
		</interleave>

		<!-- 0x0300000  edata     0x100000 -->
		<part repeat="0x100000">FF</part><!-- MAME: ROMREGION_ERASEFF, empty -->

		<!-- 0x0400000  gap_obj   0x200000 -->
		<part repeat="0x200000">FF</part>

		<!-- 0x0600000  point24   0x400000 -->
		<interleave output="32"><!-- {H,H,U,L}: MAME lane 0 is the never-loaded 0x00 of the 32-bit BE word; MRA cannot emit a constant lane, so *-h is repeated there.  The core must ignore stream byte 4n. -->
			<part name="sv1-pt0-h.bin" crc="3be21115" map="0001"/>
			<part name="sv1-pt0-h.bin" crc="3be21115" map="0010"/>
			<part name="sv1-pt0-u.bin" crc="4aacfc42" map="0100"/>
			<part name="sv1-pt0-l.bin" crc="6a4dddff" map="1000"/>
		</interleave>
		<part repeat="0x200000">00</part>

		<!-- 0x0A00000  c67       0x002000 -->
		<part name="c67.bin" crc="6bd8988e"/><!-- namcoc67.zip: shared master+slave DSP internal ROM -->

		<!-- 0x0A02000  gap_a     0x002000 -->
		<part repeat="0x2000">FF</part>

		<!-- 0x0A04000  nvram     0x002000 -->
		<part repeat="0x2000">00</part><!-- solvalou.nv: not in the local romset (MAME 0.277-era zip); nvram_device::DEFAULT_ALL_0 (namcos21_c67.cpp:853) is the MAME fallback -->

		<!-- 0x0A06000  gap_b     0x1FA000 -->
		<part repeat="0x1FA000">FF</part>

		<!-- 0x0C00000  c140      0x200000 -->
		<part name="sv1-voi0.bin" crc="7f61bbcf"/>
		<part name="sv1-voi1.bin" crc="c732e66c"/>
		<part name="sv1-voi2.bin" crc="51076298"/>
		<part name="sv1-voi3.bin" crc="33085ff3"/>

		<!-- 0x0E00000  audiocpu  0x020000 -->
		<part name="sv1-snd0.bin" crc="5e007864"/>

		<!-- 0x0E20000  gap_wram  0x1E0000 -->
		<part repeat="0x1E0000">00</part>

		<!-- 0x1000000  c355spr   0x400000 -->
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="sv1-obj0.bin" crc="773798bb" map="0001"/>
			<part name="sv1-obj1.bin" crc="a36d9e79" map="0010"/>
			<part name="sv1-obj2.bin" crc="c8672b8a" map="0100"/>
			<part name="sv1-obj3.bin" crc="293ef1c5" map="1000"/>
		</interleave>
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="sv1-obj4.bin" crc="33a008a7" map="0001"/>
			<part name="sv1-obj5.bin" crc="31551245" map="0010"/>
			<part name="sv1-obj6.bin" crc="fe319530" map="0100"/>
			<part name="sv1-obj7.bin" crc="95ed6dcb" map="1000"/>
		</interleave>
		<patch offset="0x20CE6">00 00</patch><!-- MAME driver_init patch, see PATCHES -->
	</rom>

	<!-- C68 DSW port ($2000, namcos21_c67.cpp:658-680).  MAME reads it ACTIVE LOW;
	     the OSD bit here is the LOGICAL switch (1 = On) and the core inverts:
	     dsw_port[n] = ~status[24+n].  Unnamed switches keep MAME's "DSWn" label. -->
	<switches default="20" base="24">
		<dip name="Test Mode (SW:1)" bits="0" ids="Off,On"/>
		<dip name="DSW2 (SW:2)" bits="1" ids="Off,On"/>
		<dip name="DSW3 (SW:3)" bits="2" ids="Off,On"/>
		<dip name="DSW4 (SW:4)" bits="3" ids="Off,On"/>
		<dip name="DSW5 (SW:5)" bits="4" ids="Off,On"/>
		<dip name="PCM ROM (SW:6)" bits="5" ids="2M,4M"/>
		<dip name="DSW7 (SW:7)" bits="6" ids="Off,On"/>
		<dip name="Screen Stop (SW:8)" bits="7" ids="Off,On"/>
	</switches>

	<buttons names="Zapper,Start,Blaster,Button 3,Button 4,Coin,Service,Test,-,Pause" default="A,Start,B,X,Y,Select,L,R,,"/>
</misterromdescription>
