<!--
  Pop's Pop's — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 37).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... popspops ...)
  line 10841, ROM_START(popspops), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Pop's Pop's</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>popspops</setname>
  <year>1999</year>
  <manufacturer>Afega</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FB,FF,25">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Unknown (tells the answers)" ids="On,Off"/>
    <dip bits="3" name="Unknown (SW:4)" ids="On,Off"/>
    <dip bits="4" name="Unknown (SW:5)" ids="On,Off"/>
    <dip bits="5" name="Unknown (SW:6)" ids="On,Off"/>
    <dip bits="6" name="Free Play" ids="On,Off"/>
    <dip bits="7" name="Unknown (SW:8)" ids="On,Off"/>
    <dip bits="8" name="Unknown (SW:9)" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW:10)" ids="On,Off"/>
    <dip bits="10" name="Unknown (SW:11)" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,3C_1C,2C_1C,3C_2C,2C_3C,1C_3C,1C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="popspops.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 (init_grdnstrm scramble) -->
    <interleave output="16">
      <part crc="17e0c48b" name="afega5.u107" map="01"/>
      <part crc="db191762" name="afega4.u112" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="afega1.u92"/>
    <!-- fgtile, 0x010000 -->
    <part crc="f39dd5d2" name="afega3.u4"/>
    <!-- bgtile, 0x400000 (8bpp: two 4bpp halves); no sprite ROM on this board -->
    <part crc="6d506c97" name="afega6.uc8"/>
    <part crc="02d7f9de" name="afega7.uc3"/>
    <!-- oki1, 0x040000 -->
    <part crc="ecd8eeac" name="afega2.u95"/>
  </rom>
</misterromdescription>
