<misterromdescription>
    <name>Thunder &amp; Lightning (set 1)</name>
    <setname>thunderl</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1990</year>
    <manufacturer>Seta</manufacturer>
    <category>Arcade</category>
    <rotation>vertical</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>00</part></rom>

    <rom index="0" zip="thunderl.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="m4" crc="1e6b9462" map="01"/>
            <part name="m5" crc="7e82793e" map="10"/>
        </interleave>
        <!-- pad to 0x100000 -->
        <part repeat="983040">00</part>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="t17" crc="599a632a" map="01"/>
            <part name="t16" crc="3aeef91c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="t15" crc="b97a7b56" map="01"/>
            <part name="t14" crc="79c707be" map="10"/>
        </interleave>
        <!-- pad to 0x300000 -->
        <part repeat="1572864">00</part>
        <!-- x1snd -->
        <part name="r28" crc="a043615d"/>
        <part name="r27" crc="cb8425a3"/>
    </rom>

    <switches default="E9,FF,EF" base="0">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Flip Screen" bits="1" ids="Off,On"/>
        <dip name="Cabinet" bits="2" ids="Upright,Cocktail"/>
        <dip name="Controls" bits="3" ids="1,2"/>
        <dip name="Demo Sounds" bits="4" ids="On,Off"/>
        <dip name="Lives" bits="5" ids="2,3"/>
        <dip name="Difficulty" bits="6,7" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coin A" bits="8,9,10,11" ids="4 Coins/4 Credits,3 Coins/4 Credits,2 Coins/4 Credits,1 Coin/4 Credits,4 Coins/3 Credits,3 Coins/3 Credits,2 Coins/3 Credits,1 Coin/3 Credits,4 Coins/2 Credits,3 Coins/2 Credits,2 Coins/2 Credits,1 Coin/2 Credits,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="12,13,14,15" ids="4 Coins/4 Credits,3 Coins/4 Credits,2 Coins/4 Credits,1 Coin/4 Credits,4 Coins/3 Credits,3 Coins/3 Credits,2 Coins/3 Credits,1 Coin/3 Credits,4 Coins/2 Credits,3 Coins/2 Credits,2 Coins/2 Credits,1 Coin/2 Credits,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Force 1 Life" bits="20" ids="Off,On"/>
        <dip name="Copyright" bits="21,22,23" ids="None,None,None,None,Romstar,Visco,Seta (Romstar License),Seta (Visco License)"/>
    </switches>

    <buttons names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>
</misterromdescription>
