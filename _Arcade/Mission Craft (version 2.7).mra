<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Mission Craft (version 2.7)</name>
    <setname>misncrft</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Sun</manufacturer>
    <category>Shooter</category>
    <rotation>vertical (cw)</rotation>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>02 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="misncrft.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part repeat="0x80000">00</part>  <!-- maincpu 0x80000 -->
        <part name="prg-rom2.bin" crc="04d22da6"/>
        <!-- qs1000:cpu, once -->
        <part name="snd-rom2.us1" crc="8821e5b9"/>
        <part repeat="0x60000">00</part>  <!-- eeprom -->
        <!-- eeprom: the 93C46's default image -->
        <part name="93c46-eeprom-misncrft" crc="83c813eb"/>
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="snd-rom1.u15" crc="fb381da9"/>
        <part repeat="0x180000">00</part>  <!-- qs1000 0x200000 -->
        <part name="qs1001a.u17" crc="d13c6407"/>
        <part repeat="0x380000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="roml00" crc="748c5ae5" map="0021"/>
            <part name="romh00" crc="f34ae697" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="roml01" crc="e37ece7b" map="0021"/>
            <part name="romh01" crc="71fe4bc3" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
