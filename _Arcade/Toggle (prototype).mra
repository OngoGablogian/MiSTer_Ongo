<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Toggle (prototype)</name>
	<setname>toggle</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1985</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>2</players>

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="toggle.zip|sente6vb.zip" md5="none">
		<part name="tgle-ab0.bin" crc="8c7b7fad"/>
		<part name="tgle-ab1.bin" crc="771e5434"/>
		<part name="tgle-ab2.bin" crc="9b4baa3f"/>
		<part name="tgle-ab3.bin" crc="35308a41"/>
		<part name="tgle-ab4.bin" crc="baf5617b"/>
		<part name="tgle-ab5.bin" crc="88077dad"/>
		<part repeat="0x10000">00</part>
		<part name="tgle-cd.bin" crc="0a2bb949"/>
		<part name="tgle-ef.bin" crc="3ec10804"/>
		<part repeat="0x20000">00</part>
		<part name="tgle-gr0.bin" crc="0e0e5d0e"/>
		<part name="tgle-gr1.bin" crc="3b141ad2"/>
		<part repeat="0xc000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 02 00 01 04 24 09 80 08 28 23 22 20 21 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Shoot,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="FF,7F,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Lives" bits="10" ids="2,3"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
		<dip name="High Scores" bits="7" ids="Keep All,Keep Top 5"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
