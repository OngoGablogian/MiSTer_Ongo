<misterromdescription>
    <name>Salamander 2 (ver JAA)</name>
    <setname>salmndr2</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>12</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 18); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="salmndr2.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="521jaa03.27b" crc="c3be5e0a" map="0012"/>
            <part name="521jaa02.31b" crc="f6c3a95b" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 6-byte row, then the last 2 bytes of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="521-a09.17h" crc="fb9e2f5e"/>  <!-- four-byte part -->
        <part name="521-a11.15h" crc="25e0a6e5"/>  <!-- four-byte part -->
        <part repeat="2446676">00</part>
        <part name="521-a13.13c" crc="3ed7441b"/>  <!-- second part -->
        <part repeat="699050">00</part>
        <!-- k055673: GX6, bytes 0-3 of each half-row, then bytes 4-5 -->
        <part repeat="3145730">00</part>
        <interleave output="32">
            <part name="521-a08.25g" crc="f24f76bd" map="0021"/>
            <part name="521-a07.28g" crc="50ef9b7a" map="2100"/>
        </interleave>
        <part name="521-a06.30g" crc="cba5db2c"/>  <!-- two-byte part -->
        <!-- soundcpu: MAME's region as it is -->
        <part repeat="2097152">00</part>
        <interleave output="16">
            <part name="521-a04.9c" crc="efddca7a" map="01"/>
            <part name="521-a05.7c" crc="51a3af2c" map="10"/>
        </interleave>
        <part repeat="131072">00</part>
        <!-- k054539: MAME's region as it is -->
        <part name="521-a12.9g" crc="66614d3b"/>
        <part name="521-a13.7g" crc="c3322475"/>
        <part repeat="1048576">00</part>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="salmndr2.zip" md5="none">
        <part name="salmndr2.nv" crc="60cdea03"/>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it -->
    <nvram index="4" size="128"/>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="Shot,Option,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>
</misterromdescription>
