<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Puzzle King (PacMan 2, Tetris, HyperMan 2, Snow Bros.)</name>
    <setname>4in1boot</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>2002</year>
    <manufacturer>K1 Soft</manufacturer>
    <category>Compilation</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="A,B,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>27 02 02 02 00 40 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="4in1boot.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="u74" crc="e22d3fa2" map="01"/>
            <part name="u52" crc="71815878" map="10"/>
        </interleave>
        <!-- gfx1 -->
        <part name="u78" crc="6c1fbc9c"/>
        <!-- soundcpu -->
        <part name="u35" crc="c894ac80"/>
        <!-- oki1 -->
        <part name="u14" crc="94b09b0e"/>
        <part repeat="0x2200">00</part>  <!-- image end -->
    </rom>

    <switches default="FE,83,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Difficulty" bits="1,2" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coinage" bits="3,6" ids="4 Coins/4 Credits,4 Coins/3 Credits,4 Coins/2 Credits,4 Coins/1 Credit,3 Coins/4 Credits,3 Coins/3 Credits,3 Coins/2 Credits,3 Coins/1 Credit,2 Coins/4 Credits,2 Coins/3 Credits,2 Coins/2 Credits,2 Coins/1 Credit,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Free Play" bits="7,7" ids="On,Off"/>
        <dip name="Lives" bits="8,9" ids="2,4,1,3"/>
        <dip name="Service Mode" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
