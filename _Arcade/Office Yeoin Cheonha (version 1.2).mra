<!--
  Office Yeoin Cheonha (version 1.2) (Danbi, 2001) - BrezzaSoft Crystal System hardware - MRA for the
  Crystal MiSTer core.

  ROM set: MAME officeye.zip (standalone, with its own BIOS instead of crysbios). Sizes/CRCs verified against
  MAME (c233473382353a00fb2d8b00d98c197cee910854 and 0.289). No ROM data is embedded in this file.
  docs/ROM_LAYOUT.md describes the stream.

  Index 1: board record (16 bytes): "CRYS", version 1, game id 4 (officeye: protection PIC16F84A run by the
           core, three players with Red / Green / Blue buttons), populated flash banks 2.
  Index 2: NVRAM image (zeros, then the saved .nvm).
  Index 3: protection PIC firmware (MAME region "pic", 0x4280 bytes; matched by CRC).
  Index 0: platform ROM stream. 0x0000000-0x1FFFFFF cartridge flash banks 0-1 (flash.u1, flash.u2),
           0x2000000-0x201FFFF BIOS (bios.u14, the BIOS of this board).
-->
<misterromdescription>
    <name>Office Yeoin Cheonha (version 1.2)</name>
    <setname>officeye</setname>
    <rbf>Crystal</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Danbi</manufacturer>
    <players>3</players>
    <joystick>none</joystick>
    <rotation>horizontal</rotation>
    <platform>BrezzaSoft Crystal System</platform>
    <category>Puzzle / Party</category>
    <buttons names="Red,Green,Blue,-,Start,Coin,Service" default="A,B,X,Start,Select,R"/>

    <switches default="FF" base="16">
        <dip bits="0" name="Pause" ids="On,Off"/>
        <dip bits="1" name="Free Play" ids="On,Off"/>
        <dip bits="2" name="Unknown (DSW:3)" ids="On,Off"/>
        <dip bits="3" name="Unknown (DSW:4)" ids="On,Off"/>
        <dip bits="4" name="Unknown (DSW:5)" ids="On,Off"/>
        <dip bits="5" name="Unknown (DSW:6)" ids="On,Off"/>
        <dip bits="6" name="Unknown (DSW:7)" ids="On,Off"/>
        <dip bits="7" name="Test (DSW:8)" ids="On,Off"/>
    </switches>

    <rom index="1">
        <part>
            43 52 59 53 01 04 02 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- NVRAM (64 KiB battery RAM at 0x01400000, MAME nvram format) -->
    <rom index="2">
        <part repeat="0x10000">00</part>
    </rom>
    <nvram index="2" size="65536"/>

    <!-- Protection PIC16F84A firmware: MAME image layout (program, configuration word, EEPROM) -->
    <rom index="3" zip="officeye.zip" md5="none">
        <part name="office_yeo_in_cheon_ha_pic16f84a.bin" crc="7561cdf5"/>
    </rom>

    <rom index="0" zip="officeye.zip" md5="none">
        <!-- FLASH bank 0-1: MAME region "flash" (ROM_REGION32_LE 0x2000000) -->
        <part name="flash.u1" crc="d3f3eec4"/>
        <part name="flash.u2" crc="e4f85d0a"/>
        <!-- BIOS: MAME region "maincpu" (the BIOS of this board) -->
        <part name="bios.u14" crc="ffc57e90"/>
    </rom>
</misterromdescription>
