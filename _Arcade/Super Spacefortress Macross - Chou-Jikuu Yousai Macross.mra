<!--
  Super Spacefortress Macross / Chou-Jikuu Yousai Macross — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 1).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... macross ...)
  line 10730, ROM_START(macross), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Super Spacefortress Macross / Chou-Jikuu Yousai Macross</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>macross</setname>
  <year>1992</year>
  <manufacturer>Banpresto</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="F7,FF,01">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Flip Screen" ids="On,Off"/>
    <dip bits="3" name="Language" ids="English,Japanese"/>
    <dip bits="4,5" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8,11" name="Coin B" ids="5C_3C,2C_1C,3C_2C,1C_4C,4C_1C,1C_6C,2C_5C,1C_2C,4C_3C,1C_7C,3C_1C,1C_3C,3C_4C,1C_5C,2C_3C,1C_1C"/>
    <dip bits="12,15" name="Coin A" ids="Free_Play,2C_1C,3C_2C,1C_4C,4C_1C,1C_6C,2C_5C,1C_2C,4C_3C,1C_7C,3C_1C,1C_3C,3C_4C,1C_5C,2C_3C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="macross.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 (ROM_LOAD16_WORD_SWAP) -->
    <part crc="33318d55" name="921a03"/>
    <!-- NMK004 external program, 0x010000 -->
    <part crc="77c082c7" name="921a02"/>
    <!-- NMK004 internal boot ROM, 0x002000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- NMK-215 protection MCU ROM, 0x002000 (byte-identical to gunnail's) -->
    <part crc="d355a06f" name="nmk-215.bin"/>
    <!-- fgtile, 0x020000 -->
    <part crc="bbd8242d" name="921a01"/>
    <!-- bgtile, 0x200000 (NMK214-scrambled, decoded per fetch) -->
    <part crc="4002e4bb" name="921a04"/>
    <!-- sprites, 0x200000 (ROM_LOAD16_WORD_SWAP, NMK214-scrambled) -->
    <part crc="7d2bf112" name="921a07"/>
    <!-- oki1, 0x080000 -->
    <part crc="d5a1eddd" name="921a05"/>
    <!-- oki2, 0x080000 -->
    <part crc="89461d0f" name="921a06"/>
  </rom>
</misterromdescription>
