        <interleave output="16">
            <part name="ru-21s" crc="b9f91b70" map="01"/>
            <part name="ru-19s" crc="e3953800" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- sprites - starts at 0x100000 - length 0x180000 (21 bits) -->
