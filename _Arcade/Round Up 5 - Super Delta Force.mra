        <dip name="Credit Slot B" bits="11,13" ids="1/1,2/1,1/2,1/3,1/4,1/5,4/1,4/3"/>
        <dip name="Board Diagnostics" bits="15" ids="On,Off"/>
        <IN1/>
        <dip name="Arcade Service" ids="On,Off" bits="16"/>
    </switches>
    <buttons names="Throttle,Brake,Gear,Boost,Start,Coin" default="A,B,X,Y,Start,Select" count="4"/>
