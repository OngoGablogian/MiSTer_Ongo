    <switches page_id="1" page_name="DIP Switches" base="16" default="00,80,ff">
        <DSW/>
        <dip name="Timer Length" bits="0,1" ids="Medium,Long,Short,Shortest"/>
        <dip name="Challenge Level" bits="2,3" ids="Medium,Easy,Hard,Hardest"/>
        <dip name="Attract Audio" bits="4" ids="On,Off"/>
        <dip name="Text Language" bits="5" ids="English,Japanese"/>
        <dip name="Final Stage Continue" bits="6" ids="On,Off"/>
        <dip name="Cabinet Output" bits="7" ids="A,B"/>
