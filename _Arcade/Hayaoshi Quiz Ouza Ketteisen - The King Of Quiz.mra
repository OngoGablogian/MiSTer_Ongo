    <dip bits="4,7" name="Coin B" ids="Free_Play,1C_1C,1C_1C,1C_1C,1C_1C,1C_1C,2C_3C,4C_1C,3C_1C,2C_1C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="8" name="Flip Screen" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10" name="Unknown 2-2" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="13" name="Points To Win" ids="10,15"/>
    <dip bits="14" name="Unknown 2-6" ids="On,Off"/>
    <dip bits="15" name="Unknown 2-7" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="hayaosi1.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000 -->
    <interleave output="16">
      <part crc="eaf38fab" name="5" map="01"/>
      <part crc="341f8057" name="6" map="10"/>
    </interleave>
    <!-- audiocpu 0x040000 @ 0x080000 -->
    <interleave output="16">
      <part crc="b088b27e" name="1" map="01"/>
      <part crc="cebc7b16" name="2" map="10"/>
    </interleave>
    <!-- iomcu 0x004000 @ 0x0C0000 -->
    <!-- mo-91044.mcu: undumped. Omitted; the core uses simulated protection. -->
    <part repeat="0x4000">00</part>
    <!-- scroll1 0x080000 @ 0x0C4000 -->
    <part crc="3629c455" name="7"/>
    <!-- scroll2 0x080000 @ 0x144000 -->
    <part crc="15f0b2a3" name="8"/>
    <!-- scroll3 0x020000 @ 0x1C4000 -->
    <part crc="64d5b95e" name="9"/>
    <!-- sprites 0x080000 @ 0x1E4000 -->
    <part crc="593e93d6" name="10"/>
    <!-- oki1 0x040000 @ 0x264000 -->
    <part crc="f3f5787a" name="3"/>
    <!-- oki2 0x040000 @ 0x2A4000 -->
    <part crc="ac3f9bd2" name="4"/>
  </rom>

  <!-- Priority PROM (512 B). Its own index so it reaches a write
       port on ms1_prio.sv rather than SDRAM, and so that "is any PROM
