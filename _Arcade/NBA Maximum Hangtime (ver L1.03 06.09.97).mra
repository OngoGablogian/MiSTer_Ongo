<!-- NBA Maximum Hangtime runtime profile for the shared Q256 Wolf/DCS master
     core. Maximum Hangtime uses the same graphics, sound, controls, DIP
     layout, and development-528 serial PIC profile as NBA Hangtime; only the
     two program ROMs differ. ROM data is user-supplied and CRC-checked. -->
<misterromdescription>
    <about author="rejectedcoins"/>
    <rotation>horizontal</rotation>
    <name>NBA Maximum Hangtime (ver L1.03 06/09/97)</name>
    <setname>nbamht</setname>
    <mameversion>0280</mameversion>
    <year>1996</year>
    <manufacturer>Midway</manufacturer>
    <players>4</players>
    <rbf>WolfUnit</rbf>
    <region>World</region>

    <!-- Wolf master profile 5: Maximum Hangtime 2P/4P harness and development-528 PIC. -->
    <rom index="3" md5="None"><part>05</part></rom>

    <rom index="0" zip="nbamht.zip|nbahangt.zip" md5="None">
        <part name="mhtu54_v103.bin" crc="21b0d9e1"/>
        <part name="mhtu63_v103.bin" crc="c6fdbb97"/>
    </rom>

    <rom index="1" zip="nbamht.zip|nbahangt.zip" md5="None">
