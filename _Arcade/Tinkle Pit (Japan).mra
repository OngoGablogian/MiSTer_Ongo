<!--
  Tinkle Pit (Japan) - Namco NA-1 - MRA for the Namco_NA1_NA2 MiSTer core.

  One RBF runs every supported title. The board record at rom index 2
  (docs/MRA_FORMAT.md) describes the board; ROM names, CRCs and offsets are
  from MAME 0.289 (`mame -listxml tinklpit`).

  No ROM data is embedded in this file.
-->
<misterromdescription>
    <name>Tinkle Pit (Japan)</name>
    <setname>tinklpit</setname>
    <rbf>Namco_NA1_NA2</rbf>
    <mameversion>0281</mameversion>
    <year>1993</year>
    <manufacturer>Namco</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <region>Japan</region>
    <platform>Namco NA-1</platform>
    <category>Action</category>

    <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="A,B,X,Start,Select"/>
    <!-- First-boot EEPROM: 2 KiB of 00 (an erased part reads FF, which the boot
         code takes as FLIP ON and some titles hang on). A dumped default listed
         after it overrides it; a saved .nvm (below) still wins. -->
    <rom index="1"><part repeat="0x800">00</part></rom>
    <nvram index="1" size="2048"/>

    <!-- board record: C367 (KEYCUS mode 2, the stateful LFSR), ROT0 cabinet, joystick panel -->
    <rom index="2"><part>02 6F 01 07 00 00</part></rom>

    <rom index="0" zip="tinklpit.zip|namcoc69.zip" md5="none">
        <!-- program ROM: stream $000000-$1FFFFF -->
        <interleave output="16">
            <part name="tk1-ep0l.6c" crc="fdccae42" map="01"/>
            <part name="tk1-ep0u.6f" crc="62cdb48c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="tk1-ep1l.7c" crc="7e90f104" map="01"/>
            <part name="tk1-ep1u.7f" crc="9c0b70d6" map="10"/>
        </interleave>
        <!-- mask ROM: stream $200000-$9FFFFF -->
        <interleave output="16">
            <part name="tk1-ma0l.2c" crc="c6b4e15d" map="01"/>
            <part name="tk1-ma0u.2f" crc="a3ad6f67" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="tk1-ma1l.3c" crc="61cfb92a" map="01"/>
            <part name="tk1-ma1u.3f" crc="54b77816" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="tk1-ma2l.4c" crc="087311d2" map="01"/>
            <part name="tk1-ma2u.4f" crc="5ce20c2c" map="10"/>
        </interleave>
        <!-- unpopulated tail: 00 fill, exactly as ROMREGION_ERASE00 -->
        <part repeat="0x200000">00</part>
        <!-- MCU BIOS: stream $A00000-$A03FFF -> the M37702 internal ROM, not SDRAM -->
        <part name="c69.bin" crc="349134d9"/>
    </rom>
</misterromdescription>
