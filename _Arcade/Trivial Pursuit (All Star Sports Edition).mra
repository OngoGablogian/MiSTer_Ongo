<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Trivial Pursuit (All Star Sports Edition)</name>
	<setname>triviasp</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1984</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>1</players>

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="triviasp.zip|sente6vb.zip" md5="none">
		<part name="allsport.u8a" crc="54b7ff31"/>
		<part name="allsport.u7a" crc="59fae9d2"/>
		<part name="allsport.u6a" crc="237b6b95"/>
		<part name="allsport.u5a" crc="b64d7f61"/>
		<part repeat="0x8000">00</part>
		<part name="allsport.u2a" crc="e45d09d6"/>
		<part name="allsport.u1a" crc="8bb3e831"/>
		<part repeat="0x20000">00</part>
		<part name="allsport.u6b" crc="6829de8e"/>
		<part name="allsport.u5b" crc="89398700"/>
		<part name="allsport.u4b" crc="7415a7fc"/>
		<part repeat="0x4000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>3F 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 03 02 00 01 04 FF 09 80 08 28 0C 0D 05 04 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Green,Red,-,-,Start,Coin,Service,Pause,Start 3,Start 4" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="9F,77,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Guesses" bits="10,11" ids="3,4,5,6"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
		<dip name="Sound" bits="5" ids="On,Off"/>
		<dip name="Sound Test" bits="6" ids="On,Off"/>
		<dip name="High Scores" bits="7" ids="Keep Top 5,Keep Top 10"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
