<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Hidden Catch 2 (pcb ver 3.03) (Kor/Eng) (AT89c52 protected)</name>
    <setname>hidctch2</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Mark,-,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,Start,Select,L,R" count="1"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="hidctch2.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00" crc="c6b1bc84" map="0012"/>
            <part name="01" crc="5a1c1ab3" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02" crc="3f7815aa" map="0012"/>
            <part name="03" crc="d686c59b" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04" crc="d35cb515" map="0012"/>
            <part name="05" crc="7870e5c6" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06" crc="10184a21" map="0012"/>
            <part name="07" crc="b6c4879f" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08" crc="670204d1" map="0012"/>
            <part name="09" crc="28c0f55c" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10" crc="45f374f4" map="0012"/>
            <part name="11" crc="cac54db3" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12" crc="66e681ff" map="0012"/>
            <part name="13" crc="14bd38a9" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14" crc="8eb1b01b" map="0012"/>
            <part name="15" crc="3b06fe4e" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="u43" crc="326d1dbc"/>
        <!-- qs1000:cpu -->
        <part name="u107" crc="89450a2f"/>
        <!-- soundcpu -->
        <part name="hc2.103" crc="92797034"/>
        <part repeat="0x77800">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="u97" crc="a7a1627e"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="u108" crc="75fc7a65"/>
        <patch offset="0x200BCC8">03 00</patch>  <!-- patch_mcu_protection(0xbcc8) -->
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Show Counters" bits="1" ids="On,Off"/>
        <dip name="Skip ROM DATA Check" bits="3" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
