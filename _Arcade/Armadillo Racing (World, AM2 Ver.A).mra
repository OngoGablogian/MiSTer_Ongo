			<part name="am2vera.rom3" crc="80e9435a" map="0001"/>
			<part name="am2vera.rom4" crc="1e3a6032" map="0010"/>
		</interleave>
		<part name="am1data.8k" crc="3c176589"/>
		<part name="c71.bin" crc="47c623ab"/><!-- namcoc71.zip: C71 (TMS320C25) internal ROM -->
