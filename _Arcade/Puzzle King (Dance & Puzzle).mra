<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Puzzle King (Dance &amp; Puzzle)</name>
    <setname>puzzlekg</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="puzzlekg.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="u10.bin" crc="c9c3064b" map="0012"/>
            <part name="u1.bin" crc="6b4b369d" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u11.bin" crc="92615236" map="0012"/>
            <part name="u2.bin" crc="e76bbd1d" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u14.bin" crc="f5aa39d1" map="0012"/>
            <part name="u5.bin" crc="88bb70cf" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u15.bin" crc="bcc1f74d" map="0012"/>
            <part name="u6.bin" crc="ab2248ff" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u12.bin" crc="1794973d" map="0012"/>
            <part name="u3.bin" crc="0980e877" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u13.bin" crc="31de6d19" map="0012"/>
            <part name="u4.bin" crc="2706f23c" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u16.bin" crc="c2d09171" map="0012"/>
            <part name="u7.bin" crc="52405e69" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="u17.bin" crc="234b7261" map="0012"/>
            <part name="u8.bin" crc="8f4e50d7" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="u43.bin" crc="c3db7424"/>
        <!-- qs1000:cpu -->
        <part name="u107.bin" crc="f3add818"/>
        <!-- soundcpu -->
        <part name="u111.bin" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="u97.bin" crc="f4604ce8"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="u108.bin" crc="e4555c6b"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="0,1,2,3" ids="On,-,-,-,-,-,-,-,-,-,-,-,-,-,-,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
