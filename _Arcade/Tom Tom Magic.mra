<!--
  Tom Tom Magic — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 51).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... tomagic ...)
  line 10778, ROM_START(tomagic), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Tom Tom Magic</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tomagic</setname>
  <year>1997</year>
  <manufacturer>Hobbitron T.K.Trading Co. Ltd.</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,33">
    <dip bits="0" name="Unknown (SW1:1)" ids="On,Off"/>
    <dip bits="1" name="Unknown (SW1:2)" ids="On,Off"/>
    <dip bits="2" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="3" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="4" name="Demo Sounds" ids="Off,On"/>
    <dip bits="5,7" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="8" name="Unknown (SW2:1)" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW2:2)" ids="On,Off"/>
    <dip bits="10" name="Unknown (SW2:3)" ids="On,Off"/>
    <dip bits="11" name="Unknown (SW2:4)" ids="On,Off"/>
    <dip bits="12" name="Unknown (SW2:5)" ids="On,Off"/>
    <dip bits="13" name="Unknown (SW2:6)" ids="On,Off"/>
    <dip bits="14,15" name="Balls" ids="5,2,4,3"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="tomagic.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 -->
    <interleave output="16">
      <part crc="3731ecbb" name="3.bin" map="01"/>
      <part crc="5055664a" name="4.bin" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x020000 (0000-7FFF fixed, 8000-BFFF = one of eight 0x4000 banks) -->
    <part crc="10359b6a" name="2.bin"/>
    <!-- fgtile, 0x020000 -->
    <part crc="fcceb24b" name="9.bin"/>
    <!-- bgtile, 0x080000 -->
    <part crc="14ef466c" name="10.bin"/>
    <!-- sprites, 0x200000 (two ROM_LOAD16_BYTE pairs; every byte's bits reversed per fetch: init_tomagic) -->
    <interleave output="16">
      <part crc="1708d3fb" name="8.bin" map="01"/>
      <part crc="83ae90ba" name="6.bin" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="0a297c78" name="7.bin" map="01"/>
      <part crc="88ef65e0" name="5.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x040000 (3 MHz, unbanked, on the 68000 bus at 0x094001/3) -->
    <part crc="02b042e3" name="1.bin"/>
  </rom>
</misterromdescription>
