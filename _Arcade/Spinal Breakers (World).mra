        <dip name="Service Mode" bits="13" ids="On,Off"/>
        <dip name="Health Pack" bits="14" ids="40 Hitpoints,32 Hitpoints"/>
        <dip name="Life Restoration" bits="15" ids="5 Points,10 Points"/>
