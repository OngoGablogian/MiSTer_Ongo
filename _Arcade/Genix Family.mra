<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME pirates.cpp; the layout is
         rtl/np_rom_map.svh. Do not edit by hand. -->
    <name>Genix Family</name>
    <setname>genix</setname>
    <rbf>NixPirates</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>NIX</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Button A,Button B,Special,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- the board has no DIPs; bit 0 is the core's own flip (rtl/np_video.sv) -->
    <switches default="00" base="0">
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>

    <!-- mod byte (rtl/np_rom_map.svh): [0] 0 pirates protection patch, 1 genix -->
    <rom index="1"><part>01</part></rom>

    <rom index="0" zip="genix.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="11.u15.15c" crc="d26abfb0" map="01"/>
            <part name="12.u16.16c" crc="a14a25b4" map="10"/>
        </interleave>
        <!-- tiles -->
        <part name="17.u34.12g" crc="58da8aac"/>
        <part repeat="0x40000">00</part>  <!-- tiles 0x80000 -->
        <part name="19.u35.12h" crc="96bad9a8"/>
        <part repeat="0x40000">00</part>  <!-- tiles 0x100000 -->
        <part name="18.u48.13g" crc="0ddc58b6"/>
        <part repeat="0x40000">00</part>  <!-- tiles 0x180000 -->
        <part name="20.u49.13h" crc="2be308c5"/>
        <part repeat="0x40000">00</part>  <!-- sprites start -->
        <!-- sprites -->
        <part name="16.u69.6g" crc="b8422af7"/>
        <part repeat="0x40000">00</part>  <!-- sprites 0x80000 -->
        <part name="15.u70.4g" crc="e46125c5"/>
        <part repeat="0x40000">00</part>  <!-- sprites 0x100000 -->
        <part name="14.u71.3g" crc="7a8ed21b"/>
        <part repeat="0x40000">00</part>  <!-- sprites 0x180000 -->
        <part name="13.u72.1g" crc="f78bd6ca"/>
        <part repeat="0x40000">00</part>  <!-- oki start -->
        <!-- oki -->
        <part name="10.u31.1b" crc="80d087bc"/>
    </rom>

    <!-- the 93C46, which holds the game's score table -->
    <nvram index="2" size="128"/>
</misterromdescription>
