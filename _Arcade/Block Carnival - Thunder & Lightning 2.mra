<misterromdescription>
    <name>Block Carnival / Thunder &amp; Lightning 2</name>
    <setname>blockcar</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Visco</manufacturer>
    <category>Arcade</category>
    <rotation>vertical</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>03</part></rom>

    <rom index="0" zip="blockcar.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="u1.a1" crc="4313fb00" map="01"/>
            <part name="u4.a3" crc="2237196d" map="10"/>
        </interleave>
        <!-- pad to 0x100000 -->
        <part repeat="786432">00</part>
        <!-- gfx1 -->
        <part name="bl-chr-0.u6.j3" crc="a33300ca"/>
        <part name="bl-chr-1.u9.l3" crc="563de808"/>
        <!-- pad to 0x300000 -->
        <part repeat="1048576">00</part>
        <!-- x1snd -->
        <part name="bl-snd-0.u39.a13" crc="9c2130a2"/>
    </rom>

    <switches default="FF,FF,EF" base="0">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Demo Sounds" bits="2" ids="Off,On"/>
        <dip name="Unknown 1-3" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="6,7" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Bonus Life" bits="10,11" ids="30K/Every 90K,20K/Every 70K,30K/Every 60K,20K/Every 50K"/>
        <dip name="Lives" bits="12,13" ids="1,4,3,2"/>
        <dip name="Free Play" bits="15" ids="On,Off"/>
        <dip name="Title" bits="20" ids="Block Carnival,Thunder &amp; Lightning 2"/>
    </switches>

    <buttons names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>
</misterromdescription>
