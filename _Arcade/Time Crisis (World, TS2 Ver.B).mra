<misterromdescription>
	<name>Time Crisis (World, TS2 Ver.B)</name>
	<setname>timecris</setname>
	<rbf>XNSUPER22</rbf>
	<mameversion>0287</mameversion>
	<year>1996</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System Super 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout, GENERATED by tools/gen_mra.py from
	  ROM_START(timecris) in src/mame/namco/namcos22.cpp (MAME 0.287).
	  Stream layout = canonical Prop Cycle.mra SS22 slots; regions larger
	  than a canonical slot extend it (marked below), shifting later slots.

	    0x0000000   4.00M  maincpu     68EC020 program, 32-bit BE interleave
	    0x0400000   0.50M  mcu         M37710 data ROM (SS22 BIOS + SEQ data)
	    0x0480000   0.01M  c71         C71 DSP internal ROM (namcoc71), then pad
	    0x0500000  12.00M  sprite      32x32x8bpp sprite tiles [slot extended to 0xC00000]
	    0x1100000  14.00M  textile     16x16x8bpp texture tiles
	    0x2100000   2.50M  textilemap  CCR-L + CCR-H
	    0x2380000   4.50M  pointrom    3D models, L/M/U 24-bit planes
	    0x2900000  10.00M  c352        samples (true region offsets, gaps padded, tail truncated; verified vs MAME region 2026-09-12)

	  Lightgun game: gun X/Y arrive via the M37710 ADC path (bring-up rung).
	-->

