<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Snacks'n Jaxson</name>
	<setname>snakjack</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1984</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>1</players>
	<!-- Analog: P1 trackball_y, P1 trackball_x reversed. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="snakjack.zip|sente6vb.zip" md5="none">
		<part name="rom-ab0.u9a" crc="da2dd119"/>
		<part name="rom-ab1.u8a" crc="657ddf26"/>
		<part name="rom-ab2.u7a" crc="15333dcf"/>
		<part name="rom-ab3.u6a" crc="57671f6f"/>
		<part name="rom-ab4.u5a" crc="c16c5dc0"/>
		<part name="rom-ab5.u4a" crc="d7019747"/>
		<part repeat="0x10000">00</part>
		<part name="rom-cd.u3a" crc="7b44ca4c"/>
		<part name="rom-ef.u1a" crc="f5309b38"/>
		<part repeat="0x20000">00</part>
		<part name="rom-gr0.u9b" crc="3e64b5d5"/>
		<part name="rom-gr1.u8b" crc="b3b8baee"/>
		<part name="rom-gr2.u7b" crc="e9d89dac"/>
		<part name="rom-gr3.u6b" crc="b6602be8"/>
		<part name="rom-gr4.u5b" crc="3fbfa686"/>
		<part name="rom-gr5.u4b" crc="345f94fb"/>
		<part repeat="0x4000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 00 00 00 10 88 01 00 00 00 00 00 00 00 00 00 FF FF FF FF FF FF 09 80 08 28 04 FF FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Sneeze,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="FF,75,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Bonus Life" bits="8,9" ids="Every 15000,Every 20000,Every 25000,Every 30000"/>
		<dip name="Lives" bits="10,11" ids="2,3,4,5"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
		<dip name="High Scores" bits="7" ids="Keep All,Keep Top 5"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
