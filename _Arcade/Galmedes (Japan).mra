<misterromdescription>
    <rbf>Galmedes_bazset</rbf>
    <name>Galmedes (Japan)</name>
    <setname>galmedes</setname>
    <year>1992</year>
    <manufacturer>Visco</manufacturer>
    <players>2</players>
    <joystick>8way</joystick>
    <rotation>vertical (ccw)</rotation>
    <region>Japan</region>

    <rom index="0" zip="galmedes.zip" type="merged" md5="none">
        <!-- 68000 program ROMs at 0x000000-0x03ffff. -->
        <interleave output="16">
            <part name="gm-prg1.ic23" crc="32a70753" map="01"/>
            <part name="gm-prg0.ic8" crc="fae546a4" map="10"/>
        </interleave>
        <!-- Real board has no ROM at 0x040000-0x07ffff. -->
        <part repeat="0x40000">00</part>
        <!-- 68000 mask ROM mapped at CPU 0x080000. -->
        <part name="gm-30.ic30" crc="4da2a407"/>
        <!-- Z80 program, TC0100SCN tiles and PC090OJ sprites. -->
        <part name="gm-snd.ic27" crc="d6f56c21"/>
        <part name="gm-scn.ic3" crc="3bab0581"/>
        <part name="gm-obj.ic6" crc="7a4a1315"/>
    </rom>

    <!-- MAME hiscore.dat: 1031a0/4c -->
    <nvram index="2" size="76"/>

    <switches default="f7,fb" base="16">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="A:2C/3C B:4C/1C,A:2C/1C B:3C/1C,A:1C/2C B:2C/1C,1C/1C"/>
        <dip name="Coin B" bits="6,7" ids="A:2C/3C B:1C/6C,A:2C/1C B:1C/4C,A:1C/2C B:1C/3C,A:1C/1C B:1C/2C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="Every 200k,150k and every 200k,Every 100k,100k and every 200k"/>
        <dip name="Lives" bits="12,13" ids="4,2,1,3"/>
        <dip name="Coin Mode" bits="15" ids="Mode B (World),Mode A (Japan)"/>
    </switches>
    <buttons names="Fire,Weapon,Start 1P,Start 2P,Coin,Service,Pause,Autofire"
             default="A,B,Start,Select,R,L,X,Y" count="8"/>
</misterromdescription>


