<?xml version="1.0" encoding="UTF-8"?>
<!-- BAZSET CORE â€” CORE BY bazset -->
<!-- RBF FILE: bazset_Scion.rbf -->
<!-- REQUIRED ROM ZIP FILE(S): scion.zip -->
<!-- B01 PREBUILD SOURCE ONLY â€” no compiled or tested Scion RBF yet. ROM-free. -->
<misterromdescription>
  <!-- Scion MRA14 V4 authoring for future MRA-driven pause/OSD.
       BZM1 receiver/consumer and real RBF/hardware test are not complete. -->
  <bazset_runtime version="1">
    <pause>
      <title>Scion</title>
      <build>B02 AUDIO PREBUILD - NOT RELEASED</build>
      <core_by>bazset</core_by>
      <patreon>patreon.com/c/bazset</patreon>
      <x>x.com/bazset_</x>
      <beta_testers>No verified beta testers yet</beta_testers>
      <patreon_supporters>Alexander Facchini | Groquik | BabaYaga326 | Curt Dittmer | Alessandro Gulli | RGM | JamieCRT | AlfEightyOne | Scott Dexter</patreon_supporters>
      <special_thanks>MAME hardware researchers</special_thanks>
      <bug_prompt>FOUND A BUG? REPORT IT ON MY PATREON</bug_prompt>
    </pause>
    <osd>
      <visibility>Video Settings,Game Settings,DIP Switches,Credits,Reset</visibility>
      <defaults>Aspect=Original;Rotation=Normal;CRT Adjust=Off;CRT H-Position=0;CRT V-Shift=0;CRT H-Size=0;CRT V-Size=0;Background Hiss=Reduced</defaults>
    </osd>
    <pause_style>
      <colors background="#080B18" card="#101522" border="#D9A441"
          text="#F0E9D7" dim="#71798A" accent="#5DE4FF"/>
      <layout preset="compact"/>
      <marquee frames="12"/>
    </pause_style>
  </bazset_runtime>

<name>Scion</name><setname>scion</setname><mameversion>0289</mameversion>
<!-- MAME official ROT0. CW and CCW are optional core Video Settings; default Normal. -->
<region>Region unspecified (MAME parent)</region>
<year>1984</year><manufacturer>Seibu Denshi</manufacturer><category>Arcade</category>
<players>2</players><rbf>bazset_Scion</rbf><joystick>8</joystick>
<buttons names="Shoot,Bomb,Coin,Start 1P,Start 2P" default="A,B,Select,Start,R" count="2"/>
<switches page_id="1" page_name="DIP Switches" base="16" default="05,00">
<dip name="Cabinet" bits="0" ids="Cocktail,Upright"/>
<dip name="Difficulty" bits="1" ids="Easy,Hard"/>
<dip name="Lives" bits="2,3" ids="2,3,4,5"/>
<dip name="Bonus Life" bits="4,5" ids="20K 40K,20K 80K,20K 60K,30K 90K"/>
<dip name="Coin A" bits="8,9,10" ids="1C 1C,2C 1C,1C 3C,4C 1C,1C 2C,3C 1C,1C 5C,5C 1C"/>
<dip name="Coin B" bits="11,12" ids="1C 1C,2C 1C,1C 2C,3C 1C"/>
</switches>
