<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>jjparad2</setname>
	<name>Jan Jan Paradise 2</name>
	<rotation>horizontal</rotation>
	<year>1997</year>
	<manufacturer>Electro Design</manufacturer>
	<buttons names="Button 1,Button 2,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="jjparad2.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="79a7e3d7" name="jp210000.u21" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="42415e0c" name="jp210100.u20" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="26731745" name="jp210200.u8" map="12345678" />
		</interleave>
		<part repeat="0x400000">00</part>

		<interleave output="64">
			<part crc="d0e71873" name="jp220000.u17" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="4c7d964d" name="jp220100.u9" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="73e30d7f" name="jp230000.u1" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<interleave output="64">
			<part crc="7e2b836c" name="sknsj1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="5d75e765" name="jp2000j1.u6" map="13570" />
			<part crc="1771910a" name="jp2001j1.u4" map="1357" />
		</interleave>
		<part repeat="0x100000">00</part>
	</rom>
	<rom index="2" md5="" >
		<part>10 4A 00 00 05 00</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>