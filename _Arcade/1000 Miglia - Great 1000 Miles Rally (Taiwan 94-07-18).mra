<?xml version='1.0' encoding='utf-8'?>
<misterromdescription>
  <bazset_runtime version="1">
    <pause>
      <title>1000 MIGLIA // PAUSED</title>
      <build>BAZSET b01 | V3.3 | MRA14</build>
      <core_by>bazset</core_by>
      <patreon>patreon.com/c/bazset</patreon>
      <x>x.com/bazset_</x>
      <beta_testers>No registered beta testers yet</beta_testers>
      <patreon_supporters>Alexander Facchini | Groquik | BabaYaga326 | Curt Dittmer | Alessandro Gulli | RGM | JamieCRT | AlfEightyOne | Scott Dexter</patreon_supporters>
      <special_thanks>Meathax | PixelCherryNinja</special_thanks>
      <bug_prompt>BUGS? REPORT ON MY PATREON</bug_prompt>
    </pause>
    <osd>
      <visibility>CRT H Position=show | CRT V Position=show</visibility>
      <defaults>CRT H Position=0 | CRT V Position=0</defaults>
    </osd>
    <pause_style>
      <colors background="#080B18" card="#101522" border="#D9A441" text="#F0E9D7" dim="#71798A" accent="#5DE4FF"/>
      <layout preset="compact"/>
      <marquee frames="12"/>
    </pause_style>
  </bazset_runtime>
  <name>1000 Miglia: Great 1000 Miles Rally (Taiwan 94/07/18)</name>
  <setname>gtmr</setname>
  <rbf>bazset_KanekoFamily</rbf>
  <year>1994</year>
  <manufacturer>Kaneko</manufacturer>
  <category>Arcade</category>
  <switches page_id="1" page_name="DIP Switches" base="16" default="ff">
    <dip name="Flip Screen" bits="1" ids="On,Off"/>
    <dip name="Cabinet" bits="2" ids="Cocktail,Upright"/>
    <dip name="Controller" bits="3" ids="Wheel,Joystick"/>
    <dip name="Controls" bits="4" ids="Both Sides / 270 degree wheel,1P Side / 360 degree wheel"/>
    <dip name="Use Brake" bits="5" ids="Off,On"/>
    <dip name="National Anthem &amp; Flag" bits="6,7" ids="None,Flag Only,Anthem Only,Use Memory"/>
  </switches>
  <buttons names="Brake,Accelerate,Start,Coin,Pause,-,-" default="Y,B,Start,Select,L,-,-"/>
  <nvram index="2" size="550"/>
  <rom index="0" zip="gtmr.zip" md5="none">
    <interleave output="16">
      <part name="u2.bin" crc="031799f7" map="01"/>
      <part name="u1.bin" crc="6238790a" map="10"/>
    </interleave>
    <part name="mm-300-406-a0.bin" crc="b15f6b7f"/>
    <part name="mm-300-406-a0.bin" crc="b15f6b7f"/>
    <part name="mm-200-402-s0.bin" crc="c0ab3efc"/>
    <part name="mm-201-403-s1.bin" crc="cf6b23dc"/>
    <part name="mm-202-404-s2.bin" crc="8f27f5d3"/>
    <part name="mm-203-405-s3.bin" crc="e9747c8c"/>
    <part repeat="0x1800"></part>
    <interleave output="16">
      <part name="mms0x2.u29.bin" crc="bd22b7d2" map="01"/>
      <part name="mms1x2.u30.bin" crc="b42b426f" map="10"/>
    </interleave>
    <part repeat="0x1">0000</part>
    <part repeat="0x15bff"></part>
    <part repeat="0x1"></part>
    <part name="mm-100-401-e0.bin" crc="b9cbfbee"/>
    <part repeat="0x2000"></part>
    <part repeat="0x3000"></part>
    <part name="mmd0x2.u124.bin" crc="3d7cb329"/>
  </rom>
  <romstruct>ROM size 0x02920000 (41.125 MiB). CPU 1 MiB, VIEW2 A/B 2 MiB each, KC002 sprites 30 MiB, OKI1/OKI2 3 MiB each, TOYBOX raw 128 KiB. Reconstructed on MiSTer directly from standard MAME ZIPs, with no synthetic ROM archive.</romstruct>
