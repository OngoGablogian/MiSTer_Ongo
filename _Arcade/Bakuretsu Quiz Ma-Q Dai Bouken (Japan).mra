<!--
  Bakuretsu Quiz Ma-Q Dai Bouken (Japan) - Namco NA-1 - MRA for the Namco_NA1_NA2 MiSTer core.

  One RBF runs every supported title. The board record at rom index 2
  (docs/MRA_FORMAT.md) describes the board; ROM names, CRCs and offsets are
  from MAME 0.289 (`mame -listxml bkrtmaq`).

  Quiz cabinet: four answer buttons + Start, no joystick.

  No ROM data is embedded in this file.
-->
<misterromdescription>
    <name>Bakuretsu Quiz Ma-Q Dai Bouken (Japan)</name>
    <setname>bkrtmaq</setname>
    <rbf>Namco_NA1_NA2</rbf>
    <mameversion>0281</mameversion>
    <year>1992</year>
    <manufacturer>Namco</manufacturer>
    <players>2</players>
    <joystick>none</joystick>
    <region>Japan</region>
    <platform>Namco NA-1</platform>
    <category>Quiz</category>

    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Credit" default="A,B,X,Y,Start,Select"/>
    <!-- First-boot EEPROM: 2 KiB of 00 (an erased part reads FF, which the boot
         code takes as FLIP ON and some titles hang on). A dumped default listed
         after it overrides it; a saved .nvm (below) still wins. -->
    <rom index="1"><part repeat="0x800">00</part></rom>
    <nvram index="1" size="2048"/>

    <!-- board record: C348, ROT0 cabinet, 4-button quiz panel -->
    <rom index="2"><part>01 5C 01 02 00 01</part></rom>

    <rom index="0" zip="bkrtmaq.zip|namcoc69.zip" md5="none">
        <!-- program ROM: stream $000000-$1FFFFF -->
        <interleave output="16">
            <part name="mq1-ep0l.bin" crc="f029bc57" map="01"/>
            <part name="mq1-ep0u.bin" crc="4cff62b8" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mq1-ep1l.bin" crc="e3be6f4b" map="01"/>
            <part name="mq1-ep1u.bin" crc="b44e31b2" map="10"/>
        </interleave>
        <!-- mask ROM: stream $200000-$9FFFFF -->
        <interleave output="16">
            <part name="mq1-ma0l.bin" crc="11fed35f" map="01"/>
            <part name="mq1-ma0u.bin" crc="23442ac0" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mq1-ma1l.bin" crc="fe82205f" map="01"/>
            <part name="mq1-ma1u.bin" crc="0cdb6bd0" map="10"/>
        </interleave>
        <!-- unpopulated tail: 00 fill, exactly as ROMREGION_ERASE00 -->
        <part repeat="0x400000">00</part>
        <!-- MCU BIOS: stream $A00000-$A03FFF -> the M37702 internal ROM, not SDRAM -->
        <part name="c69.bin" crc="349134d9"/>
    </rom>
</misterromdescription>
