<!-- Mortal Kombat (rev 5.5) Wolf Unit hack by Asure & Creeping1, running on the UMK3 core.
     ROM data is user-supplied and CRC-checked; none is distributed by this project.
     Note: DCS sound is deferred in this core — no audio yet. -->
<misterromdescription>
    <about author="Asure"/>
    <rotation>horizontal</rotation>
    <name>Mortal Kombat (rev 5.5) (Wolf Unit)</name>
    <setname>mk_wolf</setname>
    <mameversion>0287</mameversion>
    <year>1992</year>
    <manufacturer>Midway / Hack by Asure &amp; Creeping1</manufacturer>
    <players>2</players>
    <rbf>WolfUnit</rbf>
    <region>World</region>

    <rom index="0" zip="mk_wolf.zip" md5="None">
        <part name="mk321u54.bin" crc="33DC55EB"/>
        <part name="mk321u63.bin" crc="7957744F"/>
    </rom>

    <!-- GFX from mk3.zip: 20 ROMs. u133-u130 and u129-u122 are MK1-specific;
         u121-u114 fill the lower block (MK1 wolf uses u117-u114 where UMK3 uses u113-u110). -->
