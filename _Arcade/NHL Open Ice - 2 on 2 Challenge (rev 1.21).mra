<!-- NHL Open Ice dedicated profile for the shared cabinet-confirmed Wolf/DCS
     master core. Runtime profile 0 selects the exact four-player controls,
     development-528 PIC response, and Open Ice DSW layout (Test=bit15,
     Cabinet=bit12). The stock revision-1.21 program ROMs are intentional;
     the core supplies security, so an any-U64 bypass patch is unnecessary.
     ROM data is user-supplied and CRC-checked. -->
<misterromdescription>
    <about author="rejectedcoins"/>
    <rotation>horizontal</rotation>
    <name>NHL Open Ice: 2 on 2 Challenge (rev 1.21)</name>
    <setname>openice</setname>
    <mameversion>0280</mameversion>
    <year>1995</year>
    <manufacturer>Midway</manufacturer>
    <players>4</players>
    <rbf>WolfUnit</rbf>
    <region>World</region>

    <!-- Wolf master profile 0: Open Ice 2P/4P harness and development-528 PIC. -->
    <rom index="3" md5="None"><part>00</part></rom>

    <rom index="0" zip="openice.zip" md5="None">
        <part name="open_ice_l1.21.u54" crc="e4225284"/>
        <part name="open_ice_l1.21.u63" crc="97d308a3"/>
    </rom>

    <rom index="1" zip="openice.zip" md5="None">
