<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Suhoseong (Korea)</name>
    <setname>suhosong</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Casino</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="High,Low,Hit / Double Up,Stand / Take,Bet / Raise,-,Start,Coin,Pause" default="A,B,X,Y,L,Start,Select,R" count="5"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 30 00 00 00 30 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="suhosong.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="su_ho_sung.ui12" crc="79a4806e" map="01"/>
            <part name="su_ho_sung.uh12" crc="6bd8bd08" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="su_ho_sung.ua4" crc="bc83a944"/>
        <part name="su_ho_sung.ua5" crc="a1907ea4"/>
        <part name="su_ho_sung.ua6" crc="92fea02c"/>
        <part repeat="0x80000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="su_ho_sung.u1" crc="509ce74e"/>
        <!-- oki1 -->
        <part name="su_ho_sung.uj15" crc="266fcae8"/>
        <part repeat="0x2000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="4478e251"/>
    </rom>

    <switches default="80,00,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
