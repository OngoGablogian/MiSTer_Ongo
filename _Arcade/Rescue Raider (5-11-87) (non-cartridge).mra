<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Rescue Raider (5/11/87) (non-cartridge)</name>
	<setname>rescraid</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1987</year>
	<manufacturer>Bally Midway</manufacturer>
	<rotation>horizontal</rotation>
	<players>1</players>

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="rescraid.zip|sente6vb.zip" md5="none">
		<part name="ab 1.a10" crc="33a76b47"/>
		<part name="ab 12.a12" crc="7c7a9f12"/>
		<part name="cd 8.a16" crc="90917a43"/>
		<part name="cd 12.a18" crc="0450e9d7"/>
		<part repeat="0x20000">00</part>
		<part name="gr 0.a5" crc="e0dfc133"/>
		<part name="gr 4.a7" crc="952ade30"/>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>3F 00 00 00 00 00 00 04 00 00 00 00 00 00 00 00 03 02 00 01 04 FF 09 80 08 28 11 10 0E 0F 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Select Weapons,-,-,-,Start,Coin,Service,Pause,-,-,R Right,R Left,R Down,R Up" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="00,77,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Lives" bits="8" ids="4,5"/>
		<dip name="Minimum Game Time" bits="10,11" ids="90,60,45,120"/>
		<dip name="Unknown" bits="12" ids="On,Off"/>
		<dip name="Unknown" bits="13" ids="On,Off"/>
		<dip name="Keep High Scores" bits="14" ids="Yes,No"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit"/>
		<dip name="Bonus Coins" bits="2,4" ids="None,2 Coins=1 Bonus,3 Coins=1 Bonus,4 Coins=1 Bonus,4 Coins=2 Bonus,5 Coins=1 Bonus,5 Coins=2 Bonus,5 Coins=3 Bonus"/>
		<dip name="Left Coin Mech" bits="5" ids="x1,x2"/>
		<dip name="Right Coin Mech" bits="6,7" ids="x1,x4,x5,x6"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
