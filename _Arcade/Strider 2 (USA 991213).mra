<misterromdescription>
	<name>Strider 2 (USA 991213)</name>
	<setname>strider2u</setname>
	<year>1999</year>
	<manufacturer>Capcom</manufacturer>
	<category>Platform</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<rbf>ZN2Capcom</rbf>

	<!-- idx0 BIOS coh3002c -->
	<rom index="0" zip="coh3002c.zip" md5="none"><part name="m534002c-59.ic353" crc="e860ea8b"/></rom>
	<!-- idx1 platform byte 15 (Capcom+2MB-VRAM) -->
	<rom index="1"><part>15</part></rom>
	<!-- idx2 countryrom (Strider 2 program ROM, 512KB) -->
	<rom index="2" zip="strider2u.zip|strider2.zip" md5="none"><part name="hr2u_04.2h" crc="b28b01c6"/></rom>
	<!-- idx3 bankedroms -->
	<rom index="3" zip="strider2u.zip|strider2.zip" md5="none">
		<part name="hr2-05m.3h" crc="18716fe8"/>
		<part name="hr2-06m.4h" crc="6f13b69c"/>
		<part name="hr2-07m.5h" crc="3925701b"/>
		<part name="hr2-08m.2k" crc="d844c0dc"/>
		<part name="hr2-09m.3k" crc="cdd43e6b"/>
		<part name="hr2-10m.4k" crc="d95b3f37"/>
	</rom>
	<!-- idx4 mobo CAT702 key cp10 -->
	<rom index="4" zip="coh3002c.zip" md5="none"><part name="cp10.ic652" crc="7808fcef"/></rom>
	<!-- idx5 game CAT702 key cp13 -->
	<rom index="5" zip="strider2u.zip|strider2.zip" md5="none"><part name="cp13" crc="606edf50"/></rom>
	<!-- idx6 Z80 -->
	<rom index="6" zip="strider2u.zip|strider2.zip" md5="none">
		<part name="hr2_02.2e" crc="acd8d385"/>
	</rom>
	<!-- idx7 QSound samples: 2MB mirrored to 4MB (ROM_RELOAD) -->
	<rom index="7" zip="strider2u.zip|strider2.zip" md5="none">
		<part name="hr2-01m.3a" crc="510a16d1"/>
		<part name="hr2-01m.3a" crc="510a16d1"/>
	</rom>
	<!-- idx8 DSP microcode -->
	<rom index="8" zip="qsound_hle.zip" md5="none"><part name="dl-1425.bin" crc="d6cf5ef5"/></rom>

	<nvram index="9" size="2048"/>
	<switches base="96" default="00">
		<dip name="Service Mode" bits="1" ids="Off,On"/>
	</switches>
	<buttons names="Attack,Jump,Dash,-,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,L3" count="3"/>
</misterromdescription>
