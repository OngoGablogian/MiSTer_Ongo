<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Linky Pipe</name>
    <setname>linkypip</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="linkypip.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="lp00.u39" crc="c1e71bbc" map="0012"/>
            <part name="lp01.u34" crc="30780c08" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="lp02.u40" crc="3381bd2c" map="0012"/>
            <part name="lp03.u35" crc="459008f3" map="1200"/>
        </interleave>
        <part repeat="0x1000000">00</part>  <!-- maindata end -->
        <!-- maincpu -->
        <part name="u43.bin" crc="9ef937de"/>
        <!-- qs1000:cpu -->
        <part name="u107.bin" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="u111.bin" crc="52f419ea"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="u97.bin" crc="4465fe8d"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="u108.bin" crc="ca65856f"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Don't Touch" bits="0,1" ids="Fail (0),Fail (1),Fail (2),Working (3)"/>
        <dip name="Coinage" bits="2,3" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Unknown" bits="4" ids="On,Off"/>
        <dip name="Unknown" bits="5" ids="On,Off"/>
        <dip name="Unknown" bits="6" ids="On,Off"/>
        <dip name="Unknown" bits="7" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
