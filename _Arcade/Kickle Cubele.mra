<!--
BAZSET Kickle Cubicle / Kickle Cubele bootleg (Irem M77 hardware).
BAZSET core adaptation, game-specific repairs and Patreon release.
Original FPGA foundation and JTFRAME/JT51 copyright Jose Tejada Gomez
(Jotego) and other jtcores contributors. Original source GPL licenses
and copyright notices retained; see CREDITS_AND_SOURCE.txt.
MAME bootleg ROM set kikcubicb (parent kikcubic), no ROM redistribution.
-->
<misterromdescription>
    <about author="BAZSET (based on Jotego FPGA source)" webpage="https://patreon.com/c/bazset" source="https://github.com/jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Kickle Cubele</name>
    <setname>kikcubicb</setname>
    <mameversion>0289</mameversion>
    <year>1988</year>
    <manufacturer>bootleg</manufacturer>
    <players>2</players>
    <rbf>bazset_kickle</rbf>
    <joystick>4</joystick>
    <rom index="0" zip="kikcubicb.zip|kikcubic.zip" md5="None">
        <!-- maincpu - starts at 0x0 - length 0x30000 (18 bits) -->
        <part name="1.bin" crc="d3a589ba"/>
        <part name="4.bin" crc="9ae1e1a6"/>
        <!-- 5.bin is 32 KB and MAME reloads it to fill the 64 KB bank -->
        <part name="5.bin" crc="a5a6bffd"/>
        <part name="5.bin" crc="a5a6bffd"/>
        <part repeat="0x8000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- soundcpu - starts at 0x30000 - length 0x10000 (16 bits) -->
        <part name="mqj_a-sp-.ic34" crc="bbcf3582"/>
        <!-- PCM_START -->
        <!-- m72 - starts at 0x40000 - length 0x10000 (16 bits) -->
        <part name="mqj_a-v0-.ic31" crc="54762956"/>
        <!-- JTFRAME_BA2_START -->
        <!-- chars - starts at 0x50000 - length 0x20000 (17 bits) -->
        <interleave output="16">
            <part name="7.bin" crc="1788d51a" map="01"/>
            <part name="mqj_a-c1-.ic72" crc="49d9936d" map="10"/>
        </interleave>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x70000 - length 0x80000 (19 bits) -->
        <!-- bootleg sprite ROMs are 64 KB each and repeated twice (MAME ROM_RELOAD) -->
        <interleave output="16">
            <part name="11.bin" crc="0f0cac92" map="01"/>
            <part name="9.bin" crc="56fb4fa3" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="10.bin" crc="7d3822a8" map="01"/>
            <part name="8.bin" crc="947dbd4e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="11.bin" crc="0f0cac92" map="01"/>
            <part name="9.bin" crc="56fb4fa3" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="10.bin" crc="7d3822a8" map="01"/>
            <part name="8.bin" crc="947dbd4e" map="10"/>
        </interleave>
        <!-- Total 0xF0000 bytes - 960 kBytes -->
    </rom>
    <nvram index="2" size="203"/>
    <rom index="1">
        <part>00 59</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,d5">
        <DSW1/>
        <dip name="Difficulty" bits="0,1" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Lives" bits="2,3" ids="4,2,1,3"/>
        <DSW2/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
        <dip name="Coin Mode" bits="10" ids="Mode 2,Mode 1"/>
        <dip name="Demo Sounds" bits="11" ids="On,Off"/>
        <dip name="Cheat" bits="12" ids="On,Off"/>
        <dip name="Level Select" bits="13" ids="On,Off"/>
        <dip name="Player Adding" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="Button 1, Button 2,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
