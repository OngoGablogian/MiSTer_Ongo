<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Boong-Ga Boong-Ga (Spank'em!)</name>
    <setname>boonggab</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Taff System</manufacturer>
    <category>Arcade</category>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Light Hit,Medium Hit,Hard Hit,Max Hit,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>64 05</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="boonggab.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part name="1.rom1" crc="50522da1"/>
        <part name="2.rom0" crc="3395541b"/>
        <part repeat="0x80000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- oki1 samples -->
        <part name="3.vrom1" crc="0696bfcb"/>
        <part name="4.vrom2" crc="305c2b16"/>
        <part repeat="0x500000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <interleave output="32">
            <part name="boong-ga.roml00" crc="18be5f92" map="0021"/>
            <part name="boong-ga.romu00" crc="0158ba9e" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="boong-ga.roml05" crc="76d60553" map="0021"/>
            <part name="boong-ga.romu05" crc="35ee8fb5" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="boong-ga.roml01" crc="636e9d5d" map="0021"/>
            <part name="boong-ga.romu01" crc="b8dcf6b7" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="boong-ga.roml06" crc="8dc521b7" map="0021"/>
            <part name="boong-ga.romu06" crc="f6b83270" map="2100"/>
        </interleave>
        <part repeat="0x800000">00</part>  <!-- gfx from 16 MB, at SD_GFXHI -->
        <interleave output="32">
            <part name="boong-ga.roml02" crc="d0661c69" map="0021"/>
            <part name="boong-ga.romu02" crc="eac01eb8" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="boong-ga.roml07" crc="3301813a" map="0021"/>
            <part name="boong-ga.romu07" crc="3f1c3682" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="boong-ga.roml03" crc="4d4260b3" map="0021"/>
            <part name="boong-ga.romu03" crc="4ba00032" map="2100"/>
        </interleave>
        <part repeat="0x400000">00</part>  <!-- gfx region past its last ROM -->
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
