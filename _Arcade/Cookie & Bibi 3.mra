<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Cookie &amp; Bibi 3</name>
    <setname>cookbib3</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Fire,Special,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8F 12 2A 2A 00 30 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="cookbib3.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="u74.bin" crc="c4ab8435" map="01"/>
            <part name="u52.bin" crc="65134893" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="u75.bin" crc="cbe4d9c8"/>
        <part name="u76.bin" crc="1be17b57"/>
        <part name="u77.bin" crc="7823600d"/>
        <part repeat="0x80000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="u35.bin" crc="5dfd2a98" offset="0xC000" length="0x4000"/>
        <part name="u35.bin" crc="5dfd2a98" offset="0x8000" length="0x4000"/>
        <part name="u35.bin" crc="5dfd2a98" offset="0x4000" length="0x4000"/>
        <part name="u35.bin" crc="5dfd2a98" offset="0x0" length="0x4000"/>
        <!-- oki1 -->
        <part name="u14.bin" crc="e5bf9288"/>
        <part repeat="0x22000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="c819b9a8"/>
    </rom>

    <switches default="FE,80,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Coinage" bits="1,3" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="4,6" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <dip name="Free Play" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
