<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Final Tetris</name>
    <setname>finalttr</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Jeil Computer System</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Rotate,Rotate Back,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>8D 41 00 00 00 20 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="finalttr.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="10.7o" crc="eecc83e5" map="01"/>
            <part name="9.5o" crc="58d3640e" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="5.1d" crc="64a450f3"/>
        <part name="6.1f" crc="7281a3cc"/>
        <part name="7.1g" crc="ec80f442"/>
        <part name="9.1h" crc="2ebd316d"/>
        <part repeat="0x100000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="12.5r" crc="4bc21361"/>
        <!-- oki1 -->
        <part name="11.7p" crc="2e331022"/>
        <part repeat="0x22000">00</part>  <!-- protdata at 0x352000 -->
        <!-- protdata -->
        <part name="protdata.bin" crc="d5bbb006"/>
    </rom>

    <switches default="FF,FF,00">
        <dip name="Demo Sounds" bits="0,0" ids="Off,On"/>
        <dip name="Unknown" bits="1,1" ids="On,Off"/>
        <dip name="Unknown" bits="2,2" ids="On,Off"/>
        <dip name="Coinage" bits="3,5" ids="4 Coins/1 Credit,1 Coin/4 Credits,3 Coins/1 Credit,-,2 Coins/3 Credits,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Unknown" bits="6,6" ids="On,Off"/>
        <dip name="Unknown" bits="7,7" ids="On,Off"/>
        <dip name="Unknown" bits="8,8" ids="On,Off"/>
        <dip name="Unknown" bits="9,9" ids="On,Off"/>
        <dip name="Time" bits="10,11" ids="60 Seconds,150 Seconds,120 Seconds,90 Seconds"/>
        <dip name="Unknown" bits="12,12" ids="On,Off"/>
        <dip name="Unknown" bits="13,13" ids="On,Off"/>
        <dip name="Unknown" bits="14,14" ids="On,Off"/>
        <dip name="Unknown" bits="15,15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
