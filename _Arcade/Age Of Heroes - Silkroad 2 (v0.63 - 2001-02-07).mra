<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Age Of Heroes - Silkroad 2 (v0.63 - 2001/02/07)</name>
    <setname>aoh</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Unico</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>71 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="aoh.zip" md5="none" address="0x30000000">
        <part repeat="0x100000">00</part>  <!-- maincpu end -->
        <part repeat="0x80000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- oki1 samples -->
        <part name="rom3" crc="db8cb455"/>
        <part repeat="0x40000">00</part>  <!-- oki2 -->
        <!-- oki2 samples -->
        <part name="rom4" crc="bba47755"/>
        <!-- maincpu: ROM_LOAD16_WORD_SWAP, 0xffc00000 on -->
        <interleave output="16">
            <part name="rom1" crc="2e55ff55" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="rom2" crc="50f8a409" map="12"/>
        </interleave>
        <!-- gfx: ROM_LOAD32_WORD pairs -->
        <part repeat="0x1900000">00</part>  <!-- gfx -->
        <interleave output="32">
            <part name="g09" crc="c359febb" map="0021"/>
            <part name="g05" crc="64c8f493" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="g10" crc="08217573" map="0021"/>
            <part name="g06" crc="ffbc9fe5" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="g11" crc="5f0461b8" map="0021"/>
            <part name="g07" crc="5cb3c86a" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="g12" crc="e437b35f" map="0021"/>
            <part name="g08" crc="1fd08aa0" map="2100"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
