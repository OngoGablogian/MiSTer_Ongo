<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Cookie &amp; Bibi 2 (English, set 1)</name>
    <setname>cookbib2</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Fire,Special,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>4F 18 00 00 00 28 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="cookbib2.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="unico_01.ui12" crc="65aafde2" map="01"/>
            <part name="unico_02.uh12" crc="b2909460" map="10"/>
        </interleave>
        <part repeat="0x80000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="unico_05.ua4" crc="89fb38ce"/>
        <part name="unico_04.ua5" crc="f240111f"/>
        <part name="unico_03.ua6" crc="e1604821"/>
        <part repeat="0xC0000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="unico_07.u1" crc="f59f1c9a"/>
        <!-- oki1 -->
        <part name="unico_06.uj15" crc="5e6f76b8"/>
        <part repeat="0x20000">00</part>  <!-- protection at 0x350000 -->
        <!-- protection -->
        <part name="p87c52ebpn.bin" crc="ef042cef"/>
        <part repeat="0x200">00</part>  <!-- image end -->
    </rom>

    <switches default="FE,00,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Max Vs Round" bits="1,1" ids="1,3"/>
        <dip name="Coinage" bits="2,4" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="5,6" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
