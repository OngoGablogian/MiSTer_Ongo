<misterromdescription>
  <name>Guardians / Denjin Makai II (P-FG01-1 PCB)</name>
  <mratimestamp>202608280000</mratimestamp>
  <mameversion>0287</mameversion>
  <setname>grdians</setname>
  <year>1995</year>
  <manufacturer>Winkysoft (Banpresto license)</manufacturer>
  <rbf>Guardians</rbf>
  <about author="kandowontu and OpenAI Codex" webpage="https://github.com/kandowontu/Arcade-Guardians_MiSTer" />
  <buttons names="Attack,Jump,Special,Pause,Start,Coin,Service" default="A,B,X,Y,Start,Select,R" />
  <switches default="ff,ff" base="8">
    <dip bits="0,1" name="Difficulty" ids="Hardest,Hard,Easy,Normal" />
    <dip bits="2" name="Bonus Life" ids="500000,300000" />
    <dip bits="3" name="Title" ids="Denjin Makai II,Guardians" />
    <dip bits="4,5" name="Lives" ids="4,3,1,2" />
    <dip bits="6" name="Service Mode" ids="On,Off" />
    <dip bits="7" name="Demo Sounds" ids="Off,On" />
    <dip bits="8,9,10,11" name="Coin A" ids="Free Play,4C/3C,4C/1C,3C/4C,3C/2C,3C/1C,2C/5C,2C/3C,2C/1C,1C/7C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C" />
    <dip bits="12,13,14,15" name="Coin B" ids="Free Play,4C/3C,4C/1C,3C/4C,3C/2C,3C/1C,2C/5C,2C/3C,2C/1C,1C/7C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C" />
  </switches>
  <rom index="0" zip="grdians.zip" md5="None">
    <!-- 2 MiB TMP68301 program, byte-interleaved big-endian. -->
    <interleave output="16">
      <part name="u2.bin" crc="36adc6f2" map="01" />
      <part name="u3.bin" crc="2704f416" map="10" />
    </interleave>
    <interleave output="16">
      <part name="u4.bin" crc="bb52447b" map="01" />
      <part name="u5.bin" crc="9c164a3b" map="10" />
    </interleave>

    <!-- 32 MiB DX-101 graphics region in its native 64-bit ROM-bus order. -->
    <interleave output="64">
      <part name="u16.bin" crc="6a65f265" map="00000021" />
      <part name="u15.bin" crc="01672dcd" map="00002100" />
      <part name="u18.bin" crc="967babf4" map="00210000" />
      <part name="u17.bin" crc="0fad0629" map="21000000" />
    </interleave>
    <interleave output="64">
      <part name="u20.bin" crc="a7226ab7" offset="0x200000" length="0x200000" map="00000021" />
      <part name="u19.bin" crc="c0c998a0" offset="0x200000" length="0x200000" map="00002100" />
      <part name="u22.bin" crc="6239997a" offset="0x200000" length="0x200000" map="00210000" />
      <part name="u21.bin" crc="6f95e466" offset="0x200000" length="0x200000" map="21000000" />
    </interleave>
    <interleave output="64">
      <part name="u20.bin" crc="a7226ab7" offset="0" length="0x200000" map="00000021" />
      <part name="u19.bin" crc="c0c998a0" offset="0" length="0x200000" map="00002100" />
      <part name="u22.bin" crc="6239997a" offset="0" length="0x200000" map="00210000" />
      <part name="u21.bin" crc="6f95e466" offset="0" length="0x200000" map="21000000" />
    </interleave>

    <!-- 1 MiB X1-010 PCM sample ROM. -->
    <part name="u32.bin" crc="cf0f3017" />
  </rom>
</misterromdescription>
