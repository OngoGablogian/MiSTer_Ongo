<!--
  Many Block — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 54).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... manybloc ...)
  line 10775, ROM_START(manybloc), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Many Block</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>manybloc</setname>
  <year>1991</year>
  <manufacturer>Bee-Oh</manufacturer>
  <category>Puzzle</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp. MiSTer matches this tag as TEXT, not as a
       number: mra_loader.cpp does strncasecmp(text, "vertical", 8), so the
       numeric form this file used to carry left is_vertical false and a
       tate cabinet never picked up MiSTer.ini's [arcade_vertical] section.
       The direction is explicit because MiSTer falls back to CW when none
       is given, and ROT270 turns counter-clockwise to stand upright (the
       core's own rotate_ccw=1 case). -->
  <rotation>vertical (ccw)</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="08,00,36">
    <dip bits="0" name="Slot System" ids="Off,On"/>
    <dip bits="1" name="Explanation" ids="English,Japanese"/>
    <dip bits="2" name="Demo Sounds" ids="On,Off"/>
    <dip bits="3" name="Cabinet" ids="Cocktail,Upright"/>
    <dip bits="4" name="Test Mode" ids="Off,On"/>
    <dip bits="5,6" name="Difficulty" ids="Normal,Hard,Hardest,Easy"/>
    <dip bits="7" name="Flip Screen" ids="Off,On"/>
    <dip bits="8,10" name="Coin A" ids="1C_1C,1C_2C,1C_3C,1C_4C,2C_1C,3C_1C,4C_1C,5C_1C"/>
    <dip bits="11,13" name="Coin B" ids="1C_1C,1C_2C,1C_3C,1C_4C,2C_1C,3C_1C,4C_1C,5C_1C"/>
    <dip bits="14,15" name="Plate Probability" ids="Normal,Better,Best,Bad"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="manybloc.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="07473154" name="1-u33.bin" map="01"/>
      <part crc="04acd8c1" name="2-u35.bin" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="7bf5fafa" name="3-u146.bin"/>
    <!-- fgtile, 0x010000 -->
    <part crc="413b5438" name="12-u39.bin"/>
    <!-- bgtile, 0x080000 (2 files) -->
    <part crc="536699e6" name="5-u97.bin"/>
    <part crc="28af2640" name="4-u96.bin"/>
    <!-- sprites, 0x080000 (two ROM_LOAD16_BYTE pairs) -->
    <interleave output="16">
      <part crc="9eab216f" name="10-u86b.bin" map="01"/>
      <part crc="03eede77" name="8-u54b.bin" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="fe747dd5" name="11-u85b.bin" map="01"/>
      <part crc="dfcfa040" name="9-u53b.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 (fixed 0x20000 = the first quarter of 6-u131.bin; banks 0-2 are the rest) -->
    <part crc="79a4ae75" name="6-u131.bin"/>
    <part crc="21db875e" name="7-u132.bin"/>
    <!-- oki2, 0x080000 (ROM_REGION ERASE00 — the chip is fitted but has no samples) -->
    <part repeat="0x80000">00</part>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for manybloc, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F 00 50 00 04 00 19
        00 0F 00 54 00 9C 00 00
        00 0F 03 B2 00 06 00 00
    </part>
  </rom>
  <nvram index="4" size="166"/>
</misterromdescription>
