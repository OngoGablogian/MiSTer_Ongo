<!--
  S.S. Mission — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 52).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... ssmissin ...)
  line 10801, ROM_START(ssmissin), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>S.S. Mission</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>ssmissin</setname>
  <year>1992</year>
  <manufacturer>Comad</manufacturer>
  <category>Shooter</category>
  <rbf>kuze_NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp. MiSTer matches this tag as TEXT, not as a
       number: mra_loader.cpp does strncasecmp(text, "vertical", 8), so the
       numeric form this file used to carry left is_vertical false and a
       tate cabinet never picked up MiSTer.ini's [arcade_vertical] section.
       The direction is explicit because MiSTer falls back to CW when none
       is given, and ROT270 turns counter-clockwise to stand upright (the
       core's own rotate_ccw=1 case). -->
  <rotation>vertical (ccw)</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,34">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Unused (SW1:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="ssmissin.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="eda61b74" name="ssm14.165" map="01"/>
      <part crc="aff15927" name="ssm15.166" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x008000 -->
    <part crc="8be6dce3" name="ssm11.188"/>
    <!-- fgtile, 0x020000 -->
    <part crc="5cf6eb1f" name="ssm16.172"/>
    <!-- bgtile, 0x100000 (2 files) -->
    <part crc="c9c28455" name="ssm17.147"/>
    <part crc="ebfdaad6" name="ssm18.148"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="a0c16c4d" name="ssm20.34" map="01"/>
      <part crc="b1943657" name="ssm19.33" map="10"/>
    </interleave>
    <!-- oki1, 0x0A0000 (fixed 0x20000 = ssm13.190, banked = ssm12.189's own 4 quarters) -->
    <part crc="618f66f0" name="ssm13.190"/>
    <part crc="e8219c83" name="ssm12.189"/>
  </rom>

  <!-- nmk_irq:vtiming -->
  <rom index="1" zip="ssmissin.zip|nmk004.zip" md5="none">
    <part crc="ed0bd072" name="ssm-pr1.114"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for ssmissin, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0B 91 00 00 C0 00 6F
    </part>
  </rom>
  <nvram index="4" size="192"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0B 90 03 00 00 63 00 00 00 00 00 00
        01 00 0B 7A 2D 00 00 02 00 00 00 00 00 00
        01 00 0B 7B 2D 00 00 02 00 00 00 00 00 00
        01 00 0B 7A 29 00 00 06 00 00 00 00 00 00
        01 00 0B 7B 29 00 00 06 00 00 00 00 00 00
        01 00 0B 7A 2F 00 00 08 00 00 00 00 00 00
        01 00 0B 7B 2F 00 00 08 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
