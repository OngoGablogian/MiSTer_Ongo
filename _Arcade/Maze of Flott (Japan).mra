<misterromdescription>
    <rbf>MazeOfFlott_bazset</rbf>
    <name>Maze of Flott (Japan)</name>
    <setname>mofflott</setname>
    <year>1989</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>8way</joystick>
    <rotation>vertical (ccw)</rotation>
    <region>Japan</region>

    <rom index="0" zip="mofflott.zip" type="merged" md5="none">
        <!-- 68000: 0x000000-0x03ffff -->
        <interleave output="16">
            <part name="c17-09.bin" crc="05ee110f" map="01"/>
            <part name="c17-08.bin" crc="d0aacffd" map="10"/>
        </interleave>
        <!-- Unpopulated 0x040000-0x07ffff program space. -->
        <part repeat="0x40000">00</part>
        <!-- 68000 mask ROM at 0x080000; raw word order, no byte swap. -->
        <part name="c17-03.bin" crc="27047fc3"/>

        <!-- Z80 sound program. -->
        <part name="c17-07.bin" crc="cdb7bc2c"/>

        <!-- TC0100SCN tiles. -->
        <part name="c17-01.bin" crc="e9466d42"/>

        <!-- PC090OJ sprites: 0x80000 mask ROM + 0x20000 interleaved EPROM pair. -->
        <part name="c17-02.bin" crc="8860a8db"/>
        <interleave output="16">
            <part name="c17-04.bin" crc="f4250410" map="01"/>
            <part name="c17-05.bin" crc="57ac4741" map="10"/>
        </interleave>

        <!-- MSM5205 ADPCM sample ROM. -->
        <part name="c17-06.bin" crc="5c332125"/>
    </rom>
    <nvram index="2" size="117"/>

    <switches default="fe,ff" base="16">
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="6,7" ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10,11" ids="None,100k Only,50k and Every 100k,20k and Every 50k"/>
        <dip name="Lives" bits="12,13" ids="2,4,5,3"/>
        <dip name="Invulnerability" bits="14" ids="On,Off"/>
        <dip name="Number of Keys" bits="15" ids="B 14,A 16"/>
    </switches>

    <buttons names="Button 1,Button 2,Start 1P,Start 2P,Coin,Service,Pause"
             default="A,B,Start,Select,R,L,X" count="7"/>
</misterromdescription>

