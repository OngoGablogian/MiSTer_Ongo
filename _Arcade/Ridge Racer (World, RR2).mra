<misterromdescription>
	<name>Ridge Racer (World, RR2)</name>
	<setname>ridgeraca</setname>
	<rbf>XNSYSTEM22</rbf>
	<mameversion>0287</mameversion>
	<year>1993</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout. Offsets are what the core's ROM loader decodes;
	  parts load in FILE ORDER and base offsets ADD (§6). Derived from
	  ROM_START(ridgerac) in src/mame/namco/namcos22.cpp and the S22 map
	  namcos22_am (see docs/s22_plan.md).

	    0x0000000  2.0M  maincpu     68020 program, 32-bit BE interleave
	    0x0200000  0.5M  sounddata   rr1data.6r (C74 external SEQ/data ROM)
	    0x0280000  16K   c74         C74 (M37702) internal mask ROM, namcoc74
	    0x0284000  8K    c71         C71 (TMS320C25) internal ROM, namcoc71

	  M1 SCOPE: the loader consumes only the 2 MB maincpu region for first
	  boot (signature word 0x13FC0000 @ reset PC 0x00009C74, reset SSP
	  0xFBFF0000). sounddata / c74 / c71 are placed for the C74+DSP rungs;
	  texture (rr1cg0-3), textilemap (rr1ccr*), pointrom (rr1pot*), c352
	  wave (rr1wav0-3) and gamma PROMs (rr1gam.*) are appended when those
	  subsystems are wired (a later rung), same as the Prop Cycle loader
	  started maincpu-only. NB: System 22 has NO sprite/VICS region.
	-->

	<rom index="0" zip="ridgeraca.zip|ridgerac.zip|namcoc74.zip|namcoc71.zip" md5="none">

		<!-- 0x0000000 maincpu 2 MB. ROM_LOAD32_BYTE offsets 3,2,1,0:
		     .4d(llb)=byte3(LSB) .2d(lmb)=byte2 .8d(umb)=byte1
		     .6d(uub)=byte0(MSB) of each 32-bit big-endian word. Same lane
		     mapping proven correct on the Prop Cycle interleave. -->
		<interleave output="32">
			<!-- 2026-08-25: halfword groups exchanged to match the 2026-08-23 MiSTer
			     main's 16-bit emission order for output="32" (hw-verified: vectors
			     byte-exact, CPU boots and runs; the old maps pair-swapped every word,
			     which sum-based image checks can NEVER detect) -->
			<part name="rr2_prgll.4d" crc="4bb7fc86" map="0100"/>
			<part name="rr2_prglm.2d" crc="68e13830" map="1000"/>
			<part name="rr2_prgum.8d" crc="705ef78a" map="0001"/>
			<part name="rr2_prguu.6d" crc="a79e456f" map="0010"/>
		</interleave>

		<!-- 0x0200000 C74 external sound/SEQ data 0.5 MB -->
		<part name="rr1data.6r" crc="18f5f748"/>

		<!-- 0x0280000 C74 internal mask ROM 16 KB, from namcoc74.zip -->
		<part name="c74.bin" crc="a3dce360"/>

		<!-- 0x0284000 C71 DSP internal ROM 8 KB, from namcoc71.zip -->
		<part name="c71.bin" crc="47c623ab"/>

		<!-- 0x0286000 point ROM 3 MB (R5): 3 planes L/M/U, 2 files each (0x80000 B).
		     pointrom[i] = signed24(U[i]<<16 | M[i]<<8 | L[i]), i=0..0xFFFFF.
		     Loaded linearly to SDRAM (word base SYS22_SD_POINT = 0x400000; region
		     byte b -> SDRAM word 0x400000 + b/2, byte-lane b&1):
		       L-plane (l0,l1): region 0x000000-0x0FFFFF -> SDRAM 0x400000-0x47FFFF
		       M-plane (m0,m1): region 0x100000-0x1FFFFF -> SDRAM 0x480000-0x4FFFFF
		       U-plane (u0,u1): region 0x200000-0x2FFFFF -> SDRAM 0x500000-0x57FFFF
		     So byte L[i]/M[i]/U[i] = SDRAM word {0x400000/0x480000/0x500000}+i/2, lane i&1. -->
		<!-- Stage-2 remap: each plane padded 1MB->2MB so L/M/U land at word
		     0x400000/0x500000/0x600000 (0x100000/plane), matching Rave's native
		     2MB planes with one fixed loader. RR point index < 0x100000 so the
		     pad (words 0x480000+/0x580000+/0x680000+) is never read. -->
		<part name="rr1potl0.5b" crc="3ac193e3"/>
		<part name="rr1potl1.4b" crc="ac3ffba5"/>
		<part repeat="0x100000">00</part>
		<part name="rr1potm0.5c" crc="42a3fa08"/>
		<part name="rr1potm1.4c" crc="1bc1ea7b"/>
		<part repeat="0x100000">00</part>
		<part name="rr1potu0.5d" crc="5e367f72"/>
		<part name="rr1potu1.4d" crc="31d92475"/>
		<part repeat="0x100000">00</part>

		<!-- 0x0586000 R7-tex: texture tile ROM 8MB (rr1cg0-3), 16x16x8bpp linear.
		     Loaded to SDRAM word 0x600000 (= MAME textile region byte 0x800000,
		     tiles 0x8000-0xFFFF). Texel byte B = tile*256+iy*16+ix (B>=0x800000);
		     SDRAM word = 0x600000 + (B-0x800000)/2, lane B&1. -->
		<part name="rr1cg0.bin" crc="b557a795"/>
		<part name="rr1cg1.bin" crc="0fa212d9"/>
		<part name="rr1cg2.bin" crc="18e2d2bd"/>
		<part name="rr1cg3.bin" crc="9564488b"/>
		<!-- 64MB map: textile region is now 16MB (word 0x1000000, holds Rave/victlap's
		     full 16MB). Ridge Racer has only 8MB (cg0-3); pad the upper 8MB so the
		     tilemap/attr/wave land at the fixed stream offsets 0x1886000/0x1A86000/0x1B06000
		     (danceyes model). RR's tiles are fixup-forced to 0x8000+ and texfetch's -0x8000
		     rebase maps them to the region START, so cg0-3 in the low half is correct. -->
		<part repeat="0x800000">00</part>
		<!-- 0x1886000 texture tilemap LO 2MB (rr1ccrl): u16 LE tile# per entry,
		     0x100000 entries -> SDRAM word 0xA00000 (entry e = word 0xA00000+e). -->
		<part name="rr1ccrl.bin" crc="6092d181"/>
		<!-- 0x0F86000 texture tilemap ATTR 0.5MB (rr1ccrh): packed nibbles, 2/byte
		     -> SDRAM word 0xB00000 (byte e/2 = word 0xB00000+e/4, nibble select). -->
		<part name="rr1ccrh.bin" crc="dd332fd5"/>
		<!-- 0x1006000 AUDIO C352 wave ROM 4MB (rr1wav0-3) -> SDRAM word 0xC00000.
		     MAME "c352" region interleave: wav0@0, wav2@0x100000, wav1@0x200000,
		     wav3@0x300000 -> append in that ORDER (wav0, wav2, wav1, wav3) so the
		     linear region matches. See docs/audio_port_plan.md. -->
		<part name="rr1wav0.10r" crc="a8e85bde"/>
		<part name="rr1wav2.10n" crc="3244cb59"/>
		<part name="rr1wav1.10p" crc="35f47c8e"/>
		<part name="rr1wav3.10l" crc="c4cda1a7"/>
	</rom>
	

	<!-- Per-game texture config (index 1, bit0): 1 = Ridge Racer (RR-class) high-half tile
	     fixup+rebase; cg0-3 loads at the textile region start (low 8 MB). -->
	<!-- B_NOROM (2026-09-13): gamma PROMs (MAME "gamma_proms", identical 3 x 256 B) -> the core's R/G/B gamma
	     LUTs (index 2). They used to be baked into the rbf; the bitstream now ships no Namco data. -->
	<rom index="2" zip="ridgeraca.zip|ridgerac.zip|namcoc74.zip|namcoc71.zip" md5="none">
		<part name="rr1gam.2d" crc="b2161bce"/>
		<part name="rr1gam.3d" crc="b2161bce"/>
		<part name="rr1gam.4d" crc="b2161bce"/>
	</rom>
	<rom index="1"><part>01 00 00 00</part></rom>

	<!-- EEPROM default (HN58C65, 8 KB) preloaded via the MRA on download index 8.
	     Ridge Racer ships NO factory eeprom in its romset, so this is the
	     synthesized valid image (magic "V133" @ device 0x410 + 8 calibration
	     sub-records) the game requires to skip "EEPROM NG" and boot past RAMTEST.
	     Device byte order: byte 2w -> eeprom_h[w] (even lane), 2w+1 -> eeprom_l[w].
	     Loaded into the HN58C65 BRAM by sys22_cpu (EEPROM_INDEX=8). -->
	<rom index="8">
