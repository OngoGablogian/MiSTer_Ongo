<misterromdescription>
	<name>Alpine Surfer (World, AF2 Ver.A)</name>
	<setname>alpines</setname>
	<rbf>XNSUPER22</rbf>
	<mameversion>0287</mameversion>
	<year>1996</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System Super 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout = the FIXED slots of rtl/s22_top.sv s22_romload
	  (re-laid by tools/ss22_relayout.py; verify: tools/mra_slotcheck.py + sim/slotmap).

	    0x0000000   4.00M  maincpu     68EC020 program, 32-bit BE interleave (region 0x000000-0x3FFFFF)
	    0x0400000   0.50M  mcu         M37710 data ROM (SS22 BIOS + SEQ data)
	    0x0480000   0.01M  c71         C71 DSP internal ROM (namcoc71), then pad
	    0x0500000   2.00M  sprite      32x32x8bpp sprite tiles (slot 12M)
	    0x1100000  10.00M  textile     16x16x8bpp texture tiles (slot 16M)
	    0x2100000   2.00M  ccrl        texture tilemap LO (slot 2M)
	    0x2300000   0.50M  ccrh        texture tilemap ATTR (slot 0.5M)
	    0x2380000   1.00M  point L     plane L (0x100000 per plane)
	    0x2580000   1.00M  point M     plane M (0x100000 per plane)
	    0x2780000   1.00M  point U     plane U (0x100000 per plane)
	    0x2900000   4.00M  c352        samples (true region offsets, gaps padded, tail truncated)
	    0x3580000   4.00M  maincpu+    program region 0x400000-0x7FFFFF (PROGX window -> SDRAM word 0xE00000)
	    0x3980000         end


	  maincpu is 8 MB of distinct code: 0x000000-0x1FFFFF fixed, 0x200000-0x3FFFFF banked
	  (alpines_am, namcos22.cpp:1933-1938; MAME attract writes banks 1 and 3->2 ~9.5k times
	  in 40 s). Region 0x400000-0x7FFFFF (file bytes 0x100000+) rides in the PROGX slot.
	-->

	<rom index="0" zip="alpines.zip|namcoc71.zip" md5="none">
		<interleave output="32">
			<!-- region byte o -> stream lane o^1 (halfword-exchange, hw-proven on ridgerac 2026-08-25) -->
			<part name="af2ver-a_ll.ic2" crc="e776159d" length="0x100000" map="0100"/>
			<part name="af2ver-a_lm.ic3" crc="c5333d38" length="0x100000" map="1000"/>
			<part name="af2ver-a_um.ic4" crc="c9095af3" length="0x100000" map="0001"/>
			<part name="af2ver-a_uu.ic5" crc="54ee33a1" length="0x100000" map="0010"/>
		</interleave>
		<part name="af1data.8k" crc="ef13ebe8"/>
		<part name="c71.bin" crc="47c623ab"/><!-- namcoc71.zip: C71 (TMS320C25) internal ROM -->
		<part repeat="0x7E000">00</part>
		<part name="af1scg0b.12f" crc="46a6222a"/>
		<part repeat="0xA00000">00</part>
		<part name="af1cg0.8d" crc="7423f3ff"/>
		<part name="af1cg1.10d" crc="ea76689a"/>
		<part name="af1cg2.12d" crc="2a38943a"/>
		<part name="af1cg3.13d" crc="7f5a3e0f"/>
		<part name="af1cg4.14d" crc="a5ee13e2"/>
		<part repeat="0x600000">00</part>
		<part name="af1ccrl.3d" crc="6c054698"/>
		<part name="af1ccrh.1d" crc="95a02a27"/>
		<part name="af1ptrl0.18k" crc="31ce46d3"/>
		<part name="af1ptrl1.16k" crc="e869bf00"/>
		<part repeat="0x100000">00</part>
		<part name="af1ptrm0.18j" crc="ef7f4d8a"/>
		<part name="af1ptrm1.16j" crc="7dd01d52"/>
		<part repeat="0x100000">00</part>
		<part name="af1ptru0.18f" crc="177f1591"/>
		<part name="af1ptru1.16f" crc="7521d18e"/>
		<part repeat="0x80000">00</part>
		<part name="af1wavea.2l" crc="28cca494"/>
		<part repeat="0x880000">00</part>
		<interleave output="32">
			<!-- B_PROG8: maincpu region 0x400000-0x7FFFFF (alpines_am banks 1,2) = file bytes 0x100000+ -->
			<!-- region byte o -> stream lane o^1 (halfword-exchange, hw-proven on ridgerac 2026-08-25) -->
			<part name="af2ver-a_ll.ic2" crc="e776159d" offset="0x100000" length="0x100000" map="0100"/>
			<part name="af2ver-a_lm.ic3" crc="c5333d38" offset="0x100000" length="0x100000" map="1000"/>
			<part name="af2ver-a_um.ic4" crc="c9095af3" offset="0x100000" length="0x100000" map="0001"/>
			<part name="af2ver-a_uu.ic5" crc="54ee33a1" offset="0x100000" length="0x100000" map="0010"/>
		</interleave>
	</rom>

	<!-- DSW at 0x440000 (namcos22s_am), SW4 = bits 16..23 -> status[31:24] (base 24); only the switches
	     MAME names are exposed. Cabinet = status[32] -> INPUTS. Controls: tools/mra_controls_ss22.py. -->

	<buttons names="Decision,L Select,R Select,-,-,Coin,Service,Test,-,Pause" default="Start,L,R,,,Select"/>
	<!-- index 1: byte0 bit6 = B_PROG8 program-ROM bank window (alpines_am: 0x300000 write selects
	     maincpu+0x200000*(1+clamp(d&3,0,2)) at 0x200000-0x3FFFFF); bytes1-3 = KEYCUS 0x01A9 @ word 1
	     (namcos22_keycus_r NAMCOS22_ALPINE_SURFER). MAME ships no default EEPROM for alpines. -->
	<rom index="1"><part>C0 81 01 A9 08 00</part></rom>
	<nvram index="8" size="8192"/>

