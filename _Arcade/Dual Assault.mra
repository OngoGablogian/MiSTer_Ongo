<misterromdescription>
	<name>Dual Assault</name>
	<mameversion>0270</mameversion>
	<setname>dualaslt</setname><parent>liberate</parent>
	<year>1984</year><manufacturer>Data East USA</manufacturer><category>Shooter</category>
	<rbf>Meathax_DataEastLiberation</rbf>
	<about author="aCORES" source="MAME liberate.cpp / liberate_v.cpp"/>
	<resolution>15kHz</resolution><rotation>vertical</rotation><flip>yes</flip>
	<players>2</players><joystick>8-way</joystick><num_buttons>2</num_buttons>
	<buttons names="Fire,Take Off/Land,Start1P,Start2P,CoinA,CoinB,Service,Tilt" default="A,B,Start,Select,R,L,X,Y"/>
	<switches default="3F,FF">
		<!-- DSW1 -->
		<dip bits="0,1" name="Coin A" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
		<dip bits="2,3" name="Coin B" ids="2 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
		<dip bits="4" name="Unknown SW1-5" ids="On,Off"/>
		<dip bits="5" name="Unknown SW1-6" ids="On,Off"/>
		<dip bits="6" name="Cabinet" ids="Upright,Cocktail"/>
		<dip bits="7" name="Title" ids="Dual Assault,Invalid: Liberation"/>
		<!-- DSW2 -->
		<dip bits="8,9" name="Lives" ids="Infinite,5,4,3"/>
		<dip bits="10,11" name="Bonus" ids="20K only,50K / every 70K,30K / every 50K,20K / every 40K"/>
		<dip bits="12,13" name="Difficulty" ids="Hardest,Hard,Normal,Easy"/>
		<dip bits="14" name="Unused SW2-7" ids="On,Off"/>
		<dip bits="15" name="Unused SW2-8" ids="On,Off"/>
	</switches>
	<rom index="0" zip="dualaslt.zip|liberate.zip" md5="none">
		<!-- DELU v1, Liberation engine/variant, opcode-only decrypt -->
		<part>44 45 4C 55 01 00 01 02 00 00 00 00 00 00 00 00</part>
		<part repeat="0x8000">00</part>
		<part name="bt12" crc="1434ee46"/>
		<part name="bt13" crc="38e0ffa4"/>
		<part repeat="0x2000">00</part>
		<part name="bt11.bin" crc="b549ccaa"/>
		<part name="bt04-5" crc="159a3e85"/>
		<part name="bt03.bin" crc="29ad1b59"/>
		<part name="bt06-5" crc="3b5a80c8"/>
		<part name="bt05.bin" crc="a8896c20"/>
		<part name="bt08-5" crc="b0cebde8"/>
		<part name="bt07.bin" crc="f919e8e2"/>
		<part name="bt01" crc="c0ddbeb5"/>
		<part name="bt02a" crc="846d9d24"/>
		<part name="bt00.bin" crc="b744454d"/>
		<part repeat="0x2000">00</part>
		<part name="bt09" crc="2ea31472"/>
		<part name="bt10a" crc="69d9aa8d"/>
		<part name="bt14.bin" crc="20281d61"/>
	</rom>
	<rom index="1"></rom><rom index="2"></rom>
	<rom index="3">
		<part>
			03 00 00 00 FF FF 00 08 00 08 00 01 11 11 40 00
			00 00 00 41 03 05 00 00
			00 00 63 04 6E 20 60 00
		</part>
	</rom>
	<nvram index="4" size="113"/>

	<remark>Dual Assault program set on the Liberation hardware path.</remark>
</misterromdescription>
