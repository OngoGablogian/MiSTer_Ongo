<misterromdescription>
    <!-- Generated by scripts/build_mra_lm.py from MAME limenko.cpp; the layout is
         rtl/lm_sdram_map.svh. Do not edit by hand. -->
    <name>Spotty (Ver. 2.0.2)</name>
    <setname>spotty</setname>
    <rbf>ppriest_Limenko</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Prince Co.</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Hold 1,Hold 2,Hold 3,Hold 4,Start,Coin,Pause,Service Coin,Service Mode,Bet,Stop,Change" default="A,B,X,Y,Start,Select,L,R" count="7"/>

    <!-- mod byte (rtl/lm_main.sv): [2:0] game (0 dynabomb, 1 sb2003, 2 legendoh, 3 hrthouse,
         4 spotty), [4] a 1 MB program at 0xfff00000 -->
    <rom index="1"><part>14</part></rom>

    <!-- byte 0 bit 0: IN2 bit 29 (limenko.cpp INPUT_PORTS) -->
    <switches default="01" base="0">
        <dip bits="0" name="Demo Sounds" ids="Off,On"/>
    </switches>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM -->
    <rom index="0" zip="spotty.zip" md5="none" address="0x30000000">
        <!-- maincpu: ROM_LOAD16_WORD_SWAP -->
        <part repeat="0x100000">00</part>  <!-- no first MB -->
        <part repeat="0x80000">FF</part>  <!-- maincpu 0x80000 -->
        <interleave output="16">
            <part name="sys_rom2" crc="6ded8d9b" map="12"/>
        </interleave>
        <!-- audiocpu -->
        <part name="at89c4051.mcu" crc="82ceab26"/>
        <part repeat="0x7F000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x17FF80">00</part>  <!-- samples -->
        <!-- oki samples -->
        <part name="sou_rom1" crc="5791195b"/>
        <part repeat="0x9C0000">00</part>  <!-- gfx -->
        <!-- gfx: maindata's bytes 0 and 1 of each dword (gc_rom1, gc_rom3), 4bpp -->
        <interleave output="16">
            <part name="gc_rom1" crc="ea03f9c5" map="01"/>
            <part name="gc_rom3" crc="0ddac0b9" map="10"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
