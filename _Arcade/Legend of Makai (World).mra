<!--
  Legend of Makai (World) — Jaleco 1988, MAME jaleco/megasys1.cpp (lomakai).
  Mega System 1 type Z. Generated by tools/gen_ms1z_mra.py from
  tools/ms1z_romdata.py; do not hand-edit.

  SDRAM image: 0x0A0000 bytes. <switches> byte 2 is not a DIP: bit 7
  unlocks the Autofire menu (tools/gen_autofire_mra.py sets it in the
  autofire_releases/ copies), nothing else reads it.
-->
<misterromdescription>
  <name>Legend of Makai (World)</name>
  <mratimestamp>202609230000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>lomakai</setname>
  <year>1988</year>
  <manufacturer>Jaleco</manufacturer>
  <category>Arcade</category>
  <rbf>JalecoMS1Z</rbf>

  <switches default="BF,BF,00">
    <dip bits="0,1" name="Lives" ids="2,5,4,3"/>
    <dip bits="4,5" name="Difficulty" ids="Hardest,Hard,Normal,Easy"/>
    <dip bits="6" name="Cabinet" ids="Upright,Cocktail"/>
    <dip bits="7" name="Flip Screen" ids="On,Off"/>
    <dip bits="8,10" name="Coin A" ids="Free_Play,4C_1C,3C_1C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="11,13" name="Coin B" ids="Free_Play,4C_1C,3C_1C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="14" name="Demo Sounds" ids="On,Off"/>
    <dip bits="15" name="Invulnerability (Cheat)" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="lomakai.zip" md5="none">
    <!-- maincpu 0x040000 @ 0x000000 -->
    <interleave output="16">
      <part crc="ba6d65b8" name="lom_30.rom" map="01"/>
      <part crc="56a00dc2" name="lom_20.rom" map="10"/>
    </interleave>
    <!-- audiocpu 0x010000 @ 0x040000 -->
    <part crc="46e85e90" name="lom_01.rom"/>
    <!-- gfx0 0x020000 @ 0x050000 -->
    <part crc="d04fc713" name="lom_05.rom"/>
    <!-- gfx1 0x010000 @ 0x070000 -->
    <part crc="bdb15e67" name="lom_08.rom"/>
    <!-- sprites 0x020000 @ 0x080000 -->
    <part crc="f33b6eed" name="lom_06.rom"/>
  </rom>

  <!-- The board's two 256-byte PROMs (makaiden.9 / .10). MAME does not use
       them and they are not a priority PROM (docs/known-issues.md MS1Z-2);
       they ride along on their own index so the set is complete, and the
       core drops them. -->
  <rom index="1" zip="lomakai.zip" md5="none">
    <part crc="3567065d" name="makaiden.9"/>
    <part crc="e6709c51" name="makaiden.10"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for lomakai, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F F0 00 00 02 00 03
        00 0F F0 02 00 7E 00 00
        00 0F E0 60 00 04 00 00
    </part>
  </rom>
  <nvram index="4" size="132"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Lives, Infinite Energy, Infinite Time, Infinite Money, Infinite Jumps, Invincibility, Always have all keys.
       This set provides: Infinite Lives, Infinite Energy, Infinite Time, Infinite Money, Infinite Jumps, Invincibility, Always have all keys. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F C0 21 00 00 05 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 0F C0 0B 00 00 03 00 00 00 00 00 00 00 00 00 00 00 00
        03 00 0F C0 1B 00 00 09 0F C0 1D 00 00 05 0F C0 1F 00 00 09
        02 00 0F C0 22 00 00 90 0F C0 23 00 00 00 00 00 00 00 00 00
        01 00 0F C0 6E 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 0F C0 70 00 00 01 00 00 00 00 00 00 00 00 00 00 00 00
        02 00 0F C0 32 02 03 03 0F C0 33 02 80 80 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
