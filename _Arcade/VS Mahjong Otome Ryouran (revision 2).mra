<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>ryouran</setname>
	<name>VS Mahjong Otome Ryouran (revision 2)</name>
	<rotation>horizontal</rotation>
	<year>1998</year>
	<manufacturer>Electro Design</manufacturer>
	<buttons names="Button 1,Button 2,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="ryouran.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="e9c7695b" name="or100-00.u24" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="fe06bf12" name="or101-00.u20" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="f2a5237b" name="or102-00.u17" map="12345678" />
		</interleave>
		<part repeat="0x400000">00</part>

		<interleave output="64">
			<part crc="4c4701a8" name="or200-00.u16" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="a94064aa" name="or201-00.u13" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="a3f64b79" name="or300-00.u4" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<interleave output="64">
			<part crc="7e2b836c" name="sknsj1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="cba8ca4e" name="or-000-j2.u10" map="13570" />
			<part crc="8e79c6b7" name="or-001-j2.u8" map="1357" />
		</interleave>
		<part repeat="0x100000">00</part>
	</rom>
	<rom index="2" md5="" >
		<part>10 4A 00 00 05 00</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>