<misterromdescription>
	<name>Libero Grande (World, LG2/VER.A)</name>
	<setname>lbgrande</setname>
	<rbf>SYSTEM12</rbf>
	<mameversion>0277</mameversion>
	<year>1997</year>
	<manufacturer>Namco</manufacturer>
	<category>Sports</category>
	<platform>Namco System 12</platform>

	<!-- ==== SDRAM layout (see SYSTEM12.sv "ROM DETECT") ====
	     0x0000000  Main RAM      4 MB  (COH-700)
	     0x0400000  Program ROM   4 MB   ioctl 0 -> CPU 0x1FC00000 (boots directly, no BIOS)
	     0x0800000  Banked ROM   28 MB  ioctl 3 -> DMA-5 source / CPU 2 MB window @0x1FA00000
	     0x2800000  H8 program  512 KB   ioctl 6 -> H8/3002 external flash (S12_SPROG_START)
	     0x2880000  C352 wave     4 MB  ioctl 7                        (S12_WAVE_START)
	     top of image 0x2C80000 (44.5 MB) - fits a 64 MB module.

	     MAME's bankedroms region is 28 MB with a 16 MB HOLE: lg1rom0 sits at
	     0x0000000 (8 MB) and lg1fl3 at 0x1800000 (4 MB). The 16 MB of 00 in the
	     middle is mandatory - the bank register indexes 2 MB windows by absolute
	     offset, so dropping the hole would shift fl3 down 8 banks.
	-->

	<!-- ioctl 0: main program, 2x 2 MB 16-bit interleaved (first MAME ROM_LOAD16_BYTE
	     is at offset 0 = even/low byte = map "01", second is at offset 1 = map "10"). -->
	<rom index="0" zip="lbgrande.zip" md5="none">
		<interleave output="16">
			<part name="lg2vera.2l" crc="5ed6b152" map="01"/>
			<part name="lg2vera.2p" crc="97c57149" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 1: platform byte. bit5 = Namco System 12 (bit4 = System 11, must stay
	     CLEAR). bit6 = Tekken-3 JAMMA button remap. 0x24 = System 12 with the STOCK
	     namcos12 JVS button map (bit6 clear).
	     Second byte = KEYCUS/protection id; System 12 has no emulated KEYCUS -> 0x00. -->
	<rom index="1"><part>24 00</part></rom>

	<!-- ioctl 3: banked data ROM, 28 MB. Concatenated in MAME "bankedroms" region
	     order; interleaved pairs only where MAME uses ROM_LOAD16_BYTE. -->
	<rom index="3" zip="lbgrande.zip" md5="none">
		<interleave output="16">
			<part name="lg1rom0l.6" crc="c5df7f27" map="01"/>
			<part name="lg1rom0u.9" crc="74607817" map="10"/>
		</interleave>
		<!-- 16 MB of 00: MAME leaves this range of the bankedroms region empty -->
		<part repeat="262144">00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
		<interleave output="16">
			<part name="lg1fl3l.12" crc="c9947d3e" map="01"/>
			<part name="lg1fl3u.13" crc="f3d69f45" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 6: H8/3002 sound program, 512 KB (external flash; the H8 is ROMless).
	     MAME uses ROM_LOAD16_WORD_SWAP; the core handles the swap, ship it plain. -->
	<rom index="6" zip="lbgrande.zip" md5="none">
		<part name="lg1vera.11s" crc="de717a09"/>
	</rom>

	<!-- ioctl 7: C352 wave ROM, 4 MB. -->
	<rom index="7" zip="lbgrande.zip" md5="none">
		<part name="lg1wave0.5" crc="4647fada"/>
	</rom>

	<!-- ioctl 9: settings EEPROM, blank (all-FF). No proprietary nvram ships. -->
	<rom index="9">
		<part repeat="4096">FF</part>
	</rom>

	<buttons names="Button 1,Button 2,Button 3,Button 4,Button 5,Button 6,Start,Coin" default="A,B,X,Y,L,R,Start,Select" count="6"/>
</misterromdescription>
