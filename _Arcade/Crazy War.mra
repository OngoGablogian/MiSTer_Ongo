<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vegaeo.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Crazy War</name>
    <setname>crazywar</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>2002</year>
    <manufacturer>Eolith</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Shot,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>00 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="crazywar.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00" crc="fbb917ae" map="0012"/>
            <part name="01" crc="59308556" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02" crc="34813167" map="0012"/>
            <part name="03" crc="7fcb0a53" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04" crc="f8eb8ce5" map="0012"/>
            <part name="05" crc="14d854df" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06" crc="31c67f0a" map="0012"/>
            <part name="07" crc="dddf93d2" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08" crc="dc37bcb9" map="0012"/>
            <part name="09" crc="86ba59cc" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10" crc="524bf126" map="0012"/>
            <part name="11" crc="613b2764" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12" crc="3c81d117" map="0012"/>
            <part name="13" crc="b86545a0" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14" crc="38ede322" map="0012"/>
            <part name="15" crc="d35e630a" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="u7" crc="697c2505"/>
        <!-- qs1000:cpu -->
        <part name="bgm.u84" crc="13aa7778"/>
        <!-- qs1000 samples -->
        <part name="effect.u85" crc="9159fcc6"/>
        <part repeat="0x100000">00</part>  <!-- qs1000 0x200000 -->
        <part name="qs1001a.u86" crc="d13c6407"/>
    </rom>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="2048"/>
</misterromdescription>
