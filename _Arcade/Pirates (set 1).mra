<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME pirates.cpp; the layout is
         rtl/np_rom_map.svh. Do not edit by hand. -->
    <name>Pirates (set 1)</name>
    <setname>pirates</setname>
    <rbf>NixPirates</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>NIX</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Shoot,Slide,Bomb,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- the board has no DIPs; bit 0 is the core's own flip (rtl/np_video.sv) -->
    <switches default="00" base="0">
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>

    <!-- mod byte (rtl/np_rom_map.svh): [0] 0 pirates protection patch, 1 genix -->
    <rom index="1"><part>00</part></rom>

    <rom index="0" zip="pirates.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="r_449b.bin" crc="224aeeda" map="01"/>
            <part name="l_5c1e.bin" crc="46740204" map="10"/>
        </interleave>
        <!-- tiles -->
        <part name="p4_4d48.bin" crc="89fda216"/>
        <part name="p2_5d74.bin" crc="40e069b4"/>
        <part name="p1_7b30.bin" crc="26d78518"/>
        <part name="p8_9f4f.bin" crc="f31696ea"/>
        <!-- sprites -->
        <part name="s1_6e89.bin" crc="c78a276f"/>
        <part name="s2_6df3.bin" crc="9f0bad96"/>
        <part name="s4_fdcc.bin" crc="8916ddb5"/>
        <part name="s8_4b7c.bin" crc="1c41bd2c"/>
        <!-- oki -->
        <part name="s89_49d4.bin" crc="63a739ec"/>
    </rom>

    <!-- the 93C46, which holds the game's score table -->
    <nvram index="2" size="128"/>
</misterromdescription>
