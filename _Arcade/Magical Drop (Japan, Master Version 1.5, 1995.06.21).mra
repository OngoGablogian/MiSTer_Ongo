    <rom index="0" zip="magdrop.zip|chainrec.zip" md5="None" address="0x30000000">
        <!-- 
  0[0]: jm         Joe & Mac Returns
  0[1]: cr         Chain Reaction
  0[2]: md         Magical Drop
  0[3]: mdp        Magical Drop Plus
  0[4]: cn         Charlie Ninja
  0[5]: hv         Heavy Smash -->
        <part>
            04 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x100000 (20 bits) -->
        <interleave output="16">
            <part name="re00-2.e1" crc="7138f10f" map="12"/>
        </interleave>
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- tiles - starts at 0x100000 - length 0x200000 (21 bits) -->
        <part name="mcc-00" crc="646b03ec"/>
        <part repeat="0x100000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- PCM1_START -->
        <!-- oki1 - starts at 0x300000 - length 0x80000 (19 bits) -->
        <part name="mcc-04" crc="86ee6ade"/>
        <part repeat="0x40000"> FF</part>
        <!-- PCM2_START -->
        <!-- oki2 - starts at 0x380000 - length 0x200000 (21 bits) -->
        <part name="mcc-03" crc="da2ebba0"/>
        <part repeat="0x100000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- sprites - starts at 0x580000 - length 0x200000 (21 bits) -->
        <part name="mcc-02.a14" crc="d0f97126"/>
        <part name="mcc-01.a13" crc="13d88745"/>
        <!-- Total 0x780000 bytes - 7680 kBytes -->
    </rom>
    <rom index="2" zip="magdrop.zip|chainrec.zip">
