<!-- Cabinet-test MRA for Arcade-SmashTV_firefix_mixboot.rbf. -->
<misterromdescription>
    <about author="rejectedcoins"/>
    <rotation>horizontal</rotation>
    <name>Smash T.V. (rev 8.00)</name>
    <setname>smashtv</setname>
    <mameversion>0280</mameversion>
    <year>1990</year>
    <manufacturer>Williams</manufacturer>
    <players>2</players>
    <rbf>SmashTV</rbf>
    <joystick>8</joystick>
    <region>World</region>

    <rom index="0" zip="smashtv.zip" md5="None">
        <part name="la1_smash_tv_game_rom_u111.u111" crc="72f0ba84"/>
        <part name="la1_smash_tv_game_rom_u112.u112" crc="436f0283"/>
        <part name="la1_smash_tv_game_rom_u113.u113" crc="4a4b8110"/>
        <part name="la1_smash_tv_game_rom_u95.u95"   crc="e864a44b"/>
        <part name="la1_smash_tv_game_rom_u96.u96"   crc="15555ea7"/>
        <part name="la1_smash_tv_game_rom_u97.u97"   crc="ccac9d9e"/>
        <part name="la1_smash_tv_game_rom_u106.u106" crc="5c718361"/>
        <part name="la1_smash_tv_game_rom_u107.u107" crc="0fba1e36"/>
        <part name="la1_smash_tv_game_rom_u108.u108" crc="cb0a092f"/>
        <part name="la8_smash_tv_game_rom_u105.u105" crc="48cd793f"/>
        <part name="la8_smash_tv_game_rom_u89.u89"   crc="8e7fe463"/>
        <part name="sl2_smash_tv_sound_rom_u4.u4"    crc="29d3f6c8"/>
        <part name="sl2_smash_tv_sound_rom_u19.u19"  crc="ac5a402a"/>
        <part name="sl2_smash_tv_sound_rom_u20.u20"  crc="875c66d9"/>
    </rom>

    <!-- Rotary is forced Off in RTL and therefore cannot be re-enabled while
         entering/leaving diagnostics. Test mode itself remains available. -->
    <switches default="FF,FF">
        <dip name="Test Switch" bits="15" ids="On,Off"/>
        <dip name="Unknown DS1:1" bits="7" ids="On,Off"/>
        <dip name="Unknown DS1:2" bits="6" ids="On,Off"/>
    </switches>

    <buttons names="Fire Up,Fire Down,Fire Left,Fire Right,Start,Coin"
             default="Y,A,X,B,Start,Select" count="4"/>
</misterromdescription>
