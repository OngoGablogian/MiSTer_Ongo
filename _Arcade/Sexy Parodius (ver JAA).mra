<misterromdescription>
    <name>Sexy Parodius (ver JAA)</name>
    <setname>sexyparo</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>08</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 8); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="sexyparo.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="533jaa03.27b" crc="4a95e80d" map="0012"/>
            <part name="533jaa02.31b" crc="b8030abc" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 5-byte row, then the last 1 byte of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="533a19.17h" crc="3ec1843e"/>  <!-- four-byte part -->
        <part repeat="2097152">00</part>
        <part name="533a18.13g" crc="d3e0d058"/>  <!-- second part -->
        <part repeat="524288">00</part>
        <!-- k055673: MAME's region, a four-byte part then the fifth bytes -->
        <part repeat="3145728">00</part>
        <interleave output="32">
            <part name="533a17.25g" crc="9947af57" map="0021"/>
            <part name="533a13.28g" crc="58f1fc38" map="2100"/>
        </interleave>
        <part name="533a11.30g" crc="983105e1" length="0x100000"/>  <!-- the chip reads this much -->
        <!-- soundcpu: MAME's region as it is -->
        <part repeat="3145728">00</part>
        <interleave output="16">
            <part name="533a08.9c" crc="06d14cff" map="01"/>
            <part name="533a09.7c" crc="a93c6f0b" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="533a22.9g" crc="97233814"/>
        <part name="533a23.7g" crc="1bb7552b"/>
    </rom>


    <!-- MAME's hiscore.dat entries for hiscore.v (rtl/hiscore) -->
    <rom index="3">
        <part>
        2D 7D 82 00 3F FF 00 02 00 02 00 01 00 0F 20 00
        00 C1 07 52 00 04 00 00
        00 C1 07 5E 00 78 00 06
        00 C1 07 54 00 01 73 73
        </part>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it; then hiscore.v's tables -->
    <nvram index="4" size="253"/>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="Power Up,Shot,Missile,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- from Pugsy's MAME cheats (mamecheat.co.uk), scripts/mame_cheats.py: replaced
         as the CPU reads them (rtl/cheat/cheatengine.sv) -->
    <cheats size="16" max="16">
        <cheat name="Infinite Credits"                              >00000010 00C10249 00000000 00000099</cheat>
        <cheat name="Always have 300 items"                         >00000010 00C109C0 00000000 00000003</cheat>
        <cheat name="P1 Infinite Lives"                             >00000010 00C107E9 00000000 0000000A</cheat>
        <cheat name="P1 Invincibility"                              >00000010 00C00E4F 00000000 00000002</cheat>
        <cheat name="P1 Infinite ALEX Energy"                       >00000010 00C0134F 00000000 00000099</cheat>
        <cheat name="P1 Get Maximum Level Items"                    >00000020 00C109C0 00000000 00000999</cheat>
        <cheat name="P1 Constantly Cycle Upgrades"                  >00000010 00C00EDD 00000000 00000001</cheat>
        <cheat name="P1 Infinite Bell Option"                       >00000010 00C00EDF 00000000 00000003</cheat>
        <cheat name="P1 Select Bell Choice: Activate Option Slot #7">00000010 00C00EE1 00000000 00000000</cheat>
        <cheat name="P1 Select Bell Choice: KIKU Beam"              >00000010 00C00EE1 00000000 00000008</cheat>
        <cheat name="P1 Select Bell Choice: Super Bomb"             >00000010 00C00EE1 00000000 00000009</cheat>
        <cheat name="P1 Select Bell Choice: Big"                    >00000010 00C00EE1 00000000 0000000A</cheat>
        <cheat name="P1 Select Bell Choice: Option #7 Effect"       >00000010 00C00EE1 00000000 0000000B</cheat>
        <cheat name="P1 Select Bell Choice: Alex"                   >00000010 00C00EE1 00000000 0000000D</cheat>
        <cheat name="P2 Infinite Lives"                             >00000010 00C10867 00000000 0000000A</cheat>
        <cheat name="P2 Invincibility"                              >00000010 00C03B4F 00000000 00000002</cheat>
    </cheats>
</misterromdescription>
