<misterromdescription>
    <!-- Generated by scripts/build_mra_lm.py from MAME limenko.cpp; the layout is
         rtl/lm_sdram_map.svh. Do not edit by hand. -->
    <name>Legend of Heroes</name>
    <setname>legendoh</setname>
    <rbf>ppriest_Limenko</rbf>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Limenko</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Attack,Jump,Button 3,Button 4,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,X,Y,Start,Select,L,R" count="4"/>

    <!-- mod byte (rtl/lm_main.sv): [2:0] game (0 dynabomb, 1 sb2003, 2 legendoh, 3 hrthouse,
         4 spotty), [4] a 1 MB program at 0xfff00000 -->
    <rom index="1"><part>02</part></rom>

    <!-- byte 0 bit 0: IN2 bit 29 (limenko.cpp INPUT_PORTS); bits 3:1 the QS1000's output shift -->
    <switches default="04" base="0">
        <dip bits="0" name="Sound Enable" ids="On,Off"/>
        <dip bits="1,3" name="Volume Boost" ids="Off,+6 dB,+12 dB,+18 dB,+24 dB,+30 dB"/>
    </switches>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM -->
    <rom index="0" zip="legendoh.zip" md5="none" address="0x30000000">
        <!-- maincpu: ROM_LOAD16_WORD_SWAP -->
        <part repeat="0x100000">FF</part>  <!-- maincpu, erased -->
        <part repeat="0x80000">FF</part>  <!-- maincpu 0x180000 -->
        <interleave output="16">
            <part name="01.sys_rom4" crc="49b4a91f" map="12"/>
        </interleave>
        <!-- qs1000:cpu -->
        <part name="sou_prg.06" crc="bfafe7aa"/>
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x17FF80">00</part>  <!-- samples -->
        <!-- qs1000 samples -->
        <part name="sou_rom.07" crc="4c6eb6d2"/>
        <part name="sou_rom.08" crc="42c32dd5"/>
        <part repeat="0x100000">00</part>  <!-- samples 0x200000 -->
        <part name="qs1003.u4" crc="19e4b469"/>
        <!-- maindata: ROM_LOAD16_WORD_SWAP -->
        <interleave output="16">
            <part name="sys_rom6" crc="5c13d467" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="sys_rom5" crc="19dc8d23" map="12"/>
        </interleave>
        <part repeat="0x200000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_BYTE quads -->
        <interleave output="32">
            <part name="cg_rom10" crc="93a48489" map="0001"/>
            <part name="cg_rom20" crc="1a6c0258" map="0010"/>
            <part name="cg_rom30" crc="a0559ef4" map="0100"/>
            <part name="cg_rom40" crc="a607b2b5" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="cg_rom11" crc="a9fd5a50" map="0001"/>
            <part name="cg_rom21" crc="b05cdeb2" map="0010"/>
            <part name="cg_rom31" crc="a9a0d386" map="0100"/>
            <part name="cg_rom41" crc="1c014f45" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="02.cg_rom12" crc="8b2e8cbc" map="0001"/>
            <part name="03.cg_rom22" crc="a35960c8" map="0010"/>
            <part name="04.cg_rom32" crc="3f486cab" map="0100"/>
            <part name="05.cg_rom42" crc="5d807bec" map="1000"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
