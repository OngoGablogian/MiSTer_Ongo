<misterromdescription>
   <name>Print Club (Japan Vol.4)</name>
   <setname>pclubjv4</setname>
   <rbf>SystemC2</rbf>
   <mameversion>0276</mameversion>
   <year>1996</year>
   <manufacturer>Atlus</manufacturer>
   <category>Arcade</category>

   <rom index="0" zip="pclubjv4.zip" md5="none">
      <!-- board config header -->
      <part>00 00</part>
      <!-- region 0: 68000 program, 2097152 bytes -->
      <part>00 20 00 00</part>
      <interleave output="16">
        <part name="p4jsm.u32" map="10"/>
        <part name="p4jsm.u31" map="01"/>
      </interleave>
      <interleave output="16">
        <part name="p4jsm.u34" map="10"/>
        <part name="p4jsm.u33" map="01"/>
      </interleave>
      <!-- region 1: uPD7759 samples, 524288 bytes -->
      <part>01 08 00 00</part>
      <part name="epr-18169.ic4"/>
      <!-- region 2: 317-xxxx protection table -->
      <part>02 00 01 00</part>
      <part>06 02 07 03 06 02 07 03 04 00 04 00 04 00 04 00</part>
      <part>05 01 04 00 04 00 05 01 01 05 01 05 00 04 00 04</part>
      <part>0E 08 0F 09 0E 08 0F 09 0C 0A 0C 0A 0C 0A 0C 0A</part>
      <part>0D 0B 0C 0A 0C 0A 0D 0B 09 0F 09 0F 08 0E 08 0E</part>
      <part>06 02 06 02 06 02 06 02 04 00 04 00 04 00 04 00</part>
      <part>05 01 05 01 04 00 04 00 01 05 01 05 00 04 00 04</part>
      <part>0E 0A 0E 0A 0E 0A 0E 0A 0C 08 0C 08 0C 08 0C 08</part>
      <part>0D 09 0D 09 0C 08 0C 08 09 0D 09 0D 08 0C 08 0C</part>
      <part>0E 0A 07 03 0E 0A 07 03 0C 08 04 00 0C 08 04 00</part>
      <part>0D 09 04 00 0C 08 05 01 09 0D 01 05 08 0C 00 04</part>
      <part>0E 08 07 01 0E 08 07 01 0C 0A 04 02 0C 0A 04 02</part>
      <part>0D 0B 04 02 0C 0A 05 03 09 0F 01 07 08 0E 00 06</part>
      <part>0E 0A 06 02 0E 0A 06 02 0C 08 04 00 0C 08 04 00</part>
      <part>0D 09 05 01 0C 08 04 00 09 0D 01 05 08 0C 00 04</part>
      <part>0E 0A 06 02 0E 0A 06 02 0C 08 04 00 0C 08 04 00</part>
      <part>0D 09 05 01 0C 08 04 00 09 0D 01 05 08 0C 00 04</part>
   </rom>

   <buttons names="Button 1,Button 2,Button 3,Start,Coin,Service,Test" default="A,B,X,Start,Select,R,L" count="7"/>

   <switches default="FF,FF" base="0">
      <dip name="Coins per Credit (Normal / Alternate)" bits="0,1,2" ids="25 / 30,6 / 7,10 / 12,1 / 2,15 / 20,4 / 5,8 / 9,3 / Free Play"/>   <!-- 0,1,2,3,4,5,6,7 -->
      <dip name="Alternate Coinage" bits="3" ids="On,Off"/>   <!-- 0,8 -->
      <dip name="Coin B" bits="4,5,6,7" ids="Free Play (if Coin A too) or 1/1,1 Coin/1 Credit  2/3,1 Coin/1 Credit  4/5,1 Coin/1 Credit  5/6,2 Coins/1 Credit  4/3,2 Coins/1 Credit  5/3  6/4,2 Coins/3 Credits,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>   <!-- 0,16,32,48,64,80,96,112,128,144,160,176,192,208,224,240 -->
      <dip name="Demo Sounds" bits="13" ids="Off,On"/>   <!-- 0,32 -->
   </switches>
</misterromdescription>
