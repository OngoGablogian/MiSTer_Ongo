<misterromdescription>
	<name>Star Gladiator Episode I: Final Crusade (USA 960627)</name>
	<setname>starglad</setname>
	<year>1996</year>
	<manufacturer>Capcom</manufacturer>
	<category>Fighting</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>USA</region>
	<rbf>ZN1Capcom</rbf>

	<!-- BIOS: Capcom ZN-1 BIOS (coh1000c), 512KB, ioctl_index 0. Japanese mask ROM. -->
	<rom index="0" zip="coh1000c.zip" md5="none">
		<part name="m534002c-13.ic353" crc="50033af6"/>
	</rom>

	<!-- Platform: Capcom ZN-1, ioctl_index 1. 0x25 = 0x05 + bit5 (4-button title,
	     MAME capcom4b): KICK harness carries Guard/Kick on core buttons 3/4. -->
	<rom index="1">
		<part>25</part>
	</rom>

	<!-- 4-button layout (MAME capcom4b): B1/B2 = attacks (P1), B3=Guard/B4=Kick
	     (KICK harness). Default pad A,B,X,Y. -->
	<buttons names="A,B,Guard,Kick,-,-,Start,Coin,Pause" default="A,B,X,Y,,,Start,Select,L3" count="4"/>

	<!-- Country/program ROM: 512KB, ioctl_index 2, CPU 0x1FB80000 (MAME region "countryrom") -->
	<rom index="2" zip="starglad.zip" md5="none">
		<part name="ps1u_04.2h" crc="121fb234"/>
	</rom>

	<!-- Banked ROM: 6x4MB = 24MB, ioctl_index 3 (MAME region "bankedroms").          -->
	<!-- CPU fixed window 0x1F000000-0x1F3FFFFF = ofs 0 (ps1-05m).                     -->
	<!-- CPU banked window 0x1F400000-0x1F7FFFFF, bank N = ofs (N+1)*4MB via 0x1FB00000.-->
	<!--   bank 0=ps1-06m, 1=ps1-07m, 2=ps1-08m, 3=ps1-09m, 4=ps1-10m.                  -->
	<rom index="3" zip="starglad.zip" md5="none">
		<part name="ps1-05m.3h" crc="8ad72c4f"/>
		<part name="ps1-06m.4h" crc="95d8ed61"/>
		<part name="ps1-07m.5h" crc="c06752db"/>
		<part name="ps1-08m.2k" crc="381f9ded"/>
		<part name="ps1-09m.3k" crc="bd894812"/>
		<part name="ps1-10m.4k" crc="ff80c18a"/>
	</rom>

	<!-- CAT702 key A: motherboard key (cp01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000c.zip" md5="none">
		<part name="cp01.ic652" crc="bb7ba033"/>
	</rom>

	<!-- CAT702 key B: game key (cp03), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="starglad.zip" md5="none">
		<part name="cp03" crc="27970400"/>
	</rom>

	<!-- QSound: Z80 sound program (audiocpu), 256KB (2x128KB), ioctl_index 6 -> SDRAM ch5 -->
	<rom index="6" zip="starglad.zip" md5="none">
		<part name="ps1_02a.2e" crc="b854df92"/>
		<part name="ps1_03a.3e" crc="a2562fbb"/>
	</rom>

	<!-- QSound: DL-1425 sample ROM, 4MB (ROM_LOAD16_WORD_SWAP), ioctl_index 7 -> SDRAM ch4.
	     Loaded STRAIGHT; the core inverts the ch4 byte-select to reproduce the word swap. -->
	<rom index="7" zip="starglad.zip" md5="none">
		<part name="ps1-01m.3b" crc="0bfb17aa"/>
	</rom>

	<!-- QSound: DL-1425 DSP microcode, 24KB (first 8KB used), ioctl_index 8 -> DSP prog ROM.
	     Game-independent QSound firmware, streamed into the jtdsp16 internal ROM. -->
	<rom index="8" zip="qsound_hle.zip" md5="none">
		<part name="dl-1425.bin" crc="d6cf5ef5"/>
	</rom>

	<!-- DIP switches map to zn_dsw via ~status[103:96] (base=96, 1 byte; ZN1.sv inverts).
	     From MAME zn.cpp DSW: bit 0x02 = Service Mode (bios testmode). -->
	<nvram index="9" size="2048"/>
	<switches base="96" default="00">
		<dip name="Service Mode" bits="1" ids="Off,On"/>
	</switches>
</misterromdescription>
