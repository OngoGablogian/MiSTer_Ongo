<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME dreamwld.cpp; the layout is
         rtl/memory/dreamworld_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME dreamwld.cpp"/>
    <name>Dream World</name>
    <setname>dreamwld</setname>
    <rbf>DreamWorld</rbf>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Platform</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Dig,Jump,Book,-,-,-,Start,Coin,Pause" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod byte (DreamWorld.sv): [0] the second OKI (dreamwld_map), [2:1] orientation -->
    <rom index="1"><part>01</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="dreamwld.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="3.bin" crc="e8f7ae78" map="0001"/>
            <part name="4.bin" crc="3ef5d51b" map="0010"/>
            <part name="1.bin" crc="35c94ee5" map="0100"/>
            <part name="2.bin" crc="5409e7fc" map="1000"/>
        </interleave>
        <part repeat="0x100000">00</part>  <!-- gfx1 at 0x200000 -->
        <!-- gfx1 -->
        <part name="9.bin" crc="fa84e3af"/>
        <part repeat="0x600000">00</part>  <!-- gfx2 at 0xA00000 -->
        <!-- gfx2 -->
        <part name="10.bin" crc="3553e4f5"/>
        <!-- spritelut -->
        <interleave output="16">
            <part name="8.bin" crc="8d570df6" map="01"/>
            <part name="7.bin" crc="a68bf35f" map="10"/>
        </interleave>
        <!-- oki1 -->
        <part name="5.bin" crc="9689570a"/>
        <!-- oki2 -->
        <part name="6.bin" crc="c8b91f30"/>
        <!-- mcu -->
        <part name="87c51rap.bin" crc="987bbfe8"/>
    </rom>

    <switches default="FF,FF,00">
        <dip name="Lives" bits="0,1" ids="5,4,2,3"/>
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <dip name="Coinage" bits="9,10,11" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (DreamWorld.sv flip_screen) -->
        <dip name="Flip Screen" bits="16" ids="Off,On"/>
    </switches>
</misterromdescription>
