<misterromdescription>
  <!-- BAZSET MRA-driven credits: real index249 HPS receiver and native pause pixel A/B checked. Experimental hardware unverified. -->
<bazset_runtime version="1"><pause><title>Agress - Missile Daisenryaku</title><build>b01</build><core_by>bazset</core_by><patreon>patreon.com/c/bazset</patreon><x>x.com/bazset_</x><beta_testers>No enrolled beta testers yet</beta_testers><patreon_supporters>Alexander Facchini | Groquik | BabaYaga326 | Curt Dittmer | Alessandro Gulli | RGM | JamieCRT | AlfEightyOne | Scott Dexter</patreon_supporters><special_thanks>Meathax | PixelCherryNinja</special_thanks><bug_prompt>FOUND A BUG? REPORT IT ON MY PATREON</bug_prompt></pause><osd><visibility>CRT H-Position=show | CRT V-Shift=show</visibility><defaults>CRT H-Position=0 | CRT V-Shift=0</defaults></osd><pause_style><colors background="#080B18" card="#101522" border="#D9A441" text="#F0E9D7" dim="#71798A" accent="#5DE4FF"/><layout preset="compact"/><marquee frames="12"/></pause_style></bazset_runtime>
    <about author="BAZSET" webpage="https://www.patreon.com/c/bazset"/>
    <rotation>horizontal</rotation>
    <name>Agress - Missile Daisenryaku (Japan)</name>
    <setname>agress</setname>
    <mameversion>0289</mameversion>
    <year>1991</year>
    <manufacturer>Palco</manufacturer>
    <category>Arcade</category>
    <players>2</players>
    <rbf>bazset_Agress</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="agress.zip" md5="None">
        <!--  Header to identify the PCB type
        Byte 0: b0 Block Out, b1 Japanese Block Out, b2 Agress

  0[0]: blockout   Blockout
  0[1]: blockoutj  Blockoutj
  0[2]: agress     Agress -->
        <part>
            04 00 00 00 </part>
        <!-- maincpu - starts at 0x0 - length 0x40000 (18 bits) -->
        <interleave output="16">
            <part name="palco2.91" crc="abfd5bcc" map="01"/>
            <part name="palco1.81" crc="3acc917a" map="10"/>
        </interleave>
        <!-- JTFRAME_BA1_START -->
        <!-- audiocpu - starts at 0x40000 - length 0x8000 (15 bits) -->
        <part name="palco3.73" crc="2a21c97d"/>
        <!-- PCM_START -->
        <!-- oki - starts at 0x48000 - length 0x20000 (17 bits) -->
        <part name="palco4.78" crc="9dfd9cfe"/>
        <!-- Total 0x68000 bytes - 416 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ff">
        <DSW1/>
        <dip name="Coinage" bits="0,1" ids="3/1,2/1,1/2,1/1"/>
        <dip name="Opening Cut" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="5" ids="Off,On"/>
        <DSW2/>
        <dip name="Difficulty" bits="8,9" ids="Very Hard,Hard,Easy,Normal"/>
        <dip name="Lives" bits="10" ids="1,2"/>
    </switches>
    <buttons names="Stop 1,Stop 2,Bomb,-,Start,Coin,Core credits" default="A,B,X,Start,Select,-" count="3"/>
    <rom index="249"><part></part></rom>
</misterromdescription>
