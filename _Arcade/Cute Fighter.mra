<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME dreamwld.cpp; the layout is
         rtl/memory/dreamworld_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME dreamwld.cpp"/>
    <name>Cute Fighter</name>
    <setname>cutefght</setname>
    <rbf>DreamWorld</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>SemiCom</manufacturer>
    <category>Fighter</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Attack,Strong Attack,Catch,-,-,-,Start,Coin,Pause" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod byte (DreamWorld.sv): [0] the second OKI (dreamwld_map), [2:1] orientation -->
    <rom index="1"><part>01</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="cutefght.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="5_semicom" crc="c14fd5dc" map="0001"/>
            <part name="6_semicom" crc="47440088" map="0010"/>
            <part name="3_semicom" crc="e7e7a866" map="0100"/>
            <part name="4_semicom" crc="476a3bf5" map="1000"/>
        </interleave>
        <!-- gfx1 -->
        <part name="10_semicom" crc="62bf1e6e"/>
        <part name="11_semicom" crc="796f23a7"/>
        <part name="13_semicom" crc="24222b3c"/>
        <part name="14_semicom" crc="385b69d7"/>
        <!-- gfx2 -->
        <part name="12_semicom" crc="45d29c22"/>
        <!-- spritelut -->
        <interleave output="16">
            <part name="7_semicom" crc="39454102" map="01"/>
            <part name="8_semicom" crc="fccb1b13" map="10"/>
        </interleave>
        <!-- oki1 -->
        <part name="2_semicom" crc="694ddaf9"/>
        <!-- oki2 -->
        <part name="1_semicom" crc="fa3b6890"/>
        <!-- mcu -->
        <part name="mcu.bin" crc="7d9acd7d"/>
    </rom>

    <switches default="FF,FE,00">
        <dip name="Ticket Payout" bits="5,6" ids="No,Little,Much,Normal"/>
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <dip name="Coinage" bits="9,10,11" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="12,13,14" ids="Level 3,Level 2,Level 1,Level 8,Level 7,Level 6,Level 5,Level 4"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (DreamWorld.sv flip_screen) -->
        <dip name="Flip Screen" bits="16" ids="Off,On"/>
    </switches>
</misterromdescription>
