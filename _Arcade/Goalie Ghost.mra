<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Goalie Ghost</name>
	<setname>gghost</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1984</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>2</players>
	<!-- Analog: P2 trackball_y, P2 trackball_x reversed, P1 trackball_y, P1 trackball_x reversed. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="gghost.zip|sente6vb.zip" md5="none">
		<part name="ggh-ab0.u9a" crc="ed0fdeac"/>
		<part name="ggh-ab1.u8a" crc="5bfbae58"/>
		<part name="ggh-ab2.u7a" crc="f0baf921"/>
		<part name="ggh-ab3.u6a" crc="ed0fdeac"/>
		<part name="ggh-ab4.u5a" crc="5bfbae58"/>
		<part name="ggh-ab5.u4a" crc="f0baf921"/>
		<part repeat="0x10000">00</part>
		<part name="ggh-cd.u3a" crc="d3d75f84"/>
		<part name="ggh-ef.u2a" crc="a02b4243"/>
		<part repeat="0x20000">00</part>
		<part name="ggh-gr0.u8b" crc="03515526"/>
		<part name="ggh-gr1.u8b" crc="b4293435"/>
		<part name="ggh-gr2.u7b" crc="ece0cb97"/>
		<part name="ggh-gr3.u6b" crc="dd7e25d0"/>
		<part name="ggh-gr4.u5b" crc="b4293435"/>
		<part name="ggh-gr5.u4b" crc="d3da0093"/>
		<part repeat="0x4000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 00 11 89 10 88 01 00 00 00 00 00 00 00 00 00 FF FF FF FF 24 25 09 80 08 28 04 05 FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Jump,Button 2,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="FF,7D,FF,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Game Duration" bits="8,10" ids="9 Points,Timed 1:15,11 Points,Timed 1:30,15 Points,Timed 2:00,21 Points,Timed 2:30"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="Free Play,1 Coin/2 Credits,2 Coins/1 Credit,1 Coin/1 Credit"/>
		<dip name="Players Per Credit" bits="2" ids="1,1 Or 2"/>
		<dip name="High Scores" bits="7" ids="Keep All,Keep Top 5"/>
		<dip name="Flip Screen" bits="32" ids="Off,On"/>
	</switches>
</misterromdescription>
