<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Street Football (11/12/86)</name>
	<setname>sfootbal</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1986</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>2</players>
	<!-- Analog: P2 ad_stick_y, P2 ad_stick_x reversed, P1 ad_stick_y, P1 ad_stick_x reversed. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="sfootbal.zip|sente6vb.zip" md5="none">
		<part name="street_football_ab_01_11-12-86.u8a" crc="2a69803f"/>
		<part name="street_football_ab_23_11-12-86.u7a" crc="89f157c2"/>
		<part name="street_football_ab_45_11-12-86.u6a" crc="91ad42c5"/>
		<part repeat="0x10000">00</part>
		<part name="street_football_cd_6_ef_11-12-86.u1a" crc="bf80bb1a"/>
		<part repeat="0x20000">00</part>
		<part name="street_football_gr_01_11-12-86.u4c" crc="e3108d35"/>
		<part name="street_football_gr_23_11-12-86.u3c" crc="5c5af726"/>
		<part name="street_football_gr_45_11-12-86.u2c" crc="e767251e"/>
		<part name="street_football_gr_67_11-12-86.u1c" crc="42452a7a"/>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 05 29 A1 28 A0 00 00 00 00 00 00 00 00 00 00 04 24 FF FF FF FF 09 80 08 28 FF FF FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Pass/Player,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="00,73,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Game Time" bits="8,10" ids="1:30,1:40,1:50,2:00,2:20,2:40,3:00,3:30"/>
		<dip name="Players Per Credit" bits="11" ids="1,1 Or 2"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit"/>
		<dip name="Bonus Coins" bits="2,4" ids="None,2 Coins=1 Bonus,3 Coins=1 Bonus,4 Coins=1 Bonus,4 Coins=2 Bonus,5 Coins=1 Bonus,5 Coins=2 Bonus,5 Coins=3 Bonus"/>
		<dip name="Left Coin Mech" bits="5" ids="x1,x2"/>
		<dip name="Right Coin Mech" bits="6,7" ids="x1,x4,x5,x6"/>
		<dip name="Flip Screen" bits="24" ids="Off,On"/>
	</switches>
</misterromdescription>
