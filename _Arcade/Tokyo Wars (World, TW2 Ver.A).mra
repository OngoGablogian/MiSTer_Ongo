		<part repeat="0x800000">00</part>
		<part name="tw1ptru3.14f" crc="939044c2"/>
	</rom>

	<!-- DSW at 0x440000 (namcos22s_am), SW4 = bits 16..23 -> status[31:24] (base 24); only the switches
	     MAME names are exposed. Cabinet = status[32] -> INPUTS. Controls: tools/mra_controls_ss22.py. -->
	<switches default="00,00" base="24">
		<dip bits="0" name="Test Mode (SW4:1)" ids="Off,On"/>
		<dip bits="8" name="Cabinet" ids="Standard,Deluxe"/>
	</switches>

	<buttons names="Right Trigger,Left Trigger,Start,Forward,Backward,Coin,Service,Test,-,Pause" default="A,B,Start,R,L,Select"/>
	<rom index="1"><part>00 84 01 A8 01 00</part></rom>

	<!-- B_EEDL: MAME "eeprom" region default (8 KB, cell i = CPU 0x460000+2i), see header. -->
	<rom index="8" zip="tokyowar.zip" md5="none">
		<part name="tokyowar_defaults.nv" crc="e8bd7d09"/>
	</rom>
	<nvram index="8" size="8192"/>

