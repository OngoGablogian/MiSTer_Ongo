<misterromdescription>
	<name>Tokyo Wars (World, TW2 Ver.A)</name>
	<setname>tokyowar</setname>
	<rbf>XNSUPER22</rbf>
	<mameversion>0287</mameversion>
	<year>1996</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System Super 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout = the FIXED slots of rtl/s22_top.sv s22_romload
	  (re-laid by tools/ss22_relayout.py; verify: tools/mra_slotcheck.py + sim/slotmap).

	    0x0000000   4.00M  maincpu     68EC020 program, 32-bit BE interleave
	    0x0400000   0.50M  mcu         M37710 data ROM (SS22 BIOS + SEQ data)
	    0x0480000   0.01M  c71         C71 DSP internal ROM (namcoc71), then pad
	    0x0500000   8.00M  sprite      32x32x8bpp sprite tiles (slot 12M)
	    0x1100000  16.00M  textile     16x16x8bpp texture tiles (slot 16M)
	    0x2100000   2.00M  ccrl        texture tilemap LO (slot 2M)
	    0x2300000   0.50M  ccrh        texture tilemap ATTR (slot 0.5M)
	    0x2380000   2.00M  point L     plane L (0x200000 per plane)
	    0x2580000   2.00M  point M     plane M (0x200000 per plane)
	    0x2780000   1.50M  point U     plane U (0x200000 per plane)
	    0x2900000   4.00M  c352        samples (true region offsets, gaps padded, tail truncated)
	    0x3500000   0.50M  point U+    U-plane bytes 0x180000+ (POINTX window -> SDRAM word 0x6C0000)
	    0x3580000         end

	  B_EEDL (eenv 2026-10-14): MAME "eeprom" region default tokyowar_defaults.nv on
	  download index 8 (cell i = CPU 0x460000+2i).
	  MAME with a blank (all-FF) EEPROM self-formats (writes 64 cells) and reaches the
	  same attract by t=30 s, so not boot-critical; loaded so the core starts from MAME's
	  shipped settings.
	-->

	<rom index="0" zip="tokyowar.zip|namcoc71.zip" md5="none">
		<interleave output="32">
			<!-- region byte o -> stream lane o^1 (halfword-exchange, hw-proven on ridgerac 2026-08-25) -->
			<part name="tw2vera.1" crc="2b17ca92" map="0100"/>
			<part name="tw2vera.2" crc="12da84e3" map="1000"/>
			<part name="tw2vera.3" crc="7d42c516" map="0001"/>
			<part name="tw2vera.4" crc="b904ed16" map="0010"/>
		</interleave>
		<part name="tw1data.8k" crc="bd046e4b"/>
		<part name="c71.bin" crc="47c623ab"/><!-- namcoc71.zip: C71 (TMS320C25) internal ROM -->
		<part repeat="0x7E000">00</part>
		<part name="tw1scg0.12f" crc="e3ec4daa"/>
