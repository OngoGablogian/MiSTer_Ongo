<!--
  E.D.F.: Earth Defense Force (set 1) — Jaleco 1991, MAME jaleco/megasys1.cpp (edf).
  Mega System 1 type B. Generated by tools/gen_ms1bcd_mra.py from
  tools/ms1_romdata.py, which is extracted from the driver; do not hand-edit.

  SDRAM image: fixed per-mode bases, each region padded to the mode's largest
  instance so the core needs one base table per mode rather than one per set.
  Total 0x2E4000 bytes.

  <switches> byte 2 is not a DIP: it is the game-mode byte, read at RUN TIME
  only (never during the ROM stream — index 254 arrives last). Bits 1:0 mode
  B/C/D, bit 4 sample clock 2 MHz, bits 6:5 protection (0 MCU, 1 simulated,
  2 none, 3 System D's own).
-->
<misterromdescription>
  <name>E.D.F.: Earth Defense Force (set 1)</name>
  <mratimestamp>202609200000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>edf</setname>
  <year>1991</year>
  <manufacturer>Jaleco</manufacturer>
  <category>Arcade</category>
  <rbf>JalecoMS1BCD</rbf>

  <switches default="FF,FF,00">
    <dip bits="0,2" name="Coin A" ids="Free_Play,1C_4C,2C_1C,1C_2C,3C_1C,1C_3C,1C_5C,1C_1C"/>
    <dip bits="3,5" name="Coin B" ids="4C_1C,1C_4C,2C_1C,1C_2C,3C_1C,1C_3C,1C_5C,1C_1C"/>
    <dip bits="6" name="Demo Sounds" ids="Off,On"/>
    <dip bits="7" name="Service Mode" ids="On,Off"/>
    <dip bits="8,10" name="DSW-B bits 2-0" ids="0,1,2,3,4,5,6,7"/>
    <dip bits="11" name="Lives" ids="4,3"/>
    <dip bits="12,13" name="Difficulty" ids="Easy,Hard,Very Hard,Normal"/>
    <dip bits="14" name="Unknown" ids="On,Off"/>
    <dip bits="15" name="Flip Screen" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="edf.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000 -->
    <interleave output="16">
      <part crc="105094d1" name="edf5.b5" map="01"/>
      <part crc="94da2f0c" name="edf_06.rom" map="10"/>
    </interleave>
    <!-- audiocpu 0x040000 @ 0x080000 -->
    <interleave output="16">
      <part crc="2290ea19" name="edf1.f5" map="01"/>
      <part crc="ce93643e" name="edf2.f3" map="10"/>
    </interleave>
    <!-- iomcu 0x004000 @ 0x0C0000 -->
    <part crc="1503026d" name="edf.mcu"/>
    <!-- scroll1 0x080000 @ 0x0C4000 -->
    <part crc="6744f406" name="edf_m04.rom"/>
    <!-- scroll2 0x080000 @ 0x144000 -->
    <part crc="6f47e456" name="edf_m05.rom"/>
    <!-- scroll3 0x020000 @ 0x1C4000 -->
    <part crc="96e38983" name="edf_09.rom"/>
    <!-- sprites 0x080000 @ 0x1E4000 -->
    <part crc="ef469449" name="edf_m03.rom"/>
    <!-- oki1 0x040000 @ 0x264000 -->
    <part crc="fc4281d2" name="edf_m02.rom"/>
    <!-- oki2 0x040000 @ 0x2A4000 -->
    <part crc="9149286b" name="edf_m01.rom"/>
  </rom>

  <!-- Priority PROM (512 B). Its own index so it reaches a write
       port on ms1_prio.sv rather than SDRAM, and so that "is any PROM
       data in the bitstream?" stays an easy question. -->
  <rom index="1" zip="edf.zip" md5="none">
    <part crc="1d877538" name="rd.20n"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for edf, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 06 4C 17 01 07 01 00
        00 06 1D 3E 00 04 00 00
        00 06 4C CB 00 01 09 09
    </part>
  </rom>
  <nvram index="4" size="268"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 06 16 F3 00 00 02 00 00 00 00 00 00
        01 00 06 19 53 00 00 02 00 00 00 00 00 00
        01 00 06 16 F5 00 00 03 00 00 00 00 00 00
        01 00 06 19 55 00 00 03 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
