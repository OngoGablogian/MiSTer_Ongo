<misterromdescription>
	<name>Space Invaders DX (US, v2.1)</name>
	<setname>spacedx</setname>
	<year>1994</year>
	<manufacturer>Taito America</manufacturer>
	<rbf>TaitoB</rbf>
	<rotation>horizontal</rotation>
	<mameversion>277</mameversion>
	<about author="slopcore" webpage="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" source="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" twitter=""/>
	<buttons default="A,B,X,Start,Select,L" names="Shoot,Button 2,Button 3,-,-,-,Start,Coin,Pause"/>

	<!--
	  Generated from MAME's ROM data and verified byte-for-byte against the
	  core's ROM image. Do not hand-edit the ROM stream.
	-->

	<rom index="0" address="0x30000000" zip="spacedx.zip">
		<!--Board config: game_t index 8 (spacedx)-->
		<part>08 00</part>

		<!--Region 0: maincpu, 68000 program, 524288 bytes-->
		<part>00080000</part>
		<interleave output="16">
			<part crc="56b0be6c" name="d89-xx.ic2" map="01"/>
			<part crc="7122751e" name="d89-06.ic18" map="10"/>
		</interleave>

		<!--Region 1: tc0180vcu graphics, 1048576 bytes-->
		<part>01100000</part>
		<interleave output="32">
			<part crc="c36544b9" name="d89-02.ic14" map="0021"/>
			<part crc="fffa0660" name="d89-01.ic9" map="2100"/>
		</interleave>

		<!--Region 2: audiocpu, Z80 program, 65536 bytes-->
		<part>02010000</part>
		<part crc="bd743401" name="d89-07.ic27"/>

		<!--Region 3: ymsnd:adpcma, 524288 bytes-->
		<part>03080000</part>
		<part crc="218f31a4" name="d89-03.ic15"/>
	</rom>

	<!--93C46 EEPROM, 128 bytes. Saved and restored by the firmware at index 2.-->
	<nvram index="2" size="128"/>
</misterromdescription>
