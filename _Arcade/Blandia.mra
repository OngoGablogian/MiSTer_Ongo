<misterromdescription>
    <name>Blandia</name>
    <setname>blandia</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Allumer</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>1A</part></rom>

    <rom index="0" zip="blandia.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="ux001001.u3" crc="2376a1f3" map="01"/>
            <part name="ux001002.u4" crc="b915e172" map="10"/>
        </interleave>
        <part repeat="524288">00</part>
        <interleave output="16">
            <part name="ux001003.u202" crc="98052c63" map="12"/>
        </interleave>
        <!-- gfx1 -->
        <part name="ux001008.u64" crc="413647b6"/>
        <part name="ux001007.u201" crc="4440fdd1"/>
        <part name="ux001006.u63" crc="abc01cf7"/>
        <part name="ux001005.u200" crc="bea0c4a5"/>
        <!-- gfx2 -->
        <interleave output="24">
            <part name="ux001009.u65" crc="bc6f6aea" offset="0x0" length="0x40000" map="001"/>
            <part name="ux001010.u66" crc="bd7f7614" offset="0x0" length="0x80000" map="120"/>
        </interleave>
        <part repeat="262144">FF 00 00</part>
        <!-- pad to 0x800000 -->
        <part repeat="524288">00</part>
        <!-- gfx3 -->
        <interleave output="24">
            <part name="ux001011.u67" crc="5efe0397" offset="0x0" length="0x40000" map="001"/>
            <part name="ux001012.u068" crc="f29959f6" offset="0x0" length="0x80000" map="120"/>
        </interleave>
        <part repeat="262144">FF 00 00</part>
        <!-- pad to 0xa00000 -->
        <part repeat="524288">00</part>
        <!-- x1snd -->
        <part name="ux001013.u69" crc="5cd273cd"/>
        <part name="ux001014.u70" crc="86b49b4e"/>
        <part repeat="524288">00</part>
    </rom>

    <switches default="FF,FF,FF" base="0">
        <dip name="Lives" bits="0,1" ids="3,2,1/1 Round,1/2 Rounds"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="2 Player Game" bits="4" ids="1 Credit,2 Credits"/>
        <dip name="Continue" bits="5" ids="1 Coin,1 Credit"/>
        <dip name="Flip Screen" bits="6" ids="On,Off"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <dip name="Demo Sounds" bits="8" ids="Off,On"/>
        <dip name="Coinage Type" bits="9" ids="Coin Mode 2,Coin Mode 1"/>
        <dip name="Coin A" bits="10,11,12" ids="Free Play,2 Coins/3 Credits,2C_5C,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="13,14,15" ids="Free Play,DSW,DSW,DSW,3 Coins/7 CreditsDSW,DSW,DSW,DSW"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>
</misterromdescription>
