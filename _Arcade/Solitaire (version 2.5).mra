<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME vamphalf.cpp; the layout is
         rtl/vh_sdram_map.svh. Do not edit by hand. -->
    <name>Solitaire (version 2.5)</name>
    <setname>solitaire</setname>
    <rbf>Vamphalf</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>F2 System</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>
    <buttons names="Column 1,Column 2,Column 3,Column 4,Start,Coin,Pause,Service Coin,Service Mode,Column 5,Column 6,Column 7,Turn Up Card,Select Turned Up Card,Register,Gift" default="A,B,X,Y,Start,Select,L,R" count="11"/>

    <!-- mod bytes (Vamphalf.sv): [0] E1-32 board, [2:1] rotation, [7:3] I/O map family;
         second byte [0] 16-bit sprite codes (gfx above 8 MB), [1] a 2 MB program, [2] 17-bit codes,
         the gfx above 16 MB at SD_GFXHI (needs the 128 MB SDRAM module) -->
    <rom index="1"><part>40 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="solitaire.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <part repeat="0x80000">00</part>  <!-- maincpu 0x80000 -->
        <part name="rom2.bin" crc="304e4338"/>
        <part repeat="0x80000">00</part>  <!-- eeprom -->
        <part repeat="0x80">FF</part>  <!-- eeprom: none in the set, the 93C46 erased -->
        <part repeat="0x7FF80">00</part>  <!-- samples -->
        <!-- oki1 samples -->
        <part name="vrom1.bin" crc="bbbf4ac8"/>
        <part repeat="0x5C0000">00</part>  <!-- gfx -->
        <!-- gfx: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="romu00.bin" crc="7fee63ac" map="2100"/>
            <part name="roml00.bin" crc="0d973625" map="0021"/>
        </interleave>
        <interleave output="32">
            <part name="romu01.bin" crc="f3f3f3e5" map="2100"/>
            <part name="roml01.bin" crc="5bba95b8" map="0021"/>
        </interleave>
    </rom>

    <nvram index="2" size="128"/>
</misterromdescription>
