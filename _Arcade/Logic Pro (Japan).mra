<!--
  Logic Pro (Japan) - Deniam 1996 - MRA for the Deniam MiSTer core.
  MAME set logicpro (MAME 0.289 sega/deniam.cpp, deniam-16b). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/MRA_FORMAT.md.

  ioctl index 1: board config byte 00 (bit 0 = deniam-16c, bit 1 = Karian Cross scroll offsets).
  ioctl index 0 stream (hps_io WIDE=1; 16-bit regions arrive as big-endian words):
    000000-0FFFFF  maincpu   MAME region 'maincpu' (word, zero padded)
    100000-27FFFF  chars     MAME region 'chars' (byte, zero padded)
    280000-67FFFF  spritegfx MAME region 'spritegfx' (word, zero padded)
    680000-77FFFF  oki       MAME region 'oki' (byte, zero padded)
    780000-78FFFF  audiocpu  MAME region 'audiocpu' (byte, zero padded)

  DIP switches (index 254): byte 0 = DSW, MAME port value (active low).
-->
<misterromdescription>
    <name>Logic Pro (Japan)</name>
    <setname>logicpro</setname>
    <parent>croquis</parent>
    <rbf>Deniam</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Deniam</manufacturer>
    <category>Puzzle</category>
    <players>2</players>
    <joystick>4-way</joystick>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Pause" default="A,B,X,Start,Select,L"/>

    <switches default="FF" base="16">
        <dip bits="0,1,2" name="Coinage" ids="Free Play,2C1C,3C1C,1C2C,3C2C,1C3C,2C3C,1C1C"/>
        <dip bits="3,4" name="Play Time" ids="Fastest,Slow,Fast,Normal"/>
        <dip bits="5,6" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
        <dip bits="7" name="Demo Sounds" ids="Off,On"/>
    </switches>

    <rom index="1">
        <part>00</part>
    </rom>
    <rom index="0" zip="logicpro.zip|croquis.zip" md5="None">
        <!-- 000000 maincpu -->
        <interleave output="16">
            <part name="logicpro.r4" crc="c506d484" map="10"/>
            <part name="logicpro.r3" crc="d5a4cf62" map="01"/>
        </interleave>
        <part repeat="0x80000">00</part>
        <!-- 100000 chars -->
        <part name="logicpro.r5" crc="dedf18c9"/>
        <part name="logicpro.r6" crc="3ecbd1c2"/>
        <part name="logicpro.r7" crc="47135521"/>
        <!-- 280000 spritegfx -->
        <interleave output="16">
            <part name="logicpro.r9" crc="a98bc1d2" map="10"/>
            <part name="logicpro.r8" crc="1de46298" map="01"/>
        </interleave>
        <part repeat="0x300000">00</part>
        <!-- 680000 oki -->
        <part name="logicpro.r1" crc="a1fec4d4"/>
        <part repeat="0x80000">00</part>
        <!-- 780000 audiocpu -->
        <part name="logicpro.r2" crc="000d624b"/>
    </rom>
</misterromdescription>
