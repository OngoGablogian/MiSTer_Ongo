	<about author="slopcore" webpage="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" source="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" twitter=""/>
	<buttons default="A,Start,Select,L" names="Shoot,-,-,-,-,-,Start,Coin,Pause"/>

	<!--
	  Generated from MAME's ROM data and verified byte-for-byte against the
	  core's ROM image. Do not hand-edit the ROM stream.
	-->

	<rom index="0" address="0x30000000" zip="pbobble.zip">
		<!--Board config: game_t index 7 (pbobble)-->
		<part>07 00</part>

		<!--Region 0: maincpu, 68000 program, 524288 bytes-->
		<part>00080000</part>
		<interleave output="16">
			<part crc="2abe07d1" name="pb-ic2.ic2" map="01"/>
			<part crc="5de14f49" name="pb-ic18.ic18" map="10"/>
		</interleave>

		<!--Region 1: tc0180vcu graphics, 1048576 bytes-->
		<part>01100000</part>
		<interleave output="32">
			<part crc="55f90ea4" name="pb-ic14.ic14" map="0021"/>
			<part crc="3253aac9" name="pb-ic9.ic9" map="2100"/>
		</interleave>

		<!--Region 2: audiocpu, Z80 program, 131072 bytes-->
		<part>02020000</part>
		<part crc="26efa4c4" name="pb-ic27.ic27"/>

		<!--Region 3: ymsnd:adpcma, 1048576 bytes-->
		<part>03100000</part>
		<part crc="0840cbc4" name="pb-ic15.ic15"/>
	</rom>

	<!--93C46 EEPROM, 128 bytes. Saved and restored by the firmware at index 2.-->
	<nvram index="2" size="128"/>
</misterromdescription>
