<misterromdescription>
    <name>Zing Zing Zip (World) / Zhen Zhen Ji Pao (China?)</name>
    <setname>zingzip</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Allumer / Tecmo</manufacturer>
    <category>Arcade</category>
    <rotation>vertical</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>15</part></rom>

    <rom index="0" zip="zingzip.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="uy001001.3" crc="1a1687ec" map="01"/>
            <part name="uy001002.4" crc="62e3b0c4" map="10"/>
        </interleave>
        <part repeat="1572864">00</part>
        <!-- gfx1 -->
        <part name="uy001006.64" crc="46e4a7d8"/>
        <part name="uy001005.63" crc="4aac128e"/>
        <!-- pad to 0x400000 -->
        <part repeat="1048576">00</part>
        <!-- gfx2 -->
        <interleave output="24">
            <part name="uy001007.65" crc="ec5b3ab9" offset="0x0" length="0x80000" map="001"/>
            <part name="uy001008.66" crc="1dff7c4b" offset="0x0" length="0x100000" map="120"/>
        </interleave>
        <part repeat="524288">00</part>
        <!-- pad to 0x800000 -->
        <part repeat="2097152">00</part>
        <!-- gfx3 -->
        <interleave output="16">
            <part name="uy001010.68" crc="bdbcdf03" map="12"/>
        </interleave>
        <part repeat="1048576">00</part>
        <!-- x1snd -->
        <part name="uy001011.70" crc="bd845f55"/>
    </rom>

    <switches default="FF,FF,FF" base="0">
        <dip name="Lives" bits="0,1" ids="5,4,2,3"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coinage" bits="4,5,6,7" ids="Free Play,8 Coins/3 Credits,5 Coins/3 Credits,3 Coins/2 Credits,2 Coins/3 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,6 Coins/1 Credit,5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>
</misterromdescription>
