<misterromdescription>
    <name>SD Gundam Neo Battling (Japan)</name>
    <setname>neobattl</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Banpresto</manufacturer>
    <category>Arcade</category>
    <rotation>vertical</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>05</part></rom>

    <rom index="0" zip="neobattl.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="bp923001.u45" crc="0d0aeb73" map="01"/>
            <part name="bp923002.u46" crc="9731fbbc" map="10"/>
        </interleave>
        <part repeat="786432">00</part>
        <!-- gfx1 -->
        <part name="bp923-003.u15" crc="91ca98a1"/>
        <part name="bp923-004.u9" crc="15c678e3"/>
        <!-- pad to 0x300000 -->
        <part repeat="1048576">00</part>
        <!-- x1snd -->
        <part name="bp923-005.u4" crc="7c0e37be"/>
    </rom>

    <switches default="FF,FF,FF" base="0">
        <dip name="Lives" bits="0,1" ids="4,3,1,2"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coinage" bits="4,5,6,7" ids="Free Play,8 Coins/3 Credits,5 Coins/3 Credits,3 Coins/2 Credits,2 Coins/3 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,6 Coins/1 Credit,5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On"/>
        <dip name="Unknown" bits="10" ids="On,Off"/>
        <dip name="Stage Select (Cheat)" bits="11" ids="On,Off"/>
        <dip name="Unknown" bits="12" ids="On,Off"/>
        <dip name="Unknown" bits="13" ids="On,Off"/>
        <dip name="Unknown" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,-,-,-,-,-,Start,Coin,Pause,Service" default="A,Start,Select,L,R" count="1"/>
</misterromdescription>
