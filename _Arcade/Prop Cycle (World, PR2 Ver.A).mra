<misterromdescription>
	<name>Prop Cycle (World, PR2 Ver.A)</name>
	<setname>propcycl</setname>
	<rbf>XNSUPER22</rbf>
	<mameversion>0287</mameversion>
	<year>1996</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System Super 22</platform>
	<rotation>horizontal</rotation>
	<region>World</region>

	<!--
	  Download-stream layout. Offsets are what the core's ROM loader decodes.
	  Derived from ROM_START(propcycl) in src/mame/namco/namcos22.cpp:6435 and
	  the device ROM in src/mame/namco/namco_dsp.cpp:41.

	    0x0000000  4.0M  maincpu     68EC020 program, 32-bit BE interleave
	    0x0400000  0.5M  mcu         pr1data.8k, SS22-BIOS ver1.41 (M37710)
	    0x0480000  8K    c71         C71 DSP internal mask ROM (namcoc71)
	    0x0500000  4.0M  sprite      32x32x8bpp, C374
	    0x0900000 16.0M  textile     16x16x8bpp texture tiles
	    0x1900000  2.5M  textilemap  CCR-L 2M + CCR-H 0.5M
	    0x1B80000  4.5M  pointrom    3D model data, 24-bit in L/M/U planes
	    0x2000000 12.0M  c352        wavea @0, GAP 4M, waveb @0x800000
	                                 (the gap is real - MAME loads waveb at
	                                  region offset 0x800000, not contiguously)
	    0x2C00000        end (46 MB)

	  Duplicate board positions in the MAME set (e.g. pr1scg0.12f == pr1scg0.12l)
	  are the SAME data at the SAME region offset; only one copy is loaded here.
	-->

	<rom index="0" zip="propcycl.zip|namcoc71.zip" md5="none">

		<!-- 0x0000000 maincpu 4 MB. ROM_LOAD32_BYTE offsets 3,2,1,0 mean
		     .4 is byte 0 (MSB) and .1 is byte 3 (LSB) of each 32-bit
		     big-endian word. Verified: reset SSP=0x00E20000 (work RAM at
		     e00000-e3ffff), reset PC=0x0000BC4C, which matches the vblank
		     spin at 0xBF5A observed live in MAME. -->
		<interleave output="32">
			<!-- 2026-08-30: remapped to the halfword-exchange convention (region byte
			     o -> stream lane o^1) hardware-proven on ridgerac 2026-08-25. The old
			     identity maps pair-swapped every word under the 2026-08-23+ MiSTer
			     main's 16-bit emission order (undetectable by sum-based checks). -->
			<part name="pr2vera.4" crc="cf4d5638" map="0010"/>
			<part name="pr2vera.3" crc="74bf4b74" map="0001"/>
			<part name="pr2vera.2" crc="c0da354a" map="1000"/>
			<part name="pr2vera.1" crc="3f58594c" map="0100"/>
		</interleave>

		<!-- 0x0400000 mcu 0.5 MB -->
		<part name="pr1data.8k" crc="2e5767a4"/>

		<!-- 0x0480000 C71 DSP internal ROM, 8 KB, from namcoc71.zip -->
		<part name="c71.bin" crc="47c623ab"/>

		<!-- pad 0x0482000 -> 0x0500000 -->
		<part repeat="0x7E000">00</part>

		<!-- 0x0500000 sprite 4 MB (canonical SS22 slot = 12 MB; pad +8 MB so textile/texmap/point
		     land at the canonical stream offsets shared with timecris. The 12 MB sprite slot IS
		     SDRAM-loaded since B_SPRITE (word 0x700000); the pad is zero tiles.) -->
		<part name="pr1scg0.12f" crc="2d09a869"/>
		<part name="pr1scg1.10f" crc="7433c5bd"/>
		<part repeat="0x800000">00</part>

		<!-- 0x1100000 textile 16 MB (canonical) -->
		<part name="pr1cg0.8d"  crc="0a041238"/>
		<part name="pr1cg1.10d" crc="7d09e6a7"/>
		<part name="pr1cg2.12d" crc="659f006e"/>
		<part name="pr1cg3.13d" crc="d30bffa3"/>
		<part name="pr1cg4.14d" crc="f4636cc9"/>
		<part name="pr1cg5.16d" crc="97d333de"/>
		<part name="pr1cg6.18d" crc="3e081c03"/>
		<part name="pr1cg7.19d" crc="ec9fc5c8"/>

		<!-- 0x1900000 textilemap 2.5 MB -->
		<part name="pr1ccrl.3d" crc="e01321fd"/>
		<part name="pr1ccrh.1d" crc="1d68bc31"/>

		<!-- 0x1B80000 pointrom: 9 x 0.5 MB in 3 planes L/M/U (1.5 MB each). The
		     geometry engine's sys22_point_read reads planes at a fixed 2 MB stride
		     (L=SDword 0x400000, M=0x500000, U=0x600000), so each 1.5 MB plane is
		     padded to 2 MB here (0x80000 bytes after L and after M) -> 5.5 MB total,
		     POINT_BYTES=0x580000 in s22_top's romload. Same "pad to 2 MB" convention
		     RR uses. c352 wave below shifts +1 MB but is not SDRAM-loaded on SS22. -->
		<part name="pr1ptrl0.18k" crc="fddb27a2"/>
		<part name="pr1ptrl1.16k" crc="6964dd06"/>
		<part name="pr1ptrl2.15k" crc="4d7ed1d4"/>
		<part repeat="0x80000">00</part>
		<part name="pr1ptrm0.18j" crc="b6f204b7"/>
		<part name="pr1ptrm1.16j" crc="949588b7"/>
		<part name="pr1ptrm2.15j" crc="dc1cef0a"/>
		<part repeat="0x80000">00</part>
		<part name="pr1ptru0.18f" crc="5d66a7c4"/>
		<part name="pr1ptru1.16f" crc="e9a3f72b"/>
		<part name="pr1ptru2.15f" crc="c346a842"/>

		<!-- 0x2000000 c352 samples. waveb sits at region offset 0x800000,
		     so a 4 MB hole must be preserved or every sample address above
		     the gap is wrong. -->
		<part name="pr1wavea.2l" crc="320f3913"/>
		<part repeat="0x400000">00</part>
		<part name="pr1waveb.1l" crc="d91acb26"/>

	</rom>

	<!-- DSW at 0x440000, 8 switches, bits 16..23 (see namcos22s_am).
	     MAME labels these "Unknown"; service mode is on INPUTS bit 3. -->
	<switches default="00" base="24">
		<dip name="DSW1" bits="0" ids="Off,On"/>
		<dip name="DSW2" bits="1" ids="Off,On"/>
		<dip name="DSW3" bits="2" ids="Off,On"/>
		<dip name="DSW4" bits="3" ids="Off,On"/>
		<dip name="DSW5" bits="4" ids="Off,On"/>
		<dip name="DSW6" bits="5" ids="Off,On"/>
		<dip name="DSW7" bits="6" ids="Off,On"/>
		<dip name="DSW8" bits="7" ids="Off,On"/>
	</switches>

	<!--
	  NOTE ON CONTROLS: the pedal is NOT an analog axis. propcycl_state drives
	  it as a timed pulse train - TIMER "pedal_update" every 20 ms plus a
	  generic pedal_interrupt (namcos22.cpp:2884/2890). The handlebar IS analog,
	  read through the M37710 ADC channels an0..an3 (mcu_adc_r<0..3>).
	  Any MiSTer mapping has to synthesise the pedal pulses, not pass an axis.
	-->

	<!-- game-appropriate labels from MAME PORT_NAMEs: "Cycle Pedal" and "Gun Trigger"
	     (namcos22.cpp propcycl inputs). Handlebar is the analog steer. Parent and clone
	     kept consistent. Provisional J1 slots; finalise with the propcycl control map. -->
	<!-- B_PCCTL 2026-09-12: MAME propcycl INPUTS = Coin/Service/Test/Start only; the handlebar is the
	     analog ADC.0/ADC.1 (left stick or D-pad/arrows, MAME KEYDELTA ramp) and the pedal is a pulse
	     train (OPT.0 "Cycle Pedal"): J1 slot 1 = Pedal button (OSD "Pedal turbo" Off/1/3), slot 2 = Start. -->
	<buttons names="Pedal,Start,-,-,-,Coin,Service,Test,-,Pause" default="A,Start,,,,Select,L,R"/>

	<!-- index-1 byte0 bit4 = Prop Cycle controls (ss22_prop in SUPER22.sv) -->
	<rom index="1"><part>10 00 00 00</part></rom>
	<!-- B_PAUSEIMG: PATREON pause screen, 640x640 RGB565 little-endian scrolling credits canvas (tools/gen_pause_image.py from
	     pause_src/pause.txt); loaded into the DDR3 pause buffer, scrolled while the core is paused. -->
	<rom index="9" address="0x30600000">
		<part>
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
