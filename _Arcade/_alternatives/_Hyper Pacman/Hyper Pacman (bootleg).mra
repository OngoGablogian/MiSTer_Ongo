<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Hyper Pacman (bootleg)</name>
    <setname>hyperpacb</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>bootleg</manufacturer>
    <category>Maze</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Jump,Fire,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>0F 10 00 00 00 18 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="hyperpacb.zip|hyperpac.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="hpacui12.bin" crc="23dc00d1" map="01"/>
            <part name="hpacuh12.bin" crc="633ab2c6" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="hyperpac.a4" crc="bd8673da"/>
        <part name="hyperpac.a5" crc="5d90cd82"/>
        <part name="hyperpac.a6" crc="61d86e63"/>
        <part repeat="0x140000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="hyperpac.u1" crc="03faf88e"/>
        <!-- oki1 -->
        <part name="hyperpac.j15" crc="fb9f468d"/>
        <part repeat="0x2200">00</part>  <!-- image end -->
    </rom>

    <switches default="FE,00,00">
        <dip name="Demo Sounds" bits="0,0" ids="On,Off"/>
        <dip name="Lives" bits="1,1" ids="5,3"/>
        <dip name="Coinage" bits="2,4" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Difficulty" bits="5,6" ids="Easy,Hardest,Hard,Normal"/>
        <dip name="Service Mode" bits="7,7" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (Pandora.sv flip_osd) -->
        <dip name="Flip Screen" bits="16,16" ids="Off,On"/>
    </switches>
</misterromdescription>
