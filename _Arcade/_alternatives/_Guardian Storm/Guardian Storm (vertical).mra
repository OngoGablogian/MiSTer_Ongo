<!--
  Guardian Storm (vertical) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 31).
  Clone of grdnstrm; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... grdnstrmv ...)
  line 10827, ROM_START(grdnstrmv), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Guardian Storm (vertical)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>grdnstrmv</setname>
  <year>1998</year>
  <manufacturer>Afega (Apples Industries license)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,1F">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Free Play" ids="On,Off"/>
    <dip bits="3" name="Bombs" ids="3,2"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,5,2,3"/>
    <dip bits="8" name="Flip Screen" ids="On,Off"/>
    <dip bits="9" name="Mirror Screen" ids="On,Off"/>
    <dip bits="10" name="Unused (SW2:6)" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="grdnstrmv.zip|grdnstrm.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 (init_grdnstrm scramble) -->
    <interleave output="16">
      <part crc="05920a99" name="afega3.u107" map="01"/>
      <part crc="16d41050" name="afega2.u112" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="afega7.u92"/>
    <!-- fgtile, 0x010000 -->
    <part crc="9e7ef086" name="afega1.u4"/>
    <!-- bgtile, 0x400000 (8bpp: two 4bpp halves) -->
    <part crc="d68588c2" name="afega_af1-b2.uc8"/>
    <part crc="f8b200a8" name="afega_af1-b1.uc3"/>
    <!-- sprites, 0x200000 (plain) -->
    <part crc="9b54ff84" name="afega6.uc13"/>
    <!-- oki1, 0x040000 -->
    <part crc="e911ce33" name="afega1.u95"/>
  </rom>
</misterromdescription>
