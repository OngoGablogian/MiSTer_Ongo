<!--
  GunNail (bootleg) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 50).
  Clone of gunnail; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... gunnailb ...)
  line 10798, ROM_START(gunnailb), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>GunNail (bootleg)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>gunnailb</setname>
  <year>1992</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FD,FF,32">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Language" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6" name="Unused (SW1:2)" ids="On,Off"/>
    <dip bits="7" name="Unused (SW1:1)" ids="On,Off"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="gunnailb.zip|gunnail.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 -->
    <interleave output="16">
      <part crc="6ba7c54d" name="27c020.6e" map="01"/>
      <part crc="b9566c46" name="27c020.6d" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x020000 (0000-7FFF fixed, 8000-BFFF = one of eight 0x4000 banks) (Kaneko's Air Buster sound program) -->
    <part crc="6e0a5df0" name="27c010.3b"/>
    <!-- fgtile, 0x020000 -->
    <part crc="6d2ca620" name="27c010.5g"/>
    <!-- bgtile, 0x100000 (the 27c160's first half, its halves are identical; NMK214-scrambled, decoded per fetch) -->
    <part crc="062100a9" name="27c160.k10" offset="0x00000" length="0x100000"/>
    <!-- sprites, 0x200000 (ROM_LOAD16_WORD_SWAP, NMK214-scrambled; gunnail's 92077-7.u134 data) -->
    <part crc="d49169b3" name="92077-7.u134"/>
    <!-- oki1, 0x040000 (3 MHz, unbanked, written by the 68000 at 0x194001) -->
    <part crc="c5f7c0d9" name="27c020.1c"/>
  </rom>
</misterromdescription>
