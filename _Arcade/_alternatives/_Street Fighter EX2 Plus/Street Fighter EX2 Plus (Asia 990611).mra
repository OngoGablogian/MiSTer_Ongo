<misterromdescription>
	<name>Street Fighter EX2 Plus (Asia 990611)</name>
	<setname>sfex2pa</setname>
	<year>1999</year>
	<manufacturer>Capcom / Arika</manufacturer>
	<category>Fighting</category>
	<players>2</players>
	<rotation>horizontal</rotation>
	<rbf>ZN2Capcom</rbf>

	<!-- idx0 BIOS coh3002c -->
	<rom index="0" zip="coh3002c.zip" md5="none"><part name="m534002c-59.ic353" crc="e860ea8b"/></rom>
	<!-- idx1 platform byte 15 (Capcom+2MB-VRAM) -->
	<rom index="1"><part>15</part></rom>
	<!-- idx2 countryrom -->
	<rom index="2" zip="sfex2pa.zip|sfex2p.zip" md5="none"><part name="x2pa_04.2h" crc="c437d602"/></rom>
	<!-- idx3 bankedroms -->
	<rom index="3" zip="sfex2pa.zip|sfex2p.zip" md5="none">
		<part name="x2p-05m.3h" crc="4ee3110f"/>
		<part name="x2p-06m.4h" crc="4cd53a45"/>
		<part name="x2p-07m.5h" crc="11207c2a"/>
		<part name="x2p-08m.2k" crc="3560c2cc"/>
		<part name="x2p-09m.3k" crc="344aa227"/>
		<part name="x2p-10m.4k" crc="2eef5931"/>
	</rom>
	<!-- idx4 mobo CAT702 key cp10 -->
	<rom index="4" zip="coh3002c.zip" md5="none"><part name="cp10.ic652" crc="7808fcef"/></rom>
	<!-- idx5 game CAT702 key -->
	<rom index="5" zip="sfex2pa.zip|sfex2p.zip" md5="none"><part name="cp12" crc="7cc2ed68"/></rom>
	<!-- idx6 Z80 -->
	<rom index="6" zip="sfex2pa.zip|sfex2p.zip" md5="none">
		<part name="x2p_02.2e" crc="3705de5e"/>
		<part name="x2p_03.3e" crc="6ae828f6"/>
	</rom>
	<!-- idx7 QSound samples -->
	<rom index="7" zip="sfex2pa.zip|sfex2p.zip" md5="none">
		<part name="x2p-01m.3a" crc="14a5bb0e"/>
	</rom>
	<!-- idx8 DSP microcode -->
	<rom index="8" zip="qsound_hle.zip" md5="none"><part name="dl-1425.bin" crc="d6cf5ef5"/></rom>

	<nvram index="9" size="2048"/>
	<switches base="96" default="00"><dip name="Service Mode" bits="1" ids="Off,On"/></switches>
	<buttons names="LP,MP,HP,LK,MK,HK,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,L3" count="6"/>
</misterromdescription>
