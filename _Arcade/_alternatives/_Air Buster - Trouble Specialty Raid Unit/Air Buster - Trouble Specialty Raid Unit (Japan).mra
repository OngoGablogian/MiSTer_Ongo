<misterromdescription>
    <name>Air Buster: Trouble Specialty Raid Unit (Japan)</name>
    <setname>airbustrj</setname>
    <mameversion>0289</mameversion>
    <year>1990</year>
    <manufacturer>Kaneko (Namco license)</manufacturer>
    <category>Shooter</category>
    <rbf>Meathax_AirBuster</rbf>
    <rotation>horizontal</rotation>
    <joystick>8-way</joystick>
    <num_buttons>2</num_buttons>
    <buttons names="Shot,Buster,Start,Coin,Pause,Service" default="A,B,Start,Select,R,L"/>
    <switches default="FF,FF" base="0">
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Coin B" bits="6,7" ids="2C/3C,2C/1C,1C/2C,1C/1C"/>
        <dip name="Difficulty" bits="8,9" ids="Very Difficult,Difficult,Easy,Normal"/>
        <dip name="Freeze" bits="11" ids="On,Off"/>
        <dip name="Lives" bits="12,13" ids="7,5,4,3"/>
        <dip name="Demo Sounds" bits="14" ids="Off,On"/>
    </switches>
    <rom index="1">
        <part>01</part>
    </rom>
    <rom index="3" description="hiscore">
        <part>00 00 00 00 00 01 00 00 00 00 00 01 00 01 01 00</part>
        <part>00 00 E1 60 40 01 01 00</part>
    </rom>
    <nvram index="4" size="64"/>
    <rom index="0" zip="airbustrj.zip|airbustr.zip" md5="6ac7b0163c9cfb4bc92afa5265e4969e">
        <!--maincpu-->
        <part name="pr-14j.bin" crc="6b9805bd"/>
        <!--subcpu-->
        <part name="pr-11j.bin" crc="85464124"/>
        <!--audiocpu-->
        <part name="pr-21.bin" crc="6e0a5df0"/>
        <!--oki-->
        <part name="pr-200.bin" crc="a4dd3390"/>
        <!--tiles-->
        <part name="pr-000.bin" crc="8ca68f0d"/>
        <!--sprites-->
        <part name="pr-001.bin" crc="7e6cb377"/>
        <part name="pr-02.bin" crc="6bbd5e46"/>
        <part repeat="0x70000">00</part>
    </rom>
</misterromdescription>
