<!--
  Nostradamus (Japan) - Face 1993 - MRA for the LINDA board MiSTer core
  (Nostradamus / Magical Cat Adventure; core file Nostradamus).
  MAME set nostj (MAME 0.289 misc/mcatadv.cpp). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/ROM_LAYOUT.md.

  ioctl index 0 stream (hps_io WIDE=1):
    000000-0FFFFF  maincpu   MAME region 'maincpu' from 0x0 (68000 words)
    100000-13FFFF  soundcpu  MAME region 'soundcpu' from 0x0 (bytes in order)
    140000-23FFFF  adpcma    MAME region 'ymsnd:adpcma' from 0x0 (bytes in order)
    240000-3BFFFF  bg0       MAME region 'bg0' from 0x0 (bytes in order)
    3C0000-53FFFF  bg1       MAME region 'bg1' from 0x0 (bytes in order)
    540000-A3FFFF  sprdata   MAME region 'sprdata' from 0x0 (bytes in order)
  sprdata 500000-7FFFFF (MAME ROMREGION_ERASEFF, no ROMs) is not sent: the core returns FF.
  ioctl index 1: game select byte 00 (00 = Nostradamus board, 01 = Magical Cat board).

  DIP switches (index 254): byte 0 = DSW1 (SW1:1-8 = bits 0-7), byte 1 = DSW2 (SW2:1-8),
  MAME port values (active low). Default FF,FF = MAME defaults.
-->
<misterromdescription>
    <name>Nostradamus (Japan)</name>
    <setname>nostj</setname>
    <rbf>Nostradamus</rbf>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Face</manufacturer>
    <category>Shooter</category>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Shot,Button 2,Button 3,Start,Coin,Service,Pause" default="A,B,X,Start,Select,R,L"/>

    <switches default="FF,FF" base="16">
        <dip bits="0,1" name="Lives" ids="5,4,2,3"/>
        <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="4" name="Flip Screen" ids="On,Off"/>
        <dip bits="5" name="Demo Sounds" ids="Off,On"/>
        <dip bits="6,7" name="Bonus Life" ids="None,1000k 2000k,500k 1000k,800k 1500k"/>
        <dip bits="8,9,10" name="Coin A" ids="Free Play,3C 2C,3C 1C,2C 3C,2C 1C,1C 3C,1C 2C,1C 1C"/>
        <dip bits="11,12,13" name="Coin B" ids="4C 1C,3C 2C,3C 1C,2C 3C,2C 1C,1C 3C,1C 2C,1C 1C"/>
        <dip bits="14" name="Unused (SW2:7)" ids="On,Off"/>
        <dip bits="15" name="Service Mode" ids="On,Off"/>
    </switches>

    <rom index="1"><part>00</part></rom>
    <rom index="0" zip="nostj.zip|nost.zip" md5="None">
        <!-- 000000 maincpu -->
        <interleave output="16">
            <part name="nos-pe-u.bin" crc="4b080149" map="10"/>
            <part name="nos-po-j.u29" crc="7fe241de" map="01"/>
        </interleave>
        <!-- 100000 soundcpu -->
        <part name="nos-ps.u9" crc="832551e9"/>
        <!-- 140000 adpcma -->
        <part name="nossn-00.u53" crc="3bd1bcbc"/>
        <!-- 240000 bg0 -->
        <part name="nos-b0-0.u58" crc="0214b0f2"/>
        <part name="nos-b0-1.u59" crc="3f8b6b34"/>
        <!-- 3C0000 bg1 -->
        <part name="nos-b1-0.u60" crc="ba6fd0c7"/>
        <part name="nos-b1-1.u61" crc="dabd8009"/>
        <!-- 540000 sprdata -->
        <interleave output="16">
            <part name="nos-se-0.u82" crc="9d99108d" map="01"/>
            <part name="nos-so-0.u83" crc="7df0fc7e" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="nos-se-1.u84" crc="aad07607" map="01"/>
            <part name="nos-so-1.u85" crc="83d0012c" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="nos-se-2.u86" crc="d99e6005" map="01"/>
            <part name="nos-so-2.u87" crc="f60e8ef3" map="10"/>
        </interleave>
    </rom>
</misterromdescription>
