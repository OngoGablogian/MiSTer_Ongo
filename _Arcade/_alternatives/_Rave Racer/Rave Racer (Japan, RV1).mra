<misterromdescription>
	<name>Rave Racer (Japan, RV1)</name>
	<setname>raveraceja</setname>
	<rbf>XNSYSTEM22</rbf>
	<mameversion>0287</mameversion>
	<year>1995</year>
	<manufacturer>Namco</manufacturer>
	<category>Arcade</category>
	<platform>Namco System 22</platform>
	<rotation>horizontal</rotation>
	<region>Japan</region>

	<!--
	  BOOT BRING-UP scope (Stage 1). Same System 22 hardware as Ridge Racer
	  (namcos22_state, C71 DSP + C74 sound, no specific KEYCUS, init == ridgerac).
	  This MRA loads ONLY maincpu + sounddata + C74/C71 BIOS - identical region
	  sizes/offsets to the Ridge Racer M1 loader, so NO core RTL change is needed
	  to boot the 68020 and run Rave Racer's code (attract/menus).

	  NB: full 3D is a Stage-2 follow-up: Rave Racer's data is DOUBLE Ridge
	  Racer's - textures 16MB (rv1cg0-7, 8 files) vs RR 8MB, point ROM 6MB
	  (rv1pot{l,m,u}0-3, 12 files) vs RR 3MB. Both overflow the RR SDRAM region
	  bases (point L/M/U at word 0x400000/0x480000/0x500000 = 0x80000/plane;
	  textures at 0x600000), so they are DELIBERATELY OMITTED here and require an
	  SDRAM remap (romload region params + texfetch/point_read bases) first.

	    0x0000000  2.0M  maincpu   68020 program, 32-bit BE interleave (rv2_prg*)
	    0x0200000  0.5M  sounddata rv1data.6r (C74 external SEQ/data)
	    0x0280000  16K   c74       C74 (M37702) internal mask ROM (shared BIOS)
	    0x0284000  8K    c71       C71 (TMS320C25) internal ROM (shared BIOS)
	-->

	<rom index="0" zip="raveraceja.zip|raverace.zip|namcoc74.zip|namcoc71.zip" md5="none">

		<!-- 0x0000000 maincpu 2 MB. ROM_LOAD32_BYTE lanes: .4d(llb)=byte3(LSB)
		     .2d(lmb)=byte2 .8d(umb)=byte1 .6d(uub)=byte0(MSB). Same halfword-group
		     map as the hw-verified Ridge Racer interleave. -->
		<interleave output="32">
			<part name="rv1_prgll.4d" crc="5dfce6cd" map="0100"/>
			<part name="rv1_prglm.2d" crc="0d4d9f74" map="1000"/>
			<part name="rv1_prgum.8d" crc="28e503e3" map="0001"/>
			<part name="rv1_prguu.6d" crc="c47d9ff4" map="0010"/>
		</interleave>

		<!-- 0x0200000 C74 external sound/SEQ data 0.5 MB -->
		<part name="rv1data.6r" crc="d358ec20"/>

		<!-- 0x0280000 C74 internal mask ROM 16 KB (shared, from namcoc74.zip) -->
		<part name="c74.bin" crc="a3dce360"/>

		<!-- 0x0284000 C71 DSP internal ROM 8 KB (shared, from namcoc71.zip) -->
		<part name="c71.bin" crc="47c623ab"/>

		<!-- ================= Stage-2 3D data (SDRAM remap) =================
		     Same fixed stream offsets + SDRAM bases as Ridge Racer's remapped MRA; Rave's
		     point planes are natively 2 MB so no padding is needed here. -->

		<!-- 0x0286000 point ROM 6 MB: L(potl0-3) M(potm0-3) U(potu0-3), each 2 MB ->
		     SDRAM word 0x400000/0x500000/0x600000 (0x100000/plane), byte-lane i&1. -->
		<part name="rv1potl0.5b" crc="de2ce519"/>
		<part name="rv1potl1.4b" crc="2215cb5a"/>
		<part name="rv1potl2.3b" crc="ddb15bf7"/>
		<part name="rv1potl3.2b" crc="fa9361ca"/>
		<part name="rv1potm0.5c" crc="3c024f3a"/>
		<part name="rv1potm1.4c" crc="b1a32a68"/>
		<part name="rv1potm2.3c" crc="a414fe15"/>
		<part name="rv1potm3.2c" crc="2953bbb4"/>
		<part name="rv1potu0.5d" crc="b9eaf3cc"/>
		<part name="rv1potu1.4d" crc="a5c55258"/>
		<part name="rv1potu2.3d" crc="c18fcb74"/>
		<part name="rv1potu3.2d" crc="79735aaa"/>

		<!-- 0x0886000 textures: FULL 16 MB (cg0-7). Rave (RAVE_RACER gametype) has NO
		     high-half tile fixup, so it uses the ENTIRE 16 MB texture ROM directly (scheme B,
		     tile_fixup_en=0 via index 1). cg0 at region start (word 0x1000000). -->
		<part name="rv1cg0.1a" crc="c518f06b"/>
		<part name="rv1cg1.1c" crc="6628f792"/>
		<part name="rv1cg2.1d" crc="0b707cc5"/>
		<part name="rv1cg3.1e" crc="39b62921"/>
		<part name="rv1cg4.1f" crc="a9791ea2"/>
		<part name="rv1cg5.1j" crc="b2c79ec1"/>
		<part name="rv1cg6.1k" crc="8cddedc2"/>
		<part name="rv1cg7.1n" crc="b39147ca"/>

		<!-- 0x1886000 texture tilemap LO 2 MB (rv1ccrl) -> SDRAM word 0x1800000 -->
		<part name="rv1ccrl.5a" crc="bc634f72"/>
		<!-- 0x1A86000 texture tilemap ATTR 0.5 MB (rv1ccrh) -> SDRAM word 0x1900000 -->
		<part name="rv1ccrh.5c" crc="a741b262"/>

		<!-- 0x1306000 C352 wave 4 MB -> SDRAM word 0xC80000. MAME c352 interleave:
		     wav0@0, wav2@0x100000, wav1@0x200000, wav3@0x300000 -> append in that order. -->
		<part name="rv1wav0.10r" crc="5aef8143"/>
		<part name="rv1wav2.10n" crc="5af9dc83"/>
		<part name="rv1wav1.10p" crc="9ed9e6b3"/>
		<part name="rv1wav3.10l" crc="ffb9ad75"/>
	</rom>
	

	<!-- EEPROM default (HN58C65, 8 KB) preloaded via the MRA on download index 8.
	     Rave Racer DOES ship a factory eeprom in its romset: rv1eeprm.9e. Loading Rave's OWN image here
	     (sets without one start blank, 0xFF, as in MAME) gives the game its own
	     factory settings record. Device byte order: byte
	     2w -> eeprom_h[w] (even lane), 2w+1 -> eeprom_l[w]; sys22_cpu EEPROM_INDEX=8. -->
	<!-- Per-game texture config (index 1, bit0): 0 = Rave/victlap use the full 16 MB texture
	     ROM directly (no RR-class high-half tile fixup/rebase). -->
	<!-- B_NOROM (2026-09-13): gamma PROMs (MAME "gamma_proms", identical 3 x 256 B) -> the core's R/G/B gamma
	     LUTs (index 2). They used to be baked into the rbf; the bitstream now ships no Namco data. -->
	<rom index="2" zip="raveraceja.zip|raverace.zip|namcoc74.zip|namcoc71.zip" md5="none">
		<part name="rr1gam.2d" crc="b2161bce"/>
		<part name="rr1gam.3d" crc="b2161bce"/>
		<part name="rr1gam.4d" crc="b2161bce"/>
	</rom>
	<rom index="1"><part>02 00 00 00</part></rom>

	<rom index="8" zip="raveraceja.zip|raverace.zip" md5="none">
		<part name="rv1eeprm.9e" crc="e00dd412"/>
	</rom>

	<!-- Rave Racer standard cabinet: steer/gas/brake/shifter via C74 shared RAM.
	     Input calibration differs from RR (per-game ADC offsets in the core) - for
	     gameplay, not boot. -->

	<buttons names="Gas,Brake,Shift Up,Shift Down,View Change,Coin,Service,Test,-,Pause" default="A,B,R,L,X,Select"/>
	<switches default="00,00,00" base="24">
		<dip bits="0" name="Test Mode (SW2:1)" ids="Off,On"/>
		<dip bits="16,17" name="Cabinet" ids="Standard,Deluxe,50 Inch,Twin"/>
	</switches>
	<nvram index="8" size="8192"/>

	<!-- index 9: PATREON pause screen (640x640 RGB565 scrolling supporter credits), written by
	     Main straight into DDR3 0x30600000 (sys22_ddrfb PAUSE_BASE); shown while paused. -->
	<!-- B_PAUSEIMG: PATREON pause screen, 640x640 RGB565 little-endian scrolling credits canvas (tools/gen_pause_image.py from
	     pause_src/pause.txt); loaded into the DDR3 pause buffer, scrolled while the core is paused. -->
	<rom index="9" address="0x30600000">
		<part>
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
