<!--
  Monky Elf (Korean bootleg of Avenging Spirit) — Jaleco 1990, MAME jaleco/megasys1.cpp (monkelf).
  Mega System 1 type B. Generated by tools/gen_ms1bcd_mra.py from
  tools/ms1_romdata.py, which is extracted from the driver; do not hand-edit.

  SDRAM image: fixed per-mode bases, each region padded to the mode's largest
  instance so the core needs one base table per mode rather than one per set.
  Total 0x2E4000 bytes.

  <switches> byte 2 is not a DIP: it is the game-mode byte, read at RUN TIME
  only (never during the ROM stream — index 254 arrives last). Bits 1:0 mode
  B/C/D, bit 4 sample clock 2 MHz, bits 6:5 protection (0 MCU, 1 simulated,
  2 none, 3 System D's own).
-->
<misterromdescription>
  <name>Monky Elf (Korean bootleg of Avenging Spirit)</name>
  <mratimestamp>202609200000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>monkelf</setname>
  <year>1990</year>
  <manufacturer>bootleg</manufacturer>
  <category>Arcade</category>
  <rbf>JalecoMS1BCD</rbf>

  <switches default="FF,FD,40">
    <dip bits="0,3" name="Coin A" ids="Free_Play,1C_1C,1C_1C,1C_1C,1C_1C,1C_1C,2C_3C,4C_1C,3C_1C,2C_1C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="4,7" name="Coin B" ids="Free_Play,1C_1C,1C_1C,1C_1C,1C_1C,1C_1C,2C_3C,4C_1C,3C_1C,2C_1C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="8" name="Flip Screen" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="On,Off"/>
    <dip bits="10" name="Allow Continue" ids="Off,On"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="13" name="Cabinet" ids="Cocktail,Upright"/>
    <dip bits="14" name="Test Mode" ids="On,Off"/>
    <dip bits="15" name="Service Mode" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="monkelf.zip|avspirit.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000 -->
    <interleave output="16">
      <part crc="40b80914" name="6" map="01"/>
      <part crc="6c45465d" name="5" map="10"/>
    </interleave>
    <!-- audiocpu 0x040000 @ 0x080000 -->
    <interleave output="16">
      <part crc="d02ec045" name="4" map="01"/>
      <part crc="30213390" name="3" map="10"/>
    </interleave>
    <!-- iomcu 0x004000 @ 0x0C0000 -->
    <part repeat="0x4000">00</part>
    <!-- scroll1 0x080000 @ 0x0C4000 -->
    <part crc="728335d4" name="8"/>
    <!-- scroll2 0x080000 @ 0x144000 -->
    <part crc="7896f6b0" name="9"/>
    <!-- scroll3 0x020000 @ 0x1C4000 -->
    <part crc="0c37edf7" name="10"/>
    <!-- sprites 0x080000 @ 0x1E4000 -->
    <part crc="2b1180b3" name="7"/>
    <!-- oki1 0x040000 @ 0x264000 -->
    <part crc="13be9979" name="1"/>
    <!-- oki2 0x040000 @ 0x2A4000 -->
    <part crc="05bc04d9" name="2"/>
    <patch offset="0x744">4E 71</patch>
  </rom>

  <!-- Priority PROM (512 B). Its own index so it reaches a write
       port on ms1_prio.sv rather than SDRAM, and so that "is any PROM
       data in the bitstream?" stays an easy question. -->
  <rom index="1" zip="monkelf.zip|avspirit.zip" md5="none">
    <part crc="547eccc0" name="82s147"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for monkelf, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 07 9D F6 00 4F 00 54
    </part>
  </rom>
  <nvram index="4" size="79"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 07 8F 8B 00 00 99 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
