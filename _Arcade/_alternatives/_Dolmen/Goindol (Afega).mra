<!--
  Goindol (Afega) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 56).
  Clone of dolmen; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... dolmenk ...)
  line 10810, ROM_START(dolmenk), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Goindol (Afega)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>dolmenk</setname>
  <year>1995</year>
  <manufacturer>Afega</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,38">
    <dip bits="0" name="Unknown (SW1:8)" ids="On,Off"/>
    <dip bits="1" name="Unknown (SW1:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Easy,Normal,Hard,Hardest"/>
    <dip bits="4" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Free Credit" ids="1500k,1000k,800k,500k"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="dolmenk.zip|dolmen.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="38491cad" name="afega_5.uj2" map="01"/>
      <part crc="834cc396" name="afega_6.uj3" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 (1st and 2nd half identical) -->
    <part crc="3d52d5f4" name="afega_1.su6"/>
    <!-- fgtile, 0x020000 -->
    <part crc="13fa4415" name="afega6.uj11"/>
    <!-- bgtile, 0x080000 -->
    <part crc="b3fa7be6" name="afega9.ui20"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="65f85cfe" name="afega_8.ub13" map="01"/>
      <part crc="f32554d4" name="afega_7.ub11" map="10"/>
    </interleave>
    <!-- oki1, 0x0A0000 - init_twinactn banks from the region BASE (not +0x80000 as ssmissin does), so the canonical [fixed][bank0..3] slots are: su12, su12, the region's own 0x20000-0x3FFFF GAP (MAME leaves it unfilled = zeros; su13 sits at 0x40000), then su13's two halves. -->
    <part crc="1a2ce1c2" name="afega2.su12"/>
    <part crc="1a2ce1c2" name="afega2.su12"/>
    <part repeat="0x20000">00</part>
    <part crc="d3531018" name="afega3.su13"/>
  </rom>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 00 21 00 00 09 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
