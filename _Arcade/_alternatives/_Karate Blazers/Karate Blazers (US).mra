<misterromdescription>
    <about author="jotego,andreabogazzi" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Karate Blazers (US)</name>
    <setname>karatblzu</setname>
    <mameversion>0282</mameversion>
    <year>1991</year>
    <manufacturer>Video System Co.</manufacturer>
    <players>4</players>
    <rbf>pspike</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="karatblzu.zip|karatblz.zip" md5="None" address="0x30000000">
        <!-- byte 1 bit 0 = pspikes  hardware
             bit 1 = turbofrc hardware
             bit 2 = aerofgt  hardware
  1[0]: pspikes    Power Spikes hardware
  1[1]: turbofrc   Turbo Force hardware: two tile layers, two sprite chips
  1[3]: karatblz   Karate Blazers hardware: 4 players, Z80 at 4MHz
  1[2]: aerofgt    Aero Fighters hardware: turbofrc map moved, 320x224 -->
        <part>
            00 08 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x100000 (20 bits) -->
        <part name="1v2.u14" crc="202e6220"/>
        <part name="v1.u15" crc="d16ee21b"/>
        <part repeat="0x80000"> FF</part>
        <!-- SCR0_START -->
        <!-- gfx1 - starts at 0x100000 - length 0x100000 (20 bits) -->
        <part name="gha.u55" crc="3e0cea91"/>
        <part repeat="0x80000"> FF</part>
        <!-- JTFRAME_BA1_START -->
        <!-- gfx4 - starts at 0x200000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="u59.ghb" crc="158c9cde" map="0021"/>
            <part name="ghd.u60" crc="73180ae3" map="2100"/>
        </interleave>
        <!-- SND_START -->
        <!-- soundbank - starts at 0x300000 - length 0x100000 (20 bits) -->
        <part name="v5.u92" crc="97d67510"/>
        <part repeat="0xE0000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- pcma - starts at 0x400000 - length 0x100000 (20 bits) -->
        <part name="u104" crc="5795e884"/>
        <!-- OBJ0_START -->
        <!-- spritegfx - starts at 0x500000 - length 0x300000 (22 bits) -->
        <interleave output="32">
            <part name="u42" crc="65f0da84" map="0021"/>
            <part name="u43" crc="7b349e5d" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="v3.u44" crc="34bdead2" map="0021"/>
            <part name="v4.u45" crc="be4d487d" map="2100"/>
        </interleave>
        <part repeat="0xC0000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- gfx2 - starts at 0x800000 - length 0x100000 (20 bits) -->
        <part name="gh9.u61" crc="5d1676bd"/>
        <part repeat="0x80000"> FF</part>
        <!-- PCMB_START -->
        <!-- pcmb - starts at 0x900000 - length 0x80000 (19 bits) -->
        <part name="u105.gh8" crc="7a68cb1b"/>
        <!-- Total 0x980000 bytes - 9728 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="ff,ab">
        <DSW/>
        <dip name="Coinage" bits="0,2" ids="1/6,1/5,1/3,1/2,4/1,3/1,2/1,1/1"/>
        <dip name="Continue" bits="3" ids="Start 2/Cont 1,Start 1/Cont 1"/>
        <dip name="Lives" bits="4" ids="1,2"/>
        <dip name="Cabinet" bits="5,6" ids="4 Players,4 Players,3 Players,2 Players"/>
        <dip name="Coin Slot" bits="7" ids="Individual,Same"/>
        <dip name="Service Mode" bits="8" ids="On,Off"/>
        <dip name="Number of Enemies" bits="9,10" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Strength of Enemies" bits="11,12" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Freeze" bits="13" ids="On,Off"/>
        <dip name="Demo Sounds" bits="14" ids="On,Off"/>
        <dip name="Flip Screen" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
