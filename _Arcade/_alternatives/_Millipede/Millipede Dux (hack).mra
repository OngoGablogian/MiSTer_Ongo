<misterromdescription>
	<name>Millipede Dux (hack)</name>
	<region>World</region>
	<homebrew>no</homebrew>
	<bootleg>yes</bootleg>
	<version></version>
	<alternative></alternative>
	<platform>Atari</platform>
	<series>Centipede</series>
	<year>1989</year>
	<manufacturer>hack (Two-Bit Score)</manufacturer>
	<category>Shooter</category>

	<setname>millipdd</setname>
	<parent>milliped</parent>
	<mameversion>0268</mameversion>
	<rbf>Millipede</rbf>
	<about author="Usquebagh" webpage="https://github.com/Usquebagh/Arcade-Millipede_MiSTer">Millipede (1982): 6502, two POKEYs, Trak-Ball. Built from schematic package SP-217.</about>

	<rotation>vertical (ccw)</rotation>
	<flip>yes</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<special_controls>trackball</special_controls>
	<num_buttons>1</num_buttons>
	<buttons default="A,Start,Select,R,L" names="Fire,Start 1P,Start 2P,Coin,Pause"/>

	<!-- Byte 0: 5D ($0408), byte 1: 5B ($0808), byte 2: 8P (trackball counters, $2000/$2001) -->
	<switches default="14,02,34">
		<dip bits="0" name="Millipede Head" ids="Easy,Hard"/>
		<dip bits="1" name="Beetle" ids="Easy,Hard"/>
		<dip bits="2,3" name="Lives" ids="2,3,4,5"/>
		<dip bits="4,5" name="Bonus Life" ids="12000,15000,20000,None"/>
		<dip bits="6" name="Spider" ids="Easy,Hard"/>
		<dip bits="7" name="Starting Score Select" ids="On,Off"/>
		<dip bits="8,9" name="Coinage" ids="Free Play,1 Coin 2 Credits,1 Coin 1 Credit,2 Coins 1 Credit"/>
		<dip bits="10,11" name="Right Coin" ids="x1,x4,x5,x6"/>
		<dip bits="12" name="Left Coin" ids="x1,x2"/>
		<dip bits="13,15" name="Bonus Coins" ids="None,3 credits/2 coins,5 credits/4 coins,6 credits/4 coins,6 credits/5 coins,4 credits/3 coins,Demo Mode" values="0,1,2,3,4,5,6"/>
		<dip bits="16,17" name="Language" ids="English,German,French,Spanish"/>
		<dip bits="18,19" name="Bonus" ids="0,0 1x,0 1x 2x,0 1x 2x 3x"/>
		<dip bits="22" name="Credit Minimum" ids="1,2"/>
	</switches>

	<!-- Layout must match the download decode in rtl/millipede.v -->
	<rom index="0" md5="none" zip="millipdd.zip|milliped.zip">
		<!-- 0000 program: CPU 4000-7FFF -->
		<part crc="40711675" name="136013-104.mn1"/>
		<part crc="fb01baf2" name="136013-103.l1"/>
		<part crc="62e137e0" name="136013-102.jk1"/>
		<part crc="46752c7d" name="136013-101.h1"/>
		<!-- 4000 picture ROMs 5R (AREA0), 5P (AREA1) -->
		<part crc="b6c617b6" name="mil-dux.5r"/>
		<part crc="2a6ef4b0" name="mil-dux.5p"/>
		<!-- 5000 sync PROM 7E -->
		<part crc="6fa3093a" name="136001-213.e7"/>
	</rom>

	<nvram index="4" size="64"/>
</misterromdescription>
