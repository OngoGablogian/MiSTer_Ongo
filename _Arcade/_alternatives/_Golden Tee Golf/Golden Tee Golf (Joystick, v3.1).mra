<misterromdescription>
    <name>Golden Tee Golf (Joystick, v3.1)</name>
    <setname>gtgj31</setname>
    <rbf>Gm0rk_ITech8</rbf>
    <mameversion>0289</mameversion>
    <mratimestamp>20261003</mratimestamp>
    <year>1990</year>
    <manufacturer>Strata / Incredible Technologies</manufacturer>
    <category>Sports / Golf</category>
    <players>4</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <num_buttons>1</num_buttons>
    <buttons names="Swing,Start,Coin,Service" default="A,Start,R,L"/>

    <romstruct>
Board select (ioctl index 1): 0F = itech8 6809 board (3), joystick and
swing button (bit 2), 64 KB program (bit 3), horizontal.
Download stream (ioctl index 0), 1,146,880 bytes:
000000 - 007FFF   32K  sound program                  -> block RAM
008000 - 017FFF   64K  main program                   -> SDRAM bank 0
018000 - 057FFF  256K  OKI samples region (128K used) -> SDRAM bank 2
058000 - 117FFF  768K  graphics ROM region            -> SDRAM bank 1
    </romstruct>

    <rom index="1">
        <part>0F</part>
    </rom>

    <rom index="0" zip="gtgj31.zip|gtg.zip" md5="ffb177718b7021e95af2b8c5efa003b1">
        <!-- sound program (sound CPU $8000-$FFFF) -->
        <part name="golf_snd-v1.1_u27.u27" crc="358d2440"/>
        <!-- main program (64 KB: banks at $4000, last 32 KB at $8000) -->
        <part name="gtg_joy_v3.1_u5.u5" crc="61984272"/>
        <!-- OKI M6295 samples -->
        <part name="golf_srom0.srom0" crc="1cccbfdf"/>
        <part repeat="0x20000">00</part>
        <!-- graphics ROMs -->
        <part name="golf_grom00.grom0" crc="a29c688a"/>
        <part name="golf_grom01.grom1" crc="b52a23f6"/>
        <part name="golf_grom02.grom2" crc="9b8e3a61"/>
        <part name="golf_grom03.grom3" crc="b6e9fb15"/>
        <part name="golf_grom04.grom4" crc="faa16729"/>
        <part name="golf_grom05.grom5" crc="5b393314"/>
    </rom>

    <!-- 8 KB battery-backed RAM (CPU $2000-$3FFF) -->
    <nvram index="4" size="8192"/>
</misterromdescription>
