<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME pirates.cpp; the layout is
         rtl/np_rom_map.svh. Do not edit by hand. -->
    <name>Pirates (set 2)</name>
    <setname>piratesb</setname>
    <rbf>NixPirates</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>NIX</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Shoot,Slide,Bomb,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- the board has no DIPs; bit 0 is the core's own flip (rtl/np_video.sv) -->
    <switches default="00" base="0">
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>

    <!-- mod byte (rtl/np_rom_map.svh): [0] 0 pirates protection patch, 1 genix -->
    <rom index="1"><part>00</part></rom>

    <rom index="0" zip="piratesb.zip|pirates.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="u15" crc="0cfd6415" map="01"/>
            <part name="u16" crc="98cece02" map="10"/>
        </interleave>
        <!-- tiles -->
        <part name="u34" crc="89fda216"/>
        <part name="u35" crc="40e069b4"/>
        <part name="u48" crc="26d78518"/>
        <part name="u49" crc="f31696ea"/>
        <!-- sprites -->
        <part name="u69" crc="c78a276f"/>
        <part name="u70" crc="9f0bad96"/>
        <part name="u71" crc="0bb7c816"/>
        <part name="u72" crc="1c41bd2c"/>
        <!-- oki -->
        <part name="u31" crc="63a739ec"/>
    </rom>

    <!-- the 93C46, which holds the game's score table -->
    <nvram index="2" size="128"/>
</misterromdescription>
