<!--
  Hacha Mecha Fighter (Location Test Prototype, 19th Sep. 1991) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 11).
  Clone of hachamf; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... hachamfp ...)
  line 10728, ROM_START(hachamfp), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Hacha Mecha Fighter (Location Test Prototype, 19th Sep. 1991)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>hachamfp</setname>
  <year>1991</year>
  <manufacturer>NMK</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,0B">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Unused (SW1:7)" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="4" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="Off,On"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="hachamfp.zip|hachamf.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="b62ad179" name="kf-68-po-b.ic6" map="01"/>
      <part crc="b98a525e" name="kf-68-pe-b.ic7" map="10"/>
    </interleave>
    <!-- NMK004 external program, 0x010000 -->
    <part crc="f7cace47" name="kf-snd.ic4"/>
    <!-- NMK004 internal boot ROM, 0x002000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- fgtile, 0x020000 -->
    <part crc="a2c1e25d" name="kf-vram.ic3"/>
    <!-- bgtile, 0x100000 (2 files) -->
    <part crc="8604adff" name="kf-scl0.ic5"/>
    <part crc="05a624e3" name="kf-scl1.ic12"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="81594aad" name="kf-obj1.ic11" map="01"/>
      <part crc="a471bbd8" name="kf-obj0.ic8" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 -->
    <part crc="e068d2cf" name="kf-a0.ic2"/>
    <!-- oki2, 0x080000 -->
    <part crc="d945aabb" name="kf-a1.ic1"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="hachamfp.zip|hachamf.zip|nmk004.zip" md5="none">
    <part crc="633ab1c9" name="82s135.ic50"/>
  </rom>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 90 03 00 00 63 00 00 00 00 00 00
        01 00 0F 53 1B 00 00 02 00 00 00 00 00 00
        01 00 0F 67 1B 00 00 02 00 00 00 00 00 00
        01 00 0F 53 29 00 00 06 00 00 00 00 00 00
        01 00 0F 67 29 00 00 06 00 00 00 00 00 00
        01 00 0F 53 2F 00 00 08 00 00 00 00 00 00
        01 00 0F 67 2F 00 00 08 00 00 00 00 00 00
    </part>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for hachamfp, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F C0 00 03 DF 01 4E
    </part>
  </rom>
  <nvram index="4" size="991"/>
</misterromdescription>
