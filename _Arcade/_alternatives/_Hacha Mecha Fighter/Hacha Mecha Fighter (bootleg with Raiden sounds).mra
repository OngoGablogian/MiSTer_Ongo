<!--
  Hacha Mecha Fighter (bootleg with Raiden sounds) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 46).
  Clone of hachamf; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... hachamfb2 ...)
  line 10784, ROM_START(hachamfb2), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Hacha Mecha Fighter (bootleg with Raiden sounds)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>hachamfb2</setname>
  <year>1991</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FD,FF,2E">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Language" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="4" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="Off,On"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="hachamfb2.zip|hachamf.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="8c8e6a3c" name="10c" map="01"/>
      <part crc="45867475" name="10e" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 (seibu_sound_map: 0000-1FFF = the file's start, the 8000-FFFF window = its second half (bank 0) or first half (bank 1)) -->
    <part crc="99ee7505" name="2.12w"/>
    <!-- fgtile, 0x020000 -->
    <part crc="a2c1e25d" name="tile.10l"/>
    <!-- bgtile, 0x100000 (hachamf's 91076-4.101 data) -->
    <part crc="df9653a4" name="91076-4.101"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair, each file's identical halves: the first is loaded) -->
    <interleave output="16">
      <part crc="4d7ddc5e" name="c.2m" offset="0x0" length="0x80000" map="01"/>
      <part crc="cb213740" name="b.2k" offset="0x0" length="0x80000" map="10"/>
    </interleave>
    <!-- oki1, 0x010000 (1 MHz, unbanked) -->
    <part crc="f6f6c4bf" name="1.14y"/>
  </rom>
</misterromdescription>
