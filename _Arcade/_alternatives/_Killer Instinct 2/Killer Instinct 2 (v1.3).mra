  <setname>kinst2</setname>
  <year>1996</year>
  <manufacturer>Rare / Nintendo (Midway license)</manufacturer>
  <category>Fighter</category>
  <rbf>KillerInstinct</rbf>

  <buttons names="High Quick,High Medium,High Fierce,Low Quick,Low Medium,Low Fierce,Start,Coin,Service,Test,-,-,-,-,-,-" default="A,B,X,Y,R,L,Start,Select"/>

  <switches default="FF,FF">
    <dip bits="0,1" name="Blood Level" ids="None,Low,Medium,High"/>
    <dip bits="2" name="Demo Sounds" ids="Off,On"/>
    <dip bits="3" name="Finishing Moves" ids="Off,On"/>
    <dip bits="4" name="Display Warning" ids="Off,On"/>
    <dip bits="8" name="Coinage Source" ids="Disk,Dipswitch"/>
    <dip bits="9,10,11" name="Coin Setting" ids="Free Play,10,9,ECA,4,3,2,1"/>
    <dip bits="12,13" name="Country" ids="Not Used,France,Germany,USA"/>
    <dip bits="14" name="Coin Counters" ids="2,1"/>
    <dip bits="15" name="Test Switch" ids="On,Off"/>
  </switches>

  <remark>
    Killer Instinct 2 dedicated-board ROM v1.3. Convert kinst2.chd to a raw
    .img with chdman.
  </remark>

