		</interleave>
		<part repeat="0xD00000">00</part>

		<interleave output="64">
			<part crc="f0781376" name="gp4-200-00.u16" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="10c4b183" name="gp4-201-00.u18" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="8374663a" name="gp4-300-00.u4" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="886ef77f" name="gp4-301-01.u7" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

