<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>galpani4k</setname>
	<name>Gals Panic 4 (Korea)</name>
	<rotation>horizontal</rotation>
	<year>1996</year>
	<manufacturer>Kaneko</manufacturer>
	<buttons names="Button 1,Button 2,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="galpani4k.zip|galpani4.zip|skns.zip" address="0x30000000">
