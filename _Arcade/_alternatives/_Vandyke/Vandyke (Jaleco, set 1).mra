<!--
  Vandyke (Jaleco, set 1) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 5).
  Clone of vandyke; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... vandykejal ...)
  line 10709, ROM_START(vandykejal), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Vandyke (Jaleco, set 1)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>vandykejal</setname>
  <year>1990</year>
  <manufacturer>UPL (Jaleco license)</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp. MiSTer matches this tag as TEXT, not as a
       number: mra_loader.cpp does strncasecmp(text, "vertical", 8), so the
       numeric form this file used to carry left is_vertical false and a
       tate cabinet never picked up MiSTer.ini's [arcade_vertical] section.
       The direction is explicit because MiSTer falls back to CW when none
       is given, and ROT270 turns counter-clockwise to stand upright (the
       core's own rotate_ccw=1 case). -->
  <rotation>vertical (ccw)</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,05">
    <dip bits="0" name="Lives" ids="2,3"/>
    <dip bits="1" name="Unused (SW1:7)" ids="On,Off"/>
    <dip bits="2" name="Unused (SW1:6)" ids="On,Off"/>
    <dip bits="3" name="Service Mode" ids="On,Off"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Demo Sounds" ids="Off,On"/>
    <dip bits="6,7" name="Difficulty" ids="Easy,Hard,Hardest,Normal"/>
    <dip bits="8" name="Flip Screen" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW2:7)" ids="On,Off"/>
    <dip bits="10,12" name="Coin B" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="vandykejal.zip|vandyke.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="170e4d2e" name="jaleco2.15" map="01"/>
      <part crc="c1d01c59" name="vdk-1.16" map="10"/>
    </interleave>
    <!-- NMK004 external program, 0x010000 -->
    <part crc="eba544f0" name="vdk-4.127"/>
    <!-- NMK004 internal boot ROM, 0x002000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- fgtile, 0x010000 -->
    <part crc="5a547c1b" name="vdk-3.222"/>
    <!-- bgtile, 0x080000 -->
    <part crc="195a24be" name="vdk-01.13"/>
    <!-- sprites, 0x200000 (two ROM_LOAD16_BYTE pairs) -->
    <interleave output="16">
      <part crc="d54722a8" name="vdk-06.203" map="01"/>
      <part crc="42d41f06" name="vdk-07.202" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="ba456d27" name="vdk-05.3-1" map="01"/>
      <part crc="0a730547" name="vdk-04.2-1" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 -->
    <part crc="b2103274" name="vdk-02.126"/>
    <!-- oki2, 0x080000 -->
    <part crc="631776d3" name="vdk-03.165"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="vandykejal.zip|vandyke.zip|nmk004.zip" md5="none">
    <part crc="98ed1c97" name="ic100.bpr"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for vandykejal, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F 01 01 00 FF 00 2E
        00 0F 00 D1 00 03 00 00
    </part>
  </rom>
  <nvram index="4" size="258"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 00 51 00 00 09 00 00 00 00 00 00
        01 00 0F 21 27 00 00 03 00 00 00 00 00 00
        01 00 0F 21 A7 00 00 03 00 00 00 00 00 00
        01 00 0F 00 B1 00 00 0A 00 00 00 00 00 00
        01 00 0F 00 C1 00 00 0A 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
