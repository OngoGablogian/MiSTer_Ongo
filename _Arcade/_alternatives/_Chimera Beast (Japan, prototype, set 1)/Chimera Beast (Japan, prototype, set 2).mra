<!--
  Chimera Beast (Japan, prototype, set 2) — Jaleco 1993, MAME jaleco/megasys1.cpp (chimeraba).
  Mega System 1 type C. Generated by tools/gen_ms1bcd_mra.py from
  tools/ms1_romdata.py, which is extracted from the driver; do not hand-edit.

  SDRAM image: fixed per-mode bases, each region padded to the mode's largest
  instance so the core needs one base table per mode rather than one per set.
  Total 0x344000 bytes.

  <switches> byte 2 is not a DIP: it is the game-mode byte, read at RUN TIME
  only (never during the ROM stream — index 254 arrives last). Bits 1:0 mode
  B/C/D, bit 4 sample clock 2 MHz, bits 6:5 protection (0 MCU, 1 simulated,
  2 none, 3 System D's own).
-->
<misterromdescription>
  <name>Chimera Beast (Japan, prototype, set 2)</name>
  <mratimestamp>202609200000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>chimeraba</setname>
  <year>1993</year>
  <manufacturer>Jaleco</manufacturer>
  <category>Arcade</category>
  <rbf>JalecoMS1BCD</rbf>

  <switches default="BD,FF,21">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="On,Off"/>
    <dip bits="2" name="Allow Continue" ids="Off,On"/>
    <dip bits="3,4" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="5,6" name="Lives" ids="4,3,1,2"/>
    <dip bits="7" name="Service Mode" ids="On,Off"/>
    <dip bits="8,11" name="Coin A" ids="Free_Play,1C_1C,1C_1C,1C_1C,1C_1C,1C_1C,2C_3C,4C_1C,3C_1C,2C_1C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="12,15" name="Coin B" ids="Free_Play,1C_1C,1C_1C,1C_1C,1C_1C,1C_1C,2C_3C,4C_1C,3C_1C,2C_1C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="chimeraba.zip|chimerab.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000 -->
    <interleave output="16">
      <part crc="d3b83ca9" name="chim3.bin" map="01"/>
      <part crc="4e66e630" name="chim2.bin" map="10"/>
    </interleave>
    <!-- audiocpu 0x020000 @ 0x080000 -->
    <interleave output="16">
      <part crc="a682b1ca" name="prg8.bin" map="01"/>
      <part crc="83b9982d" name="prg7.bin" map="10"/>
    </interleave>
    <!-- iomcu 0x004000 @ 0x0A0000 -->
    <!-- chimerab.mcu: undumped. Omitted; the core uses simulated protection. -->
    <part repeat="0x4000">00</part>
    <!-- scroll1 0x080000 @ 0x0A4000 -->
    <part crc="e4c2ac77" name="s1.bin"/>
    <!-- scroll2 0x080000 @ 0x124000 -->
    <part crc="fafb37a5" name="s2.bin"/>
    <!-- scroll3 0x020000 @ 0x1A4000 -->
    <part crc="5fe38a83" name="scr3.bin"/>
    <!-- sprites 0x100000 @ 0x1C4000 -->
    <part crc="6e7f1778" name="b2.bin"/>
    <part crc="29c0385e" name="b1.bin"/>
    <!-- oki1 0x040000 @ 0x2C4000 -->
    <part crc="14b3afe6" name="voi11.bin"/>
    <!-- oki2 0x040000 @ 0x304000 -->
    <part crc="67498914" name="voi10.bin"/>
  </rom>

  <!-- Priority PROM (512 B). Its own index so it reaches a write
       port on ms1_prio.sv rather than SDRAM, and so that "is any PROM
       data in the bitstream?" stays an easy question. -->
  <rom index="1" zip="chimeraba.zip|chimerab.zip" md5="none">
    <!-- pr-91044: MAME BAD_DUMP, a documented substitution; shipped as the best available data. -->
    <part crc="c69423d6" name="pr-91044"/>
  </rom>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 FF CB CF 00 00 09 00 00 00 00 00 00
        01 00 FF CC 7F 00 00 09 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
