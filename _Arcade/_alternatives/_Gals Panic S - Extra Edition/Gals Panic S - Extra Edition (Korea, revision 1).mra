<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>galpanisk</setname>
	<name>Gals Panic S - Extra Edition (Korea, revision 1)</name>
	<rotation>horizontal</rotation>
	<year>1997</year>
	<manufacturer>Kaneko</manufacturer>
	<buttons names="Button 1,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="galpanisk.zip|galpanis.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="a1a7acf2" name="gps-100-00.u24" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="49f764b6" name="gps-101-00.u20" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="51980272" name="gps-102-00.u17" map="12345678" />
		</interleave>
		<part repeat="0x400000">00</part>

		<interleave output="64">
			<part crc="c146a09e" name="gps-200-00.u16" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="9dfa2dc6" name="gps-201-00.u13" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<part repeat="0x1000000">00</part>

		<interleave output="64">
			<part crc="9e4da8e3" name="gps-300-00.u4" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<interleave output="64">
			<part crc="ff1c9f79" name="sknsk1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="c9ff3d8a" name="gps-000-k1.u10" map="13570" />
			<part crc="354e601d" name="gps-001-k1.u8" map="1357" />
		</interleave>
	</rom>
	<rom index="2" md5="" >
		<part>00 4B FB FF FF FF</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>