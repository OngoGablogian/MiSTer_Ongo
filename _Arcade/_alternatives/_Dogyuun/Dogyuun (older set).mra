<misterromdescription>
    <name>Dogyuun (older set)</name>
    <setname>dogyuuna</setname>
    <rbf>Dogyuun</rbf>
    <mameversion>0288</mameversion>
    <year>1992</year>
    <manufacturer>Toaplan</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Vertical (CCW)</rotation>
    <platform>Toaplan TP-022</platform>
    <category>Shoot'em up</category>

    <buttons names="Shot,Bomb or Speed,Merge or Detach,Start,Coin,Pause" default="A,B,X,Start,Select,L" count="3"/>

    <switches default="00,00,30">
        <dip name="Free Play" bits="0" ids="Off,On"/>
        <dip name="Flip Screen" bits="1" ids="Off,On"/>
        <dip name="Service Mode" bits="2" ids="Off,On"/>
        <dip name="Demo Sounds" bits="3" ids="On,Off"/>
        <dip name="Coin A" bits="4,5" ids="1/1,2/1,3/1,4/1"/>
        <dip name="Coin B" bits="6,7" ids="1/2,1/3,1/4,1/6"/>
        <dip name="Difficulty" bits="8,9" ids="Normal,Easy,Hard,Very Hard"/>
        <dip name="Bonus Life" bits="10,11" ids="200k only,200k 400k 600k,400k only,None"/>
        <dip name="Lives" bits="12,13" ids="3,5,2,1"/>
        <dip name="Invulnerability (Cheat)" bits="14" ids="Off,On"/>
        <dip name="Allow Continue" bits="15" ids="Yes,No"/>
        <dip name="Region" bits="20,23"
             values="3,1,2,0,4,5,6,8,9,10,11,13,15"
             ids="Europe,USA,USA Atari,Japan,Hong Kong no speedups,Korea no speedups,Taiwan no speedups,Southeast Asia no speedups,Hong Kong,Korea,Taiwan,Southeast Asia,Japan Taito"/>
    </switches>

    <rom index="0" zip="dogyuuna.zip|dogyuun.zip" md5="None" address="0x30000000">
        <part name="01.u64" crc="fe5bd7f4"/>

        <interleave output="32">
            <part name="tp022_3.w92" crc="191b595f" map="0021"/>
            <part name="tp022_4.w93" crc="d58d29ca" map="2100"/>
        </interleave>

        <interleave output="32">
            <part name="tp022_5.w16" crc="d4c1db45" map="0021"/>
            <part name="tp022_6.w17" crc="d48dc74f" map="2100"/>
        </interleave>

        <part name="tp022_2.w30" crc="043271b3"/>
    </rom>

    <rom index="1">
        <part>05 80</part>
    </rom>

    <!-- MAME hiscore range: main work RAM 0x10034a-0x1003c5 -->
    <rom index="4">
        <part>00 10 03 4a 00 7c 00 1b</part>
    </rom>
    <nvram index="2" size="264" />
</misterromdescription>
