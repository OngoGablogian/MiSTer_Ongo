<misterromdescription>
    <name>Lethal Enforcers II: Gun Fighters (ver UAA)</name>
    <setname>le2u</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>14</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 20); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="le2u.zip|le2.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="312uaa05.26b" crc="973aa500" map="0001"/>
            <part name="312uaa04.28b" crc="cba39552" map="0010"/>
            <part name="312uaa03.30b" crc="20bc94e6" map="0100"/>
            <part name="312uaa02.33b" crc="04f3bd9e" map="1000"/>
        </interleave>
        <part repeat="3">00</part>
        <!-- k056832: MAME's region as it is (8-byte rows, a granule each) -->
        <part repeat="393213">00</part>
        <interleave output="16">
            <part name="312a14.17h" crc="dc862f19" map="01"/>
            <part name="312a12.22h" crc="98c04ddd" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="312a15.15h" crc="516f2941" map="01"/>
            <part name="312a13.20h" crc="16e5fdaa" map="10"/>
        </interleave>
        <!-- k056832: the four-byte part of each 8-byte row, then the last 4 bytes of each (the core spreads rows to 8) -->
        <!-- k055673: MAME's region as it is -->
        <interleave output="64">
            <part name="312a11.25g" crc="5f474357" map="00000021"/>
            <part name="312a10.28g" crc="3c570d04" map="00002100"/>
            <part name="312a09.30g" crc="b2c5d6d5" map="00210000"/>
            <part name="312a08.33g" crc="29015d56" map="21000000"/>
        </interleave>
        <!-- soundcpu: MAME's region as it is -->
        <interleave output="16">
            <part name="312a06.9c" crc="ff6f2cd4" map="01"/>
            <part name="312a07.7c" crc="3d31e989" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="312a17.9g" crc="ed101448"/>
        <part name="312a18.7g" crc="5717abd7"/>
        <part repeat="1048576">00</part>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="le2u.zip|le2.zip" md5="none">
        <part name="le2u.nv" crc="d46b3878"/>
    </rom>


    <!-- MAME's hiscore.dat entries for hiscore.v (rtl/hiscore) -->
    <rom index="3">
        <part>
        22 18 07 00 3F FF 00 02 00 02 00 01 00 0F 20 00
        00 C0 3E 94 00 40 05 48
        </part>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it; then hiscore.v's tables -->
    <nvram index="4" size="192"/>

    <switches default="FF,FF">
        <dip name="Stereo" bits="0" ids="Mono,Stereo"/>
        <dip name="Coin Mechanism" bits="1" ids="Independent,Common"/>
        <dip name="Stage Select" bits="2" ids="Yes,No"/>
    </switches>

    <buttons names="Trigger,Reload,-,-,-,-,Start,Coin,Pause,Service" default="A,B,Start,Select,L,R" count="2"/>

    <!-- from Pugsy's MAME cheats (mamecheat.co.uk), scripts/mame_cheats.py: replaced
         as the CPU reads them (rtl/cheat/cheatengine.sv) -->
    <cheats size="16" max="16">
        <cheat name="Infinite Credits"                   >00000010 00C012AB 00000000 00000009</cheat>
        <cheat name="Kill Boss with 1 hit Now!"          >00000010 00C013F6 00000000 00000000</cheat>
        <cheat name="P1 Infinite Lives"                  >00000010 00C012F2 00000000 00000005</cheat>
        <cheat name="P1 Infinite Ammo"                   >00000010 00C01314 00000000 00000006</cheat>
        <cheat name="P1 Invincibility"                   >00000010 00C012F5 00000000 00000002</cheat>
        <cheat name="P1 No Victims"                      >00000010 00C01311 00000000 00000000</cheat>
        <cheat name="P1 Select Rank Now!: Posse"         >00000010 00C012F0 00000000 00000000 00000010 00C012F1 00000000 00000000</cheat>
        <cheat name="P1 Select Rank Now!: Deputy"        >00000010 00C012F0 00000000 00000001 00000010 00C012F1 00000000 00000001</cheat>
        <cheat name="P1 Select Rank Now!: Sheriff"       >00000010 00C012F0 00000000 00000002 00000010 00C012F1 00000000 00000002</cheat>
        <cheat name="P1 Select Rank Now!: Deputy Marshal">00000010 00C012F0 00000000 00000003 00000010 00C012F1 00000000 00000003</cheat>
        <cheat name="P1 Select Rank Now!: U.S. Marshal"  >00000010 00C012F0 00000000 00000004 00000010 00C012F1 00000000 00000004</cheat>
        <cheat name="P2 Infinite Lives"                  >00000010 00C01332 00000000 00000005</cheat>
        <cheat name="P2 Infinite Ammo"                   >00000010 00C01354 00000000 00000006</cheat>
        <cheat name="P2 Invincibility"                   >00000010 00C01335 00000000 00000002</cheat>
        <cheat name="P2 No Victims"                      >00000010 00C01351 00000000 00000000</cheat>
        <cheat name="P2 Select Rank Now!: Posse"         >00000010 00C01330 00000000 00000000 00000010 00C01331 00000000 00000000</cheat>
        <cheat name="P2 Select Rank Now!: Deputy"        >00000010 00C01330 00000000 00000001 00000010 00C01331 00000000 00000001</cheat>
        <cheat name="P2 Select Rank Now!: Sheriff"       >00000010 00C01330 00000000 00000002 00000010 00C01331 00000000 00000002</cheat>
        <cheat name="P2 Select Rank Now!: Deputy Marshal">00000010 00C01330 00000000 00000003 00000010 00C01331 00000000 00000003</cheat>
        <cheat name="P2 Select Rank Now!: U.S. Marshal"  >00000010 00C01330 00000000 00000004 00000010 00C01331 00000000 00000004</cheat>
    </cheats>
</misterromdescription>
