<misterromdescription>
	<name>Ashura Blaster (US)</name>
	<setname>ashurau</setname>
	<year>1990</year>
	<manufacturer>Taito America</manufacturer>
	<rbf>TaitoB</rbf>
	<rotation>vertical</rotation>
	<mameversion>277</mameversion>
	<about author="slopcore" webpage="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" source="https://github.com/Mezzow/Arcade-TaitoB_MiSTer" twitter=""/>
	<buttons default="A,B,Start,Select,L" names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause"/>

	<!--
	  Generated from MAME's ROM data and verified byte-for-byte against the
	  core's ROM image. Do not hand-edit the ROM stream.
	-->

	<rom index="0" address="0x30000000" zip="ashurau.zip|ashura.zip">
		<!--Board config: game_t index 2 (ashura)-->
		<part>02 00</part>

		<!--Region 0: maincpu, 68000 program, 524288 bytes-->
		<part>00080000</part>
		<interleave output="16">
			<part crc="e91d0ab1" name="c43-09.31" map="01"/>
			<part crc="d5aefc9b" name="c43-11.50" map="10"/>
		</interleave>
		<interleave output="16">
			<part crc="5ef4f19f" name="c43-08.30" map="01"/>
			<part crc="c218e7ea" name="c43-10.49" map="10"/>
		</interleave>

		<!--Region 1: tc0180vcu graphics, 1048576 bytes-->
		<part>01100000</part>
		<interleave output="32">
			<part crc="105722ae" name="c43-02" map="0021"/>
			<part crc="426606ba" name="c43-03" map="2100"/>
		</interleave>

		<!--Region 2: audiocpu, Z80 program, 65536 bytes-->
		<part>02010000</part>
		<part crc="cb26fce1" name="c43-16"/>

		<!--Region 3: ymsnd:adpcma, 524288 bytes-->
		<part>03080000</part>
		<part crc="db953f37" name="c43-01"/>
	</rom>

	<switches default="fffe">
		<dip name="Cabinet" bits="0" values="0,1" ids="Upright,Cocktail"/>
		<dip name="Flip Screen" bits="1" values="0,1" ids="On,Off"/>
		<dip name="Service Mode" bits="2" values="0,1" ids="On,Off"/>
		<dip name="Demo Sounds" bits="3" values="0,1" ids="Off,On"/>
		<dip name="Coinage" bits="4,5" values="0,1,2,3" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
		<dip name="Price to Continue" bits="6,7" values="0,1,2,3" ids="3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit,Same as Start"/>
		<dip name="Difficulty" bits="8,9" values="0,1,2,3" ids="Hardest,Hard,Easy,Medium"/>
		<dip name="Bonus Life" bits="10,11" values="0,1,2,3" ids="every 250k,every 200k,every 100k,every 150k"/>
		<dip name="Lives" bits="12,13" values="0,1,2,3" ids="1,2,4,3"/>
		<dip name="Allow Continue" bits="14" values="0,1" ids="Off,On"/>
		<dip name="Unknown" bits="15" values="0,1" ids="On,Off"/>
	</switches>
</misterromdescription>
