<!--
  Tenkomori Shooting (Japan, TKM1-VER.A1) - Namco 1998 - MRA for the Tenkomori MiSTer core (Namco System 12).
  MAME set tenkomorja1 (MAME 0.289 namcos12.cpp). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/MRA_FORMAT.md.

  ioctl streams (hps_io WIDE=1, little-endian 16-bit words) -> SDRAM:
    index 0  MIPS program ROM     4 MB  -> 0x0400000 (CPU 0x1FC00000)
    index 3  banked ROM          28 MB  -> 0x0800000 (0x1FA00000 window, ROM DMA)
    index 6  H8/3002 program    512 KB  -> 0x2400000 (raw file, MAME ROM_LOAD16_WORD_SWAP)
    index 7  C352 wave ROM       16 MB  -> 0x2480000
    index 9  AT28C16 EEPROM (nvram, 4 KB image of 0x1F140000-0x1F140FFF)
  Requires a 64 MB (or larger) SDRAM module.

  DDR3 fast ROM loading: Main_MiSTer copies each ROM into DDR3 at the <rom> address and sends only
  its length; the core replays it into SDRAM (rtl/tkm_fastload.sv, docs/FASTLOAD.md).
-->
<misterromdescription>
    <name>Tenkomori Shooting (Japan, TKM1/VER.A1)</name>
    <setname>tenkomorja1</setname>
    <parent>tenkomor</parent>
    <rbf>Tenkomori</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Namco</manufacturer>
    <category>Shooter / Variety</category>
    <region>Japan</region>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>vertical (cw)</rotation>
    <buttons names="Shoot,Start,Coin,Service,Test,Pause" default="A,Start,Select,R,L,R3"/>

    <rom index="0" zip="tenkomorja1.zip|tenkomor.zip" md5="None" address="0x34000000">
        <!-- MIPS program: ROM_LOAD16_BYTE pair, first file = even (low) bytes -->
        <interleave output="16">
            <part name="tkm1vera.2e" crc="d4c89229" map="01"/>
            <part name="tkm1vera.2j" crc="a6bfcaf4" map="10"/>
        </interleave>
    </rom>
    <rom index="3" zip="tenkomorja1.zip|tenkomor.zip" md5="None" address="0x34400000">
        <!-- 0000000 -->
        <interleave output="16">
            <part name="tkm1rom0l.12" crc="dddebb39" map="01"/>
            <part name="tkm1rom0u.11" crc="dbcc3838" map="10"/>
        </interleave>
        <!-- 1000000 -->
        <interleave output="16">
            <part name="tkm1fl1l.9" crc="071ef722" map="01"/>
            <part name="tkm1fl1u.10" crc="580f8391" map="10"/>
        </interleave>
        <!-- 1400000 -->
        <interleave output="16">
            <part name="tkm1fl2l.7" crc="bd54efe3" map="01"/>
            <part name="tkm1fl2u.8" crc="6e4e6320" map="10"/>
        </interleave>
        <!-- 1800000 -->
        <interleave output="16">
            <part name="tkm1fl3l.5" crc="a31ffb10" map="01"/>
            <part name="tkm1fl3u.6" crc="bc566162" map="10"/>
        </interleave>
    </rom>
    <rom index="6" zip="tenkomorja1.zip|tenkomor.zip" md5="None" address="0x36000000">
        <part name="tkm1vera.11s" crc="0b414dae"/>
    </rom>
    <rom index="7" zip="tenkomorja1.zip|tenkomor.zip" md5="None" address="0x36080000">
        <part name="tkm1wave0.2" crc="6085387d"/>
        <part name="tkm1wave1.1" crc="7567796b"/>
    </rom>
    <nvram index="9" size="4096"/>
</misterromdescription>
