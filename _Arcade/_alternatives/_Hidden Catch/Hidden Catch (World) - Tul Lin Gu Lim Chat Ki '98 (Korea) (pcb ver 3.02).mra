<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Hidden Catch (World) / Tul Lin Gu Lim Chat Ki '98 (Korea) (pcb ver 3.02)</name>
    <setname>hidnctcha</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Mark,-,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,Start,Select,L,R" count="1"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="hidnctcha.zip|hidnctch.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="hc0_u39.bin" crc="eefb6add" map="0012"/>
            <part name="hc1_u34.bin" crc="482f3e52" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="hc2_u40.bin" crc="914a1544" map="0012"/>
            <part name="hc3_u35.bin" crc="80c59133" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="hc4_u41.bin" crc="9a9e2203" map="0012"/>
            <part name="hc5_u36.bin" crc="74b1719d" map="1200"/>
        </interleave>
        <part repeat="0x800000">00</part>  <!-- maindata end -->
        <!-- maincpu -->
        <part name="3.02.u43" crc="9bb260a8"/>
        <!-- qs1000:cpu -->
        <part name="hc_u107.bin" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="hc_u111.bin" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="hc_u97.bin" crc="ebf9f77b"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="hc_u108.bin" crc="2bae46cb"/>
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Show Counters" bits="1" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
