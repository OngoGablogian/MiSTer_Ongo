<misterromdescription>
	<name>Punch-Out!! (Rev A, harder)</name>
	<setname>punchoutah</setname>
	<year>1984</year>
	<manufacturer>Nintendo</manufacturer>
	<rbf>Punchout_test</rbf>
	<rotation>horizontal</rotation>
	<mameversion>277</mameversion>
	<buttons default="B,A,Y,Select" names="Left Punch,Right Punch,KOBlow,-,Coin"></buttons>
	<switches default="ef,0f">
		<!-- SW2 -->
		<dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
		<dip name="Time" bits="2,3" ids="Longest,Long,Short,Shortest" values="3,2,1,0"/>
		<dip name="Demo Sounds" bits="4" ids="On,Off"/>
		<dip name="Rematch At A Discount" bits="5" ids="On,Off"/>
		<dip name="Service Mode" bits="7" ids="On,Off"/>
		<!-- SW1 -->
		<dip name="Coinage" bits="8,11" ids="1 Coin/1 Credit,2 Coins/1 Credit,3 Coins/1 Credit,4 Coins/1 Credit,5 Coins/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/4 Credits,1 Coin/5 Credits,1 Coin/6 Credits,1 Coin/2 Cr 2/Play,1 Coin/3 Cr 2/Play,Free Play" values="15,14,3,4,1,13,10,9,5,8,7,2,0"/>
		<!--dip name="R18 (unused)" bits="14" ids="Fitted,Not Fitted"/-->
		<dip name="Copyright (R19)" bits="15" ids="America,Japan"/>
	</switches>
