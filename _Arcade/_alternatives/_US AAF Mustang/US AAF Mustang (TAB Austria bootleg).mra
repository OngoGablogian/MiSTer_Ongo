<!--
  US AAF Mustang (TAB Austria bootleg) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 44).
  Clone of mustang; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... mustangb2 ...)
  line 10782, ROM_START(mustangb2), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>US AAF Mustang (TAB Austria bootleg)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>mustangb2</setname>
  <year>1990</year>
  <manufacturer>bootleg (TAB Austria)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,2C">
    <dip bits="0" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2,4" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="5,7" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="8" name="Flip Screen" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW1:7)" ids="On,Off"/>
    <dip bits="10,11" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="12" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="13" name="Unknown (SW1:3)" ids="On,Off"/>
    <dip bits="14,15" name="Lives" ids="5,2,4,3"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="mustangb2.zip|mustang.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="0d06f723" name="04.bin" map="01"/>
      <part crc="13c6363b" name="05.bin" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 (seibu_sound_map: 0000-1FFF = the file's start, the 8000-FFFF window = its second half (bank 0) or first half (bank 1)) -->
    <part crc="90820499" name="01.bin"/>
    <!-- fgtile, 0x020000 (mustang's 90058-1 data) -->
    <part crc="81ccfcad" name="90058-1"/>
    <!-- bgtile, 0x080000 (4 files) -->
    <part crc="5f8fdfb1" name="07.bin"/>
    <part crc="39757d6a" name="10.bin"/>
    <part crc="b3dd5243" name="08.bin"/>
    <part crc="c6c9752f" name="09.bin"/>
    <!-- sprites, 0x100000 (four ROM_LOAD16_BYTE pairs) -->
    <interleave output="16">
      <part crc="54773f95" name="13.bin" map="01"/>
      <part crc="d13f0722" name="18.bin" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="932d3e33" name="14.bin" map="01"/>
      <part crc="87c1fb43" name="17.bin" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="a62b2f87" name="15.bin" map="01"/>
      <part crc="23d03ad5" name="16.bin" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="9d3bee66" name="11.bin" map="01"/>
      <part crc="42a6cfc2" name="12.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x010000 (1.32 MHz, unbanked) -->
    <part crc="f6f6c4bf" name="02.bin"/>
  </rom>
</misterromdescription>
