<!--
  Thunder Dragon 3 (bootleg of Thunder Dragon 2) — clone of tdragon3h on the shared Family C "Macross2" rbf.
  Generated by tools/gen_family_c_mra.py from mame/src/mame/nmk/
  nmk16.cpp: GAME(... tdragon3h ...) line 10744, ROM_START(tdragon3h).
  Machine config, DIP switches and buttons are the parent's (see the
  hand-authored parent .mra for the full derivation); only the ROM
  parts differ. Files shared with the parent are looked up in the
  parent's zip as well (zip="tdragon3h.zip|tdragon2.zip").
-->
<misterromdescription>
  <name>Thunder Dragon 3 (bootleg of Thunder Dragon 2)</name>
  <mratimestamp>202609090000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tdragon3h</setname>
  <year>1996</year>
  <manufacturer>bootleg (Conny Co Ltd.)</manufacturer>
  <category>Shooter</category>
  <rbf>Macross2</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1/DSW2 defaults and the hidden game-select third byte, as the parent. -->
  <switches default="F7,FF,04">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Flip Screen" ids="On,Off"/>
    <dip bits="3" name="Unused" ids="Off,On"/>
    <dip bits="4,5" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8,11" name="Coin B" ids="5C_3C,2C_1C,3C_2C,1C_4C,4C_1C,1C_6C,2C_5C,1C_2C,4C_3C,1C_7C,3C_1C,1C_3C,3C_4C,1C_5C,2C_3C,1C_1C"/>
    <dip bits="12,15" name="Coin A" ids="Free_Play,2C_1C,3C_2C,1C_4C,4C_1C,1C_6C,2C_5C,1C_2C,4C_3C,1C_7C,3C_1C,1C_3C,3C_4C,1C_5C,2C_3C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Button 4,Start,Coin" default="Y,B,A,X,Start,R"/>

  <rom index="0" zip="tdragon3h.zip|tdragon2.zip" md5="none">
    <!-- maincpu, 0x080000 @ 0x000000 (ROM_LOAD16_BYTE pair: l = odd MAME offsets on even stream addresses) -->
    <interleave output="16">
      <part crc="4699c313" name="l.27c020" map="01"/>
      <part crc="0091f4a3" name="h.27c2001" map="10"/>
    </interleave>
    <!-- audiocpu, 0x020000 @ 0x080000 (the parent's file, 1.27c1000 in MAME's set: byte-identical) -->
    <part crc="b870be61" name="5.bin"/>
    <!-- fgtile, 0x020000 @ 0x0A0000 -->
    <part crc="f809d616" name="12.27c1000"/>
    <!-- bgtile, 0x200000 @ 0x0C0000 (2 files, tdragon2's data split) -->
    <part crc="5951c031" name="conny.3"/>
    <part crc="a7772524" name="conny.4"/>
    <!-- sprites, 0x400000 @ 0x2C0000: a ROM_LOAD16_BYTE pair then a ROM_LOAD16_WORD_SWAP file (tdragon2's data split) -->
    <interleave output="16">
      <part crc="37b32460" name="conny.1" map="01"/>
      <part crc="fefe8384" name="conny.2" map="10"/>
    </interleave>
    <part crc="baee84b2" name="ww930918.8"/>
    <!-- oki (MAME "oki2", the only chip fitted), 0x200000 @ 0x6C0000 — the core reads it from the oki1 slot in this mode; no filler for the absent oki1 -->
    <part crc="564f87ed" name="conny.6"/>
    <part crc="2e767f6f" name="conny.7"/>
  </rom>
</misterromdescription>
