<!--
  Nekketsu Koukou Dodgeball Bu (Japan, bootleg) - bootleg 1987 - MRA for the SuperDodgeBall MiSTer core.
  MAME set nkdodgeb (MAME 0.289 technos/spdodgeb.cpp). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/MRA_FORMAT.md.

  ioctl index 0 stream (hps_io WIDE=0, bytes):
    000000-00FFFF  maincpu
    010000-017FFF  audiocpu
    018000-01BFFF  mcu
    01C000-05BFFF  text
    05C000-09BFFF  sprites
    09C000-0BBFFF  adpcm
    0BC000-0BC7FF  proms

  DIP switches (index 254): byte 0 = DSW (3001); byte 1 = difficulty (IN0 bits 7-6) and the
  MCU port 5 DIPs (bits 2-1). MAME port values, active low.
-->
<misterromdescription>
    <name>Nekketsu Koukou Dodgeball Bu (Japan, bootleg)</name>
    <setname>nkdodgeb</setname>
    <parent>spdodgeb</parent>
    <rbf>SuperDodgeBall</rbf>
    <mameversion>0289</mameversion>
    <year>1987</year>
    <manufacturer>bootleg</manufacturer>
    <category>Sports / Dodgeball</category>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <buttons names="Throw,Pass,Start,Coin,Pause" default="A,B,Start,Select,L"/>

    <switches default="FF,C6" base="16">
        <dip bits="0,2" name="Coin A" ids="4C/1C,3C/1C,2C/1C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="3,5" name="Coin B" ids="4C/1C,3C/1C,2C/1C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="6" name="Flip Screen" ids="On,Off"/>
        <dip bits="7" name="Demo Sounds" ids="Off,On"/>
        <dip bits="9" name="Unknown" ids="On,Off"/>
        <dip bits="10" name="Allow Continue" ids="No,Yes"/>
        <dip bits="14,15" name="Difficulty" ids="Very Hard,Hard,Easy,Normal"/>
    </switches>

    <rom index="0" zip="nkdodgeb.zip|spdodgeb.zip" md5="None">
        <!-- 000000 maincpu -->
        <part name="12.bin" crc="aa674fd8"/>
        <!-- 010000 audiocpu -->
