        <part name="11.bin" crc="2140b070"/>
        <part name="9.bin" crc="18660ac1"/>
        <part name="8.bin" crc="5caae3c9"/>
        <!-- 05C000 sprites -->
        <part name="2.bin" crc="1271583e"/>
        <part name="1.bin" crc="5ae6cccf"/>
        <part name="4.bin" crc="f5022822"/>
