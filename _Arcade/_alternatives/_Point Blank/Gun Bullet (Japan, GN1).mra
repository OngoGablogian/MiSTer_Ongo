<!--
  Gun Bullet (Japan, GN1) - Namco NB-1 - MRA for the Namco_NB1 MiSTer core.

  GENERATED by scripts/mra/nb1_mra.py from scripts/mra/games/gunbuletj.json
  (MAME 0.289 (mame0289) metadata). Do not edit by hand; regenerate and run
  `nb1_mra.py validate`. No ROM data is embedded in this file.

  Loads the ROM set, the board record (index 2: which KEYCUS part is fitted),
  a check record (index 3) that the core uses to verify every region after
  loading, and the EEPROM (index 1: power-on image + MiSTer NVRAM
  save/restore). The C75 BIOS (c75.bin) comes from the game zip (non-merged
  sets) or from namcoc75.zip (split/merged sets).

  ioctl index 0 = the NB-1 platform ROM stream (docs/MRA_FORMAT.md):
  every MAME region in MAME byte order, padded to its fixed window, in
  platform order; stream offset == SDRAM byte address. The same layout serves
  every NB-1 game; nothing in the RBF knows which game is loaded.
-->
<misterromdescription>
    <name>Gun Bullet (Japan, GN1)</name>
    <setname>gunbuletj</setname>
    <rbf>Namco_NB1</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Namco</manufacturer>
    <platform>Namco NB-1</platform>
    <buttons names="Trigger,-,-,Start,Coin,Service" default="A,B,X,Start,Select,R"/>

    <!-- M2 check record: header + 14 entries (region, lanes, offset, length,
         CRC32 per lane). Lane CRCs equal MAME's per-file CRC32s; gap entries
         carry the CRC of the fill. Sent first so it is present when the ROM
         stream completes. -->
    <rom index="3">
        <part>
            4E 42 31 43 01 0E 00 00 20 40 80 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 00 00 00 00 40 00 C8 2D 72 06 09 C9 EF FC 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 40 00 00 00 40 00 F7 8D 46 48 71 A0 09 31 00 00 00 00 00 00 00 00 00 00 00 00
            03 01 00 00 00 00 80 00 00 00 80 00 45 BC D2 1A 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 00 00 00 00 10 00 46 12 C6 A5 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 10 00 00 00 10 00 72 97 C5 C8 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 20 00 00 00 10 00 99 D9 96 DC 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 30 00 00 00 10 00 08 C3 52 43 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            02 01 00 00 00 00 00 00 00 00 20 00 B7 7E 47 05 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 02 00 00 00 00 00 00 00 00 10 00 07 DB A4 72 9E 30 9E F9 00 00 00 00 00 00 00 00 00 00 00 00
            05 01 00 00 00 00 00 00 00 00 08 00 85 FF D4 86 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 01 00 00 00 00 00 00 00 00 02 00 38 BA 36 68 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 01 00 00 00 00 02 00 00 00 06 00 72 37 71 24 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            06 01 00 00 00 00 00 00 00 40 00 00 A5 39 F5 42 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            07 01 00 00 00 00 00 00 20 00 00 00 AD 55 0A 19 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- M7 board record (NB1B v1, 16 bytes): KEYCUS mode 0, ID $0000 (none)
         on word 0, changing value on word 0. From MAME custom_key_r NAMCONB1_GUNBULET (init_gunbulet).
         Record v3: light-gun I/O board fitted (MAME gunbulet_state gun_r at $100000).
         Format: rtl/nb1/nb1_board_config.sv. -->
    <rom index="2">
        <part>
            4E 42 31 42 03 10 00 00 00 00 00 00 00 00 01 00
        </part>
    </rom>

    <!-- M18 EEPROM (28C16, 2 KiB, MAME EEPROM_2816): index 1 carries the power-on
         image, then MiSTer replaces it with the saved .nvm if one exists and saves
         it again after the game writes the EEPROM. Both come before the ROM stream,
         so the CPU never runs before the EEPROM holds its final contents. File
         format = MAME nvram/<set>/eeprom (cell 0 first). Core: rtl/nb1/nb1_nvram.sv. -->
    <rom index="1" zip="gunbuletj.zip|ptblank.zip|namcoc75.zip" md5="none">
        <part name="eeprom" crc="95760d0f"/>
    </rom>
    <nvram index="1" size="2048"/>

    <rom index="0" zip="gunbuletj.zip|ptblank.zip|namcoc75.zip" md5="none">
        <!-- OBJ: stream 0x0000000-0x0FFFFFF, MAME region "c355spr" -->
        <!-- ROM_LOAD32_WORD: gn1obj0l.ic1 -> bytes 0-1, gn1obj0u.ic2 -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="gn1obj0l.ic1" crc="06722dc8" map="0021"/>
            <part name="gn1obj0u.ic2" crc="fcefc909" map="2100"/>
        </interleave>
        <!-- ROM_LOAD32_WORD: gn1obj1l.ic3 -> bytes 0-1, gn1obj1u.ic4 -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="gn1obj1l.ic3" crc="48468df7" map="0021"/>
            <part name="gn1obj1u.ic4" crc="3109a071" map="2100"/>
        </interleave>
        <part repeat="0x800000">00</part>
        <!-- CHR: stream 0x1000000-0x13FFFFF, MAME region "c123tmap" -->
        <part name="gn1-chr0.8j" crc="a5c61246"/>
        <part name="gn1-chr1.9j" crc="c8c59772"/>
        <part name="gn1-chr2.10j" crc="dc96d999"/>
        <part name="gn1-chr3.11j" crc="4352c308"/>
        <!-- VOICE: stream 0x1400000-0x15FFFFF, MAME region "c352" -->
        <part name="gn1-voi0.5j" crc="05477eb7"/>
        <!-- PROG: stream 0x1600000-0x16FFFFF, MAME region "maincpu" -->
        <!-- ROM_LOAD32_WORD: gn1_mpru.13b -> bytes 0-1, gn1_mprl.15b -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="gn1_mpru.13b" crc="72a4db07" map="0021"/>
            <part name="gn1_mprl.15b" crc="f99e309e" map="2100"/>
        </interleave>
        <!-- SHAPE: stream 0x1700000-0x177FFFF, MAME region "c123tmap:mask" -->
        <part name="gn1-sha0.5m" crc="86d4ff85"/>
        <!-- C75DATA: stream 0x1780000-0x17FFFFF, MAME region "c75data" -->
        <part name="gn1_spr0.5b" crc="6836ba38"/>
        <part repeat="0x60000">00</part>
        <!-- C75BIOS: stream 0x1800000-0x1803FFF, MAME region "mcu:internal" -->
        <part name="c75.bin" crc="42f539a5"/>
        <!-- KEYDATA: stream 0x1804000-0x180401F, MAME region "proms" -->
        <part repeat="0x20">00</part>
    </rom>
</misterromdescription>
