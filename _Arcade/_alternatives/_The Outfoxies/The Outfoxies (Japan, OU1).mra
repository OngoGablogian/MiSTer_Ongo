<!--
  The Outfoxies (Japan, OU1) - Namco NB-2 - MRA for the Namco_NB2 MiSTer core.

  GENERATED by scripts/mra/nb2_mra.py from scripts/mra/games/outfxiesj.json
  (MAME 0.289 (mame0289) metadata). Do not edit by hand; regenerate and run
  `nb2_mra.py validate`. No ROM data is embedded in this file.

  Index 3: check record (the core verifies every region after loading).
  Index 2: board record (KEYCUS, graphics bank transforms, hot work-RAM pages).
  Index 1: EEPROM power-on image + MiSTer NVRAM save/restore.
  Index 0: the NB-2 platform ROM stream (docs/ARCHITECTURE.md section 2.3): every MAME region in
  MAME byte order, placed in its fixed window; stream offset == physical address (below
  0x2000000 SDRAM, above it the DDR3 sprite store). The C75 BIOS (c75.bin) comes from the game
  zip (non-merged sets) or from namcoc75.zip (split/merged sets).
  address="0x30000000": DDR3 fast loading (MiSTer copies the stream into DDR3 there and the core
  replays it, rtl/nb2/nb2_fastload.sv); firmware without it streams the ROM as before.
-->
<misterromdescription>
    <name>The Outfoxies (Japan, OU1)</name>
    <setname>outfxiesj</setname>
    <rbf>Namco_NB2</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Namco</manufacturer>
    <players>4</players>
    <joystick>8-way</joystick>
    <platform>Namco NB-2</platform>
    <buttons names="Button 1,Button 2,Button 3,Start,Coin,Service" default="A,B,X,Start,Select,R"/>

    <!-- check record: header + 20 entries (region, lanes, offset, length, CRC32 per lane).
         Lane CRCs equal MAME's per-file CRC32s (lanes 0x12: one CRC over the 16-bit
         byte-swapped window = the file CRC of a ROM_LOAD16_WORD_SWAP file); gap entries carry
         the CRC of the fill. -->
    <rom index="3">
        <part>
            4E 42 32 43 01 14 00 00 00 00 40 03 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            08 01 00 00 00 00 00 00 00 00 20 00 C8 67 0C A5 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            08 01 00 00 00 00 20 00 00 00 20 00 80 67 86 14 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            08 01 00 00 00 00 40 00 00 00 20 00 AF F3 CC 55 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            08 01 00 00 00 00 60 00 00 00 20 00 7E 87 89 8D 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 00 00 00 00 20 00 E9 F2 B3 B3 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            04 01 00 00 00 00 20 00 00 00 60 00 4C 10 3F 38 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            02 01 00 00 00 00 00 00 00 00 20 00 71 B2 8F 2D 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            02 01 00 00 00 00 20 00 00 00 60 00 4C 10 3F 38 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            05 01 00 00 00 00 00 00 00 00 20 00 97 03 CB 9B 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            09 01 00 00 00 00 00 00 00 00 20 00 94 81 B4 FB 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 02 00 00 00 00 00 00 00 00 10 00 FB 08 83 D9 30 E5 B9 D3 00 00 00 00 00 00 00 00 00 00 00 00
            07 12 00 00 00 00 00 00 00 00 08 00 AD AE 49 1A 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            07 12 00 00 00 00 08 00 00 00 08 00 9D 11 BB 63 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            01 01 00 00 00 00 00 00 00 00 08 00 66 E5 CE 60 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            06 01 00 00 00 00 00 00 00 40 00 00 A5 39 F5 42 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 00 00 00 00 40 00 84 71 4F 1B 94 97 A6 D0 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 40 00 00 00 40 00 84 3E A9 48 86 E3 9D 99 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 80 00 00 00 40 00 D0 6C 38 30 F8 A5 AD CC 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 C0 00 00 00 40 00 4E B4 41 5F 8E 2C 85 BC 00 00 00 00 00 00 00 00 00 00 00 00
            03 02 00 00 00 00 00 01 00 00 40 00 D7 F9 A5 99 BB AA EC 70 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- board record (NB2B v1, 32 bytes): KEYCUS mode 1, ID $0186 (C390) on word 1, changing
         value on word 2 (MAME custom_key_r NAMCONB2_OUTFOXIES (init_outfxies)); bank transforms $0D (MAME outfxies config);
         hot work-RAM pages 208 209 20A 20B 20C 20D 20E 20F 212 213 214 215 216 217 218 219 21A 21C 220 224 225 226 228 22D 22E 235 236 240.
         Format: rtl/nb2/nb2_board_config.sv. -->
    <rom index="2">
        <part>
            4E 42 32 42 01 20 00 00 01 01 86 01 02 0D 00 00 FF FC 17 71 61 60 00 01 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <!-- EEPROM (28C16, 2 KiB, MAME EEPROM_2816): erased power-on image (MAME has no default),
         then MiSTer replaces it with the saved .nvm and saves it after the game writes it. -->
    <rom index="1">
        <part repeat="0x800">FF</part>
    </rom>
    <nvram index="1" size="2048"/>

    <rom index="0" zip="outfxiesj.zip|outfxies.zip|namcoc75.zip" md5="none" address="0x30000000">
        <!-- ROZ: stream 0x0000000-0x07FFFFF, MAME region "c169roz" -->
        <part name="ou1-rot0.3d" crc="a50c67c8"/>
        <part name="ou1-rot1.3c" crc="14866780"/>
        <part name="ou1-rot2.3b" crc="55ccf3af"/>
        <part repeat="0x200000">00</part>
        <!-- CHR: stream 0x0800000-0x0FFFFFF, MAME region "c123tmap" -->
        <part name="ou1-scr0.1d" crc="b3b3f2e9"/>
        <part repeat="0x600000">00</part>
        <!-- VOICE: stream 0x1000000-0x17FFFFF, MAME region "c352" (window = MAME region 0x0-0x3FFFFF, 0x800000-0xBFFFFF) -->
        <part name="ou1voi0.6n" crc="2d8fb271"/>
        <part repeat="0x600000">00</part>
        <!-- SHAPE: stream 0x1800000-0x19FFFFF, MAME region "c123tmap:mask" -->
        <part name="ou1shas.12s" crc="9bcb0397"/>
        <!-- ROZMASK: stream 0x1A00000-0x1BFFFFF, MAME region "c169roz:mask" -->
        <part name="ou1shar.18s" crc="fbb48194"/>
        <!-- PROG: stream 0x1C00000-0x1CFFFFF, MAME region "maincpu" -->
        <!-- ROM_LOAD32_WORD: ou1_mpru.11d -> bytes 0-1, ou1_mprl.11c -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1_mpru.11d" crc="d98308fb" map="0021"/>
            <part name="ou1_mprl.11c" crc="d3b9e530" map="2100"/>
        </interleave>
        <!-- DATA: stream 0x1D00000-0x1DFFFFF, MAME region "data" -->
        <!-- ROM_LOAD16_WORD_SWAP: the bytes of every 16-bit word exchanged -->
        <interleave output="16">
            <part name="ou1dat0.20a" crc="1a49aead" map="12"/>
        </interleave>
        <!-- ROM_LOAD16_WORD_SWAP: the bytes of every 16-bit word exchanged -->
        <interleave output="16">
            <part name="ou1dat1.20b" crc="63bb119d" map="12"/>
        </interleave>
        <!-- C75DATA: stream 0x1E00000-0x1E7FFFF, MAME region "c75data" -->
        <part name="ou1spr0.5b" crc="60cee566"/>
        <!-- C75BIOS: stream 0x1E80000-0x1E83FFF, MAME region "mcu:internal" -->
        <part name="c75.bin" crc="42f539a5"/>
        <!-- GAP: stream 0x1E84000-0x1FFFFFF, unused -->
        <part repeat="0x17C000">00</part>
        <!-- OBJ: stream 0x2000000-0x33FFFFF, MAME region "c355spr" -->
        <!-- ROM_LOAD32_WORD: ou1obj0l.4c -> bytes 0-1, ou1obj0u.8c -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1obj0l.4c" crc="1b4f7184" map="0021"/>
            <part name="ou1obj0u.8c" crc="d0a69794" map="2100"/>
        </interleave>
        <!-- ROM_LOAD32_WORD: ou1obj1l.4b -> bytes 0-1, ou1obj1u.8b -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1obj1l.4b" crc="48a93e84" map="0021"/>
            <part name="ou1obj1u.8b" crc="999de386" map="2100"/>
        </interleave>
        <!-- ROM_LOAD32_WORD: ou1obj2l.4a -> bytes 0-1, ou1obj2u.8a -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1obj2l.4a" crc="30386cd0" map="0021"/>
            <part name="ou1obj2u.8a" crc="ccada5f8" map="2100"/>
        </interleave>
        <!-- ROM_LOAD32_WORD: ou1obj3l.6c -> bytes 0-1, ou1obj3u.9c -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1obj3l.6c" crc="5f41b44e" map="0021"/>
            <part name="ou1obj3u.9c" crc="bc852c8e" map="2100"/>
        </interleave>
        <!-- ROM_LOAD32_WORD: ou1obj4l.6b -> bytes 0-1, ou1obj4u.9b -> bytes 2-3 of each longword -->
        <interleave output="32">
            <part name="ou1obj4l.6b" crc="99a5f9d7" map="0021"/>
            <part name="ou1obj4u.9b" crc="70ecaabb" map="2100"/>
        </interleave>
    </rom>
</misterromdescription>
