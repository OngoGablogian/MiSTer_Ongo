		<part repeat="8192">00</part>
		<part repeat="8192">00</part>
		<!--Region: paltop, Size: 0x600 bytes-->
		<part crc="0ad4d727" name="chs1-b-6e_pink.6e"/>
		<part crc="86f5cfdb" name="chs1-b-6f_pink.6f"/>
		<part crc="8bd406f8" name="chs1-b-7f_pink.7f"/>
		<!--Region: palbot, Size: 0x600 bytes-->
		<part crc="9e170f64" name="chs1-b-7e_white.7e"/>
		<part crc="3a2e333b" name="chs1-b-8e_white.8e"/>
		<part crc="1663eed7" name="chs1-b-8f_white.8f"/>
		<!-- Copyright check. At Z80 0x0030 (RST 30h) this build has:
		       DB 03   IN A,(03)   read DSW1
		       E6 80   AND 80h     isolate bit 7 = R19 copyright jumper
		       C8      RET Z       return ONLY if the jumper reads Nintendo
		     If it reads Nintendo of America the routine does not return and
		     falls into FF FF FF (RST 38h), so the game hangs. Rev B has 
		     C9 (unconditional RET) in the same spot and never checks.
		     Writing C9 here makes the Japan build ignore the jumper too,
		     so it runs whichever way R19 is set.
		     Disabled by default: the Copyright DIP already defaults to Japan,
		     so the check passes. Uncomment to ignore the jumper entirely. -->
		<!--patch offset="0x00034">C9</patch-->
		<!-- spnchoutj stores these char ROMs bit-inverted (MAME ROMREGION_INVERT on
		     gfx1) and linearly, where Rev B chips are scrambled and
		     not inverted. The parts above re-emit each ROM as blocks 0,2,1,3 to
		     match what the core expects. -->
		<patch offset="0x46000" operation="xor"></patch>
		<patch offset="0x46100" operation="xor"></patch>
		<patch offset="0x46200" operation="xor"></patch>
		<patch offset="0x46300" operation="xor"></patch>
		<patch offset="0x46400" operation="xor"></patch>
		<patch offset="0x46500" operation="xor"></patch>
		<patch offset="0x46600" operation="xor"></patch>
		<patch offset="0x46700" operation="xor"></patch>
		<patch offset="0x46800" operation="xor"></patch>
		<patch offset="0x46900" operation="xor"></patch>
		<patch offset="0x46A00" operation="xor"></patch>
		<patch offset="0x46B00" operation="xor"></patch>
		<patch offset="0x46C00" operation="xor"></patch>
		<patch offset="0x46D00" operation="xor"></patch>
		<patch offset="0x46E00" operation="xor"></patch>
		<patch offset="0x46F00" operation="xor"></patch>
		<patch offset="0x47000" operation="xor"></patch>
		<patch offset="0x47100" operation="xor"></patch>
		<patch offset="0x47200" operation="xor"></patch>
		<patch offset="0x47300" operation="xor"></patch>
		<patch offset="0x47400" operation="xor"></patch>
		<patch offset="0x47500" operation="xor"></patch>
		<patch offset="0x47600" operation="xor"></patch>
		<patch offset="0x47700" operation="xor"></patch>
