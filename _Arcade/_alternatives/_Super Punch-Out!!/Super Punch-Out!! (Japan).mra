		<part crc="daf74de0" name="chp1-v.6n"/>
		<part crc="4cb7ea82" name="chp1-v.8p"/>
		<part crc="1c0d09aa" name="chp1-v.8n"/>
		<!--Region: gfx1, Size: 0x8000 bytes-->
		<part crc="b017e1e9" name="b_4c_01a.bin" offset="0x0000" length="0x0800"/>
		<part crc="b017e1e9" name="b_4c_01a.bin" offset="0x1000" length="0x0800"/>
		<part crc="b017e1e9" name="b_4c_01a.bin" offset="0x0800" length="0x0800"/>
		<part crc="b017e1e9" name="b_4c_01a.bin" offset="0x1800" length="0x0800"/>
		<part repeat="8192">00</part>
