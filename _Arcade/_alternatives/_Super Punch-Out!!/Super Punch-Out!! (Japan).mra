<misterromdescription>
	<name>Super Punch-Out!! (Japan)</name>
	<setname>spnchoutj</setname>
	<year>1984</year>
	<manufacturer>Nintendo</manufacturer>
	<rbf>Punchout_test</rbf>
	<rotation>horizontal</rotation>
	<mameversion>277</mameversion>
	<buttons default="B,A,Y,X,Select" names="Left Punch,Right Punch,Duck,KOBlow,Coin"></buttons>
	<switches default="ef,8f">
		<!-- SW2 -->
		<dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
		<dip name="Time" bits="2,3" ids="Longest,Long,Short,Shortest" values="3,2,1,0"/>
		<dip name="Demo Sounds" bits="4" ids="On,Off"/>
		<dip name="Rematch At A Discount" bits="5" ids="On,Off"/>
		<dip name="Service Mode" bits="7" ids="On,Off"/>
		<!-- SW1 -->
		<dip name="Coinage" bits="8,11" ids="1 Coin/1 Credit,2 Coins/1 Credit,3 Coins/1 Credit,4 Coins/1 Credit,5 Coins/1 Credit,6 Coins/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/4 Credits,1 Coin/5 Credits,1 Coin/6 Credits,1 Coin/2 Cr 3/Play,1 Coin/3 Cr 2/Play,Free Play" values="15,14,3,12,11,7,13,10,9,5,8,4,2,0"/>
		<!--dip name="R18 (unused)" bits="14" ids="Fitted,Not Fitted"/-->
		<dip name="Copyright (R19)" bits="15" ids="America,Japan"/>
	</switches>
	<rom index="0" zip="spnchoutj.zip|spnchout.zip|punchout.zip">
		<!--Region: maincpu, Size: 0xC000 bytes-->
		<part crc="dc2a592b" name="chs1c8la.bin"/>
		<part crc="ce687182" name="chs1c8ka.bin"/>
		<part crc="1fa629e8" name="chs1-c.8j"/>
		<part crc="15a6c068" name="chs1-c.8h"/>
		<part crc="f745b5d5" name="chs1c8fa.bin"/>
		<!--Region: audiocpu, Size: 0x2000 bytes-->
		<part crc="cb6ef376" name="chp1-c.4k"/>
		<!--Region: vlm, Size: 0x4000 bytes-->
		<part crc="d05fb730" name="chs1c6pa.bin"/>
		<!--Region: gfx3, Size: 0x2C000 bytes-->
		<part crc="ff33405d" name="chs1-v.2r"/>
		<part crc="f507818b" name="chs1-v.2t"/>
		<part crc="0995fc95" name="chs1-v.2u"/>
		<part crc="f44d9878" name="chs1-v.2v"/>
		<part repeat="8192">00</part>
		<part crc="09570945" name="chs1-v.3r"/>
