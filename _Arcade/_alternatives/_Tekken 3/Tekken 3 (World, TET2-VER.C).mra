<misterromdescription>
	<name>Tekken 3 (World, TET2/VER.C)</name>
	<setname>tekken3c</setname>
	<rbf>SYSTEM12</rbf>
	<mameversion>0277</mameversion>
	<year>1997</year>
	<manufacturer>Namco</manufacturer>
	<category>Fighting</category>
	<platform>Namco System 12</platform>

	<!-- ==== SDRAM layout (see SYSTEM12.sv "ROM DETECT") ====
	     0x0000000  Main RAM      4 MB  (COH-700)
	     0x0400000  Program ROM   4 MB   ioctl 0 -> CPU 0x1FC00000 (boots directly, no BIOS)
	     0x0800000  Banked ROM   28 MB  ioctl 3 -> DMA-5 source / CPU 2 MB window @0x1FA00000
	     0x2800000  H8 program  512 KB   ioctl 6 -> H8/3002 external flash (S12_SPROG_START)
	     0x2880000  C352 wave     8 MB  ioctl 7                        (S12_WAVE_START)
	     top of image 0x3080000 (48.5 MB) - fits a 64 MB module.

	     Same 28 MB banked ROM / 8 MB wave as the parent set; only the 2x2 MB
	     program pair, the FL3 flash pair and the H8 program differ.
	-->

	<!-- ioctl 0: main program, 2x 2 MB 16-bit interleaved (first MAME ROM_LOAD16_BYTE
	     is at offset 0 = even/low byte = map "01", second is at offset 1 = map "10"). -->
	<rom index="0" zip="tekken3.zip" md5="none">
		<interleave output="16">
			<part name="tet2verc.2e" crc="4483d76e" map="01"/>
			<part name="tet2verc.2j" crc="3b4fee42" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 1: platform byte. bit5 = Namco System 12 (bit4 = System 11, must stay
	     CLEAR). bit6 = Tekken-3 JAMMA button remap. 0x64 = System 12 + the Tekken-3 remap.
	     Second byte = KEYCUS/protection id; System 12 has no emulated KEYCUS -> 0x00. -->
	<rom index="1"><part>64 00</part></rom>

	<!-- ioctl 3: banked data ROM, 28 MB. Concatenated in MAME "bankedroms" region
	     order; interleaved pairs only where MAME uses ROM_LOAD16_BYTE. -->
	<rom index="3" zip="tekken3.zip" md5="none">
		<interleave output="16">
			<part name="tet1rom0l.6" crc="2886bb32" map="01"/>
			<part name="tet1rom0u.9" crc="c5705b92" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="tet1rom1l.7"  crc="0397d283" map="01"/>
			<part name="tet1rom1u.10" crc="502ba5cd" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="tet1rom2l.8"  crc="e03b1c24" map="01"/>
			<part name="tet1rom2u.11" crc="75eb2ab3" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="tet1fl3l.12" crc="45513073" map="01"/>
			<part name="tet1fl3u.13" crc="1917d993" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 6: H8/3002 sound program, 512 KB (external flash; the H8 is ROMless).
	     MAME uses ROM_LOAD16_WORD_SWAP; the core handles the swap, ship it plain. -->
	<rom index="6" zip="tekken3.zip" md5="none">
		<part name="tet1verb.11s" crc="b13d88a9"/>
	</rom>

	<!-- ioctl 7: C352 wave ROM, 8 MB. -->
	<rom index="7" zip="tekken3.zip" md5="none">
		<part name="tet1wave0.5" crc="77ba7975"/>
		<part name="tet1wave1.4" crc="ffeba79f"/>
	</rom>

	<!-- ioctl 9: settings EEPROM (AT28C16, 2048 bytes). Persisted as .nvram save file. -->
	<nvram index="9" size="2048"/>

	<buttons names="LP,RP,LK,RK,-,-,Start,Coin,Pause" default="A,B,X,Y,,,Start,Select,L3" count="4"/>
</misterromdescription>
