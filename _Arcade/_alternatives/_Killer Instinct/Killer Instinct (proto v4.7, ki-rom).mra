<misterromdescription>
  <name>Killer Instinct (proto v4.7, ki-rom)</name>
  <mratimestamp>20261027</mratimestamp>
  <mameversion>0287</mameversion>
  <setname>kinst</setname>
  <year>1994</year>
  <manufacturer>Rare / Nintendo (Midway license)</manufacturer>
  <category>Fighter</category>
  <rbf>KillerInstinct</rbf>

  <buttons names="High Quick,High Medium,High Fierce,Low Quick,Low Medium,Low Fierce,Start,Coin,Service,Test,Pause,-,-,-,-,-" default="A,B,X,Y,R,L,Start,Select"/>

  <switches default="FF,FF">
    <dip bits="0,1" name="Blood Level" ids="None,Low,Medium,High"/>
    <dip bits="2" name="Demo Sounds" ids="Off,On"/>
    <dip bits="3" name="Finishing Moves" ids="Off,On"/>
    <dip bits="4" name="Display Warning" ids="Off,On"/>
    <dip bits="5" name="Blood Color" ids="White,Red"/>
    <dip bits="6" name="Boot Sounds" ids="Off,On"/>
    <dip bits="7" name="Wait for Input on Boot" ids="No,Yes"/>
    <dip bits="8" name="Coinage Source" ids="Disk,Dipswitch"/>
    <dip bits="9,11" name="Coin Setting" ids="Free Play,10,9,ECA,4,3,2,1"/>
    <dip bits="12,13" name="Country" ids="Not Used,France,Germany,USA"/>
    <dip bits="14" name="Coin Counters" ids="2,1"/>
    <dip bits="15" name="Test Switch" ids="On,Off"/>
  </switches>

  <!-- Game selector: 00 = Killer Instinct -->
  <rom index="0">
    <part>00</part>
  </rom>

  <remark>
    Uses the ki-rom custom boot ROM. Place ki-rom.zip in games/hbmame.
  </remark>
  
  <!-- Combined 4.5 MiB ROM image -->
  <rom index="1">
    <part zip="/hbmame/ki-rom.zip" name="19489-ki-p47.u98"/>
    <part zip="kinst.zip" name="u10-l1" crc="b6cc155f"/>
    <part zip="kinst.zip" name="u11-l1" crc="0b5e05df"/>
    <part zip="kinst.zip" name="u12-l1" crc="d05ce6ad"/>
    <part zip="kinst.zip" name="u13-l1" crc="7d0954ea"/>
    <part zip="kinst.zip" name="u33-l1" crc="8bbe4f0c"/>
    <part zip="kinst.zip" name="u34-l1" crc="b2e73603"/>
    <part zip="kinst.zip" name="u35-l1" crc="0aaef4fc"/>
    <part zip="kinst.zip" name="u36-l1" crc="0577bb60"/>
  </rom>
  
  <remark>
    Convert kinst.chd to a raw .img with chdman.
  </remark>
  
  <file type="s" index="0" path="kinst.img" delay="0"/>
</misterromdescription>
