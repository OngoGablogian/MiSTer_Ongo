	<rom index="0" zip="cybsleda.zip|cybsled.zip|namcoc67.zip" md5="none">

		<!-- 0x0000000  maincpu   0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="cy1-mpr-u.3j" crc="cc5a2e83" map="01"/>
			<part name="cy1-mpr-l.1j" crc="f7ee8b48" map="10"/>
		</interleave>

		<!-- 0x0100000  slave     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="cy1-spr-u.6c" crc="28dd707b" map="01"/>
			<part name="cy1-spr-l.4c" crc="437029de" map="10"/>
		</interleave>

		<!-- 0x0200000  data      0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="cy1-data-u.3a" crc="570da15d" map="01"/>
			<part name="cy1-data-l.1a" crc="9cf96f9e" map="10"/>
		</interleave>

		<!-- 0x0300000  edata     0x100000 -->
		<interleave output="16"><!-- 68000 BE word: -u = even byte = D15-D8 -->
			<part name="cy1-edata0-u.3b" crc="77452533" map="01"/>
			<part name="cy1-edata0-l.1b" crc="e812e290" map="10"/>
		</interleave>

		<!-- 0x0400000  gap_obj   0x200000 -->
		<part repeat="0x200000">FF</part>

		<!-- 0x0600000  point24   0x400000 -->
		<interleave output="32"><!-- {H,H,U,L}: MAME lane 0 is the never-loaded 0x00 of the 32-bit BE word; MRA cannot emit a constant lane, so *-h is repeated there.  The core must ignore stream byte 4n. -->
			<part name="cy1-poi-h1.2f" crc="eaf8bac3" map="0001"/>
			<part name="cy1-poi-h1.2f" crc="eaf8bac3" map="0010"/>
			<part name="cy1-poi-lu1.2k" crc="c544a8dc" map="0100"/>
			<part name="cy1-poi-ll1.2n" crc="30acb99b" map="1000"/>
		</interleave>
		<interleave output="32"><!-- {H,H,U,L}: MAME lane 0 is the never-loaded 0x00 of the 32-bit BE word; MRA cannot emit a constant lane, so *-h is repeated there.  The core must ignore stream byte 4n. -->
			<part name="cy1-poi-h2.2j" crc="4079f342" map="0001"/>
			<part name="cy1-poi-h2.2j" crc="4079f342" map="0010"/>
			<part name="cy1-poi-lu2.2l" crc="61d816d4" map="0100"/>
			<part name="cy1-poi-ll2.2p" crc="faf09158" map="1000"/>
		</interleave>

		<!-- 0x0A00000  c67       0x002000 -->
		<part name="c67.bin" crc="6bd8988e"/><!-- namcoc67.zip: shared master+slave DSP internal ROM -->

		<!-- 0x0A02000  gap_a     0x002000 -->
		<part repeat="0x2000">FF</part>

		<!-- 0x0A04000  nvram     0x002000 -->
		<part name="cybsleda.nv" crc="a73bb03e"/><!-- default settings incl. analog calibration -->

		<!-- 0x0A06000  gap_b     0x1FA000 -->
		<part repeat="0x1FA000">FF</part>

		<!-- 0x0C00000  c140      0x200000 -->
		<part name="cy1-voi0.12b" crc="99d7ce46"/>
		<part name="cy1-voi1.12c" crc="2b335f06"/>
		<part name="cy1-voi2.12d" crc="10cd15f0"/>
		<part name="cy1-voi3.12e" crc="c902b4a4"/>

		<!-- 0x0E00000  audiocpu  0x020000 -->
		<part name="cy1-snd0.8j" crc="3dddf83b"/>

		<!-- 0x0E20000  gap_wram  0x1E0000 -->
		<part repeat="0x1E0000">00</part>

		<!-- 0x1000000  c355spr   0x400000 -->
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="cy1-obj0.5s" crc="5ae542d5" map="0001"/>
			<part name="cy1-obj1.5x" crc="4aae3eff" map="0010"/>
			<part name="cy1-obj2.3s" crc="d64ec4c3" map="0100"/>
			<part name="cy1-obj3.3x" crc="3d1f7168" map="1000"/>
		</interleave>
		<interleave output="32"><!-- objN feeds pixel columns x%4==N (linear 8bpp, 16 bytes/row) -->
			<part name="cy1-obj4.4s" crc="57904076" map="0001"/>
			<part name="cy1-obj5.4x" crc="0e11ca47" map="0010"/>
			<part name="cy1-obj6.2s" crc="7748b485" map="0100"/>
			<part name="cy1-obj7.2x" crc="b6eb6ad2" map="1000"/>
		</interleave>
	</rom>

	<!-- C68 DSW port ($2000, namcos21_c67.cpp:658-680).  MAME reads it ACTIVE LOW;
	     the OSD bit here is the LOGICAL switch (1 = On) and the core inverts:
	     dsw_port[n] = ~status[24+n].  Unnamed switches keep MAME's "DSWn" label. -->
	<switches default="20" base="24">
		<dip name="Test Mode (SW:1)" bits="0" ids="Off,On"/>
		<dip name="DSW2 (SW:2)" bits="1" ids="Off,On"/>
		<dip name="DSW3 (SW:3)" bits="2" ids="Off,On"/>
		<dip name="DSW4 (SW:4)" bits="3" ids="Off,On"/>
		<dip name="DSW5 (SW:5)" bits="4" ids="Off,On"/>
		<dip name="PCM ROM (SW:6)" bits="5" ids="2M,4M"/>
		<dip name="DSW7 (SW:7)" bits="6" ids="Off,On"/>
		<dip name="Screen Stop (SW:8)" bits="7" ids="Off,On"/>
	</switches>

	<buttons names="Gun,Start,Missile,View Change,-,Coin,Service,Test,Start 2,Pause" default="A,Start,B,X,,Select,L,R,,"/>
</misterromdescription>
