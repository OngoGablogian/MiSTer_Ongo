	    0x0300000  0x100000  edata     0x100000 from files, 0x000000 pad 0xFF
	    0x0400000  0x200000  gap_obj   0x000000 from files, 0x200000 pad 0xFF
	    0x0600000  0x400000  point24   0x400000 from files, 0x000000 pad 0x00
	    0x0A00000  0x002000  c67       0x002000 from files, 0x000000 pad 0x00
	    0x0A02000  0x002000  gap_a     0x000000 from files, 0x002000 pad 0xFF
