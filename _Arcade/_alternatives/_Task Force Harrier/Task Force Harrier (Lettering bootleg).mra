<!--
  Task Force Harrier (Lettering bootleg) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 55).
  Clone of tharrier; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... tharrierb ...)
  line 10792, ROM_START(tharrierb), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Task Force Harrier (Lettering bootleg)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tharrierb</setname>
  <year>1989</year>
  <manufacturer>bootleg (Lettering)</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="00,00,37">
    <dip bits="0,1" name="Lives" ids="3,2,4,5"/>
    <dip bits="2,3" name="Bonus Life" ids="200k,None,200k 1000k,200k 500k 1000k 2000k 3000k 5000k"/>
    <dip bits="4,5" name="Difficulty" ids="Normal,Easy,Hard,Hardest"/>
    <dip bits="6" name="Unused (DSW1:7)" ids="Off,On"/>
    <dip bits="7" name="Cabinet" ids="Upright,Cocktail"/>
    <dip bits="8,10" name="Coin B" ids="1C_1C,1C_2C,1C_3C,1C_4C,2C_1C,3C_1C,4C_1C,Free Play"/>
    <dip bits="11,13" name="Coin A" ids="1C_1C,1C_2C,1C_3C,1C_4C,2C_1C,3C_1C,4C_1C,Free Play"/>
    <dip bits="14" name="Demo Sounds" ids="On,Off"/>
    <dip bits="15" name="Unused (DSW2:8)" ids="Off,On"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="tharrierb.zip|tharrier.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="65c247f6" name="3.21b" map="01"/>
      <part crc="d55d21c7" name="cpua" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="b959f837" name="12.4l"/>
    <!-- mcu, 0x001000 (the whole MC68705R3 image: user EPROM, bootstrap ROM and vectors) -->
    <part crc="c560798b" name="mc68705r35.bin"/>
    <!-- fgtile, 0x008000 — half the original's. MAME wraps tile codes modulo the region's own tile count (gfx_element::get_data does code %= total), so the family's 0x010000 slot is filled with a SECOND COPY rather than zeros: that reproduces the wrap exactly for the codes above 1023. -->
    <part crc="4e9a7e0b" name="t.256"/>
    <part crc="4e9a7e0b" name="t.256"/>
    <!-- bgtile, 0x080000 (8 files) -->
    <part crc="9b97073c" name="10h.512"/>
    <part crc="d5a90bd5" name="21h.512"/>
    <part crc="3d4a03ac" name="12h.512"/>
    <part crc="edecb4c8" name="24h.512"/>
    <part crc="c20d20ed" name="11h.512"/>
    <part crc="c7949c45" name="23h.512"/>
    <part crc="7f38e700" name="22h.512"/>
    <part crc="43499c11" name="9h.512"/>
    <!-- sprites, 0x100000 (8 ROM_LOAD16_BYTE pairs) -->
    <interleave output="16">
      <part crc="203b88f8" name="l10.512" map="01"/>
      <part crc="b1537a3b" name="l3.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="0c5cef0e" name="l15.512" map="01"/>
      <part crc="060ed368" name="l1.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="6b637cda" name="l16.512" map="01"/>
      <part crc="d62b4a9e" name="l2.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="dfabc192" name="l14.512" map="01"/>
      <part crc="5f249283" name="l6.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="3ac04d8f" name="l11.512" map="01"/>
      <part crc="5e51cdfa" name="l5.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="85445005" name="l12.512" map="01"/>
      <part crc="0a8b8eca" name="l8.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="5cf2b63b" name="l13.512" map="01"/>
      <part crc="19f82acd" name="l4.512" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="4c5a8f33" name="l9.512" map="01"/>
      <part crc="fc99519f" name="l7.512" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 (8 files) -->
    <part crc="f509f5ca" name="8h.512"/>
    <part crc="1a0ec174" name="7h.512"/>
    <part crc="55e704f7" name="6h.512"/>
    <part crc="ad459ad3" name="5h.512"/>
    <part crc="5ee53d1d" name="4h.512"/>
    <part crc="91c27b64" name="3h.512"/>
    <part crc="8d11ce0d" name="2h.512"/>
    <part crc="b42203c4" name="1h.512"/>
    <!-- oki2, 0x080000 (8 files) -->
    <part crc="024878b1" name="13h.512"/>
    <part crc="3544758d" name="14h.512"/>
    <part crc="6929577a" name="15h.512"/>
    <part crc="c909d929" name="16h.512"/>
    <part crc="09e7635b" name="17h.512"/>
    <part crc="370a2fbd" name="18h.512"/>
    <part crc="64e58cfe" name="19h.512"/>
    <part crc="5ccd9205" name="20h.512"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="tharrierb.zip|tharrier.zip|nmk004.zip" md5="none">
    <part crc="fcd5efea" name="21.bpr"/>
  </rom>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 90 19 00 00 63 00 00 00 00 00 00
        01 00 0F 77 49 00 00 03 00 00 00 00 00 00
        01 00 0F 7B 49 00 00 03 00 00 00 00 00 00
        01 00 0F 77 51 00 00 0A 00 00 00 00 00 00
        01 00 0F 7B 51 00 00 0A 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
