<!--
  Task Force Harrier (US) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 20).
  Clone of tharrier; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... tharrieru ...)
  line 10700, ROM_START(tharrieru), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Task Force Harrier (US)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tharrieru</setname>
  <year>1989</year>
  <manufacturer>UPL (American Sammy license)</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp. MiSTer matches this tag as TEXT, not as a
       number: mra_loader.cpp does strncasecmp(text, "vertical", 8), so the
       numeric form this file used to carry left is_vertical false and a
       tate cabinet never picked up MiSTer.ini's [arcade_vertical] section.
       The direction is explicit because MiSTer falls back to CW when none
       is given, and ROT270 turns counter-clockwise to stand upright (the
       core's own rotate_ccw=1 case). -->
  <rotation>vertical (ccw)</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,14">
    <dip bits="0" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="8" name="Cabinet" ids="Cocktail,Upright"/>
    <dip bits="9" name="Unknown (SW1:7)" ids="On,Off"/>
    <dip bits="10,11" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="12,13" name="Bonus Life" ids="200k 500k &amp; 1 2 3 5 Mil,None,200k and 1 Mil,200k"/>
    <dip bits="14,15" name="Lives" ids="5,2,4,3"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="tharrieru.zip|tharrier.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="99cea259" name="u_3.21b" map="01"/>
      <part crc="78923aaa" name="u_2.18b" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="b959f837" name="12.4l"/>
    <!-- fgtile, 0x010000 -->
    <part crc="c7402e4a" name="1.13b"/>
    <!-- bgtile, 0x080000 -->
    <part crc="64d7d687" name="89050-4.16f"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="7f715421" name="89050-17.16e" map="01"/>
      <part crc="24db3fa4" name="89050-13.16d" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 -->
    <part crc="11ee4c39" name="89050-8.4j"/>
    <!-- oki2, 0x080000 -->
    <part crc="893552ab" name="89050-10.14j"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="tharrieru.zip|tharrier.zip|nmk004.zip" md5="none">
    <part crc="fcd5efea" name="21.bpr"/>
  </rom>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 90 19 00 00 63 00 00 00 00 00 00
        01 00 0F 77 49 00 00 03 00 00 00 00 00 00
        01 00 0F 7B 49 00 00 03 00 00 00 00 00 00
        01 00 0F 77 51 00 00 0A 00 00 00 00 00 00
        01 00 0F 7B 51 00 00 0A 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
