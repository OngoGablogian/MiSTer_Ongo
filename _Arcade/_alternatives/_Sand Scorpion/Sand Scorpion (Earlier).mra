<!--
  Sand Scorpion (Earlier) — FACE 1992, MAME kaneko/sandscrp.cpp (sandscrpa). Clone of sandscrp; files shared with the parent are looked up in sandscrp.zip.
  Generated by tools/gen_sandscrp_mra.py; ROM part order is the core's fixed
  SDRAM layout (see that script's header): maincpu @0x000000 (68000 pair, odd
  file on even stream bytes for the byte-parity word rebuild), audiocpu
  @0x080000, sprites @0x0A0000, view2 @0x1A0000 (pair streamed in MAME memory
  order: the tile decoder is byte-wise), oki @0x2A0000.
  <switches> byte 0 = DSW1 (SW1), byte 1 = DSW2 (SW2): these two bytes feed the
  YM2203's port A/B inputs — on this board the Z80 reads the DIPs through the
  sound chip and reports them to the 68000 over the sound latch. Byte 2 is not
  a DIP; bit 6 of it is the hidden Autofire-menu unlock (tools/gen_autofire_mra.py).
-->
<misterromdescription>
  <name>Sand Scorpion (Earlier)</name>
  <mratimestamp>202609190000</mratimestamp>
  <mameversion>0289</mameversion>
  <setname>sandscrpa</setname>
  <year>1992</year>
  <manufacturer>Face</manufacturer>
  <category>Shooter</category>
  <rbf>kuze_SandScrp</rbf>

  <!-- ROT90 in sandscrp.cpp (a vertical game). -->
  <rotation>vertical (cw)</rotation>

  <!-- DSW1 default 0xEF (3 lives, 3 bombs, Normal, 200K/500K), DSW2 0xFF
       (1C/1C, Flip off, Continue on, Demo Sounds on, Service off).
       ids are in bit-value order (value 0 first). -->
  <switches default="EF,FF,00">
    <dip bits="0,1"   name="Lives" ids="5,2,1,3"/>
    <dip bits="2,3"   name="Bombs" ids="5,2,1,3"/>
    <dip bits="4,5"   name="Difficulty" ids="Hardest,Hard,Normal,Easy"/>
    <dip bits="6,7"   name="Bonus Life" ids="1000K/3000K,500K/1000K,100K/300K,200K/500K"/>
    <dip bits="8,11"  name="Coinage" ids="Free_Play,8C_3C,5C_3C,3C_2C,2C_3C,1C_6C,1C_5C,1C_4C,1C_3C,1C_2C,6C_1C,5C_1C,4C_1C,3C_1C,2C_1C,1C_1C"/>
    <dip bits="12"    name="Flip Screen" ids="On,Off"/>
    <dip bits="13"    name="Allow Continue" ids="Off,On"/>
    <dip bits="14"    name="Demo Sounds" ids="Off,On"/>
    <dip bits="15"    name="Service Mode" ids="On,Off"/>
  </switches>

  <!-- Five entries, positionally the core's CONF_STR J1 list: Shot, Bomb,
       Button 3 (plain fire while Autofire is on), Start, Coin. -->
  <buttons names="Shot,Bomb,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="sandscrpa.zip|sandscrp.zip" md5="none">
    <!-- maincpu 0x080000 @ 0x000000: 68000 pair, odd-offset file first (map=01) -->
    <interleave output="16">
      <part crc="6a8e0012" name="2.ic5" map="01"/>
      <part crc="c0943ae2" name="1.ic4" map="10"/>
    </interleave>
    <!-- audiocpu 0x020000 @ 0x080000 -->
    <part crc="6f3e9db1" name="8.ic51"/>
    <!-- sprites 0x100000 @ 0x0A0000 -->
    <part crc="9bb675f6" name="5.ic16"/>
    <part crc="7df2f219" name="6.ic17"/>
    <!-- view2 0x100000 @ 0x1A0000: pair in MAME memory order, even-offset file first (map=01) -->
    <interleave output="16">
      <part crc="adf20fa0" name="3.ic33" map="01"/>
      <part crc="b9222ff2" name="4.ic32" map="10"/>
    </interleave>
    <!-- oki 0x040000 @ 0x2A0000 -->
    <part crc="9870ab12" name="7.ic55"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for sandscrpa, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 70 20 14 00 50 00 1B
        00 70 00 48 00 04 00 00
    </part>
  </rom>
  <nvram index="4" size="84"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 70 00 01 00 00 09 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 70 60 27 00 00 06 00 00 00 00 00 00
        01 00 70 D0 27 00 00 06 00 00 00 00 00 00
        01 00 70 60 26 00 00 05 00 00 00 00 00 00
        01 00 70 D0 26 00 00 05 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
