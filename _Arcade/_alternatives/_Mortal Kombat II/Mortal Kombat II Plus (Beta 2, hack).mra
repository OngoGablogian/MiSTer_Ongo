	<rbf>Gm0rk_Midway-T-Unit</rbf>
	<remark>2 players</remark>
	<switches default="7D,FC">
		<dip bits="12" name="Attract Sound" ids="Off,On"/>
		<dip bits="10" name="Bill Validator" ids="Installed,Not Present"/>
		<dip bits="14" name="Blood" ids="Off,On"/>
		<dip bits="8" name="Circuit Boards" ids="2,1" values="1,0"/>
		<dip bits="2,6" name="Coinage" ids="USA-1,USA-2,USA-3,USA-4,USA-ECA,USA-Free Play,German-1,German-2,German-3,German-4,German-5,German-ECA,German-Free Play,French-1,French-2,French-3,French-4,French-ECA,French-Free Play" values="31,15,23,7,27,3,29,13,21,5,25,9,1,30,14,22,6,26,2"/>
		<dip bits="7" name="Coinage Source" ids="Dipswitch,CMOS" values="1,0"/>
		<dip bits="11" name="Comic Book Offer" ids="Off,On"/>
		<dip bits="1" name="Counters" ids="One,Two" values="1,0"/>
		<dip bits="13" name="Low Blows" ids="Off,On"/>
		<dip bits="9" name="Powerup Test" ids="Off,On"/>
		<dip bits="16" name="Service Credit" ids="Add credit,Add credit"/>
		<dip bits="0" name="Test Switch" ids="Off,On" values="1,0"/>
		<dip bits="17" name="Tilt" ids="Slam tilt,Slam tilt"/>
		<dip bits="15" name="Violence" ids="Off,On"/>
	</switches>
	<buttons names="High Punch,Low Punch,High Kick,Low Kick,Block,-,Start,Coin,Test,Pause" default="Y,B,X,A,R,-,Start,Select,-,-"/>
	<romstruct>
rom index 0 (SDRAM 0x000000):
0x000000 program ROM (1 MB, 16-bit little endian)
0x100000 graphics ROM (12 MB of MAME "video", 32-bit interleaved)
rom index 3 (SDRAM 0xD00000):
0x000000 DCS sound data ROMs, packed (3 MB)
	</romstruct>
	<rom index="1">
		<!-- game id (rtl/tunit_secrets.sv): the OSD shows the Plus Move List and View Secrets, and no Finishing Moves or Hidden Items, for this set: no patches or codes -->
		<part>
		02 01 01 00
		</part>
		<!-- AI level word 01061AD0, demo fights set it at FF827BA0 (PC after the store) (Fixed AI Difficulty) -->
		<part repeat="1104">00</part>
		<part>
		AD 61 10 00 BA 27 F8 0F
		</part>
	</rom>
