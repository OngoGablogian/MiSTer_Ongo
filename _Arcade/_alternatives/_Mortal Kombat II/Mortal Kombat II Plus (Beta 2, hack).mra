	<!-- cheats (rtl/tunit_cheats.sv): damage pointer table FFDAC1E0, hits go to FF8102F0 and FF800EC0; energy P1 010602F0, P2 01060EC0; round clock DEC A10 FFD463E0; FINISH HIM wait FFC79740, FFC797F0; 4 cheats -->
	<cheats size="8" max="8">
		<cheat name="Infinite Health P1">1FAC FD0F 81FF FFFF</cheat>
		<cheat name="Infinite Health P2">21AC FD0F 80FF FFFF</cheat>
