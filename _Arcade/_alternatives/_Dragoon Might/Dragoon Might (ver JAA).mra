<misterromdescription>
    <name>Dragoon Might (ver JAA)</name>
    <setname>dragoonj</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>0E</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 14); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="dragoonj.zip|dragoona.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="417jaa03.27b" crc="8e1f883f" map="0012"/>
            <part name="417jaa02.31b" crc="533cbbd5" map="1200"/>
        </interleave>
        <part repeat="1048576">00</part>
        <interleave output="32">
            <part name="417a05.23c" crc="2ee2c587" map="0012"/>
            <part name="417a04.26c" crc="dc574747" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 5-byte row, then the last 1 byte of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="417a16.17h" crc="88b2213b"/>  <!-- four-byte part -->
        <part repeat="2097148">00</part>
        <!-- k055673: MAME's region as it is -->
        <part repeat="3145732">00</part>
        <interleave output="32">
            <part name="417a15.25g" crc="83bccd01" map="0021"/>
            <part name="417a11.28g" crc="624a7c4c" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="417a14.18h" crc="fbf551f1" map="0021"/>
            <part name="417a10.27g" crc="18fde49f" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="417a13.20h" crc="d2e3959d" map="0021"/>
            <part name="417a09.30g" crc="b5653e24" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="417a12.23h" crc="25496115" map="0021"/>
            <part name="417a08.33g" crc="801e9d93" map="2100"/>
        </interleave>
        <!-- soundcpu: MAME's region as it is -->
        <interleave output="16">
            <part name="417a06.9c" crc="8addbbee" map="01"/>
            <part name="417a07.7c" crc="c1fd7584" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="417a17.9g" crc="88d47dfd"/>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="dragoonj.zip|dragoona.zip" md5="none">
        <part name="dragoonj.nv" crc="cbe16082"/>
    </rom>


    <!-- MAME's hiscore.dat entries for hiscore.v (rtl/hiscore) -->
    <rom index="3">
        <part>
        31 8B 1B 00 3F FF 00 02 00 02 00 01 00 0F 20 00
        00 C0 1B 00 00 9A 00 B0
        </part>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it; then hiscore.v's tables -->
    <nvram index="4" size="282"/>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="Light Punch,Medium Punch,Heavy Punch,Light Kick,Medium Kick,Heavy Kick,Start,Coin,Pause,Service" default="A,B,X,Y,L,R,Start,Select" count="6"/>

    <!-- from Pugsy's MAME cheats (mamecheat.co.uk), scripts/mame_cheats.py: replaced
         as the CPU reads them (rtl/cheat/cheatengine.sv) -->
    <cheats size="16" max="16">
        <cheat name="Infinite Credits"                     >00000010 00C01044 00000000 00000063</cheat>
        <cheat name="Finish this Round Now!"               >00000010 00C05000 00000000 00000000</cheat>
        <cheat name="Start on Final Stage"                 >00000010 00C03041 00000000 00000008</cheat>
        <cheat name="P1 Infinite Energy (Single)"          >00000010 00C180B8 00000000 000000FF</cheat>
        <cheat name="P1 Infinite Energy (Team)"            >00000010 00C180B8 00000000 000000CF</cheat>
        <cheat name="P1 Drain All Energy Now!"             >00000010 00C180B8 00000000 00000000</cheat>
        <cheat name="P1 Always have Max Power (Team)"      >00000010 00C04020 00000000 00000040 00000010 00C04052 00000000 00000002</cheat>
        <cheat name="P1 Always have Super Bomber Available">00000010 00C0503C 00000000 00000001</cheat>
        <cheat name="P1 Always Have Weapon"                >00000010 00C090EC 00000000 00000000</cheat>
        <cheat name="P1 Always No Weapon"                  >00000010 00C090EC 00000000 00000001</cheat>
        <cheat name="P1 Play with Dogma (Single)"          >00000010 00C03012 00000000 0000000C</cheat>
        <cheat name="P1 Play with Dogma (Team - 1st)"      >00000010 00C03013 00000000 0000000C</cheat>
        <cheat name="P1 Play with Dogma (Team - 2nd)"      >00000010 00C03014 00000000 0000000C</cheat>
        <cheat name="P1 Play with Dogma (Team - 3rd)"      >00000010 00C03015 00000000 0000000C</cheat>
        <cheat name="P2 Infinite Energy (Single)"          >00000010 00C181B8 00000000 000000FF</cheat>
        <cheat name="P2 Infinite Energy (Team)"            >00000010 00C181B8 00000000 000000CF</cheat>
        <cheat name="P2 Drain All Energy Now!"             >00000010 00C181B8 00000000 00000000</cheat>
        <cheat name="P2 Always have Max Power (Team)"      >00000010 00C04022 00000000 00000040 00000010 00C04054 00000000 00000002</cheat>
        <cheat name="P2 Always have Super Bomber Available">00000010 00C0503D 00000000 00000001</cheat>
        <cheat name="P2 Always No Weapon"                  >00000010 00C0B0EC 00000000 00000001</cheat>
        <cheat name="P2 Always Have Weapon"                >00000010 00C0B0EC 00000000 00000000</cheat>
        <cheat name="P2 Play with Dogma (Single)"          >00000010 00C03016 00000000 0000000C</cheat>
        <cheat name="P2 Play with Dogma (Team - 1st)"      >00000010 00C03017 00000000 0000000C</cheat>
        <cheat name="P2 Play with Dogma (Team - 2nd)"      >00000010 00C03018 00000000 0000000C</cheat>
        <cheat name="P2 Play with Dogma (Team - 3rd)"      >00000010 00C03019 00000000 0000000C</cheat>
    </cheats>
</misterromdescription>
