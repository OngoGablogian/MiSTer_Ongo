<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Spiker (earliest?)</name>
	<setname>spikerb</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1986</year>
	<manufacturer>Bally/Sente</manufacturer>
	<rotation>horizontal</rotation>
	<players>2</players>
	<!-- Analog: P2 trackball_y, P2 trackball_x reversed, P1 trackball_y, P1 trackball_x reversed. Player 1's from the mouse or the left stick, others from their stick. -->

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="spikerb.zip|spiker.zip|sente6vb.zip" md5="none">
		<part name="ab01.u8a" crc="59025e39"/>
		<part name="ab23.u7a" crc="ffb23288"/>
		<part repeat="0x14000">00</part>
		<part name="cd6ef.u1a" crc="7f04774d"/>
		<part repeat="0x20000">00</part>
		<part name="gr01.u4c" crc="1228b7a3"/>
		<part name="gr23.u3c" crc="970c81f6"/>
		<part name="gr45.u2c" crc="bf2b413d"/>
		<part repeat="0x4000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>00 05 11 89 10 88 01 03 00 00 00 00 00 00 00 00 FF FF FF FF 24 FF 09 80 08 28 04 FF FF FF 29 FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Jump/Spike,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="00,7E,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Game Duration" bits="8" ids="11 Points,15 Points"/>
		<dip name="Unknown" bits="9" ids="On,Off"/>
		<dip name="Unknown" bits="10" ids="On,Off"/>
		<dip name="Unknown" bits="11" ids="On,Off"/>
		<dip name="Unknown" bits="12" ids="On,Off"/>
		<dip name="Unknown" bits="13" ids="On,Off"/>
		<dip name="Unknown" bits="14" ids="On,Off"/>
		<dip name="Demo Sounds" bits="15" ids="On,Off"/>
		<dip name="Coinage" bits="0,1" ids="1 Coin/1 Credit,1 Coin/2 Credits,2 Coins/1 Credit,3 Coins/1 Credit"/>
		<dip name="Bonus Coins" bits="2,4" ids="None,2 Coins=1 Bonus,3 Coins=1 Bonus,4 Coins=1 Bonus,4 Coins=2 Bonus,5 Coins=1 Bonus,5 Coins=2 Bonus,5 Coins=3 Bonus"/>
		<dip name="Left Coin Mech" bits="5" ids="x1,x2"/>
		<dip name="Right Coin Mech" bits="6,7" ids="x1,x4,x5,x6"/>
		<dip name="Flip Screen" bits="24" ids="Off,On"/>
	</switches>
</misterromdescription>
