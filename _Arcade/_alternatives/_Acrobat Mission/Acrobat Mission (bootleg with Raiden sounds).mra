<!--
  Acrobat Mission (bootleg with Raiden sounds) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 45).
  Clone of acrobatm; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... acrobatmbl ...)
  line 10783, ROM_START(acrobatmbl), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Acrobat Mission (bootleg with Raiden sounds)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>acrobatmbl</setname>
  <year>1991</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FE,F7,2D">
    <dip bits="0" name="Demo Sounds" ids="On,Off"/>
    <dip bits="1" name="Flip Screen" ids="On,Off"/>
    <dip bits="2,4" name="Coin B" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="5,7" name="Coin A" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="8" name="Service Mode" ids="On,Off"/>
    <dip bits="9,10" name="Bonus Life" ids="None,50k and 100k,100k and 200k,100k and 100k"/>
    <dip bits="11" name="Language" ids="English,Japanese"/>
    <dip bits="12,13" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="14,15" name="Lives" ids="5,2,4,3"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="acrobatmbl.zip|acrobatm.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 (the PIC patch of init_acrobatmbl is applied by the core) -->
    <interleave output="16">
      <part crc="ae6d2349" name="3.10f" map="01"/>
      <part crc="c516dac3" name="4.10c" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 (seibu_sound_map: 0000-1FFF = the file's start, the 8000-FFFF window = its second half (bank 0) or first half (bank 1)) -->
    <part crc="99ee7505" name="2.12w"/>
    <!-- fgtile, 0x010000 (acrobatm's 3.ic79 data) -->
    <part crc="d86c186e" name="3.ic79"/>
    <!-- bgtile, 0x100000 (acrobatm's am-03.ic8 data) -->
    <part crc="7c12afed" name="am-03.ic8"/>
    <!-- sprites, 0x180000 (2 plain files; c.2m's identical second half is not loaded) -->
    <part crc="5672bdaa" name="am-01.ic42"/>
    <part crc="a3f5a3e0" name="c.2m" offset="0x00000" length="0x80000"/>
    <!-- oki1, 0x010000 (1 MHz, unbanked) -->
    <part crc="f6f6c4bf" name="1.14y"/>
  </rom>
</misterromdescription>
