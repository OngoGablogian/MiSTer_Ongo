<!--
  Hot Bubble (Korea, with adult pictures) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 39).
  Clone of bubl2000; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... hotbubl ...)
  line 10838, ROM_START(hotbubl), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Hot Bubble (Korea, with adult pictures)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>hotbubl</setname>
  <year>1998</year>
  <manufacturer>Afega (Pandora license)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,27">
    <dip bits="0" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="1" name="Unused (SW2:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW2:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW2:3)" ids="On,Off"/>
    <dip bits="6,7" name="Free Credit" ids="1500k,1000k,500k,800k"/>
    <dip bits="8" name="Unused (SW1:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Disabled,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Disabled,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="hotbubl.zip|bubl2000.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 (init_bubl2000 scramble; uc9 = even MAME offsets) -->
    <interleave output="16">
      <part crc="d1e72a31" name="afega8.c1.uc1" map="01"/>
      <part crc="4537c6d9" name="afega9.c2.uc9" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="rom01.92"/>
    <!-- fgtile, 0x010000 -->
    <part crc="ce683a93" name="afega9.t1.uc2"/>
    <!-- bgtile, 0x300000 (8bpp: two 4bpp halves, six files in region order) -->
    <part crc="65bd5159" name="afega10.cr5.uc15"/>
    <part crc="a89d9ce4" name="afega10.cr7.uc19"/>
    <part crc="99d6523c" name="afega9.cr6.uc16"/>
    <part crc="fc9101d2" name="afega8.cr1.uc6"/>
    <part crc="c841a4f6" name="afega9.cr3.uc12"/>
    <part crc="27ad6fc8" name="afega9.cr2.uc7"/>
    <!-- sprites, 0x080000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="22707728" name="afega8.br3.uc10" map="01"/>
      <part crc="7e132eff" name="afega10.br1.uc3" map="10"/>
    </interleave>
    <!-- oki1, 0x040000 -->
    <part crc="401c980f" name="afega8.s2.uc18"/>
  </rom>
</misterromdescription>
