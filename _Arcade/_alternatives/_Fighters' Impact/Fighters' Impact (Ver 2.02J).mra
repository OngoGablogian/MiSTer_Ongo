<misterromdescription>
	<name>Fighters' Impact (Ver 2.02J)</name>
	<setname>ftimpactj</setname>
	<year>1996</year>
	<manufacturer>Taito</manufacturer>
	<category>Fighter</category>
	<players>2</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<rbf>XNZN1TaitoFX1B</rbf>

	<!-- BIOS: Taito FX-1 BIOS, 512KB, ioctl_index 0 -->
	<rom index="0" zip="coh1000t.zip" md5="none">
		<part name="m534002c-14.ic353" crc="e3f23b6e"/>
	</rom>

	<!-- Platform: Taito FX (0x02), ioctl_index 1 -->
	<rom index="1">
		<part>02</part>
	</rom>

	<!-- Banked ROM: 2 banks x 8MB = 16MB, ioctl_index 3, CPU 0x1F000000 (8MB window) -->
	<!-- Bank 0: 2MB interleaved + 2MB empty + 4MB e25-01                       -->
	<!-- Bank 1: e25-02 (4MB) + e25-03 (4MB)                                    -->
	<rom index="3" zip="ftimpactj.zip|ftimpcta.zip|ftimpact.zip" md5="none">
		<interleave output="16">
			<part name="e25-07.3" crc="829be1cc" map="01"/>
			<part name="e25-06.4" crc="3a59deeb" map="10"/>
		</interleave>
		<part repeat="0x300000">00</part>
		<part name="e25-01.1" crc="8cc4be0c"/>
		<part name="e25-02.2" crc="8e8b4c82"/>
		<part name="e25-03.12" crc="43b1c085"/>
	</rom>

	<!-- Taito Zoom sound board (music): MN10200 program ROM, 512KB,             -->
	<!-- ioctl_index 6 -> DDR3 0x32000000 (MAME "taito_zoom:mn10200" region)     -->
	<rom index="6" zip="ftimpactj.zip|ftimpcta.zip|ftimpact.zip" md5="none">
		<part name="e25-10.14" crc="2b2ad1b1"/>
	</rom>

	<!-- Taito Zoom ZSG-2 sample ROM (MAME "taito_zoom:zsg2" region): 6MB total, -->
	<!-- ioctl_index 7 -> DDR3 0x32100000 (e25-04 4MB + e25-05 2MB concatenated) -->
	<rom index="7" zip="ftimpactj.zip|ftimpcta.zip|ftimpact.zip" md5="none">
		<part name="e25-04.27" crc="09a66d35"/>
		<part name="e25-05.28" crc="3fb57636"/>
	</rom>


	<!-- CAT702 key A: motherboard key (tt01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000t.zip" md5="none">
		<part name="tt01.ic652" crc="daac13e7"/>
	</rom>

	<!-- CAT702 key B: game key (tt05), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="ftimpactj.zip|ftimpcta.zip|ftimpact.zip" md5="none">
		<part name="tt05" crc="66045c83"/>
	</rom>

	<!-- DIP switches map to zn_dsw via ~status[103:96] (base=96, 1 byte; ZN1.sv inverts).
	     status_bit=0 (default) -> zn_dsw bit=1 = MAME "Off"; status_bit=1 -> zn_dsw bit=0 = MAME "On".
	     From MAME zn.cpp INPUT_PORTS_START(znt2p) DSW. -->
	<switches base="96" default="00">
		<dip name="Service Mode" bits="1" ids="Off,On"/>
		<dip name="Test Mode"    bits="3" ids="Off,On"/>
	</switches>
</misterromdescription>
