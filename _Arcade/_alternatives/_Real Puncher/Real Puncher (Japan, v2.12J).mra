	<buttons default="A,B,X,Y,Start,Select,L" names="Safety Switch,Pad Sensor 1,Pad Sensor 2,Pad Sensor 3,-,-,Start,Coin,Pause"/>

	<!--
	  Generated from MAME's ROM data and verified byte-for-byte against the
	  core's ROM image. Do not hand-edit the ROM stream.
	-->

	<rom index="0" address="0x30000000" zip="realpuncj.zip|realpunc.zip">
		<!--Board config: game_t index 15 (realpunc)-->
		<part>0F 00</part>

		<!--Region 0: maincpu, 68000 program, 1048576 bytes-->
		<part>00100000</part>
		<interleave output="16">
			<part crc="bb8ab32d" name="d76_04.48" map="01"/>
			<part crc="879b7e6a" name="d76_05.47" map="10"/>
		</interleave>

		<!--Region 1: tc0180vcu graphics, 4194304 bytes-->
