		<interleave output="32">
			<part crc="57691b93" name="d76_02.76" map="0021"/>
			<part crc="9f0aefd8" name="d76_03.45" map="2100"/>
		</interleave>
		<part repeat="2097152">00</part>

		<!--Region 2: audiocpu, Z80 program, 65536 bytes-->
		<part>02010000</part>
		<part crc="72c799fd" name="d76_06.106"/>

		<!--Region 3: ymsnd:adpcma, 2097152 bytes-->
		<part>03200000</part>
		<part crc="2bc265f2" name="d76_01.93"/>
	</rom>

