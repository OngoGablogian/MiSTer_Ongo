<misterromdescription>
    <name>Gokujou Parodius: Kako no Eikou o Motomete (ver JAD)</name>
    <setname>gokuparo</setname>
    <rbf>KonamiGX</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Konami</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <rom index="1"><part>05</part></rom>

    <!-- the SDRAM image rtl/memory/gx_sdram_top.sv expects for this set
         (rtl/gx_board_cfg.sv arm 5); written and proven by
         scripts/build_mra.py, not by hand -->
    <rom index="0" zip="gokuparo.zip|fantjour.zip|konamigx.zip" md5="none" address="0x30000000">
        <!-- maincpu, the CPU's window packed: BIOS, then 0x200000.. moved down by 0x1e0000 -->
        <part name="300a01.34k" crc="d5fa95f5"/>
        <interleave output="32">
            <part name="321jad04.27b" crc="916a7951" map="0012"/>
            <part name="321jad02.21b" crc="c2e548c0" map="1200"/>
        </interleave>
        <part repeat="2">00</part>
        <!-- k056832: the four-byte part of each 5-byte row, then the last 1 byte of each (the core spreads rows to 8) -->
        <part repeat="917502">00</part>
        <part name="321b14.17h" crc="437d0057"/>  <!-- four-byte part -->
        <part repeat="2936012">00</part>
        <part name="321b12.13g" crc="5f9edfa0"/>  <!-- second part -->
        <part repeat="734003">00</part>
        <!-- k055673: MAME's region, a four-byte part then the fifth bytes -->
        <part repeat="4194305">00</part>
        <interleave output="32">
            <part name="321b11.25g" crc="c6e2e74d" map="0021"/>
            <part name="321b10.28g" crc="ea9f8c48" map="2100"/>
        </interleave>
        <part name="321b09.30g" crc="94add237"/>
        <!-- soundcpu: MAME's region as it is -->
        <part repeat="3145728">00</part>
        <interleave output="16">
            <part name="321b06.9c" crc="da810554" map="01"/>
            <part name="321b07.7c" crc="c47634c0" map="10"/>
        </interleave>
        <!-- k054539: MAME's region as it is -->
        <part name="321b17.9g" crc="b3e8d5d8"/>
        <part name="321b18.7g" crc="2c561ad0"/>
    </rom>

    <!-- the default EEPROM image (the ROM_START eeprom region); the core loads it into the 93C46 -->
    <rom index="2" zip="gokuparo.zip|fantjour.zip" md5="none">
        <part name="gokuparo.nv" crc="15c0f2d9"/>
    </rom>


    <!-- MAME's hiscore.dat entries for hiscore.v (rtl/hiscore) -->
    <rom index="3">
        <part>
        1E 16 A3 00 3F FF 00 02 00 02 00 01 00 0F 20 00
        00 C0 D7 36 00 04 00 00
        00 C0 D7 42 00 78 00 09
        00 C0 D7 38 00 01 73 73
        </part>
    </rom>

    <!-- the EEPROM saved: loaded after the ROM (ioctl index 4, over the default),
         saved when the OSD opens after the game has written it; then hiscore.v's tables -->
    <nvram index="4" size="253"/>

    <switches default="FE,FF">
        <dip name="Sound Output" bits="0" ids="Stereo,Mono"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
    </switches>

    <buttons names="Power Up,Shot,Missile,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>

    <!-- from Pugsy's MAME cheats (mamecheat.co.uk), scripts/mame_cheats.py: replaced
         as the CPU reads them (rtl/cheat/cheatengine.sv) -->
    <cheats size="16" max="16">
        <cheat name="P1 Infinite Lives"                >00000010 00C0D7C7 00000000 0000000A</cheat>
        <cheat name="P1 Invincibility"                 >00000010 00C00835 00000000 00000002</cheat>
        <cheat name="P1 Invincibility 'ON' (No Bells)" >00000010 00C00873 00000000 00000001</cheat>
        <cheat name="P1 Invincibility 'OFF' (No Bells)">00000010 00C00873 00000000 00000000</cheat>
        <cheat name="P1 Always Have Super Bomb"        >00000010 00C0086F 00000000 0000000D 00000010 00C00871 00000000 00000003</cheat>
        <cheat name="P1 Always Have Megaphone Option"  >00000010 00C0086F 00000000 00000009 00000010 00C00871 00000000 00000003</cheat>
        <cheat name="P1 Always Have KIKU Beam"         >00000010 00C0086F 00000000 0000000B 00000010 00C00871 00000000 00000003</cheat>
        <cheat name="P1 Always Have Big Option"        >00000010 00C0086F 00000000 0000000E 00000010 00C00871 00000000 00000003</cheat>
        <cheat name="P1 Can Always Shoot"              >00000010 00C00875 00000000 00000000</cheat>
        <cheat name="P1 Keep Speed Level 2"            >00000010 00C00865 00000000 00000002</cheat>
        <cheat name="P1 Infinite White Bell Power"     >00000010 00C0E8CF 00000000 000000FF</cheat>
        <cheat name="P2 Infinite Lives"                >00000010 00C0D827 00000000 0000000A</cheat>
        <cheat name="P2 Invincibility"                 >00000010 00C03635 00000000 00000002</cheat>
        <cheat name="P2 Invincibility 'ON' (No Bells)" >00000010 00C03673 00000000 00000001</cheat>
        <cheat name="P2 Invincibility 'OFF' (No Bells)">00000010 00C03673 00000000 00000000</cheat>
        <cheat name="P2 Always Have Super Bomb"        >00000010 00C0366F 00000000 0000000D 00000010 00C03671 00000000 00000003</cheat>
        <cheat name="P2 Always Have Megaphone Option"  >00000010 00C0366F 00000000 00000009 00000010 00C03671 00000000 00000003</cheat>
        <cheat name="P2 Always Have KIKU Beam"         >00000010 00C0366F 00000000 0000000B 00000010 00C03671 00000000 00000003</cheat>
        <cheat name="P2 Always Have Big Option"        >00000010 00C0366F 00000000 0000000E 00000010 00C03671 00000000 00000003</cheat>
        <cheat name="P2 Can Always Shoot"              >00000010 00C03675 00000000 00000000</cheat>
        <cheat name="P2 Keep Speed Level 2"            >00000010 00C03665 00000000 00000002</cheat>
        <cheat name="P2 Infinite White Bell Power"     >00000010 00C0E92F 00000000 000000FF</cheat>
    </cheats>
</misterromdescription>
