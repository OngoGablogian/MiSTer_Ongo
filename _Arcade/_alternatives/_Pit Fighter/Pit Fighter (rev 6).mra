            <part name="136081-1067.70r" crc="ca4f75a8" map="10"/>
        </interleave>

        <!-- $280000  playfield planes 0-3 (EVEN ROM first) -->
        <interleave output="32">
            <part name="136081-1021.90m" crc="777efee3" map="0021"/>
            <part name="136081-1017.130m" crc="ad3cfea5" map="2100"/>
        </interleave>
        <interleave output="32">
