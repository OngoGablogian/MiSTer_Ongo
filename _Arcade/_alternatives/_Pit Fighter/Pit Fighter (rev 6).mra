<misterromdescription>
    <name>Pit Fighter (rev 6)</name>
    <mratimestamp>20260926</mratimestamp>
    <mameversion>0264</mameversion>
    <setname>pitfight6</setname>
    <year>1990</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Fighter</category>
    <rbf>Gm0rk_Atari-G1</rbf>
    <rotation>horizontal</rotation>
    <players>3</players>
    <num_buttons>3</num_buttons>
    <buttons names="Punch,Kick,Jump,Start,Coin" default="A,B,X,Start,R"/>

    <romstruct>
SDRAM layout, the same for every Atari G1 set (unused space is zero-filled):
000000 - 07FFFF  512K  68000 program
080000 - 27FFFF    2M  RLE motion objects
280000 - 2FFFFF  512K  playfield planes 0-3
300000 - 31FFFF  128K  playfield plane 4
320000 - 33FFFF  128K  alpha characters
340000 - 37FFFF  256K  OKI6295 samples
380000 - 38FFFF   64K  JSA II 6502 program
390000 - 3905FF  1.5K  motion object PROMs
    </romstruct>

    <rom index="0" zip="pitfight6.zip|pitfight.zip" md5="abbd3d436d926b39d0aa304ba3371448">

        <!-- $000000  68000 program -->
        <interleave output="16">
            <part name="136081-6028.05d" crc="dae1d895" map="01"/>
            <part name="136081-6029.05b" crc="4df13418" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136081-6030.15d" crc="72b4b249" map="01"/>
            <part name="136081-6031.15b" crc="f0c5d03b" map="10"/>
        </interleave>
        <part repeat="262144">00</part>

        <!-- $080000  RLE motion objects -->
