<!--
  Space Battle Ship Gomorrah (Japan) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 4).
  Clone of bioship; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... sbsgomo ...)
  line 10706, ROM_START(sbsgomo), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Space Battle Ship Gomorrah (Japan)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>sbsgomo</setname>
  <year>1990</year>
  <manufacturer>UPL</manufacturer>
  <category>Shooter</category>
  <rbf>kuze_NMK16_Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,04">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1,2" name="Difficulty" ids="Easy,Hard,Hardest,Normal"/>
    <dip bits="3" name="Service Mode" ids="On,Off"/>
    <dip bits="4" name="Unknown (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Demo Sounds" ids="Off,On"/>
    <dip bits="6,7" name="Lives" ids="2,5,4,3"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Unknown (SW2:7)" ids="On,Off"/>
    <dip bits="10,12" name="Coin B" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="5C_1C,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="sbsgomo.zip|bioship.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="1d7accb8" name="10.ic15" map="01"/>
      <part crc="7916150b" name="11.ic14" map="10"/>
    </interleave>
    <!-- NMK004 external program, 0x010000 -->
    <part crc="5f39a980" name="6.ic120"/>
    <!-- NMK004 internal boot ROM, 0x002000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- fgtile, 0x010000 -->
    <part crc="f2b77f80" name="7.ic46"/>
    <!-- bgtile, 0x080000 (the VRAM layer, gfx1) -->
    <part crc="21302e78" name="sbs-g_01.ic9"/>
    <!-- bg2tile, 0x080000 (the ROM tilemap's tiles, gfx3) -->
    <part crc="f31eb668" name="sbs-g_02.ic4"/>
    <!-- tilerom, 0x020000 (ROM tilemap indices, ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="d91448ee" name="9.ic26" map="01"/>
      <part crc="75a46fea" name="8.ic27" map="10"/>
    </interleave>
    <!-- sprites, 0x080000 -->
    <part crc="60e00d7b" name="sbs-g_03.ic194"/>
    <!-- oki1, 0x080000 -->
    <part crc="7c74cc4e" name="sbs-g_04.ic139"/>
    <!-- oki2, 0x080000 -->
    <part crc="f0a782e3" name="sbs-g_05.ic160"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="sbsgomo.zip|bioship.zip|nmk004.zip" md5="none">
    <part crc="98ed1c97" name="82s135.ic94"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for sbsgomo, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F 01 50 00 08 00 00
        00 0F 01 69 00 A3 00 00
        00 0F 02 07 00 01 4C 4C
    </part>
  </rom>
  <nvram index="4" size="172"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        01 00 0F 02 DB 00 00 4F 00 00 00 00 00 00
        01 00 0F 0E 5B 00 00 4F 00 00 00 00 00 00
        01 00 0F 02 DD 00 00 06 00 00 00 00 00 00
        01 00 0F 0E 5D 00 00 06 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
