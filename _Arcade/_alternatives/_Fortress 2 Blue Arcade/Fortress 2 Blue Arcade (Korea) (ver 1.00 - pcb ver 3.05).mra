<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Fortress 2 Blue Arcade (Korea) (ver 1.00 / pcb ver 3.05)</name>
    <setname>fort2ba</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Eolith</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="fort2ba.zip|fort2b.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="ftii000.u39" crc="be74121d" map="0012"/>
            <part name="ftii004.u34" crc="d4399f98" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="ftii001.u40" crc="35c396ff" map="0012"/>
            <part name="ftii005.u35" crc="ff553679" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="ftii002.u41" crc="1d79ed5a" map="0012"/>
            <part name="ftii006.u36" crc="c6049bbc" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="ftii003.u42" crc="3cac1efe" map="0012"/>
            <part name="ftii007.u37" crc="a583a672" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="ftii012.u43" crc="6424e05f"/>
        <!-- qs1000:cpu -->
        <part name="ftii010.u107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="ftii008.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="ftii011.u97" crc="8a431b14"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="ftii009.u108" crc="9b996b60"/>
    </rom>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
