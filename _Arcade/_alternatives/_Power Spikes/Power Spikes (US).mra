<misterromdescription>
    <about author="jotego,andreabogazzi" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>horizontal</rotation>
    <name>Power Spikes (US)</name>
    <setname>pspikesu</setname>
    <mameversion>0282</mameversion>
    <year>1991</year>
    <manufacturer>Video System Co.</manufacturer>
    <players>2</players>
    <rbf>pspike</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="pspikesu.zip|pspikes.zip" md5="None" address="0x30000000">
        <!-- byte 1 bit 0 = pspikes  hardware
             bit 1 = turbofrc hardware
             bit 2 = aerofgt  hardware
  1[0]: pspikes    Power Spikes hardware
  1[1]: turbofrc   Turbo Force hardware: two tile layers, two sprite chips
  1[3]: karatblz   Karate Blazers hardware: 4 players, Z80 at 4MHz
  1[2]: aerofgt    Aero Fighters hardware: turbofrc map moved, 320x224 -->
        <part>
            00 01 00 00 00 00 00 00
        </part>
        <!-- maincpu - starts at 0x0 - length 0x100000 (20 bits) -->
        <part name="svolly91.73" crc="bfbffcdb"/>
        <part repeat="0xC0000"> FF</part>
        <!-- SCR0_START -->
        <!-- gfx1 - starts at 0x100000 - length 0x80000 (19 bits) -->
        <part name="g7h" crc="74c23c3d"/>
        <!-- gfx4 - starts at 0x180000 - length 0x180000 (21 bits) -->
        <part repeat="0x180000"> FF</part>
        <!-- SND_START -->
        <!-- soundbank - starts at 0x300000 - length 0x100000 (20 bits) -->
        <part name="19" crc="7e8ed6e5"/>
        <part repeat="0xE0000"> FF</part>
        <!-- JTFRAME_BA2_START -->
        <!-- pcma - starts at 0x400000 - length 0x100000 (20 bits) -->
        <part name="o5b" crc="07d6cbac"/>
        <!-- OBJ0_START -->
        <!-- spritegfx - starts at 0x500000 -->
        <!-- gfx2 - starts at 0x500000 - length 0x400000 (22 bits) -->
        <interleave output="32">
            <part name="g7j" crc="0b9e4739" map="0021"/>
            <part name="g7l" crc="943139ff" map="2100"/>
        </interleave>
        <part repeat="0x300000"> FF</part>
        <!-- PCMB_START -->
        <!-- pcmb - starts at 0x900000 - length 0x40000 (18 bits) -->
        <part name="a47" crc="c6779dfa"/>
        <!-- Total 0x940000 bytes - 9472 kBytes -->
    </rom>
    <rom index="1">
        <part>00 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="bf,ff">
        <DSW/>
        <dip name="Coin A" bits="0,1" ids="1/2,3/1,2/1,1/1"/>
        <dip name="Coin B" bits="2,3" ids="1/2,3/1,2/1,1/1"/>
        <dip name="Demo Sounds" bits="6" ids="On,Off"/>
        <dip name="Flip Screen" bits="7" ids="On,Off"/>
        <dip name="Service Mode" bits="8" ids="On,Off"/>
        <dip name="1P Start Score" bits="9,10" ids="10-12,11-12,11-11,12-12"/>
        <dip name="2P Start Score" bits="11,12" ids="0-0,5-5,7-7,9-9"/>
        <dip name="Difficulty" bits="13" ids="Hard,Normal"/>
        <dip name="2P Time/Credit" bits="14" ids="2 min,3 min"/>
        <dip name="Debug" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
