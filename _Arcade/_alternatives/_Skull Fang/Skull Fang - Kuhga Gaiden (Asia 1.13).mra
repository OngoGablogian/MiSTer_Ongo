<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME deco_mlc.cpp; the layout is
         scripts/mlc_layout.py (rtl/video/mlc_video_pkg.sv). Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME deco_mlc.cpp"/>
    <name>Skull Fang - Kuhga Gaiden (Asia 1.13)</name>
    <setname>skullfnga</setname>
    <rbf>ppriest_DecoMLC156</rbf>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Shooter</category>
    <rotation>vertical (ccw)</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Shot,Shot/Throttle,Barrel Roll/Bomb,-,-,-,Start,Coin,Pause,Test" default="A,B,X,Start,Select,R" count="3"/>

    <!-- mod byte (DecoMLC.sv): [0] the DE156 configurations (0 = SH-2), [2:1] orientation,
         [3] the DECO 146, [5:4] the gfx layout (4bpp, 5bpp, 6bpp, acchi), [6] gfx1 thirds of 8 MB -->
    <rom index="1"><part>25</part></rom>

    <!-- the factory EEPROM image (ROM_REGION16_BE eeprom): the core loads it into its 93C45 -->
    <rom index="2" zip="skullfnga.zip|skullfng.zip" md5="none">
        <part name="skullfng.eeprom" crc="240d882e"/>
    </rom>

    <!-- hiscore (rtl/hiscore.v), from MAME's plugins/hiscore/hiscore.dat -->
    <rom index="3">
        <part>
        19 9A 57 EF 3F FF 00 02 00 02 00 01 00 0F 10 00
        00 10 0A 80 F0 00 12 00
        00 10 00 40 01 08 08 00
        </part>
    </rom>
    <nvram index="4" size="241"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="skullfnga.zip|skullfng.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="sx00-0.2a" crc="749c0972" map="0021"/>
            <part name="sx01-0.2b" crc="61ae7dc3" map="2100"/>
        </interleave>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="mch-01.8m" crc="d37cf0cd" map="01"/>
            <part name="mch-00.2e" crc="d5cc4238" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mch-03.10m" crc="1dea8f6c" map="01"/>
            <part name="mch-02.4e" crc="4046314d" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mch-05.11m" crc="ef0b54ba" map="01"/>
            <part name="mch-04.6e" crc="4869dfe8" map="10"/>
        </interleave>
        <part repeat="0xC00000">00</part>  <!-- gfx2 at 0x1900000 -->
        <!-- gfx2 -->
        <part name="sx02-0.6h" crc="0d3ae757"/>
        <!-- ymz -->
        <part repeat="0x200000">00</part>  <!-- ymz 0x200000 -->
        <part name="mch-06.6a" crc="b2efe4ae"/>
        <part name="mch-07.11j" crc="bc1a50a1"/>
    </rom>

    <switches default="00,00,00">
        <!-- the board has no DIP switches (a 93C45 EEPROM): read by the core, not the game -->
        <dip name="Flip Screen" bits="0" ids="Off,On"/>
    </switches>
</misterromdescription>
