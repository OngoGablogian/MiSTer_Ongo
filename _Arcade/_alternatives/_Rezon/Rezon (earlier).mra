<misterromdescription>
    <name>Rezon (earlier)</name>
    <setname>rezono</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1991</year>
    <manufacturer>Allumer</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>0D</part></rom>

    <rom index="0" zip="rezono.zip|rezon.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="us001001.u3" crc="ab923052" map="01"/>
            <part name="us001002.u4" crc="3dafa0d5" map="10"/>
        </interleave>
        <part repeat="786432">00</part>
        <interleave output="16">
            <part name="us001004.103" crc="54871c7c" map="01"/>
            <part name="us001003.102" crc="1ac3d272" map="10"/>
        </interleave>
        <part repeat="786432">00</part>
        <!-- gfx1 -->
        <part name="us001006.u64" crc="a4916e96"/>
        <part name="us001005.u63" crc="e6251ebc"/>
        <!-- pad to 0x600000 -->
        <part repeat="3145728">00</part>
        <!-- gfx2 -->
        <interleave output="16">
            <part name="us001007.u66" crc="3760b935" map="12"/>
        </interleave>
        <!-- pad to 0x800000 -->
        <part repeat="1572864">00</part>
        <!-- gfx3 -->
        <interleave output="16">
            <part name="us001008.u68" crc="0ab73910" map="12"/>
        </interleave>
        <!-- pad to 0xa00000 -->
        <part repeat="1572864">00</part>
        <!-- x1snd -->
        <interleave output="16">
            <part name="us001009.u70" crc="0d7d2e2b" map="12"/>
        </interleave>
    </rom>

    <switches default="FF,FF,FF" base="0">
        <dip name="Lives" bits="0,1" ids="5,4,2,3"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Coinage" bits="4,5,6,7" ids="Free Play,8 Coins/3 Credits,5 Coins/3 Credits,3 Coins/2 Credits,2 Coins/3 Credits,1 Coin/6 Credits,1 Coin/5 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits,6 Coins/1 Credit,5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit"/>
        <dip name="Flip Screen" bits="8" ids="On,Off"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On"/>
        <dip name="Cabinet" bits="11,12" ids="Upright 1 Controller,Cocktail,-,Upright 2 Controllers"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>
</misterromdescription>
