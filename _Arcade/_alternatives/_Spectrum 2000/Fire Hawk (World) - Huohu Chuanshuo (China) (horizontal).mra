<!--
  Fire Hawk (World) / Huohu Chuanshuo (China) (horizontal) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 40).
  Clone of spec2k; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... firehawk ...)
  line 10848, ROM_START(firehawk), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Fire Hawk (World) / Huohu Chuanshuo (China) (horizontal)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>firehawk</setname>
  <year>2001</year>
  <manufacturer>ESD</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,28">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1,3" name="Difficulty" ids="Hard,Hard,Hardest,Very_Easy,Easy,Easy,Very_Hard,Normal"/>
    <dip bits="4" name="Demo Sounds" ids="Off,On"/>
    <dip bits="5" name="Number of Bombs" ids="3,2"/>
    <dip bits="6,7" name="Lives" ids="1,4,2,3"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Region" ids="China,World"/>
    <dip bits="10" name="Free Play" ids="On,Off"/>
    <dip bits="11,12" name="Continue Coins" ids="4 Coins,2 Coins,3 Coins,1 Coin"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="firehawk.zip|spec2k.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x100000 (firehawk_map; u60 = even MAME offsets) -->
    <interleave output="16">
      <part crc="d6d71a50" name="fhawk_p1.u59" map="01"/>
      <part crc="9f35d245" name="fhawk_p2.u60" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x020000 -->
    <part crc="c6609c39" name="fhawk_s1.u40"/>
    <!-- bgtile, 0x400000 (8bpp: two 4bpp halves); no 8x8 ROM -->
    <part crc="2ab0b06b" name="fhawk_g1.uc6"/>
    <part crc="d11bfa20" name="fhawk_g2.uc5"/>
    <!-- sprites, 0x200000 (plain) -->
    <part crc="cae72ff4" name="fhawk_g3.uc2"/>
    <!-- oki1, 0x040000 -->
    <part crc="d16aaaad" name="u101"/>
    <!-- oki2, 0x040000 -->
    <part crc="3fdcfac2" name="fhawk_s3.u41"/>
  </rom>
</misterromdescription>
