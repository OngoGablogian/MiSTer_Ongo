<misterromdescription>
	<name>Tekken Tag Tournament (World, TEG2/VER.C1, set 2)</name>
	<setname>tektagtc1a</setname>
	<rbf>XNSYSTEM12</rbf>
	<mameversion>0277</mameversion>
	<year>1999</year>
	<manufacturer>Namco</manufacturer>
	<category>Fighting</category>
	<platform>Namco System 12</platform>

	<!-- ==== SDRAM layout (see SYSTEM12.sv "ROM DETECT") ====
	     0x0000000  Main RAM      4 MB   (COH-700)
	     0x0400000  Program ROM   4 MB   ioctl 0 -> CPU 0x1FC00000 (this IS the boot rom; no BIOS)
	     0x0800000  Banked ROM   56 MB   ioctl 3 -> DMA-5 source / CPU window @0x1FA00000
	     0x2800000  H8 program  512 KB   ioctl 6 -> H8/3002 external flash (S12_SPROG_START)
	     0x2880000  C352 wave     8 MB   ioctl 7                     (S12_WAVE_START)
	     top of image 0x5080000 (80.5 MB) - REQUIRES the 128MB SDRAM module (core relocates
	     H8 program/wave above the 56MB banked ROM). Same relocated layout as every other
	     KEYCUS 0x44 Tekken Tag Tournament set in this catalog (FIXED 2026-09-23: this file
	     previously documented the non-relocated 64MB-module layout, which does not match
	     how the core actually handles KEYCUS 0x44 - see ioctl index 1 below).

	     NOTE: tektagtc1a is an alternate set of the TEG2/VER.C1 version with different
	     ROM PCB layout - uses 4MB chunks instead of 8MB, and different wave ROM arrangement.
	-->

	<!-- ioctl 0: main program (2x 2MB, 16-bit interleaved). Boots directly from here. -->
	<rom index="0" zip="tektagtc1a.zip|tektagt.zip" md5="none">
		<interleave output="16">
			<part name="teg2ver_c1.2e" crc="c0800960" map="01"/>
			<part name="teg2ver_c1.2j" crc="c0476713" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 1: platform byte. bit5 = Namco System 12 (System 11 = bit4, must stay CLEAR).
	     bit7 = coh700b boot signature (copy 12 bytes from program ROM +0x20280 to main
	     RAM 0x80010000 on every reset, as MAME's namcos12_state::driver_reset does when
	     m_boot_hack is set) - REQUIRED here because tektagtc1a runs on MAME's coh700b
	     machine (same as every other Tekken Tag Tournament set), so byte0 must be 0xA4,
	     not 0x24. (FIXED 2026-09-23: this file previously shipped 0x24, i.e. no boot
	     signature, which hangs the boot ROM on a coh700b title - every sibling Tekken
	     Tag Tournament MRA in this catalog already ships 0xA4.)
	     Second byte = KEYCUS id. 0x44 = KC044: enables the HLE Tekken Tag Tournament
	     protection + alternate-DMA path in memorymux (s12_tektagt gate), and also
	     drives the relocated SDRAM layout described above. Tekken 3 / Soul Calibur
	     keep 0x00 and are unaffected. -->
	<rom index="1"><part>A4 44</part></rom>

	<!-- ioctl 3: banked data ROM, 56 MB total (tektagtc1a variant layout with 4MB chunks
	     instead of the primary set's 8MB chunks). All pairs are MAME ROM_LOAD32_WORD at
	     byte offsets 0x0/0x2 within each 32-bit word.
	     FIXED 2026-09-23: this file previously used output="32" interleaves with two-bit
	     maps ("0011"/"1100") to place each part directly into a half of the 32-bit word.
	     That does not match the idiom every OTHER Tekken Tag Tournament MRA in this
	     catalog uses for the same ROM_LOAD32_WORD situation (tektagt / tektagtjc1 /
	     tektagtub / tektagtuc1, ioctl index 3): those all use output="16" with
	     single-bit maps "01"/"10" - the only interleave idiom the MiSTer built-in MRA
	     loader assembles correctly - relying on the core to swap the middle bytes of
	     each 32-bit word to restore the ROM_LOAD32_WORD layout. The two-bit-map form
	     was never hardware-tested and would not load correctly; changed here to match
	     the proven idiom used by the rest of the set.
	     Fetched by the CPU through the 2 MB window AND by the DMA-5 ROM reader.

	     Layout (MAME region "bankedroms", size 0x3800000):
	     0x0000000: teg2roml0 (4MB) + teg2roml00 (4MB) = 8 MB (ROM_LOAD32_WORD pairs at 0x0, 0x2)
	     0x0800000: teg2romh0 (4MB) + teg2romh00 (4MB) = 8 MB
	     0x1000000: teg2roml1 (4MB) + teg2roml10 (4MB) = 8 MB
	     0x1800000: teg2romh1 (4MB) + teg2romh10 (4MB) = 8 MB
	     0x2000000: teg2roml2 (4MB) + teg2roml20 (4MB) = 8 MB
	     0x2800000: teg2romh2 (4MB) + teg2romh20 (4MB) = 8 MB
	     0x3000000: teg2rf4 (4MB) + teg2rf6 (4MB) = 8 MB (also ROM_LOAD32_WORD, unlike the
	     primary set's ROM_LOAD32_BYTE quad in this slot - see MAME ROM_START( tektagtc1a ))
	-->
	<rom index="3" zip="tektagtc1a.zip|tektagt.zip" md5="none">
		<interleave output="16">
			<part name="teg2roml0"       crc="cf984e85" map="01"/>
			<part name="teg2roml00.ic13" crc="927723a5" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2romh0"  crc="ea088657" map="01"/>
			<part name="teg2romh00" crc="a85aa306" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2roml1"       crc="8552f0ef" map="01"/>
			<part name="teg2roml10.ic14" crc="13eb424b" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2romh1"  crc="86eb5abe" map="01"/>
			<part name="teg2romh10" crc="25131a87" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2roml2"       crc="abdfc6ca" map="01"/>
			<part name="teg2roml20.ic15" crc="ed5ec7f7" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2romh2"  crc="8c03b301" map="01"/>
			<part name="teg2romh20" crc="c873c362" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="teg2rf4" crc="612f6a37" map="01"/>
			<part name="teg2rf6" crc="0c9292ce" map="10"/>
		</interleave>
	</rom>

	<!-- ioctl 6: H8/3002 sound program, 512 KB (external flash; the H8 is ROMless). -->
	<rom index="6" zip="tektagtc1a.zip|tektagt.zip" md5="none">
		<part name="teg1.11s" crc="67d0c469"/>
	</rom>

	<!-- ioctl 7: C352 wave ROM, 8 MB (4x 4MB files, tektagtc1a variant layout);
	     core relocates it to SDRAM 0x4080000 (above the 56MB banked image), same as
	     the primary tektagt set. -->
	<rom index="7" zip="tektagtc1a.zip|tektagt.zip" md5="none">
		<part name="teg2wavel0.ic12" crc="1865336f"/>
		<part name="teg2wavel1"      crc="f5ab70e6"/>
		<part name="teg2waveh0"      crc="bc0325bf"/>
		<part name="teg2waveh1"      crc="6c654921"/>
	</rom>

	<!-- ioctl 9: settings EEPROM (AT28C16, 2048 bytes). Persisted as .nvram save file. -->
	<nvram index="9" size="2048"/>

	<buttons names="LP,RP,Tag,LK,RK,-,Start,Coin,Pause" default="A,B,R,X,Y,,Start,Select,L3" count="5"/>
</misterromdescription>
