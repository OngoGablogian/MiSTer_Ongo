<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME snowbros.cpp; the layout is
         rtl/memory/snowbros_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME snowbros.cpp"/>
    <name>Snow Bros. - Nick &amp; Tom (set 1) [ppriest]</name>
    <setname>snowbros_ppriest</setname>
    <rbf>ppriest_Pandora</rbf>
    <mameversion>0289</mameversion>
    <year>1990</year>
    <manufacturer>Toaplan</manufacturer>
    <category>Platform</category>
    <rotation>horizontal</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Shoot,Jump,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod bytes (Pandora.sv) -->
    <rom index="1"><part>00 00 00 00 00 10 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="snowbros.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="16">
            <part name="sn6.bin" crc="4899ddcf" map="01"/>
            <part name="sn5.bin" crc="ad310d3f" map="10"/>
        </interleave>
        <part repeat="0xC0000">00</part>  <!-- gfx1 at 0x100000 -->
        <!-- gfx1 -->
        <part name="sbros-1.41" crc="16f06b3a"/>
        <part repeat="0x180000">00</part>  <!-- soundcpu at 0x300000 -->
        <!-- soundcpu -->
        <part name="sbros-4.29" crc="e6eab4e4"/>
        <part repeat="0x4A200">00</part>  <!-- image end -->
    </rom>

    <switches default="FE,FF,00">
        <dip name="Region" bits="0,0" ids="Europe,America (Romstar)"/>
        <dip name="Flip Screen" bits="1,1" ids="On,Off"/>
        <dip name="Service Mode" bits="2,2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3,3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="4C/1C|2C/3C,3C/1C|2C/1C,2C/1C|1C/2C,1C/1C"/>
        <dip name="Coin B" bits="6,7" ids="1C/6C|2C/3C,1C/4C|2C/1C,1C/3C|1C/2C,1C/2C|1C/1C"/>
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Bonus Life" bits="10,11" ids="None,100k+every 200k,200k Only,100k Only"/>
        <dip name="Lives" bits="12,13" ids="2,4,1,3"/>
        <dip name="Invulnerability" bits="14,14" ids="On,Off"/>
        <dip name="Allow Continue" bits="15,15" ids="No,Yes"/>
    </switches>
</misterromdescription>
