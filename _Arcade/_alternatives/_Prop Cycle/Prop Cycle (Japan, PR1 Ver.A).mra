	</rom>

	<switches default="00" base="24">
		<dip name="Unused (SW4:1)" bits="0" ids="Off,On"/>
		<dip name="Unused (SW4:2)" bits="1" ids="Off,On"/>
		<dip name="Unused (SW4:3)" bits="2" ids="Off,On"/>
