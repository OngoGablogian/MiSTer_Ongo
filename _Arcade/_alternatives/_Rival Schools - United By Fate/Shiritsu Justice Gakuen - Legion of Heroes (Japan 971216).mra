<misterromdescription>
	<name>Shiritsu Justice Gakuen: Legion of Heroes (Japan 971216)</name>
	<setname>jgakuen</setname>
	<year>1997</year>
	<manufacturer>Capcom</manufacturer>
	<category>Fighting</category>
	<players>2</players>
	<rotation>horizontal</rotation>
	<rbf>ZN2Capcom</rbf>

	<!-- idx0 BIOS coh3002c -->
	<rom index="0" zip="coh3002c.zip" md5="none"><part name="m534002c-59.ic353" crc="e860ea8b"/></rom>
	<!-- idx1 platform byte 15 (Capcom+2MB-VRAM) -->
	<rom index="1"><part>15</part></rom>
	<!-- idx2 countryrom -->
	<rom index="2" zip="jgakuen.zip|rvschool.zip" md5="none"><part name="jstj_04a.2h" crc="91b36f38"/></rom>
	<!-- idx3 bankedroms -->
	<rom index="3" zip="jgakuen.zip|rvschool.zip" md5="none">
		<part name="jst-05m.3h" crc="723372b8"/>
		<part name="jst-06m.4h" crc="4248988e"/>
		<part name="jst-07m.5h" crc="c84c5a16"/>
		<part name="jst-08m.2k" crc="791b57f3"/>
		<part name="jst-09m.3k" crc="6df42048"/>
		<part name="jst-10m.4k" crc="d7e22769"/>
		<part name="jst-11m.5k" crc="0a033ac5"/>
		<part name="jst-12m.6k" crc="43bd2ddd"/>
		<part name="jst-13m.7k" crc="6b443235"/>
	</rom>
	<!-- idx4 mobo CAT702 key cp10 -->
	<rom index="4" zip="coh3002c.zip" md5="none"><part name="cp10.ic652" crc="7808fcef"/></rom>
	<!-- idx5 game CAT702 key -->
	<rom index="5" zip="jgakuen.zip|rvschool.zip" md5="none"><part name="cp06" crc="99b22128"/></rom>
	<!-- idx6 Z80 -->
	<rom index="6" zip="jgakuen.zip|rvschool.zip" md5="none">
		<part name="jst_02.2e" crc="7809e2c3"/>
		<part name="jst_03.3e" crc="860ff24d"/>
	</rom>
	<!-- idx7 QSound samples -->
	<rom index="7" zip="jgakuen.zip|rvschool.zip" md5="none">
		<part name="jst-01m.3b" crc="9a7c98f9"/>
	</rom>
	<!-- idx8 DSP microcode -->
	<rom index="8" zip="qsound_hle.zip" md5="none"><part name="dl-1425.bin" crc="d6cf5ef5"/></rom>

	<nvram index="9" size="2048"/>
	<switches base="96" default="00"><dip name="Service Mode" bits="1" ids="Off,On"/></switches>
	<buttons names="LP,HP,LK,HK,-,-,Start,Coin,Pause" default="A,B,X,Y,L,R,Start,Select,L3" count="4"/>
</misterromdescription>
