<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-BallySente_MiSTer" source="MAME balsente.cpp"/>
	<name>Grudge Match (v00.90, Italy, location test?)</name>
	<setname>grudgei</setname>
	<rbf>BallySente</rbf>
	<mameversion>0289</mameversion>
	<year>1987</year>
	<manufacturer>Bally Midway</manufacturer>
	<rotation>horizontal</rotation>
	<players>3</players>

	<!-- Layout and configuration bytes: scripts/build_mra.py, rtl/balsente_core.sv. -->
	<rom index="0" zip="grudgei.zip|grudge.zip|sente6vb.zip" md5="none">
		<part name="gm-3a.bin" crc="eabeec2b"/>
		<part name="gm-4a.bin" crc="72664f18"/>
		<part name="gm-1a.bin" crc="ad168726"/>
		<part name="gm-5a.u5a" crc="1de8dd2e" offset="0x0" length="0x6000"/>
		<part name="gm-6a.u6a" crc="513d8cdd"/>
		<part repeat="0x20000">00</part>
		<part name="gm-6b.u6b" crc="b9681f53"/>
		<part repeat="0x8000">00</part>
		<part name="8002-10 9-25-84.5" crc="4dd0a525"/>
		<part>3F 00 00 00 00 00 00 02 00 00 00 00 00 00 00 00 FF FF FF FF 09 29 A9 80 08 28 A8 04 24 A4 FF FE</part>
	</rom>

	<nvram index="4" size="512"/>

	<buttons names="Button 1,-,-,-,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="7F,7F,FF,FE">
		<dip name="Service Mode" bits="23" ids="On,Off"/>
		<dip name="Players" bits="15" ids="3,2"/>
		<dip name="Unknown" bits="0,1" ids="0,1,2,3"/>
		<dip name="Free Play" bits="7" ids="Off,On (buggy)"/>
		<dip name="Flip Screen" bits="24" ids="Off,On"/>
	</switches>
</misterromdescription>
