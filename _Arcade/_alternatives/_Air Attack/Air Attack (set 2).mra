<!--
  Air Attack (set 2) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 52).
  Clone of airattck; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... airattcka ...)
  line 10804, ROM_START(airattcka), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Air Attack (set 2)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>airattcka</setname>
  <year>1996</year>
  <manufacturer>Comad</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,34">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Unused (SW1:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10" name="Unused (SW2:6)" ids="On,Off"/>
    <dip bits="11" name="Unused (SW2:5)" ids="On,Off"/>
    <dip bits="12" name="Unused (SW2:4)" ids="On,Off"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="airattcka.zip|airattck.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="6589c005" name="5.ue10" map="01"/>
      <part crc="3572baf0" name="6.uc10" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x008000 -->
    <part crc="3e352370" name="3.su6"/>
    <!-- fgtile, 0x020000 -->
    <part crc="e9362ab4" name="4.ul10"/>
    <!-- bgtile, 0x100000 (2 files) -->
    <part crc="86e59966" name="9.uw9"/>
    <part crc="122c8d04" name="10.ux9"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="9a83e3d8" name="8.uo82" map="01"/>
      <part crc="3c38d671" name="7.uo81" map="10"/>
    </interleave>
    <!-- oki1, 0x0A0000 (fixed 0x20000 = 2.su12, banked = 1.su13's own 4 quarters) -->
    <part crc="93ab615b" name="2.su12"/>
    <part crc="09a836bb" name="1.su13"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0200 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="airattcka.zip|airattck.zip|nmk004.zip" md5="none">
    <part crc="ed0bd072" name="82s147.uh6"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for airattcka, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0B 91 00 00 80 00 6B
    </part>
  </rom>
  <nvram index="4" size="128"/>
</misterromdescription>
