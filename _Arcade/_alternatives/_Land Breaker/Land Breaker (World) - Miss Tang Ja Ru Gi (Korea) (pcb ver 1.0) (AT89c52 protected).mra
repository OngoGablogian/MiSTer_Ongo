<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Land Breaker (World) / Miss Tang Ja Ru Gi (Korea) (pcb ver 1.0) (AT89c52 protected)</name>
    <setname>landbrkb</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="landbrkb.zip|landbrk.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="lb2-000.u39" crc="b37faf7a" map="0012"/>
            <part name="lb2-001.u34" crc="07e620c9" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="lb2-002.u40" crc="3bb4bca6" map="0012"/>
            <part name="lb2-003.u35" crc="28ce863a" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="lb2-004.u41" crc="cbe84b06" map="0012"/>
            <part name="lb2-005.u36" crc="350c77a3" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="lb2-006.u42" crc="22c57cd8" map="0012"/>
            <part name="lb2-007.u37" crc="31f957b3" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="lb_040.u43" crc="a81d681b"/>
        <!-- qs1000:cpu -->
        <part name="lb.107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="lb.103" crc="92797034"/>
        <part repeat="0x77800">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="lb_3.u97" crc="5b34dff0"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="lb_2.108" crc="a99182d7"/>
        <patch offset="0x2014DA8">03 00</patch>  <!-- patch_mcu_protection(0x14da8) -->
    </rom>

    <switches default="FF" base="0">
        <dip name="Service Mode" bits="0" ids="On,Off"/>
        <dip name="Show Counters" bits="1" ids="On,Off"/>
    </switches>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
