<!--
  Red Hawk (Excellent Co., Ltd) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 23).
  Clone of stagger1; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... redhawke ...)
  line 10821, ROM_START(redhawke), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Red Hawk (Excellent Co., Ltd)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>redhawke</setname>
  <year>1997</year>
  <manufacturer>Afega (Excellent Co. license)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,17">
    <dip bits="0" name="Service Mode" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2" name="Unused (SW2:6)" ids="On,Off"/>
    <dip bits="3" name="Unused (SW2:5)" ids="On,Off"/>
    <dip bits="4" name="Unused (SW2:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW2:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,5,2,3"/>
    <dip bits="8,9" name="Flip Screen" ids="On,Vertically,Horizontally,Off"/>
    <dip bits="10" name="Unused (SW1:6)" ids="On,Off"/>
    <dip bits="11,12" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="13,15" name="Coinage" ids="4C_1C,2C_3C,2C_1C,1C_2C,3C_1C,1C_3C,3C_2C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="redhawke.zip|stagger1.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="5e0d6188" name="rhawk3.bin" map="01"/>
      <part crc="6d2e23b4" name="rhawk2.bin" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="1.bin"/>
    <!-- bgtile, 0x080000 (4bpp) -->
    <part crc="d79aa288" name="rhawk4.bin"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="3f980ab6" name="rhawk6.bin" map="01"/>
      <part crc="0264ef54" name="rhawk7.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x040000 -->
    <part crc="e911ce33" name="5"/>
  </rom>
</misterromdescription>
