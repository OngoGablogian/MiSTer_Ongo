<!--
  Red Hawk (horizontal, bootleg) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 29).
  Clone of stagger1; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... redhawkb ...)
  line 10824, ROM_START(redhawkb), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Red Hawk (horizontal, bootleg)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>redhawkb</setname>
  <year>1997</year>
  <manufacturer>bootleg (Vince)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="00,00,1D">
    <dip bits="0" name="Unused (SW2:8)" ids="Off,On"/>
    <dip bits="1" name="Demo Sounds" ids="On,Off"/>
    <dip bits="2" name="Unused (SW2:6)" ids="Off,On"/>
    <dip bits="3" name="Unused (SW2:5)" ids="Off,On"/>
    <dip bits="4" name="Unused (SW2:4)" ids="Off,On"/>
    <dip bits="5" name="Unused (SW2:3)" ids="Off,On"/>
    <dip bits="6,7" name="Lives" ids="3,2,5,1"/>
    <dip bits="8,9" name="Flip Screen" ids="Off,Horizontally,Vertically,On"/>
    <dip bits="10" name="Unused (SW1:6)" ids="Off,On"/>
    <dip bits="11,12" name="Difficulty" ids="Normal,Hard,Easy,Hardest"/>
    <dip bits="13,15" name="Coinage" ids="1C_1C,3C_2C,1C_3C,3C_1C,1C_2C,2C_1C,2C_3C,4C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="redhawkb.zip|stagger1.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="f9fa5684" name="rhb-2.bin" map="01"/>
      <part crc="e733ea07" name="rhb-1.bin" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="5d8cf28e" name="1.bin"/>
    <!-- bgtile, 0x080000 (4bpp, packed_lsb) -->
    <part crc="d0eaf6f2" name="rhb-5.bin"/>
    <!-- sprites, 0x100000 (two plain files, packed_lsb) -->
    <part crc="0318d68b" name="rhb-3.bin"/>
    <part crc="ba21c1ef" name="rhb-4.bin"/>
    <!-- oki1, 0x040000 -->
    <part crc="e911ce33" name="5"/>
  </rom>
</misterromdescription>
