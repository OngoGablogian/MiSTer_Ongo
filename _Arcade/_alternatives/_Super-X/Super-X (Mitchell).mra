<!--
  Super-X (Mitchell) - Dooyong (Mitchell license) 1994 - MRA for the RShark MiSTer core.
  MAME set superxm (MAME 0.289 dooyong.cpp). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/MRA_FORMAT.md.

  ioctl index 1: game select byte 01 (00 = R-Shark map, 01 = Super-X map).
  ioctl index 0 stream (hps_io WIDE=1; 16-bit regions arrive as big-endian 68000 words):
    000000-1FFFFF  sprite    MAME region 'sprite' +0x0 (word)
    200000-2FFFFF  bg0       MAME region 'bg0' +0x0 (word)
    300000-3FFFFF  bg1       MAME region 'bg1' +0x0 (word)
    400000-4FFFFF  fg0       MAME region 'fg0' +0x0 (word)
    500000-5FFFFF  fg1       MAME region 'fg1' +0x0 (word)
    600000-63FFFF  bg0map    MAME region 'bg0' +0x0 (word)
    640000-67FFFF  bg1map    MAME region 'bg1' +0x0 (word)
    680000-6BFFFF  fg0map    MAME region 'fg0' +0x0 (word)
    6C0000-6FFFFF  fg1map    MAME region 'fg1' +0x0 (word)
    700000-77FFFF  tmap_hi   MAME region 'tmap_hi' +0x0 (byte)
    780000-7BFFFF  oki       MAME region 'oki' +0x0 (byte)
    7C0000-7FFFFF  maincpu   MAME region 'maincpu' +0x0 (word)
    800000-80FFFF  audiocpu  MAME region 'audiocpu' +0x0 (byte)

  DIP switches (index 254): bytes 0/1 = DSW bits 7-0 (SWA) / 15-8 (SWB), MAME port values
  (active low). Default FF,FF = MAME defaults.
-->
<misterromdescription>
    <name>Super-X (Mitchell)</name>
    <setname>superxm</setname>
    <parent>superx</parent>
    <rbf>RShark</rbf>
    <mameversion>0289</mameversion>
    <year>1994</year>
    <manufacturer>Dooyong (Mitchell license)</manufacturer>
    <category>Shooter</category>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>vertical (ccw)</rotation>
    <buttons names="Shot,Bomb,Button 3,Button 4,Start,Coin,Service,Pause" default="A,B,X,Y,Start,Select,R,L"/>

    <switches default="FF,FF" base="16">
        <dip bits="0" name="Unknown (SWA:1)" ids="On,Off"/>
        <dip bits="1" name="Coin Type" ids="B,A"/>
        <dip bits="2" name="Demo Sounds" ids="Off,On"/>
        <dip bits="3" name="Flip Screen" ids="On,Off"/>
        <dip bits="4,5" name="Coin A (type A/B)" ids="2C3C/4C1C,2C1C/3C1C,1C2C/2C1C,1C1C/1C1C"/>
        <dip bits="6,7" name="Coin B (type A/B)" ids="2C3C/1C6C,2C1C/1C4C,1C2C/1C3C,1C1C/1C1C"/>
        <dip bits="8,9" name="Lives" ids="1,4,2,3"/>
        <dip bits="10,11" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="15" name="Allow Continue" ids="No,Yes"/>
    </switches>

    <rom index="1">
        <part>01</part>
    </rom>
    <rom index="0" zip="superxm.zip|superx.zip" md5="None">
        <!-- 000000 sprite -->
        <part name="spxo-m05.10m" crc="9120dd84"/>
        <!-- 200000 bg0 -->
        <part name="spxb-m01.8c" crc="60c69129"/>
        <!-- 300000 bg1 -->
        <part name="spxb-m02.8a" crc="21b8db78"/>
        <!-- 400000 fg0 -->
        <part name="spxb-m03.8j" crc="8b42861b"/>
        <!-- 500000 fg1 -->
        <part name="spxb-m04.8f" crc="91a7ac6e"/>
        <!-- 600000 bg0map -->
        <part name="spxb-m01.8c" crc="60c69129" offset="0" length="0x40000"/>
        <!-- 640000 bg1map -->
        <part name="spxb-m02.8a" crc="21b8db78" offset="0" length="0x40000"/>
        <!-- 680000 fg0map -->
        <part name="spxb-m03.8j" crc="8b42861b" offset="0" length="0x40000"/>
        <!-- 6C0000 fg1map -->
        <part name="spxb-m04.8f" crc="91a7ac6e" offset="0" length="0x40000"/>
        <!-- 700000 tmap_hi -->
        <part name="spxb-ms3.10f" crc="8bf8c77d"/>
        <part name="spxb-ms4.10j" crc="d418a900"/>
        <part name="spxb-ms2.10a" crc="5ec87adf"/>
        <part name="spxb-ms1.10c" crc="40b4fe6c"/>
        <!-- 780000 oki -->
        <part name="4.7v" crc="434290b5"/>
        <part name="5.7u" crc="ebe6abb4"/>
        <!-- 7C0000 maincpu -->
        <interleave output="16">
            <part name="2_m.3m" crc="41c50aac" map="10"/>
            <part name="3_m.3l" crc="6738b703" map="01"/>
        </interleave>
        <!-- 800000 audiocpu -->
        <part name="1_m.5u" crc="319fa632"/>
    </rom>
</misterromdescription>
