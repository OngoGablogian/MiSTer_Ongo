            <part name="b02_7-2.h11" crc="af48c4e6" map="001"/>
            <part name="b02_6-2.h10" crc="9a29a862" map="010"/>
            <part name="b02_5-2.h8"  crc="fb7cad55" map="100"/>
        </interleave>

        <!-- fg_tiles - starts at 0x34C00 -->
