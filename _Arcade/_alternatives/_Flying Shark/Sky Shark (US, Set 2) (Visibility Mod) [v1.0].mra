            <part name="b02_11.h18" crc="f5799422" map="0010"/>
            <part name="b02_10.h16" crc="4bd099ff" map="0100"/>
            <part name="b02_09.h15" crc="230f1582" map="1000"/>
        </interleave>

        <!-- sprites - starts at 0x74C00 -->
        <interleave output="32">
            <part name="b02_01.d15" crc="2234b424" map="1000"/>
            <part name="b02_02.d16" crc="30d4c9a8" map="0100"/>
            <part name="b02_03.d17" crc="64f3d88f" map="0010"/>
