<!--
  Saboten Bombers (set 2) — NMK16 "NMK16_Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 17).
  Clone of sabotenb; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... sabotenba ...)
  line 10752, ROM_START(sabotenba), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Saboten Bombers (set 2)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>sabotenba</setname>
  <year>1992</year>
  <manufacturer>NMK / Tecmo</manufacturer>
  <category>Shooter</category>
  <rbf>NMK16_Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,11">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Language" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="sabotenba.zip|sabotenb.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 -->
    <interleave output="16">
      <part crc="0d2c1ab8" name="sb2.75" map="01"/>
      <part crc="df6f65e2" name="sb1.76" map="10"/>
    </interleave>
    <!-- NMK-215 protection MCU ROM, 0x002000 (read into the MCU from SDRAM after reset) -->
    <part crc="d355a06f" name="nmk-215.bin"/>
    <!-- fgtile, 0x010000 (8x8, bank 0) -->
    <part crc="eb7bc99d" name="ic35.sb3"/>
    <!-- bgtile, 0x200000 (8x8, bank 1, NMK214-scrambled) -->
    <part crc="24c62205" name="ic32.sb4"/>
    <!-- sprites, 0x200000 (ROM_LOAD16_WORD_SWAP, NMK214-scrambled) -->
    <part crc="b20f166e" name="ic100.sb5"/>
    <!-- oki1, 0x100000 (NMK112-banked) -->
    <part crc="288407af" name="ic30.sb6"/>
    <!-- oki2, 0x100000 (NMK112-banked) -->
    <part crc="43e33a7e" name="ic27.sb7"/>
  </rom>

  <!-- nmk_irq:vtiming, 0x0100 bytes. Streamed as its own ioctl index so no
       SDRAM region base moves; nmk_irq.sv writes it into table 0. -->
  <rom index="1" zip="sabotenba.zip|sabotenb.zip|nmk004.zip" md5="none">
    <part crc="633ab1c9" name="8.ic37"/>
  </rom>

  <!-- High scores: MAME hiscore.dat entries for sabotenba, and the
       saved dump. See tools/gen_hiscore_mra.py. -->
  <rom index="3" md5="none">
    <part>
        0C 00 00 00 00 FF 00 02 00 02 00 01 00 FF 02 00
        00 0F 6E 00 00 6C 00 1E
    </part>
  </rom>
  <nvram index="4" size="108"/>

  <!-- Cheats (Pugsy's MAME cheat database). Slots in fixed order:
       Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives, P1 Infinite Bombs, P2 Infinite Bombs.
       This set provides: Infinite Credits, P1 Invincibility, P2 Invincibility, P1 Infinite Lives, P2 Infinite Lives. See tools/gen_cheats_mra.py. -->
  <rom index="5" md5="none">
    <part>
        01 00 0F 90 03 00 00 09 00 00 00 00 00 00
        01 00 0F 00 6F 00 00 02 00 00 00 00 00 00
        01 00 0F 01 6F 00 00 02 00 00 00 00 00 00
        01 00 0F 00 37 00 00 09 00 00 00 00 00 00
        01 00 0F 01 37 00 00 09 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
        00 00 00 00 00 00 00 00 00 00 00 00 00 00
    </part>
  </rom>
</misterromdescription>
