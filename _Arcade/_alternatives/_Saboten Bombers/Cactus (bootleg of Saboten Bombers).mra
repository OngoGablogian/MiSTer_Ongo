<!--
  Cactus (bootleg of Saboten Bombers) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 18).
  Clone of sabotenb; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... cactus ...)
  line 10753, ROM_START(cactus), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Cactus (bootleg of Saboten Bombers)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>cactus</setname>
  <year>1992</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,12">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Language" ids="English,Japanese"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="cactus.zip|sabotenb.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 -->
    <interleave output="16">
      <part crc="5b8ba46a" name="01.bin" map="01"/>
      <part crc="15b2ff2f" name="02.bin" map="10"/>
    </interleave>
    <!-- fgtile, 0x010000 (sabotenb's ic35.sb3 — cactus.zip has no separate copy) -->
    <part crc="eb7bc99d" name="ic35.sb3"/>
    <!-- bgtile, 0x200000 (2 files; sabotenb's data, descrambled with the NMK-215's fixed configs) -->
    <part crc="fce962b9" name="s-05.bin"/>
    <part crc="16768fbc" name="s-06.bin"/>
    <!-- sprites, 0x200000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="bc1781b8" name="s-03.bin" map="01"/>
      <part crc="f823885e" name="s-04.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x100000 (sabotenb's ic30.sb6, same data as the driver's s-01.bin) -->
    <part crc="288407af" name="ic30.sb6"/>
    <!-- oki2, 0x100000 (sabotenb's ic27.sb7) -->
    <part crc="43e33a7e" name="ic27.sb7"/>
  </rom>
</misterromdescription>
