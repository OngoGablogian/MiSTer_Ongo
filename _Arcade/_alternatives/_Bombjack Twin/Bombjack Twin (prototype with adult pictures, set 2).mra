<!--
  Bombjack Twin (prototype? with adult pictures, set 2) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 16).
  Clone of bjtwin; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... bjtwinpa ...)
  line 10758, ROM_START(bjtwinpa), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Bombjack Twin (prototype? with adult pictures, set 2)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>bjtwinpa</setname>
  <year>1993</year>
  <manufacturer>NMK</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,10">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1,3" name="Starting level" ids="China,Hong_Kong,Thailand,Korea,Germany,England,Nevada,Japan"/>
    <dip bits="4,5" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="bjtwinpa.zip|bjtwin.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="7c99b97f" name="ic75.bin" map="01"/>
      <part crc="81106d1e" name="ic76.bin" map="10"/>
    </interleave>
    <!-- NMK-215 protection MCU ROM, 0x002000 (read into the MCU from SDRAM after reset) -->
    <part crc="d355a06f" name="nmk-215.bin"/>
    <!-- fgtile, 0x010000 -->
    <part crc="aa13df7c" name="93087-3.bin"/>
    <!-- bgtile, 0x180000 (3 files, NMK214-scrambled) -->
    <part crc="e2d2b331" name="ic32_1.bin"/>
    <part crc="28a3a845" name="ic32_2.bin"/>
    <part crc="ecce80c9" name="ic32_3.bin"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair, NMK214-scrambled) -->
    <interleave output="16">
      <part crc="ec85e1b7" name="ic100_2.bin" map="01"/>
      <part crc="2ea7e460" name="ic100_1.bin" map="10"/>
    </interleave>
    <!-- oki1, 0x100000 (2 files) -->
    <part crc="b5ef197f" name="bottom.ic30"/>
    <part crc="ab50531d" name="top.ic30"/>
    <!-- oki2, 0x100000 (2 files) -->
    <part crc="adb2f256" name="top.ic27"/>
    <part crc="6ebeb9e4" name="bottom.ic27"/>
  </rom>
</misterromdescription>
