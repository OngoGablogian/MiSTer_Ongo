<!--
  Magical Cat Adventure (Japan) - Wintechno 1993 - MRA for the LINDA board MiSTer core
  (Nostradamus / Magical Cat Adventure; core file Nostradamus).
  MAME set mcatadvj (MAME 0.289 misc/mcatadv.cpp). No ROM data is embedded in this file.
  Generated by scripts/romtool.py mra ; layout documented in docs/ROM_LAYOUT.md.

  ioctl index 0 stream (hps_io WIDE=1):
    000000-0FFFFF  maincpu   MAME region 'maincpu' from 0x0 (68000 words)
    100000-13FFFF  soundcpu  MAME region 'soundcpu' from 0x0 (bytes in order, 00 past 0x20000)
    140000-23FFFF  adpcma    MAME region 'ymsnd:adpcma' from 0x0 (bytes in order, 00 past 0x80000)
    240000-3BFFFF  bg0       MAME region 'bg0' from 0x0 (bytes in order, 00 past 0x80000)
    3C0000-53FFFF  bg1       MAME region 'bg1' from 0x0 (bytes in order)
    540000-A3FFFF  sprdata   MAME region 'sprdata' from 0x0 (bytes in order)
    A40000-B3FFFF  bg1 tail  MAME region 'bg1' from 0x180000 (bytes in order)
  sprdata 500000-7FFFFF (MAME ROMREGION_ERASEFF, no ROMs) is not sent: the core returns FF.
  ioctl index 1: game select byte 01 (00 = Nostradamus board, 01 = Magical Cat board).

  DIP switches (index 254): byte 0 = DSW1 (SW1:1-8 = bits 0-7), byte 1 = DSW2 (SW2:1-8),
  MAME port values (active low). Default FF,FF = MAME defaults.
-->
<misterromdescription>
    <name>Magical Cat Adventure (Japan)</name>
    <setname>mcatadvj</setname>
    <rbf>Nostradamus</rbf>
    <mameversion>0289</mameversion>
    <year>1993</year>
    <manufacturer>Wintechno</manufacturer>
    <category>Platform</category>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>horizontal</rotation>
    <buttons names="Fire,Jump,Button 3 (test),Start,Coin,Service,Pause" default="A,B,X,Start,Select,R,L"/>

    <switches default="FF,FF" base="16">
        <dip bits="0" name="Demo Sounds" ids="Off,On"/>
        <dip bits="1" name="Flip Screen" ids="On,Off"/>
        <dip bits="2" name="Service Mode" ids="On,Off"/>
        <dip bits="3" name="Coin Mode" ids="Mode 2,Mode 1"/>
        <dip bits="4,5" name="Coin A (Mode 1/2)" ids="2C3C/4C1C,2C1C/3C1C,1C2C/1C4C,1C1C"/>
        <dip bits="6,7" name="Coin B (Mode 1/2)" ids="2C3C/4C1C,2C1C/3C1C,1C2C/1C4C,1C1C"/>
        <dip bits="8,9" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
        <dip bits="10,11" name="Lives" ids="5,2,4,3"/>
        <dip bits="12,13" name="Energy" ids="8,5,4,3"/>
        <dip bits="14,15" name="Cabinet" ids="Upright 2P,Upright 1P,Cocktail,Upright 2P"/>
    </switches>

    <rom index="1"><part>01</part></rom>
    <rom index="0" zip="mcatadvj.zip|mcatadv.zip" md5="None">
        <!-- 000000 maincpu -->
        <interleave output="16">
            <part name="u30.bin" crc="05762f42" map="10"/>
            <part name="u29.bin" crc="4c59d648" map="01"/>
        </interleave>
        <!-- 100000 soundcpu -->
        <part name="u9.bin" crc="fda05171"/>
        <part repeat="0x20000">00</part>
        <!-- 140000 adpcma -->
        <part name="mca-u53.bin" crc="64c76e05"/>
        <part repeat="0x80000">00</part>
        <!-- 240000 bg0 -->
        <part name="mca-u58.bin" crc="3a8186e2"/>
        <part repeat="0x100000">00</part>
        <!-- 3C0000 bg1 -->
        <part name="mca-u60.bin" crc="c8942614"/>
        <part name="mca-u61.bin" crc="51af66c9" offset="0x0" length="0x80000"/>
        <!-- 540000 sprdata -->
        <interleave output="16">
            <part name="mca-u82.bin" crc="5f01d746" map="01"/>
            <part name="mca-u83.bin" crc="4e1be5a6" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="mca-u84.bin" crc="df202790" map="01"/>
            <part name="mca-u85.bin" crc="a85771d2" map="10"/>
        </interleave>
        <part repeat="0x100000">FF</part>
        <interleave output="16">
            <part name="u86.bin" crc="2d3725ed" map="01"/>
            <part name="u87.bin" crc="4ddefe08" map="10"/>
        </interleave>
        <!-- A40000 bg1 tail -->
        <part name="mca-u61.bin" crc="51af66c9" offset="0x80000" length="0x80000"/>
        <part name="u100.bin" crc="e2c311da"/>
    </rom>
</misterromdescription>
