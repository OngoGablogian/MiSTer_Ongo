<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME dreamwld.cpp; the layout is
         rtl/memory/dreamworld_sdram_top.sv. Do not edit by hand. -->
    <about author="Paul Priest" webpage="" source="MAME dreamwld.cpp"/>
    <name>Baryon - Future Assault (set 2)</name>
    <setname>baryona</setname>
    <rbf>DreamWorld</rbf>
    <mameversion>0289</mameversion>
    <year>1997</year>
    <manufacturer>SemiCom / Tirano</manufacturer>
    <category>Shooter</category>
    <rotation>vertical (ccw)</rotation>
    <players>2</players>
    <joystick>8-way</joystick>
    <buttons names="Shot,Bomb,-,-,-,-,Start,Coin,Pause" default="A,B,Start,Select,R" count="2"/>

    <!-- mod byte (DreamWorld.sv): [0] the second OKI (dreamwld_map), [2:1] orientation -->
    <rom index="1"><part>04</part></rom>

    <!-- hiscore (rtl/hiscore.v), from MAME's plugins/hiscore/hiscore.dat -->
    <rom index="3">
        <part>
        19 9A 57 EF 3F FF 00 02 00 02 00 01 00 0F 10 00
        00 FE 37 DE 78 4B F8 00
        </part>
    </rom>
    <nvram index="4" size="120"/>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/rom_loader.sv) -->
    <rom index="0" zip="baryona.zip|baryon.zip" md5="none" address="0x30000000">
        <!-- maincpu -->
        <interleave output="32">
            <part name="4.bin" crc="59e0df20" map="0001"/>
            <part name="6.bin" crc="abccbb3d" map="0010"/>
            <part name="3.bin" crc="046d4231" map="0100"/>
            <part name="5.bin" crc="63d5e7cb" map="1000"/>
        </interleave>
        <part repeat="0x100000">00</part>  <!-- gfx1 at 0x200000 -->
        <!-- gfx1 -->
        <part name="9.bin" crc="28bf828f"/>
        <part name="11.bin" crc="d0ff1bc6"/>
        <part repeat="0x400000">00</part>  <!-- gfx2 at 0xA00000 -->
        <!-- gfx2 -->
        <part name="2.bin" crc="684012e6"/>
        <!-- spritelut -->
        <interleave output="16">
            <part name="8.bin" crc="fdbb08b0" map="01"/>
            <part name="10.bin" crc="c9d20480" map="10"/>
        </interleave>
        <!-- oki1 -->
        <part name="1.bin" crc="e0349074"/>
        <part repeat="0x80000">00</part>  <!-- mcu at 0xD40000 -->
        <!-- mcu -->
        <part name="mcu.bin" crc="1ee7896c"/>
    </rom>

    <switches default="FF,FE,00">
        <dip name="Lives" bits="0,1" ids="5,4,2,3"/>
        <dip name="Free Play" bits="7" ids="On,Off"/>
        <dip name="Coinage" bits="9,10,11" ids="5 Coins/1 Credit,4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/3 Credits,2 Coins/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
        <dip name="Bomb Stock" bits="2" ids="3,2"/>
        <dip name="Demo Sounds" bits="8" ids="On,Off"/>
        <!-- not on the board: read by the core, not the game (DreamWorld.sv flip_screen) -->
        <dip name="Flip Screen" bits="16" ids="Off,On"/>
    </switches>
</misterromdescription>
