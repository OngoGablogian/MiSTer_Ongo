<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Cyber Troopers Virtual-On - Twin (USA, Revision B) (Model
      2B-CRX). Derived from MAME 0.289 model2.cpp ROM_START(vonu), a
      clone of von. For the Model 2B build (branch model2b, Model2.sv
      M2_2B: the ADSP-21062 SHARC as the coprocessor); the 2A and 2C
      cores cannot run it. Study R1024 (this set's census), R1031.

      MAME 0.289: MACHINE_NOT_WORKING. The USA Revision B program's
      first 1 MB (epr-18828b / 18829b); every other ROM is the export
      set's. R1024 measured von, not this set. No protection, no
      patches.

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py, the 2B slots as Dead or Alive (Model 2B)'s):
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window, ROM_COPY mirrors
                   written out)
        0x2080000  4 MB of zeros (the 2B core keeps the SHARC's DM page at
                   its start, SDRAM byte 0x2080000, 128 KB)
        0x2480000  256 KB of zeros (the 2A TGP's tables; 2B has none)
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB          -> SDRAM byte 0x3400000
        0x2D40000  i960 program 512 KB-2 MB    -> SDRAM byte 0x2600000
        0x2EC0000  copro data, 4 MB (the SHARC's data ROM) -> SDRAM byte 0x2780000
        0x32C0000  texture-coordinate ROM, 16 MB -> SDRAM byte 0x4000000
        0x42C0000  polygons                    -> SDRAM byte 0x5000000
      Image: 0x52C0000 bytes. Every stretch MAME's region does not load is
      written as MAME's fill (0, or 0xFF where the region is ERASEFF).

      Index 4, the game ID: 0x28, the Virtual-On sets' own (R1037; the 2B
      build only): the large layout; the SHARC's data-ROM reads from the
      copro-data slot (Model2.sv a2_copro_rom; MAME 0.289 reads only its
      first 2.25 MB); its luma rows (0, 1, 52 and 56, exact; measured on
      von, the parent). Before (0x16, Dead or Alive's, borrowed): the
      data-ROM reads were 0 (in MAME that leaves the attract with no 3D,
      R1037) and DOA's luma ranges drew all four rows with other rows'
      tables. The i960 forms it boots on (roundrl, scalerl, exprl) are in
      the 2B build since R1040. THE TWIN STICKS (R1046): MAME's von puts
      both levers and all four buttons on player 1. IN1 is joystick 1's
      stick (the left lever) with Left Shot J4 and Left Dash J5; IN2, the
      right lever, is joystick 2 (its stick, J4 Right Shot, J5 Right Dash:
      two sticks seen as two joysticks) or player 1's right analogue stick
      with Right Shot J6 and Right Dash J11 (one pad). Bit 7 is SET in this
      MRA (0xA8): the 15 kHz CRT flag (R795), which starts the core in 15
      kHz interlaced whatever the OSD says (R908).
    -->
    <name>Cyber Troopers Virtual-On - Twin (USA, Revision B) [15kHz CRT]</name>
    <setname>vonu</setname>
    <rbf>Model2B</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>A8 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1995</year>
    <manufacturer>Sega</manufacturer>
    <category>Shooter</category>

    <rom index="0" zip="vonu.zip|von.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-18828b.15" crc="6499cc59" map="0021" offset="0x000000" length="0x040000"/>
            <part name="epr-18829b.16" crc="0053b10f" map="2100" offset="0x000000" length="0x040000"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <interleave output="32">
            <part name="mpr-18648.11" crc="2edbe489" map="0021"/>
            <part name="mpr-18649.12" crc="e68c5aa6" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-18650.9" crc="89a855b9" map="0021"/>
            <part name="mpr-18651.10" crc="f4c23107" map="2100"/>
        </interleave>
        <part repeat="16777216">00</part>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots (the 2B core keeps the
                     SHARC's DM page at its start, SDRAM byte 0x2080000, 128 KB) -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB: none on 2B (no TGP) -->
        <part repeat="262144">00</part>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-18670.31" crc="3e715f76" map="12"/>
        </interleave>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped); moved by the
                     loader to SDRAM byte 0x3400000 -->
        <interleave output="16">
            <part name="mpr-18652.32" crc="037eee53" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-18653.34" crc="9ec3e7bf" map="12"/>
        </interleave>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <interleave output="32">
            <part name="epr-18828b.15" crc="6499cc59" map="0021" offset="0x040000" length="0x040000"/>
            <part name="epr-18829b.16" crc="0053b10f" map="2100" offset="0x040000" length="0x040000"/>
        </interleave>
        <interleave output="32">
            <part name="epr-18666.13" crc="66edb432" map="0021"/>
            <part name="epr-18667.14" crc="b593d31f" map="2100"/>
        </interleave>

        <!-- 0x2EC0000  copro data, 4 MB (R862): the SHARC's data ROM, MAME's 4 MB -->
        <interleave output="32">
            <part name="mpr-18662.29" crc="a33d3335" map="0021"/>
            <part name="mpr-18663.30" crc="ea74a641" map="2100"/>
        </interleave>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897; the loader's third
                     remap puts it at SDRAM byte 0x4000000) -->
        <interleave output="32">
            <part name="mpr-18660.27" crc="e53663e5" map="0021"/>
            <part name="mpr-18658.25" crc="3d0fcd01" map="2100"/>
        </interleave>
        <part repeat="4194304">FF</part>
        <interleave output="32">
            <part name="mpr-18661.28" crc="52b50410" map="0021"/>
            <part name="mpr-18659.26" crc="27aa8ae2" map="2100"/>
        </interleave>
        <part repeat="4194304">FF</part>

        <!-- 0x42C0000  polygons, 16 MB (R897; SDRAM byte 0x5000000) -->
        <interleave output="32">
            <part name="mpr-18654.17" crc="6a0caf29" map="0021"/>
            <part name="mpr-18655.21" crc="a4293e78" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-18656.18" crc="b4f51e76" map="0021"/>
            <part name="mpr-18657.22" crc="a9be4674" map="2100"/>
        </interleave>

    </rom>

    <!-- The left lever on joystick 1 (or a pad's left stick), the right lever
         on joystick 2 or player 1's right stick; Right Shot / Right Dash on
         J6 / J11 (or joystick 2's J4 / J5). MAME's von ports (R1046). -->
    <buttons names="Left Shot,Left Dash,Right Shot,Start,Coin,Test,Service,Right Dash"/>
</misterromdescription>
