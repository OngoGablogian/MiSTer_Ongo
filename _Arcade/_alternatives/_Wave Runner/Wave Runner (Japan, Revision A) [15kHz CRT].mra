<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Wave Runner (Japan, Revision A) (Model 2C-CRX). Derived from MAME 0.289 model2.cpp
      ROM_START(waverunr). For the Model 2C build of the 2A core (Model2.sv
      M2_2C); the 2A and original cores cannot run it. Study R1010.

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py's functions):
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window, ROM_COPY
                   mirrors written out)
        0x2080000  4 MB of zeros (the 2C core keeps the TGPx4's program copy
                   at its start, written by the upload)
        0x2480000  256 KB of zeros (the 2A TGP's tables; 2C has none)
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB
        0x2D40000  i960 program 512 KB-2 MB
        0x2EC0000  copro data, 4 MB: its 1 MB of copro data (the TGPx4's external ROM; MAME's region is 8 MB, the rest zeros)
        0x32C0000  texture-coordinate ROM, 16 MB (MAME's region tiled, as its
                   mask reads it)
        0x42C0000  polygons, 31 MB
      Image: 0x61C0000 bytes. NOT LOADED: the drive board's program and the comm board's, if any (MAME models neither).

      Index 4, the game ID: 0x1E (R1010). Bit 7 is SET in this MRA (0x9E): the
      15 kHz CRT flag (R795), which starts the core in 15 kHz interlaced
      whatever the OSD says (R908).
    -->
    <name>Wave Runner (Japan, Revision A) [15kHz CRT]</name>
    <setname>waverunr</setname>
    <rbf>Model2C</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>9E 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1996</year>
    <manufacturer>Sega</manufacturer>
    <category>Driving</category>

    <rom index="0" zip="waverunr.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-19282a.15" crc="5df58604" map="0021" offset="0x000000" length="0x040000"/>
            <part name="epr-19283a.16" crc="bca188e1" map="2100" offset="0x000000" length="0x040000"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <interleave output="32">
            <part name="mpr-19291.11" crc="54431d67" map="0021"/>
            <part name="mpr-19292.12" crc="9152d979" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-19293.9" crc="b168bea9" map="0021"/>
            <part name="mpr-19294.10" crc="c731e659" map="2100"/>
        </interleave>
