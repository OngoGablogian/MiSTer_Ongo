        </interleave>
        <interleave output="32">
            <part name="epr-19278.7" crc="29ed421d" map="0021"/>
            <part name="epr-19279.8" crc="6ae9f899" map="2100"/>
        </interleave>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB: none on 2C -->
        <part repeat="262144">00</part>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-19284.31" crc="efe5f0f3" map="12"/>
        </interleave>
        <part repeat="262144">00</part>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="mpr-19295.32" crc="b14eeb09" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-19296.34" crc="b4b9faff" map="12"/>
        </interleave>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <interleave output="32">
            <part name="epr-19282a.15" crc="5df58604" map="0021" offset="0x040000" length="0x040000"/>
            <part name="epr-19283a.16" crc="bca188e1" map="2100" offset="0x040000" length="0x040000"/>
        </interleave>
        <part repeat="1048576">00</part>

        <!-- 0x2EC0000  copro data, 4 MB (R862, R924) -->
        <interleave output="32">
            <part name="epr-19280.29" crc="c6b59fb9" map="0021"/>
            <part name="epr-19281.30" crc="5a6110e7" map="2100"/>
        </interleave>
        <part repeat="3145728">00</part>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897) -->
