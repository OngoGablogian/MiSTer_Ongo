<misterromdescription>
	<name>Gallop Racer (Japanese Ver 9.01.12)</name>
	<setname>glpracrj</setname>
	<year>1996</year>
	<manufacturer>Tecmo</manufacturer>
	<category>Sports</category>
	<players>1</players>
	<joystick>8-way</joystick>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<rbf>ZN1Capcom</rbf>

	<!-- BIOS: Capcom ZN-1 BIOS (coh1000c), 512KB, ioctl_index 0. Japanese mask ROM. -->
	<rom index="0" zip="coh1000c.zip" md5="none">
		<part name="m534002c-13.ic353" crc="50033af6"/>
	</rom>

	<!-- Platform: Capcom ZN-1 (0x05), ioctl_index 1 -->
	<rom index="1">
		<part>05</part>
	</rom>

	<!-- Country/program ROM: 512KB, ioctl_index 2, CPU 0x1FB80000 (MAME region "countryrom") -->
	<rom index="2" zip="glpracrj.zip|glpracr.zip" md5="none">
		<part name="gpaj_04.2h" crc="53bf551c"/>
	</rom>

	<!-- Banked ROM: 3x4MB = 12MB, ioctl_index 3 (MAME region "bankedroms"). -->
	<rom index="3" zip="glpracr.zip" md5="none">
		<part name="gra-05m.3h" crc="78053700"/>
		<part name="gra-06m.4h" crc="d73b392b"/>
		<part name="gra-07m.5h" crc="acaefe3a"/>
	</rom>

	<!-- CAT702 key A: motherboard key (cp01), 8 bytes, ioctl_index 4 -->
	<rom index="4" zip="coh1000c.zip" md5="none">
		<part name="cp01.ic652" crc="bb7ba033"/>
	</rom>

	<!-- CAT702 key B: game key (cp05), 8 bytes, ioctl_index 5 -->
	<rom index="5" zip="glpracr.zip" md5="none">
		<part name="cp05" crc="ae930900"/>
	</rom>

	<!-- Gallop Racer has NO QSound (audio Z80 held in reset, sockets empty). Silent = complete. -->

	<nvram index="9" size="2048"/>
	<switches base="96" default="00">
		<dip name="Service Mode" bits="1" ids="Off,On"/>
	</switches>
</misterromdescription>
