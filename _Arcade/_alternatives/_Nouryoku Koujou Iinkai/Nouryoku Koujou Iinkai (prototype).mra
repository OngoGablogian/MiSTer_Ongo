<!--
  Nouryoku Koujou Iinkai (prototype) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 19).
  Clone of nouryoku; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... nouryokup ...)
  line 10761, ROM_START(nouryokup), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Nouryoku Koujou Iinkai (prototype)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>nouryokup</setname>
  <year>1995</year>
  <manufacturer>Tecmo</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,13">
    <dip bits="0,1" name="Life Decrease Speed" ids="Very Fast,Fast,Slow,Normal"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="4" name="Free Play" ids="On,Off"/>
    <dip bits="5,7" name="Coinage" ids="2C_3C,4C_1C,1C_3C,2C_1C,1C_4C,3C_1C,1C_2C,1C_1C"/>
    <dip bits="8" name="Unused (SW2:8)" ids="On,Off"/>
    <dip bits="9" name="Unused (SW2:7)" ids="On,Off"/>
    <dip bits="10" name="Unused (SW2:6)" ids="On,Off"/>
    <dip bits="11" name="Unused (SW2:5)" ids="On,Off"/>
    <dip bits="12" name="Unused (SW2:4)" ids="On,Off"/>
    <dip bits="13" name="Flip Screen" ids="On,Off"/>
    <dip bits="14" name="Demo Sounds" ids="Off,On"/>
    <dip bits="15" name="Service Mode" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="nouryokup.zip|nouryoku.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x080000 -->
    <interleave output="16">
      <part crc="75ab82cd" name="ic75.2" map="01"/>
      <part crc="26075988" name="ic76.1" map="10"/>
    </interleave>
    <!-- fgtile, 0x010000 -->
    <part crc="03d0c3b1" name="ic35.3"/>
    <!-- bgtile, 0x200000 (4 files, plain) -->
    <part crc="1fec8e14" name="bg0.u1.ic32"/>
    <part crc="7b8ea3f0" name="bg1.u2.ic32"/>
    <part crc="6f4eb408" name="bg2.u3.ic32"/>
    <part crc="dea8c120" name="bg3.u4.ic32"/>
    <!-- sprites, 0x200000 (two ROM_LOAD16_BYTE pairs, plain) -->
    <interleave output="16">
      <part crc="d4913a08" name="obj0odd.u6.ic100" map="01"/>
      <part crc="7966ce07" name="obj0even.u7.ic100" map="10"/>
    </interleave>
    <interleave output="16">
      <part crc="4a383085" name="obj1odd.u8.ic100" map="01"/>
      <part crc="e01567e8" name="obj1even.u9.ic100" map="10"/>
    </interleave>
    <!-- oki1, 0x100000 (2 files) -->
    <part crc="34ded136" name="soundpcm0.bottom.ic30"/>
    <part crc="a8d2abf7" name="soundpcm1.top.ic30"/>
    <!-- oki2, 0x100000 (2 files) -->
    <part crc="29d0a15d" name="soundpcm2.top.ic27"/>
    <part crc="c764e749" name="soundpcm3.bottom.ic27"/>
  </rom>
</misterromdescription>
