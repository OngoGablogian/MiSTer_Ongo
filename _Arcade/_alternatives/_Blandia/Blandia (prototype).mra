<misterromdescription>
    <name>Blandia (prototype)</name>
    <setname>blandiap</setname>
    <rbf>Seta</rbf>
    <mameversion>0286</mameversion>
    <year>1992</year>
    <manufacturer>Allumer</manufacturer>
    <category>Arcade</category>
    <rotation>horizontal</rotation>

    <!-- which game, for rtl/seta_board_cfg.sv. FIRST, because the download is permuted with it. -->
    <rom index="1"><part>1B</part></rom>

    <rom index="0" zip="blandiap.zip|blandia.zip" md5="none">
        <!-- maincpu -->
        <interleave output="16">
            <part name="prg-even.bin" crc="7ecd30e8" map="01"/>
            <part name="prg-odd.bin" crc="42b86c15" map="10"/>
        </interleave>
        <part repeat="524288">00</part>
        <interleave output="16">
            <part name="tbl0.bin" crc="69b79eb8" map="01"/>
            <part name="tbl1.bin" crc="cf2fd350" map="10"/>
        </interleave>
        <!-- gfx1 -->
        <interleave output="16">
            <part name="o-1.bin" crc="4c67b7f0" map="01"/>
            <part name="o-0.bin" crc="5e7b8555" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="o-5.bin" crc="40bee78b" map="01"/>
            <part name="o-4.bin" crc="7c634784" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="o-3.bin" crc="387fc7c4" map="01"/>
            <part name="o-2.bin" crc="c669bb49" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="o-7.bin" crc="fc77b04a" map="01"/>
            <part name="o-6.bin" crc="92882943" map="10"/>
        </interleave>
        <!-- gfx2 -->
        <interleave output="24">
            <part name="v1-2.bin" crc="d524735e" map="001"/>
            <part name="v1-1.bin" crc="09bdf75f" map="010"/>
            <part name="v1-0.bin" crc="73617548" map="100"/>
        </interleave>
        <interleave output="24">
            <part name="v1-5.bin" crc="eb440cdb" map="001"/>
            <part name="v1-4.bin" crc="803911e5" map="010"/>
            <part name="v1-3.bin" crc="7f18e4fb" map="100"/>
        </interleave>
        <!-- pad to 0x800000 -->
        <part repeat="1310720">00</part>
        <!-- gfx3 -->
        <interleave output="24">
            <part name="v2-1.bin" crc="c4f15638" map="001"/>
            <part name="v2-1.bin" crc="c4f15638" map="010"/>
            <part name="v2-0.bin" crc="5b05eba9" map="100"/>
        </interleave>
        <interleave output="24">
            <part name="v2-5.bin" crc="c2e57622" map="001"/>
            <part name="v2-4.bin" crc="16ec2130" map="010"/>
            <part name="v2-3.bin" crc="80ad0c3b" map="100"/>
        </interleave>
        <!-- pad to 0xa00000 -->
        <part repeat="1310720">00</part>
        <!-- x1snd -->
        <part name="s-0.bin" crc="a5fde408" offset="0x0" length="0x20000"/>
        <part name="s-1.bin" crc="3083f9c4" offset="0x0" length="0x20000"/>
        <part name="s-2.bin" crc="a591c9ef" offset="0x0" length="0x20000"/>
        <part name="s-3.bin" crc="68826c9d" offset="0x0" length="0x20000"/>
        <part name="s-4.bin" crc="1c7dc8c2" offset="0x0" length="0x20000"/>
        <part name="s-5.bin" crc="4bb0146a" offset="0x0" length="0x20000"/>
        <part name="s-6.bin" crc="9f8f34ee" offset="0x0" length="0x20000"/>
        <part name="s-7.bin" crc="e077dd39" offset="0x0" length="0x20000"/>
        <part name="s-0.bin" crc="a5fde408" offset="0x20000" length="0x20000"/>
        <part name="s-1.bin" crc="3083f9c4" offset="0x20000" length="0x20000"/>
        <part name="s-2.bin" crc="a591c9ef" offset="0x20000" length="0x20000"/>
        <part name="s-3.bin" crc="68826c9d" offset="0x20000" length="0x20000"/>
        <part name="s-4.bin" crc="1c7dc8c2" offset="0x20000" length="0x20000"/>
        <part name="s-5.bin" crc="4bb0146a" offset="0x20000" length="0x20000"/>
        <part name="s-6.bin" crc="9f8f34ee" offset="0x20000" length="0x20000"/>
        <part name="s-7.bin" crc="e077dd39" offset="0x20000" length="0x20000"/>
    </rom>

    <switches default="FF,FF,FF" base="0">
        <dip name="Lives" bits="0,1" ids="3,2,1/1 Round,1/2 Rounds"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="2 Player Game" bits="4" ids="1 Credit,2 Credits"/>
        <dip name="Continue" bits="5" ids="1 Coin,1 Credit"/>
        <dip name="Flip Screen" bits="6" ids="On,Off"/>
        <dip name="Service Mode" bits="7" ids="On,Off"/>
        <dip name="Demo Sounds" bits="8" ids="Off,On"/>
        <dip name="Coinage Type" bits="9" ids="Coin Mode 2,Coin Mode 1"/>
        <dip name="Coin A" bits="10,11,12" ids="Free Play,2 Coins/3 Credits,2C_5C,2 Coins/1 Credit,3 Coins/1 Credit,1 Coin/3 Credits,1 Coin/2 Credits,1 Coin/1 Credit"/>
        <dip name="Coin B" bits="13,14,15" ids="Free Play,DSW,DSW,DSW,3 Coins/7 CreditsDSW,DSW,DSW,DSW"/>
    </switches>

    <buttons names="Button 1,Button 2,Button 3,-,-,-,Start,Coin,Pause,Service" default="A,B,X,Start,Select,L,R" count="3"/>
</misterromdescription>
