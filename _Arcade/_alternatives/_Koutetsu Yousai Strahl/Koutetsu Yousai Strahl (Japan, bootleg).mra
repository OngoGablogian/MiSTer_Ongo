<!--
  Koutetsu Yousai Strahl (Japan, bootleg) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 49).
  Clone of strahl; files it shares with the parent are looked up in the parent zip.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... strahljbl ...)
  line 10787, ROM_START(strahljbl), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Koutetsu Yousai Strahl (Japan, bootleg)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>strahljbl</setname>
  <year>1992</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="7F,FF,31">
    <dip bits="0,2" name="Coin A" ids="5C_1C,4C_1C,3C_1C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="3,5" name="Coin B" ids="5C_1C,4C_1C,3C_1C,2C_1C,1C_4C,1C_3C,1C_2C,1C_1C"/>
    <dip bits="6" name="Flip Screen" ids="On,Off"/>
    <dip bits="7" name="Demo Sounds" ids="On,Off"/>
    <dip bits="8,9" name="Lives" ids="5,4,2,3"/>
    <dip bits="10,11" name="Difficulty" ids="Hardest,Hard,Easy,Normal"/>
    <dip bits="12" name="Unused (SW2:5)" ids="On,Off"/>
    <dip bits="13,14" name="Bonus Life" ids="None,300k and every 300k,100k and every 200k,200k and every 200k"/>
    <dip bits="15" name="Service Mode" ids="On,Off"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="strahljbl.zip|strahl.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="890f74d0" name="a8.u2" map="01"/>
      <part crc="3ddca4f7" name="a7.u3" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 (seibu_sound_map: 0000-1FFF = the file's start, the 8000-FFFF window = its second half (bank 0) or first half (bank 1)) -->
    <part crc="99ee7505" name="a6.u417"/>
    <!-- fgtile, 0x010000 (strahl's strahl-3.73 data) -->
    <part crc="2273b33e" name="strahl-3.73"/>
    <!-- bgtile, 0x040000 (bgvideoram0's tiles, gfx1; strahl's str7b2r0.275 data) -->
    <part crc="5769e3e1" name="str7b2r0.275"/>
    <!-- bg2tile, 0x080000 (bgvideoram1's tiles, gfx3; strahl's str6b1w1.776 data) -->
    <part crc="bb1bb155" name="str6b1w1.776"/>
    <!-- sprites, 0x180000 (2 plain files; 5.4m = strahl's strl5-03.58 data) -->
    <part crc="09ede4d4" name="d.8m"/>
    <part crc="a0e7d210" name="strl5-03.58"/>
    <!-- oki1, 0x010000 (1 MHz, unbanked) -->
    <part crc="f6f6c4bf" name="a5.u304"/>
  </rom>
</misterromdescription>
