	<nvram index="4" size="512"/>

	<buttons names="Green,Red,-,-,Start,Coin,Service,Pause,Start 3,Start 4" default="A,B,X,Y,Start,Select,L,R"/>

	<switches default="9F,77,FF,FF,FE">
