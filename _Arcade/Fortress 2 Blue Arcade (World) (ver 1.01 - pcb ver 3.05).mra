<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Fortress 2 Blue Arcade (World) (ver 1.01 / pcb ver 3.05)</name>
    <setname>fort2b</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>2001</year>
    <manufacturer>Eolith</manufacturer>
    <category>Shooter</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="fort2b.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00.u5" crc="4437b595" map="0012"/>
            <part name="01.u1" crc="2a410aed" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02.u6" crc="12f0e4c0" map="0012"/>
            <part name="03.u2" crc="aaa7c45a" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04.u7" crc="428070d2" map="0012"/>
            <part name="05.u3" crc="a66f9ba9" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06.u8" crc="899d318e" map="0012"/>
            <part name="07.u4" crc="c4644798" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08.u15" crc="ce0cccfc" map="0012"/>
            <part name="09.u10" crc="5b7de0f1" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10.u16" crc="b47fc014" map="0012"/>
            <part name="11.u11" crc="7113d3f9" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12.u17" crc="8c4b63a6" map="0012"/>
            <part name="13.u12" crc="1d9b9995" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="14.u18" crc="450fa784" map="0012"/>
            <part name="15.u13" crc="c1f02d5c" map="1200"/>
        </interleave>
        <!-- maincpu -->
        <part name="1.u43" crc="b2279485"/>
        <!-- qs1000:cpu -->
        <part name="5.u107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="4.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="2.u97" crc="8a431b14"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="3.u108" crc="9b996b60"/>
    </rom>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
