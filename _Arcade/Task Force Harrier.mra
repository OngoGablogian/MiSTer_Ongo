<!--
  Task Force Harrier — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 20).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... tharrier ...)
  line 10699, ROM_START(tharrier), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Task Force Harrier</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tharrier</setname>
  <year>1989</year>
  <manufacturer>UPL</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,14">
    <dip bits="0" name="Unknown (SW2:8)" ids="On,Off"/>
    <dip bits="1" name="Demo Sounds" ids="Off,On"/>
    <dip bits="2,4" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="5,7" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="8" name="Cabinet" ids="Cocktail,Upright"/>
    <dip bits="9" name="Unknown (SW1:7)" ids="On,Off"/>
    <dip bits="10,11" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="12,13" name="Bonus Life" ids="200k 500k &amp; 1 2 3 5 Mil,None,200k and 1 Mil,200k"/>
    <dip bits="14,15" name="Lives" ids="5,2,4,3"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="tharrier.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="65c247f6" name="3.21b" map="01"/>
      <part crc="f3887a44" name="2.18b" map="10"/>
    </interleave>
    <!-- Z80 sound program, 0x010000 -->
    <part crc="b959f837" name="12.4l"/>
    <!-- fgtile, 0x010000 -->
    <part crc="005c26c3" name="1.13b"/>
    <!-- bgtile, 0x080000 -->
    <part crc="64d7d687" name="89050-4.16f"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_BYTE pair) -->
    <interleave output="16">
      <part crc="7f715421" name="89050-17.16e" map="01"/>
      <part crc="24db3fa4" name="89050-13.16d" map="10"/>
    </interleave>
    <!-- oki1, 0x080000 -->
    <part crc="11ee4c39" name="89050-8.4j"/>
    <!-- oki2, 0x080000 -->
    <part crc="893552ab" name="89050-10.14j"/>
  </rom>
</misterromdescription>
