<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>Steal See</name>
    <setname>stealsee</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>2000</year>
    <manufacturer>Moov Generation / Eolith</manufacturer>
    <category>Puzzle</category>
    <rotation>horizontal</rotation>
    <buttons names="Button 1,Button 2,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,B,Start,Select,L,R" count="2"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>01 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="stealsee.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD32_WORD_SWAP pairs -->
        <interleave output="32">
            <part name="00.u5" crc="59d247a7" map="0012"/>
            <part name="01.u1" crc="255764f2" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="02.u6" crc="ebc33180" map="0012"/>
            <part name="03.u2" crc="a81f9b6d" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="04.u7" crc="24bf37ad" map="0012"/>
            <part name="05.u3" crc="ef6b9450" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="06.u8" crc="284629c6" map="0012"/>
            <part name="07.u4" crc="a64d4434" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="08.u15" crc="861eab08" map="0012"/>
            <part name="09.u10" crc="fd96282e" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="10.u16" crc="761e0a26" map="0012"/>
            <part name="11.u11" crc="574571e7" map="1200"/>
        </interleave>
        <interleave output="32">
            <part name="12.u17" crc="9a4109e5" map="0021"/>
            <part name="13.u12" crc="9a4109e5" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="14.u18" crc="9a4109e5" map="0021"/>
            <part name="15.u13" crc="9a4109e5" map="2100"/>
        </interleave>
        <!-- maincpu -->
        <part name="ss.u43" crc="b0a1a965"/>
        <!-- qs1000:cpu -->
        <part name="ss.u107" crc="afd5263d"/>
        <!-- soundcpu -->
        <part name="ss.u111" crc="79012474"/>
        <part repeat="0x70000">00</part>  <!-- soundcpu end -->
        <!-- qs1000 samples -->
        <part name="ss.u97" crc="56c9f4a4"/>
        <part name="qs1001a.u96" crc="d13c6407"/>
        <part repeat="0x180000">00</part>  <!-- samples end -->
        <!-- sounddata -->
        <part name="ss.u108" crc="95bd136d"/>
    </rom>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
