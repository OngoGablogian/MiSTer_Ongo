<misterromdescription>
	<rbf>SKNS</rbf>
	<mameversion>0289</mameversion>
	<setname>cyvern</setname>
	<name>Cyvern - The Dragon Weapons (US)</name>
	<rotation>vertical</rotation>
	<year>1998</year>
	<manufacturer>Kaneko</manufacturer>
	<buttons names="Button 1,Button 2,Start,Coin,Service" />

	<switches default="01">
		<dip bits="1" name="Flip" ids="On,Off"/>
		<dip bits="6" name="Use Backup Ram" ids="No,Yes"/>
		<dip bits="7" name="Freeze" ids="Yes,No"/>
	</switches>

	<rom index="0" md5="" zip="cyvern.zip|cyvernj.zip|skns.zip" address="0x30000000">
		<interleave output="64">
			<part crc="cd4ae88a" name="cv100-00.u24" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="a6cb3f0b" name="cv101-00.u20" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<interleave output="64">
			<part crc="ddc8c67e" name="cv200-00.u16" map="12345678" />
		</interleave>
		<interleave output="64">
			<part crc="65863321" name="cv201-00.u13" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<part repeat="0x400000">00</part>
		<interleave output="64">
			<part crc="7486bf3a" name="cv210-00.u18" map="12345678" />
		</interleave>
		<part repeat="0x800000">00</part>

		<interleave output="64">
			<part crc="fbeda465" name="cv300-00.u4" map="12345678" />
		</interleave>
		<part repeat="0xC00000">00</part>

		<interleave output="64">
			<part crc="384d21ec" name="sknsu1.u10" map="12345678" />
		</interleave>
		<part repeat="0x180000">00</part>
		<interleave output="64">
			<part crc="1023ddca" name="cv-usa.u10" map="13570" />
			<part crc="f696f6be" name="cv-usa.u8" map="1357" />
		</interleave>
	</rom>
	<rom index="2" md5="" >
		<part>10 55 00 00 00 00</part>
	</rom>
	<nvram index="4" size="0x2000" />
</misterromdescription>