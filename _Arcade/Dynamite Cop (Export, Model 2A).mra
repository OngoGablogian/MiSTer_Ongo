<misterromdescription>
    <!--
      Sega Model 2 core for MiSTer FPGA - Copyright (C) 2026 alphanu1
      SPDX-License-Identifier: GPL-3.0-or-later

      Dynamite Cop (Export, Model 2A) (Model 2A-CRX). Derived from MAME 0.289
      model2.cpp ROM_START(dynamcop).
      For the Model 2A core (branch model2a, Model2.sv M2_2A). Study R887
      (this set), R897 (the large layout).

      NEEDS THE 128 MB SDRAM MODULE (R891). THE LARGE 2A LAYOUT (R897,
      written by tools/mra_2a_big.py): Sega Rally's whole image with
      main_data 32 MB, then the texture-coordinate ROM and the polygons,
      which the loader's third remap puts in the upper 64 MB:
        0x0000000  i960 program 0-512 KB
        0x0080000  main_data, 32 MB (MAME's 0x02000000 window)
        0x2080000  4 MB of zeros
        0x2480000  TGP math tables, 256 KB
        0x24C0000  68000 sound program, 512 KB
        0x2540000  SCSP samples, 8 MB          -> SDRAM byte 0x3400000
        0x2D40000  i960 program 512 KB-2 MB    -> SDRAM byte 0x2600000
        0x2EC0000  TGP copro data, 4 MB        -> SDRAM byte 0x2780000
        0x32C0000  texture-coordinate ROM, 16 MB -> SDRAM byte 0x4000000
        0x42C0000  polygons                    -> SDRAM byte 0x5000000
      Image: 0x62C0000 bytes. Every stretch MAME's region does not load is
      written as MAME's fill (0, or 0xFF where the region is ERASEFF).

      THE 315-5881 (MAME's key 2c2a4a93) is not modelled (R887): its window
      reads 0. The game runs four decrypt sessions (4.4, 5.1, 24.7 and 108 s)
      through two checkers (0x66ac0: "UCHIDA MOMOKA   " against 0xbc800;
      0x66a00: 16 bytes against 0xbc7f0); a mismatch stores 2 in 0x51f4b4
      and calls the penalty, which halts MAME at 4.36 s with the window
      zeroed. THE SIX PATCHES turn each compare's cmpibe into b with the same
      displacement (3aad0010 -> 08000010 at 0x66a50, 0x66a68, 0x66a80,
      0x66a98; 3aad0038 -> 08000038 at 0x66b14, 0x66b54). Proved in MAME
      (R887): zeroed reads plus the six words, 240 s, all four sessions at
      the real run's times, every snapshot byte-identical to the run with
      the chip.

      Index 4, the game ID: 0x14 (R887). Bit 7 would be the 15 kHz CRT flag.
    -->
    <name>Dynamite Cop (Export, Model 2A)</name>
    <setname>dynamcop</setname>
    <rbf>Model2A</rbf>
    <!-- R945: the NVRAM file is the backup RAM (16 KB), "M2EEPROM" and the
         93C46 EEPROM (128 bytes): the game's settings. Needs a core built
         with R945 or later; an earlier core would wrap the extra bytes onto
         the start of backup RAM. -->
    <nvram index="2" size="16520"/>
    <rom index="4" md5="none">
        <part>14 00</part>
    </rom>
    <mameversion>0289</mameversion>
    <year>1998</year>
    <manufacturer>Sega</manufacturer>
    <category>Beat 'em up</category>

    <rom index="0" zip="dynamcop.zip" md5="none">

        <!-- 0x0000000  i960 program 0-512 KB -->
        <interleave output="32">
            <part name="epr-20930.12" crc="b8fc8ff7" map="0021" offset="0x000000" length="0x040000"/>
            <part name="epr-20931.13" crc="89d13f88" map="2100" offset="0x000000" length="0x040000"/>
        </interleave>

        <!-- 0x0080000  i960 data, 32 MB (MAME's 0x02000000 window, mirrors written out) -->
        <interleave output="32">
            <part name="mpr-20797.10" crc="87bab1e4" map="0021"/>
            <part name="mpr-20798.11" crc="40dd752b" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20795.8" crc="0ef85e12" map="0021"/>
            <part name="mpr-20796.9" crc="870139cb" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20793.6" crc="42ea08f8" map="0021"/>
            <part name="mpr-20794.7" crc="8e5cd1db" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20791.4" crc="4883d0df" map="0021"/>
            <part name="mpr-20792.5" crc="47becfa2" map="2100"/>
        </interleave>

        <!-- 0x2080000  4 MB of zeros, to the fixed slots -->
        <part repeat="4194304">00</part>

        <!-- 0x2480000  TGP math tables, 256 KB -->
        <interleave output="32">
            <part name="opr-14742a.45" crc="90c6b117" map="0021"/>
            <part name="opr-14743a.46" crc="ae7f446b" map="2100"/>
        </interleave>

        <!-- 0x24C0000  68000 sound program, 512 KB (16-bit, byte-swapped) -->
        <interleave output="16">
            <part name="epr-20811.30" crc="a154b83e" map="12"/>
        </interleave>

        <!-- 0x2540000  SCSP samples, 8 MB (16-bit, byte-swapped); moved by the
                     loader to SDRAM byte 0x3400000 -->
        <interleave output="16">
            <part name="mpr-20812.31" crc="695b6088" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-20813.32" crc="1908679c" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-20814.36" crc="e8ebc74c" map="12"/>
        </interleave>
        <interleave output="16">
            <part name="mpr-20815.37" crc="1b5aaae4" map="12"/>
        </interleave>

        <!-- 0x2D40000  i960 program 512 KB-2 MB (R862) -->
        <interleave output="32">
            <part name="epr-20930.12" crc="b8fc8ff7" map="0021" offset="0x040000" length="0x040000"/>
            <part name="epr-20931.13" crc="89d13f88" map="2100" offset="0x040000" length="0x040000"/>
        </interleave>
        <interleave output="32">
            <part name="epr-20932.14" crc="618a68bf" map="0021"/>
            <part name="epr-20933.15" crc="13abe49c" map="2100"/>
        </interleave>

        <!-- 0x2EC0000  TGP copro data, 4 MB (R862) -->
        <part repeat="4194304">00</part>

        <!-- 0x32C0000  texture-coordinate ROM, 16 MB (R897; the loader's third
                     remap puts it at SDRAM byte 0x4000000) -->
        <interleave output="32">
            <part name="mpr-20809.25" crc="3b7b4622" map="0021"/>
            <part name="mpr-20807.24" crc="1241e0f2" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20810.27" crc="838a10a7" map="0021"/>
            <part name="mpr-20808.26" crc="706bd495" map="2100"/>
        </interleave>

        <!-- 0x42C0000  polygons, 32 MB (R897; SDRAM byte 0x5000000) -->
        <interleave output="32">
            <part name="mpr-20799.16" crc="424571bf" map="0021"/>
            <part name="mpr-20803.20" crc="61a8ad52" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20800.17" crc="3c2ee808" map="0021"/>
            <part name="mpr-20804.21" crc="03b35cb8" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20801.18" crc="c6914173" map="0021"/>
            <part name="mpr-20805.22" crc="f6605ede" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="mpr-20802.19" crc="d11b5267" map="0021"/>
            <part name="mpr-20806.23" crc="0c942073" map="2100"/>
        </interleave>

        <!-- R887: the 315-5881 checks, cmpibe -> b (same displacement) -->
        <patch offset="0x66a50">10 00 00 08</patch>
        <patch offset="0x66a68">10 00 00 08</patch>
        <patch offset="0x66a80">10 00 00 08</patch>
        <patch offset="0x66a98">10 00 00 08</patch>
        <patch offset="0x66b14">38 00 00 08</patch>
        <patch offset="0x66b54">38 00 00 08</patch>

    </rom>

    <!-- Player 1 on joystick 1, player 2 on joystick 2, the same buttons
         (VF2's order: R887's three-button profile). -->
    <buttons names="Punch,Kick,Jump,Start,Coin,Test,Service"/>
</misterromdescription>
