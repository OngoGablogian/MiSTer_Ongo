<misterromdescription>
    <!-- Generated by scripts/build_mra.py from MAME eolith16.cpp; the layout is
         rtl/eo_sdram_map.svh. Do not edit by hand. -->
    <name>KlonDike+</name>
    <setname>klondkp</setname>
    <rbf>Eolith</rbf>
    <mameversion>0289</mameversion>
    <year>1999</year>
    <manufacturer>Eolith</manufacturer>
    <category>Card</category>
    <rotation>horizontal</rotation>
    <buttons names="Pick,-,-,-,Start,Coin,Pause,Service Coin,Service Mode" default="A,Start,Select,L,R" count="1"/>

    <!-- mod byte (Eolith.sv): [1:0] board type, 0 Vega, 1 Gradation 2D, 2 eolith16; [2] light pens; then the
         memory wait states, clocks per MEM3 and per MEM0-2 access (rtl/eo_busws.sv) -->
    <rom index="1"><part>02 00 00</part></rom>

    <!-- address: the HPS puts the image in DDR3 and the core copies it to SDRAM (rtl/memory/vh_rom_loader.sv) -->
    <rom index="0" zip="klondkp.zip" md5="none" address="0x30000000">
        <!-- maindata: ROM_LOAD16_WORD_SWAP -->
        <interleave output="16">
            <part name="kd.u31" crc="e5dd12b5" map="12"/>
        </interleave>
        <part repeat="0x1E00000">00</part>  <!-- maindata end -->
        <!-- maincpu -->
        <part name="kd.u5" crc="591f0c73"/>
        <part repeat="0x80000">00</part>  <!-- maincpu end -->
        <!-- oki -->
        <part name="kd.u28" crc="c12112a1"/>
    </rom>

    <!-- the .nvm: AT28C16 (Vega, 2 KB) or 93C66 (512 x 8) -->
    <nvram index="2" size="512"/>
</misterromdescription>
