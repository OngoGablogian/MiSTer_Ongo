<misterromdescription>
	<name>Arm Wrestling</name>
	<setname>armwrest</setname>
	<year>1985</year>
	<manufacturer>Nintendo</manufacturer>
	<rbf>Punchout_test</rbf>
	<rotation>horizontal</rotation>
	<mameversion>277</mameversion>
	<!--buttons default="B,A,Y,X,Select" names="Left Punch,Right Punch,Pull,Power,Coin"></buttons-->
	<!--buttons default="Y,X,Select" names="-,-,Pull,Power,Coin"></buttons-->
	<!--buttons default="X,Select,Y" names="-,-,-,Pull,Coin,Power"></buttons-->
	<buttons default="A,Select,B" names="-,-,-,Pull,Coin,Power"></buttons>
	<switches default="ff,0f">
		<!-- SW2 -->
		<dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
		<dip name="Coinage Table" bits="5" ids="A (listed below),B (see .mra comment)" values="1,0"/>
		<dip name="Rematches" bits="6" ids="3,7"/>
		<dip name="Service Mode" bits="7" ids="On,Off"/>
		<!-- SW1 -->
		<dip name="Coinage" bits="8,11" ids="1 Coin/1 Credit,2 Coins/1 Credit,3 Coins/1 Credit,4 Coins/1 Credit,5 Coins/1 Credit,6 Coins/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/4 Credits,1 Coin/5 Credits,1 Coin/6 Credits,1 Coin/3 Cr 2/Play,1 Coin/5 Cr 2/Play,1 Coin/4 Cr 3/Play,1 Coin/5 Cr 5/Play,Free Play" values="15,14,3,12,11,7,13,10,9,5,8,4,2,1,6,0"/>
		<!--dip name="Coin Slots (R18)" bits="14" ids="1,2"/-->
		<!--dip name="R19 (unused)" bits="15" ids="Fitted,Not Fitted"/-->
	</switches>
