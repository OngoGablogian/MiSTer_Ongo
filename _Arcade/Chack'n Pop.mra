<?xml version="1.0" encoding="UTF-8"?>
<!-- ========================================================== -->
<!-- BAZSET CORE: CHACK'N POP - B01 PATREON RELEASE                  -->
<!-- RBF FILE: Arcade-ChacknPop.rbf                               -->
<!-- REQUIRED ROM ZIP FILE(S): chaknpop.zip (owner-supplied)     -->
<!-- B01 IN ENGINEERING: NOT CERTIFIED. ORIGINAL ROM NOT INCLUDED -->
<!-- ========================================================== -->
<misterromdescription>
  <!-- MRA Pause V4 authoring; BZM1 V1 on-wire packet.
       BZM1 CRC receiver and V4 pause renderer in B01 candidate. -->
  <bazset_runtime version="1">
    <pause>
      <title>Chack'n Pop</title>
      <build>B01 V3.3 DEVELOPMENT - 2026-10-27</build>
      <core_by>bazset</core_by>
      <patreon>patreon.com/c/bazset</patreon>
      <x>x.com/bazset_</x>
      <beta_testers>No beta testers yet</beta_testers>
      <patreon_supporters>Alexander Facchini | Groquik | BabaYaga326 | Curt Dittmer | Alessandro Gulli | RGM | JamieCRT | AlfEightyOne | Scott Dexter</patreon_supporters>
      <special_thanks>MAME hardware researchers</special_thanks>
      <bug_prompt>FOUND A BUG? REPORT IT ON MY PATREON</bug_prompt>
    </pause>
    <osd>
      <visibility>Video Settings,Game Settings,DIP Switches,Credits,Reset</visibility>
      <defaults>Aspect=Original;CRT Adjust=On;CRT H Position=0;CRT V Position=0</defaults>
    </osd>
    <pause_style>
      <colors background="#080B18" card="#101522" border="#D9A441"
              text="#F0E9D7" dim="#71798A" accent="#5DE4FF"/>
      <layout preset="compact"/>
      <marquee frames="12"/>
    </pause_style>
  </bazset_runtime>
  <name>Chack'n Pop</name>
  <setname>chaknpop</setname>
  <mameversion>0289</mameversion>
  <year>1983</year>
  <manufacturer>Taito</manufacturer>
  <region>Japan</region>
  <category>Arcade</category>
  <players>2</players>
  <rotation>horizontal</rotation>
  <rbf>bazset_ChacknPop</rbf>
  <joystick/>
  <!-- MAME 0.289 hiscore.dat: CPU 8449 len 0x1f, guards 04/00 and 8466=14. -->
  <nvram index="2" size="31"/>
  <!-- Original ROM0 packed stream for active HPS ROM loader:
       00000-07fff main ROM bank 0000-7fff (4 x 0x2000)
       08000-09fff main ROM a000-bfff (0x2000)
       0a000-0a7ff MC68705P5 ROM (0x0800)
       0a800-0e7ff sprites (0x4000; MAME physical order)
       0e800-127ff chars (0x4000)
       12800-12fff palette PROMs (0x0800)
       END 0x13000. DO NOT confuse packed stream with CPU address. -->
  <rom index="0" zip="chaknpop.zip">
    <part name="ao4_01.ic28" crc="386fe1c8"/>
    <part name="ao4_02.ic27" crc="5562a6a7"/>
    <part name="ao4_03.ic26" crc="3e2f0a9c"/>
    <part name="ao4_04.ic25" crc="5209c7d4"/>
    <part name="ao4_05.ic3" crc="8720e024"/>
    <part name="ao4_06.ic23" crc="9c78c24c"/>
    <part name="ao4_08.ic14" crc="5575a021"/>
    <part name="ao4_07.ic15" crc="ae687c18"/>
    <part name="ao4_09.ic98" crc="757a723a"/>
    <part name="ao4_10.ic97" crc="3e3fd608"/>
    <part name="ao4-11.ic96" crc="9bf0e85f"/>
    <part name="ao4-12.ic95" crc="954ce8fc"/>
  </rom>
  <!-- Important: ROM0 MUST precede the config index ROM for reset semantics. -->
  <rom index="249"><part></part></rom>
  <!-- Original board DIP defaults A=00, B=4F, C=7D.
       Data path to FPGA is not implemented/verified yet. -->
  <switches page_id="1" page_name="DIP Switches" base="16" default="00,4F,7D">
    <DSWA/>
    <dip name="Coin A" bits="0,1,2,3" ids="1C 1C,1C 2C,1C 3C,1C 4C,1C 5C,1C 6C,1C 7C,1C 8C,2C 1C,3C 1C,4C 1C,5C 1C,6C 1C,7C 1C,8C 1C,9C 1C"/>
    <dip name="Coin B" bits="4,5,6,7" ids="1C 1C,1C 2C,1C 3C,1C 4C,1C 5C,1C 6C,1C 7C,1C 8C,2C 1C,3C 1C,4C 1C,5C 1C,6C 1C,7C 1C,8C 1C,9C 1C"/>
    <DSWB/>
    <dip name="Bonus Life" bits="8,9" ids="80K/100K,60K/100K,40K/100K,20K/100K"/>
    <dip name="Free Play" bits="10" ids="On,Off"/>
    <dip name="Lives" bits="11,12" ids="6,3,2,1"/>
    <dip name="Training" bits="13" ids="On,Off"/>
    <dip name="Flip Screen" bits="14" ids="On,Off"/>
    <dip name="Cabinet" bits="15" ids="Upright,Cocktail"/>
    <DSWC/>
    <dip name="Language" bits="16" ids="English,Japanese"/>
    <dip name="Demo Sounds" bits="17" ids="On,Off"/>
    <dip name="Super Chack'n" bits="18" ids="1st Chance,pi"/>
    <dip name="Endless (Cheat)" bits="19" ids="On,Off"/>
    <dip name="Credit Info" bits="20" ids="Off,On"/>
    <dip name="Show Year" bits="21" ids="Off,On"/>
    <dip name="Infinite (Cheat)" bits="22" ids="On,Off"/>
    <dip name="Coinage" bits="23" ids="1 Way,2 Way"/>
  </switches>
  <buttons names="Left Bomb,Right Bomb,P1 Start,P2 Start,Coin,Service,Pause"
           default="Y,B,Start,R,Select,X,L"/>
</misterromdescription>
