<!--
  Thunder Dragon (8th Jan. 1992, unprotected) — NMK16 "Gunnail" rbf (rtl/gunnail/gunnail_core.sv game id 8).
  Parent set.

  Transcribed from mame/src/mame/nmk/nmk16.cpp: GAME(... tdragon ...)
  line 10722, ROM_START(tdragon), its INPUT_PORTS_START DIP tables.
  ROM part order = the core's per-game SDRAM layout (contiguous — the
  loader streams the parts back to back). The nmk_irq timing PROMs are
  fixed at synthesis and not downloaded. Generated by
  tools/gen_gunnail_mra.py.
-->
<misterromdescription>
  <name>Thunder Dragon (8th Jan. 1992, unprotected)</name>
  <mratimestamp>202609110000</mratimestamp>
  <mameversion>0270</mameversion>
  <setname>tdragon</setname>
  <year>1991</year>
  <manufacturer>NMK (Tecmo license)</manufacturer>
  <category>Shooter</category>
  <rbf>Gunnail</rbf>

  <!-- ROT270 in nmk16.cpp -->
  <rotation>1</rotation>

  <!-- DSW1, DSW2 (defaults from the PORT_DIPNAME default values; ids in
       bit-value order, value 0 first), then the game-id byte the core
       selects the board with. -->
  <switches default="FF,FF,08">
    <dip bits="0" name="Flip Screen" ids="On,Off"/>
    <dip bits="1" name="Unused (SW1:7)" ids="On,Off"/>
    <dip bits="2,3" name="Difficulty" ids="Hardest,Easy,Hard,Normal"/>
    <dip bits="4" name="Unused (SW1:4)" ids="On,Off"/>
    <dip bits="5" name="Unused (SW1:3)" ids="On,Off"/>
    <dip bits="6,7" name="Lives" ids="1,2,4,3"/>
    <dip bits="8" name="Unused (SW2:8)" ids="Off,On"/>
    <dip bits="9" name="Demo Sounds" ids="Off,On"/>
    <dip bits="10,12" name="Coin B" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
    <dip bits="13,15" name="Coin A" ids="Free_Play,1C_4C,3C_1C,1C_2C,4C_1C,1C_3C,2C_1C,1C_1C"/>
  </switches>

  <buttons names="Button 1,Button 2,Button 3,Start,Coin" default="Y,B,A,Start,R"/>

  <rom index="0" zip="tdragon.zip|nmk004.zip" md5="none">
    <!-- maincpu, 0x040000 -->
    <interleave output="16">
      <part crc="6e154d8e" name="91070_68k.7" map="01"/>
      <part crc="121c3ae7" name="91070_68k.8" map="10"/>
    </interleave>
    <!-- NMK004 external program, 0x010000 -->
    <part crc="bf493d74" name="91070.1"/>
    <!-- NMK004 internal boot ROM, 0x002000 (nmk004.zip) -->
    <part crc="8ae61a09" name="nmk004.bin"/>
    <!-- fgtile, 0x020000 -->
    <part crc="fe365920" name="91070.6"/>
    <!-- bgtile, 0x100000 -->
    <part crc="d0bde826" name="91070.5"/>
    <!-- sprites, 0x100000 (ROM_LOAD16_WORD_SWAP) -->
    <part crc="3eedc2fe" name="91070.4"/>
    <!-- oki1, 0x080000 -->
    <part crc="ae6875a8" name="91070.3"/>
    <!-- oki2, 0x080000 -->
    <part crc="ecfea43e" name="91070.2"/>
  </rom>
</misterromdescription>
