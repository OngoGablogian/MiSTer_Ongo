    <nvram index="3" size="32768"/>
    <!-- Advance and Hi Score Reset are the coin-door service buttons; with the
         OSD "Service Switch" set to Manual Down they open NARC's operator menu. -->
    <buttons names="Fire,Jump,Rocket Bomb,Crouch,Start,Coin,Advance,Hi Score Reset" default="A,B,X,Y,Start,Select,L,R" count="8"/>
